#!/usr/bin/env bash
# RIINA pre-push hook — runs riinac verify --full + strict security gates.
# Install: cp 00_SETUP/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -euo pipefail

# Source cargo environment if available
# (needed for riinac verify which runs cargo commands)
if [ -f "${HOME}/.cargo/env" ]; then
    source "${HOME}/.cargo/env"
fi

# Source opam environment if available
# (needed for Coq compilation via riinac verify --full)
if command -v opam &> /dev/null; then
    eval $(opam env --switch=coq820 2>/dev/null) || true
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
ISABELLE_HELPER="$REPO_ROOT/scripts/isabelle-local.sh"

echo "================================================================"
echo "  RIINA PRE-PUSH VERIFICATION"
echo "================================================================"

if [ ! -f "$ISABELLE_HELPER" ]; then
    echo "FAIL: missing Isabelle helper ($ISABELLE_HELPER)"
    exit 1
fi
# shellcheck disable=SC1090
source "$ISABELLE_HELPER"

if ! ISABELLE_BIN="$(riina_require_local_isabelle "$REPO_ROOT" 2>&1)"; then
    echo "FAIL: local Isabelle policy failed"
    echo "$ISABELLE_BIN"
    echo "Run: bash scripts/provision-isabelle.sh"
    exit 1
fi
riina_export_local_isabelle_env "$ISABELLE_BIN"
echo "Local Isabelle verified: $ISABELLE_BIN"

# ── Step 1: Locate riinac (with staleness check) ──────────────────
RIINAC=""
for candidate in \
    "${REPO_ROOT}/03_PROTO/target/release/riinac" \
    "${REPO_ROOT}/03_PROTO/target/debug/riinac"; do
    if [ -x "$candidate" ]; then
        RIINAC="$candidate"
        break
    fi
done

# Staleness check: rebuild if any riinac crate source is newer than the binary
REBUILD_NEEDED=0
if [ -n "$RIINAC" ]; then
    NEWEST_SRC=$(find "${REPO_ROOT}/03_PROTO/crates/riinac" -name "*.rs" -newer "$RIINAC" 2>/dev/null | head -1)
    if [ -n "$NEWEST_SRC" ]; then
        echo "  riinac binary is stale ($(basename "$NEWEST_SRC") is newer) — rebuilding..."
        REBUILD_NEEDED=1
    fi
fi

if [ -z "$RIINAC" ] || [ "$REBUILD_NEEDED" -eq 1 ]; then
    if [ -z "$RIINAC" ]; then
        echo "riinac not found — building..."
    fi
    (cd "${REPO_ROOT}/03_PROTO" && cargo build --release -p riinac 2>&1) || {
        echo "FAIL: could not build riinac"
        exit 1
    }
    RIINAC="${REPO_ROOT}/03_PROTO/target/release/riinac"
fi

# ── Step 2: Run riinac verify --full ───────────────────────────────
echo "[1/4] Running riinac verify --full..."
"$RIINAC" verify --full || {
    echo "BLOCKED: riinac verify --full failed"
    exit 1
}
echo "      riinac verify --full passed"

# ── Step 3: Strict security gates ──────────────────────────────────
echo "[2/4] Running strict security gates..."
ZERO="0000000000000000000000000000000000000000"
RANGES=()

while read local_ref local_sha remote_ref remote_sha; do
    if [ -z "${local_sha:-}" ]; then
        continue
    fi
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi

    if [ "$remote_sha" = "$ZERO" ]; then
        # New remote ref; compare against HEAD ancestry as best-effort fallback.
        RANGES+=("$local_sha")
    else
        RANGES+=("$remote_sha..$local_sha")
    fi
done

if [ ${#RANGES[@]} -eq 0 ]; then
    RANGES=("origin/main..HEAD")
fi

SECURITY_CMD=(bash "$REPO_ROOT/scripts/security-gates.sh")
for range in "${RANGES[@]}"; do
    SECURITY_CMD+=(--range "$range")
done

"${SECURITY_CMD[@]}" || {
    echo "BLOCKED: strict security gates failed"
    exit 1
}
echo "      strict security gates passed"

echo ""
echo "================================================================"
echo "  ALL PRE-PUSH CHECKS PASSED"
echo "================================================================"
