#!/usr/bin/env bash
# ============================================================================
# RIINA pre-commit hook — MANDATORY verification before each commit
#
# This hook enforces:
#   1. Documentation audit (metrics match codebase)
#   2. Code verification (riinac verify --fast)
#
# Install: bash 00_SETUP/scripts/install_hooks.sh
# Manual:  cp 00_SETUP/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# NEVER bypass this hook. If it fails, fix the issue.
# ============================================================================

set -euo pipefail

# Source cargo environment if available
# (needed for riinac verify which runs cargo commands)
if [ -f "${HOME}/.cargo/env" ]; then
    source "${HOME}/.cargo/env"
fi

# Source opam environment if available
# (needed for Coq compilation via riinac verify)
if command -v opam &> /dev/null; then
    eval $(opam env --switch=coq820 2>/dev/null) || true
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "================================================================"
echo "  RIINA PRE-COMMIT VERIFICATION"
echo "================================================================"

# ── Step 0a: _CoqProject completeness check ──────────────────────────
# Every .v file in 02_FORMAL/coq/ (except _archive_deprecated/) must be
# listed in _CoqProject.  Catches the "AhmedStyleTest.v" class of drift
# where a file exists on disk but verify.rs (which reads _CoqProject)
# never sees it.
COQ_DIR="$REPO_ROOT/02_FORMAL/coq"
COQ_PROJECT="$COQ_DIR/_CoqProject"
if [ -f "$COQ_PROJECT" ]; then
    MISSING=$(comm -23 \
      <(find "$COQ_DIR" -name "*.v" -type f ! -path "*/_archive_deprecated/*" ! -path "*/_incomplete/*" -printf "%P\n" | sort) \
      <(grep '\.v$' "$COQ_PROJECT" | grep -v '^#' | sed 's/^[[:space:]]*//' | sort))
    if [ -n "$MISSING" ]; then
        echo ""
        echo "================================================================"
        echo "  BLOCKED: .v files not listed in _CoqProject"
        echo ""
        echo "$MISSING"
        echo ""
        echo "  Add these files to 02_FORMAL/coq/_CoqProject or delete them."
        echo "================================================================"
        exit 1
    fi
    echo "[0a] _CoqProject completeness: OK"
fi

# ── Step 1: Documentation Audit ───────────────────────────────────────
# Skip audit for commits that are explicitly documentation updates
COMMIT_MSG_FILE="${1:-}"
SKIP_AUDIT=0

# Check if this is a recovery/protocol commit (allow to proceed)
if [ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ]; then
    if grep -qE '\[RECOVERY\]|\[AUDIT\]|\[PROTOCOL\]' "$COMMIT_MSG_FILE" 2>/dev/null; then
        SKIP_AUDIT=1
    fi
fi

# ── Step 0b: Auto-regenerate metrics if proof/test files changed ──────
# Detects staged changes to .v/.lean/.thy/.rs files and re-generates
# metrics.json + propagates to docs BEFORE the audit runs.
if [ "$SKIP_AUDIT" -eq 0 ]; then
    STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)
    PROOF_CHANGED=0
    if echo "$STAGED_FILES" | grep -qE '\.(v|lean|thy)$'; then
        PROOF_CHANGED=1
    fi
    if echo "$STAGED_FILES" | grep -qE '03_PROTO/.*\.rs$'; then
        PROOF_CHANGED=1
    fi

    if [ "$PROOF_CHANGED" -eq 1 ]; then
        echo "[0/3] Proof/test files changed — regenerating metrics..."
        if [ -f "${REPO_ROOT}/scripts/generate-metrics.sh" ]; then
            bash "${REPO_ROOT}/scripts/generate-metrics.sh" --fast 2>/dev/null || true
        fi
        if [ -f "${REPO_ROOT}/scripts/sync-metrics.sh" ]; then
            bash "${REPO_ROOT}/scripts/sync-metrics.sh" 2>/dev/null || true
        fi
        # Auto-stage updated metrics files so audit-docs sees fresh data
        git add "${REPO_ROOT}/website/public/metrics.json" 2>/dev/null || true
        git add "${REPO_ROOT}/CLAUDE.md" "${REPO_ROOT}/README.md" \
                "${REPO_ROOT}/PROGRESS.md" "${REPO_ROOT}/CONTRIBUTING.md" \
                "${REPO_ROOT}/llms.txt" 2>/dev/null || true
        echo "      Metrics regenerated and staged"
    fi
fi

if [ "$SKIP_AUDIT" -eq 0 ] && [ -f "${REPO_ROOT}/scripts/audit-docs.sh" ]; then
    echo "[1/3] Running documentation audit..."
    if ! bash "${REPO_ROOT}/scripts/audit-docs.sh" --quick 2>/dev/null; then
        echo ""
        echo "================================================================"
        echo "  BLOCKED: Documentation audit failed"
        echo ""
        echo "  Run: bash scripts/audit-docs.sh"
        echo "  Fix discrepancies, then commit again."
        echo "================================================================"
        exit 1
    fi
else
    echo "[1/3] Documentation audit skipped (recovery commit or script missing)"
fi

# ── Step 1b: Vacuity gate for staged .v files ────────────────────────
# Only runs if .v files are being committed. Catches vacuous proofs
# (True/trivial, reflexivity on boolean stubs, False definitions).
STAGED_V_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.v$' | grep -v '_archive_deprecated' || true)
if [ -n "$STAGED_V_FILES" ] && [ -f "${REPO_ROOT}/scripts/detect-vacuous-proofs.py" ]; then
    echo "[1b/3] Vacuity check on staged .v files..."
    VACUITY_FOUND=0
    for vf in $STAGED_V_FILES; do
        FULL_PATH="${REPO_ROOT}/${vf}"
        if [ -f "$FULL_PATH" ]; then
            RESULT=$(python3 "${REPO_ROOT}/scripts/detect-vacuous-proofs.py" "$FULL_PATH" --summary 2>&1 || true)
            FINDINGS=$(echo "$RESULT" | grep "Total findings:" | grep -oE '[0-9]+' || echo "0")
            CRITICAL=$(echo "$RESULT" | grep "P1 (True/trivial)" | grep -oE '[0-9]+' | head -1 || echo "0")
            P3=$(echo "$RESULT" | grep "P3 (False definitions)" | grep -oE '[0-9]+' | head -1 || echo "0")
            if [ "${CRITICAL:-0}" -gt 0 ] || [ "${P3:-0}" -gt 0 ]; then
                echo "  WARNING: ${vf} has ${CRITICAL} True/trivial + ${P3} False-stub findings"
                VACUITY_FOUND=1
            fi
        fi
    done
    if [ "$VACUITY_FOUND" -eq 1 ]; then
        echo ""
        echo "  ⚠ Vacuous proofs detected in staged .v files."
        echo "  Review with: python3 scripts/detect-vacuous-proofs.py <file>"
        echo "  Proceeding (warning only — not blocking until vacuity gate is mandatory)"
    else
        echo "      No critical vacuity in staged .v files"
    fi
fi

# ── Step 2: Locate riinac (with staleness check) ─────────────────────
RIINAC=""
for candidate in \
    "${REPO_ROOT}/03_PROTO/target/release/riinac" \
    "${REPO_ROOT}/03_PROTO/target/debug/riinac"; do
    if [ -x "$candidate" ]; then
        RIINAC="$candidate"
        break
    fi
done

# Staleness check: rebuild if any riinac crate source is newer than the binary
REBUILD_NEEDED=0
if [ -n "$RIINAC" ]; then
    NEWEST_SRC=$(find "${REPO_ROOT}/03_PROTO/crates/riinac" -name "*.rs" -newer "$RIINAC" 2>/dev/null | head -1)
    if [ -n "$NEWEST_SRC" ]; then
        echo "  riinac binary is stale ($(basename "$NEWEST_SRC") is newer) — rebuilding..."
        REBUILD_NEEDED=1
    fi
fi

if [ -z "$RIINAC" ] || [ "$REBUILD_NEEDED" -eq 1 ]; then
    if [ -z "$RIINAC" ]; then
        echo "riinac not found — building..."
    fi
    (cd "${REPO_ROOT}/03_PROTO" && cargo build --release -p riinac 2>&1) || {
        echo "FAIL: could not build riinac"
        exit 1
    }
    RIINAC="${REPO_ROOT}/03_PROTO/target/release/riinac"
fi

# ── Step 3: Code Verification ─────────────────────────────────────────
echo "[2/3] Running riinac verify --fast..."
"$RIINAC" verify --fast || {
    echo ""
    echo "================================================================"
    echo "  BLOCKED: riinac verify --fast failed"
    echo "================================================================"
    exit 1
}

echo ""
echo "================================================================"
echo "  PRE-COMMIT VERIFICATION PASSED"
echo "================================================================"
exit 0
