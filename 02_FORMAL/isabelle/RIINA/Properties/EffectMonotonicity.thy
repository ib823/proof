(* If application has pure effect, function body and arguments are pure. *)
(* app_pure_implies_parts_pure (matches Coq) *)
lemma app_pure_implies_parts_pure: "\<forall> Γ Σ Δ e1 e2 T1 T ε_fn ε1 ε2, has_type Γ Σ Δ e1 (TFn T1 T ε_fn) ε1 \<longrightarrow> has_type Γ Σ Δ e2 T1 ε2 \<longrightarrow> effect_join ε_fn (effect_join ε1 ε2) = EffPure \<longrightarrow> ε_fn = EffPure \<and> ε1 = EffPure \<and> ε2 = EffPure"
  by auto

(* If let has pure effect, both body and continuation are pure. *)
(* let_pure_implies_parts_pure (matches Coq) *)
lemma let_pure_implies_parts_pure: "\<forall> ε1 ε2, effect_join ε1 ε2 = EffPure \<longrightarrow> ε1 = EffPure \<and> ε2 = EffPure"
  by auto

(* If if-then-else has pure effect, all branches are pure. *)
(* if_pure_implies_parts_pure (matches Coq) *)
lemma if_pure_implies_parts_pure: "\<forall> ε1 ε2 ε3, effect_join ε1 (effect_join ε2 ε3) = EffPure \<longrightarrow> ε1 = EffPure \<and> ε2 = EffPure \<and> ε3 = EffPure"
  by auto

(* The effect of an application is at least as large as the function body effect. *)
(* app_effect_geq_fn (matches Coq) *)
lemma app_effect_geq_fn: "\<forall> Γ Σ Δ e1 e2 T T1 ε_fn ε1 ε2, has_type Γ Σ Δ e1 (TFn T1 T ε_fn) ε1 \<longrightarrow> has_type Γ Σ Δ e2 T1 ε2 \<longrightarrow> effect_leq ε_fn (effect_join ε_fn (effect_join ε1 ε2))"
  by auto

(* The effect of an application is at least as large as each argument's effect. *)
(* app_effect_geq_arg1 (matches Coq) *)
lemma app_effect_geq_arg1: "\<forall> ε_fn ε1 ε2, effect_leq ε1 (effect_join ε_fn (effect_join ε1 ε2))"
  by simp

(* app_effect_geq_arg2 (matches Coq) *)
lemma app_effect_geq_arg2: "\<forall> ε_fn ε1 ε2, effect_leq ε2 (effect_join ε_fn (effect_join ε1 ε2))"
  by simp

(* The effect of a let is at least as large as each component. *)
(* let_effect_geq_body (matches Coq) *)
lemma let_effect_geq_body: "\<forall> ε1 ε2, effect_leq ε1 (effect_join ε1 ε2)"
  by auto

(* let_effect_geq_cont (matches Coq) *)
lemma let_effect_geq_cont: "\<forall> ε1 ε2, effect_leq ε2 (effect_join ε1 ε2)"
  by auto

(* Fst inversion preserves pure effect. *)
(* fst_pure (matches Coq) *)
lemma fst_pure: "\<forall> Γ Σ Δ e T1, has_type Γ Σ Δ (EFst e) T1 EffPure \<longrightarrow> \<exists> T2, has_type Γ Σ Δ e (TProd T1 T2) EffPure"
  by auto

(* Snd inversion preserves pure effect. *)
(* snd_pure (matches Coq) *)
lemma snd_pure: "\<forall> Γ Σ Δ e T2, has_type Γ Σ Δ (ESnd e) T2 EffPure \<longrightarrow> \<exists> T1, has_type Γ Σ Δ e (TProd T1 T2) EffPure"
  by auto

(* Classify of pure expression gives pure classify. *)
(* classify_pure (matches Coq) *)
lemma classify_pure: "\<forall> Γ Σ Δ e T, has_type Γ Σ Δ (EClassify e) (TSecret T) EffPure \<longrightarrow> has_type Γ Σ Δ e T EffPure"
  by auto

(* Prove of pure expression gives pure prove. *)
(* prove_pure (matches Coq) *)
lemma prove_pure: "\<forall> Γ Σ Δ e T, has_type Γ Σ Δ (EProve e) (TProof T) EffPure \<longrightarrow> has_type Γ Σ Δ e T EffPure"
  by auto

(* Effect join is bounded by the max of individual levels. *)
(* effect_join_level_bound (matches Coq) *)
lemma effect_join_level_bound: "\<forall> e1 e2, effect_level (effect_join e1 e2) = Nat.max (effect_level e1) (effect_level e2)"
  by auto

(* If an effect is greater than or equal to a join, it's geq both components. *)
(* effect_leq_join_both (matches Coq) *)
lemma effect_leq_join_both: "\<forall> e1 e2 e, effect_leq (effect_join e1 e2) e \<longrightarrow> effect_leq e1 e \<and> effect_leq e2 e"
  by simp

(* Conversely, if an effect is geq both, it's geq the join. *)
(* effect_leq_both_join (matches Coq) *)
lemma effect_leq_both_join: "\<forall> e1 e2 e, effect_leq e1 e \<longrightarrow> effect_leq e2 e \<longrightarrow> effect_leq (effect_join e1 e2) e"
  by simp

(* Pure is the identity for effect_join. *)
(* effect_join_pure_r (matches Coq) *)
lemma effect_join_pure_r: "\<forall> e, effect_join e EffPure = e"
  by auto

(* TFn is injective in all arguments. *)
(* tfn_injective (matches Coq) *)
lemma tfn_injective: "\<forall> T1 T2 ε1 T1' T2' ε1', TFn T1 T2 ε1 = TFn T1' T2' ε1' \<longrightarrow> T1 = T1' \<and> T2 = T2' \<and> ε1 = ε1'"
  by auto

(* TProd is injective. *)
(* tprod_injective (matches Coq) *)
lemma tprod_injective: "\<forall> T1 T2 T1' T2', TProd T1 T2 = TProd T1' T2' \<longrightarrow> T1 = T1' \<and> T2 = T2'"
  by auto

(* TSum is injective. *)
(* tsum_injective (matches Coq) *)
lemma tsum_injective: "\<forall> T1 T2 T1' T2', TSum T1 T2 = TSum T1' T2' \<longrightarrow> T1 = T1' \<and> T2 = T2'"
  by auto

(* TRef is injective. *)
(* tref_injective (matches Coq) *)
lemma tref_injective: "\<forall> T sl T' sl', TRef T sl = TRef T' sl' \<longrightarrow> T = T' \<and> sl = sl'"
  by auto

(* TSecret is injective. *)
(* tsecret_injective (matches Coq) *)
lemma tsecret_injective: "\<forall> T T', TSecret T = TSecret T' \<longrightarrow> T = T'"
  by auto

(* TProof is injective. *)
(* tproof_injective (matches Coq) *)
lemma tproof_injective: "\<forall> T T', TProof T = TProof T' \<longrightarrow> T = T'"
  by auto

(* TList is injective. *)
(* tlist_injective (matches Coq) *)
lemma tlist_injective: "\<forall> T T', TList T = TList T' \<longrightarrow> T = T'"
  by auto

(* TOption is injective. *)
(* toption_injective (matches Coq) *)
lemma toption_injective: "\<forall> T T', TOption T = TOption T' \<longrightarrow> T = T'"
  by auto

(* Effect of nested lets is the join of all effects. *)
(* nested_let_effect (matches Coq) *)
lemma nested_let_effect: "\<forall> Γ Σ Δ x y e1 e2 e3 T1 T2 T3 ε1 ε2 ε3, has_type Γ Σ Δ e1 T1 ε1 \<longrightarrow> has_type ((x, T1) :: Γ) Σ Δ e2 T2 ε2 \<longrightarrow> has_type ((y, T2) :: (x, T1) :: Γ) Σ Δ e3 T3 ε3 \<longrightarrow> has_type Γ Σ Δ (ELet x e1 (ELet y e2 e3)) T3 (effect_join ε1 (effect_join ε2 ε3))"
  by auto

(* Effect of sequential pair construction. *)
(* sequential_pair_effect (matches Coq) *)
lemma sequential_pair_effect: "\<forall> Γ Σ Δ e1 e2 T1 T2 ε1 ε2, has_type Γ Σ Δ e1 T1 ε1 \<longrightarrow> has_type Γ Σ Δ e2 T2 ε2 \<longrightarrow> has_type Γ Σ Δ (EPair e1 e2) (TProd T1 T2) (effect_join ε1 ε2)"
  by auto

(* Classify preserves effect. *)
(* classify_preserves_effect (matches Coq) *)
lemma classify_preserves_effect: "\<forall> Γ Σ Δ e T ε, has_type Γ Σ Δ e T ε \<longrightarrow> has_type Γ Σ Δ (EClassify e) (TSecret T) ε"
  by auto

(* Prove preserves effect. *)
(* prove_preserves_effect (matches Coq) *)
lemma prove_preserves_effect: "\<forall> Γ Σ Δ e T ε, has_type Γ Σ Δ e T ε \<longrightarrow> has_type Γ Σ Δ (EProve e) (TProof T) ε"
  by auto

(* Inl preserves effect. *)
(* inl_preserves_effect (matches Coq) *)
lemma inl_preserves_effect: "\<forall> Γ Σ Δ e T1 T2 ε, has_type Γ Σ Δ e T1 ε \<longrightarrow> has_type Γ Σ Δ (EInl e T2) (TSum T1 T2) ε"
  by auto

(* Inr preserves effect. *)
(* inr_preserves_effect (matches Coq) *)
lemma inr_preserves_effect: "\<forall> Γ Σ Δ e T1 T2 ε, has_type Γ Σ Δ e T2 ε \<longrightarrow> has_type Γ Σ Δ (EInr e T1) (TSum T1 T2) ε"
  by auto

(* Ref always introduces at least EffWrite. *)
(* ref_introduces_write (matches Coq) *)
lemma ref_introduces_write: "\<forall> Γ Σ Δ e l T ε, has_type Γ Σ Δ (ERef e l) T ε \<longrightarrow> effect_leq EffWrite ε"
  by simp

(* Deref always introduces at least EffRead. *)
(* deref_introduces_read (matches Coq) *)
lemma deref_introduces_read: "\<forall> Γ Σ Δ e T ε, has_type Γ Σ Δ (EDeref e) T ε \<longrightarrow> effect_leq EffRead ε"
  by simp

(* Assign always introduces at least EffWrite. *)
(* assign_introduces_write (matches Coq) *)
lemma assign_introduces_write: "\<forall> Γ Σ Δ e1 e2 T ε, has_type Γ Σ Δ (EAssign e1 e2) T ε \<longrightarrow> effect_leq EffWrite ε"
  by simp

(* Ref cannot have pure effect. *)
(* ref_not_pure (matches Coq) *)
lemma ref_not_pure: "\<forall> Γ Σ Δ e l T, ~ has_type Γ Σ Δ (ERef e l) T EffPure"
  by simp

(* Deref cannot have pure effect. *)
(* deref_not_pure (matches Coq) *)
lemma deref_not_pure: "\<forall> Γ Σ Δ e T, ~ has_type Γ Σ Δ (EDeref e) T EffPure"
  by simp

(* Assign cannot have pure effect. *)
(* assign_not_pure (matches Coq) *)
lemma assign_not_pure: "\<forall> Γ Σ Δ e1 e2 T, ~ has_type Γ Σ Δ (EAssign e1 e2) T EffPure"
  by simp

(* Ref expression always has positive effect level *)
(* ref_effect_level_positive (matches Coq) *)
lemma ref_effect_level_positive: "\<forall> Γ Σ Δ e l T ε, has_type Γ Σ Δ (ERef e l) T ε \<longrightarrow> effect_level ε > 0"
  by simp

(* Deref expression always has positive effect level *)
(* deref_effect_level_positive (matches Coq) *)
lemma deref_effect_level_positive: "\<forall> Γ Σ Δ e T ε, has_type Γ Σ Δ (EDeref e) T ε \<longrightarrow> effect_level ε > 0"
  by simp

(* Assign expression always has positive effect level *)
(* assign_effect_level_positive (matches Coq) *)
lemma assign_effect_level_positive: "\<forall> Γ Σ Δ e1 e2 T ε, has_type Γ Σ Δ (EAssign e1 e2) T ε \<longrightarrow> effect_level ε > 0"
  by simp

(* Ref and deref are both nonpure *)
(* ref_deref_both_nonpure (matches Coq) *)
lemma ref_deref_both_nonpure: "\<forall> Γ Σ Δ e1 l1 e2 T1 T2 ε1 ε2, has_type Γ Σ Δ (ERef e1 l1) T1 ε1 \<longrightarrow> has_type Γ Σ Δ (EDeref e2) T2 ε2 \<longrightarrow> ε1 \<noteq> EffPure \<and> ε2 \<noteq> EffPure"
  by auto

(* Assign and deref are both nonpure *)
(* assign_deref_both_nonpure (matches Coq) *)
lemma assign_deref_both_nonpure: "\<forall> Γ Σ Δ e1 e2 e3 T1 T2 ε1 ε2, has_type Γ Σ Δ (EAssign e1 e2) T1 ε1 \<longrightarrow> has_type Γ Σ Δ (EDeref e3) T2 ε2 \<longrightarrow> ε1 \<noteq> EffPure \<and> ε2 \<noteq> EffPure"
  by auto

