theory StoreSafety
  imports Main
begin

(* Store extension after fresh allocation: update extends the original.
    (Re-exported from Preservation for discoverability.) *)
(* store_extend_after_alloc (matches Coq) *)
lemma store_extend_after_alloc: "\<forall> Σ l T sl, store_ty_lookup l Σ = None \<longrightarrow> store_ty_extends Σ (store_ty_update l T sl Σ)"
  by auto

(* After updating location l, looking up l returns the new value. *)
(* store_lookup_after_update (matches Coq) *)
lemma store_lookup_after_update: "\<forall> st l v, store_lookup l (store_update l v st) = Some v"
  by auto

(* After updating a different location, lookup for l is unchanged. *)
(* store_lookup_update_other (matches Coq) *)
lemma store_lookup_update_other: "\<forall> st l l' v, l \<noteq> l' \<longrightarrow> store_lookup l (store_update l' v st) = store_lookup l st"
  by auto

(* Store typing update for the same location returns the new entry. *)
(* store_ty_update_same (matches Coq) *)
lemma store_ty_update_same: "\<forall> Σ l T sl, store_ty_lookup l (store_ty_update l T sl Σ) = Some (T, sl)"
  by auto

(* Store typing update for a different location is unchanged. *)
(* store_ty_update_other (matches Coq) *)
lemma store_ty_update_other: "\<forall> Σ l l' T sl, l \<noteq> l' \<longrightarrow> store_ty_lookup l (store_ty_update l' T sl Σ) = store_ty_lookup l Σ"
  by auto

(* Two sequential extensions compose. *)
(* store_extend_compose (matches Coq) *)
lemma store_extend_compose: "\<forall> Σ1 Σ2 Σ3, store_ty_extends Σ1 Σ2 \<longrightarrow> store_ty_extends Σ2 Σ3 \<longrightarrow> store_ty_extends Σ1 Σ3"
  by auto

(* Extension is anti-symmetric on lookups: if Σ1 extends Σ2 and vice versa,
    they agree on all entries. *)
(* store_extend_antisym_lookup (matches Coq) *)
lemma store_extend_antisym_lookup: "\<forall> Σ1 Σ2 l T sl, store_ty_extends Σ1 Σ2 \<longrightarrow> store_ty_extends Σ2 Σ1 \<longrightarrow> store_ty_lookup l Σ1 = Some (T, sl) \<longrightarrow> store_ty_lookup l Σ2 = Some (T, sl)"
  by auto

(* Well-typed expressions remain well-typed after store extension.
    (Alias for store_ty_extends_preserves_typing.) *)
(* typing_monotone_store (matches Coq) *)
lemma typing_monotone_store: "\<forall> Γ Σ Σ' Δ e T ε, store_ty_extends Σ Σ' \<longrightarrow> has_type Γ Σ Δ e T ε \<longrightarrow> has_type Γ Σ' Δ e T ε"
  by auto

(* Location typing is preserved under store extension. *)
(* loc_typed_under_extension (matches Coq) *)
lemma loc_typed_under_extension: "\<forall> Σ Σ' l T sl, store_ty_extends Σ Σ' \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> store_ty_lookup l Σ' = Some (T, sl)"
  by auto

(* Closed values preserve typing under store extension. *)
(* value_typed_under_extension (matches Coq) *)
lemma value_typed_under_extension: "\<forall> Σ Σ' v T ε, store_ty_extends Σ Σ' \<longrightarrow> has_type nil Σ Public v T ε \<longrightarrow> value v \<longrightarrow> has_type nil Σ' Public v T ε"
  by auto

(* Every well-typed value in a well-formed store has EffPure effect. *)
(* store_wf_values_pure (matches Coq) *)
lemma store_wf_values_pure: "\<forall> Σ st l T sl v, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> store_lookup l st = Some v \<longrightarrow> has_type nil Σ Public v T EffectPure"
  by auto

(* All stored values in a well-formed store are values. *)
(* store_wf_all_values (matches Coq) *)
lemma store_wf_all_values: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> value v"
  by auto

(* Typed locations in a well-formed store have runtime entries. *)
(* store_wf_typed_implies_stored (matches Coq) *)
lemma store_wf_typed_implies_stored: "\<forall> Σ st l T sl, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v"
  by auto

(* Runtime entries have types in a well-formed store. *)
(* store_wf_stored_implies_typed (matches Coq) *)
lemma store_wf_stored_implies_typed: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl)"
  by auto

(* Location lookup decidability in store typing. *)
(* store_ty_lookup_dec (matches Coq) *)
lemma store_ty_lookup_dec: "\<forall> l Σ, {\<exists> T sl, store_ty_lookup l Σ = Some (T, sl)} + {store_ty_lookup l Σ = None}"
  by simp

(* Location equality is decidable (nat decidability). *)
(* loc_eq_dec (matches Coq) *)
lemma loc_eq_dec: "\<forall> (l1 l2 : loc), {l1 = l2} + {l1 \<noteq> l2}"
  by auto

(* Store typing update commutes for distinct locations (lookup equivalence). *)
(* store_ty_update_commute_lookup (matches Coq) *)
lemma store_ty_update_commute_lookup: "\<forall> Σ l1 T1 sl1 l2 T2 sl2 l, l1 \<noteq> l2 \<longrightarrow> store_ty_lookup l (store_ty_update l1 T1 sl1 (store_ty_update l2 T2 sl2 Σ)) = store_ty_lookup l (store_ty_update l2 T2 sl2 (store_ty_update l1 T1 sl1 Σ))"
  by auto

(* Empty store and empty store typing satisfy well-formedness. *)
(* store_wf_empty (matches Coq) *)
lemma store_wf_empty: "store_wf nil nil"
  by auto

(* Typing is preserved when a fresh location is added to the store typing. *)
(* typing_under_alloc (matches Coq) *)
lemma typing_under_alloc: "\<forall> Γ Σ Δ e T ε l T' sl', store_ty_lookup l Σ = None \<longrightarrow> has_type Γ Σ Δ e T ε \<longrightarrow> has_type Γ (store_ty_update l T' sl' Σ) Δ e T ε"
  by auto

(* Double allocation preserves typing when both locations are fresh. *)
(* typing_under_double_alloc (matches Coq) *)
lemma typing_under_double_alloc: "\<forall> Γ Σ Δ e T ε l1 T1 sl1 l2 T2 sl2, l1 \<noteq> l2 \<longrightarrow> store_ty_lookup l1 Σ = None \<longrightarrow> store_ty_lookup l2 Σ = None \<longrightarrow> has_type Γ Σ Δ e T ε \<longrightarrow> has_type Γ (store_ty_update l2 T2 sl2 (store_ty_update l1 T1 sl1 Σ)) Δ e T ε"
  by auto

(* If Σ extends Σ' and both are well-formed with their stores,
    then typed locations in Σ' are also typed in Σ. *)
(* store_wf_extends_typed (matches Coq) *)
lemma store_wf_extends_typed: "\<forall> Σ Σ' st l T sl, store_ty_extends Σ Σ' \<longrightarrow> store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v"
  by auto

(* Fresh location lookup on store typing returns None. *)
(* fresh_loc_store_ty_none (matches Coq) *)
lemma fresh_loc_store_ty_none: "\<forall> Σ st, store_wf Σ st \<longrightarrow> store_ty_lookup (fresh_loc st) Σ = None"
  by auto

(* Fresh location has no runtime entry. *)
(* fresh_loc_store_none (matches Coq) *)
lemma fresh_loc_store_none: "\<forall> st, store_lookup (fresh_loc st) st = None"
  by auto

(* All values in a well-formed store are well-typed with pure effect
    (combining forward and reverse directions). *)
(* store_wf_all_well_typed (matches Coq) *)
lemma store_wf_all_well_typed: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl) \<and> value v \<and> has_type nil Σ Public v T EffectPure"
  by auto

(* If a location is in Σ and Σ extends to Σ', the location is in Σ'. *)
(* store_ty_in_extends (matches Coq) *)
lemma store_ty_in_extends: "\<forall> Σ Σ' l, store_ty_extends Σ Σ' \<longrightarrow> (\<exists> T sl, store_ty_lookup l Σ = Some (T, sl)) \<longrightarrow> (\<exists> T sl, store_ty_lookup l Σ' = Some (T, sl))"
  by auto

(* Location absence is contra-variant under extension:
    if l is not in Σ' and Σ extends to Σ', then l is not in Σ. *)
(* store_ty_not_in_extends (matches Coq) *)
lemma store_ty_not_in_extends: "\<forall> Σ Σ' l, store_ty_extends Σ Σ' \<longrightarrow> store_ty_lookup l Σ' = None \<longrightarrow> store_ty_lookup l Σ = None"
  by simp

(* Extension is preserved when the same fresh location is added to both. *)
(* store_ty_extends_update_both (matches Coq) *)
lemma store_ty_extends_update_both: "\<forall> Σ Σ' l T sl, store_ty_extends Σ Σ' \<longrightarrow> store_ty_extends (store_ty_update l T sl Σ) (store_ty_update l T sl Σ')"
  by auto

