(* Store well-formedness implies stored expressions are values *)
(* store_wf_lookup_value (matches Coq) *)
lemma store_wf_lookup_value: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> value v"
  by auto

(* Store well-formedness implies stored expressions are well-typed *)
(* store_wf_lookup_typed (matches Coq) *)
lemma store_wf_lookup_typed: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl) \<and> has_type nil Σ Public v T EffectPure"
  by auto

(* For typed locations, lookup succeeds with a value *)
(* store_wf_typed_loc_has_value (matches Coq) *)
lemma store_wf_typed_loc_has_value: "\<forall> Σ st l T sl, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v"
  by auto

(* Combined: typed location lookup gives typed value *)
(* store_wf_typed_loc_gives_typed_value (matches Coq) *)
lemma store_wf_typed_loc_gives_typed_value: "\<forall> Σ st l T sl, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v \<and> has_type nil Σ Public v T EffectPure"
  by auto

(* Forward direction: store_wf implies domain correspondence *)
(* store_wf_forward (matches Coq) *)
lemma store_wf_forward: "\<forall> Σ st, store_wf Σ st \<longrightarrow> \<forall> l T sl, store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v \<and> has_type nil Σ Public v T EffectPure"
  by auto

(* Backward direction: store_wf implies runtime values are typed *)
(* store_wf_backward (matches Coq) *)
lemma store_wf_backward: "\<forall> Σ st, store_wf Σ st \<longrightarrow> \<forall> l v, store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl) \<and> value v \<and> has_type nil Σ Public v T EffectPure"
  by auto

(* Empty store is well-formed with empty store typing *)
(* store_wf_empty (matches Coq) *)
lemma store_wf_empty: "store_wf nil nil"
  by auto

(* Empty store typing means empty store (forward) *)
(* store_wf_empty_ty_no_values (matches Coq) *)
lemma store_wf_empty_ty_no_values: "\<forall> st, store_wf nil st \<longrightarrow> \<forall> l v, store_lookup l st = None \<or> ~ value v \<or> store_lookup l st \<noteq> Some v"
  by (cases rule: ‹_›.cases; simp)

(* If two stores agree on all lookups, wf transfers *)
(* store_wf_lookup_agree (matches Coq) *)
lemma store_wf_lookup_agree: "\<forall> Σ st1 st2, store_wf Σ st1 \<longrightarrow> (\<forall> l, store_lookup l st1 = store_lookup l st2) \<longrightarrow> store_wf Σ st2"
  by auto

(* All values in a well-formed store are typed with pure effect *)
(* store_wf_all_pure (matches Coq) *)
lemma store_wf_all_pure: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> \<exists> T, has_type nil Σ Public v T EffectPure"
  by auto

(* Values in well-formed stores are always values (tautological but useful) *)
(* store_wf_lookup_is_value (matches Coq) *)
lemma store_wf_lookup_is_value: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> value v"
  by auto

(* If Σ extends to Σ' and we have WF for Σ, the forward property
    partially transfers (we still find the same values) *)
(* store_wf_extends_forward (matches Coq) *)
lemma store_wf_extends_forward: "\<forall> Σ Σ' st l T sl, store_wf Σ st \<longrightarrow> store_ty_extends Σ Σ' \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v"
  by auto

(* Location not in store typing means not required for WF *)
(* store_wf_loc_not_in_ty (matches Coq) *)
lemma store_wf_loc_not_in_ty: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = None \<longrightarrow> \<forall> T sl, ~ (store_ty_lookup l Σ = Some (T, sl))"
  by auto

(* Typed locations always have runtime values *)
(* store_wf_typed_implies_stored (matches Coq) *)
lemma store_wf_typed_implies_stored: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> (\<exists> T sl, store_ty_lookup l Σ = Some (T, sl)) \<longrightarrow> \<exists> v, store_lookup l st = Some v"
  by auto

(* Stored values always have types *)
(* store_wf_stored_implies_typed (matches Coq) *)
lemma store_wf_stored_implies_typed: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl)"
  by auto

(* Updating a location with a value of the same type preserves WF *)
(* store_wf_update_same_type (matches Coq) *)
lemma store_wf_update_same_type: "\<forall> Σ st l v T sl, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> value v \<longrightarrow> has_type nil Σ Public v T EffectPure \<longrightarrow> store_wf Σ (store_update l v st)"
  by auto

(* Full characterization: store_wf is equivalent to bidirectional correspondence *)
(* store_wf_characterize (matches Coq) *)
lemma store_wf_characterize: "\<forall> Σ st, store_wf Σ st <-> ((\<forall> l T sl, store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v \<and> has_type nil Σ Public v T EffectPure) \<and> (\<forall> l v, store_lookup l st = Some v \<longrightarrow> \<exists> T sl, store_ty_lookup l Σ = Some (T, sl) \<and> value v \<and> has_type nil Σ Public v T EffectPure))"
  by auto

(* store_has_values follows from store_wf *)
(* store_wf_implies_has_values (matches Coq) *)
lemma store_wf_implies_has_values: "\<forall> Σ st, store_wf Σ st \<longrightarrow> store_has_values st"
  by auto

(* Empty store has values trivially *)
(* store_has_values_empty (matches Coq) *)
lemma store_has_values_empty: "store_has_values nil"
  by auto

(* If Σ' extends Σ and store_wf Σ st, then forward property
    holds for all Σ-typed locations in Σ' *)
(* store_wf_extends_lookup_typed (matches Coq) *)
lemma store_wf_extends_lookup_typed: "\<forall> Σ Σ' st l T sl, store_wf Σ st \<longrightarrow> store_ty_extends Σ Σ' \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v \<and> value v \<and> has_type nil Σ' Public v T EffectPure"
  by auto

(* Store well-formedness is preserved by evaluation steps *)
(* store_wf_preserved_by_step (matches Coq) *)
lemma store_wf_preserved_by_step: "\<forall> e e' T ε st st' ctx ctx' Σ, has_type nil Σ Public e T ε \<longrightarrow> store_wf Σ st \<longrightarrow> (e, st, ctx) --> (e', st', ctx') \<longrightarrow> \<exists> Σ', store_wf Σ' st' \<and> store_ty_extends Σ Σ'"
  by auto

(* If a value is in a well-formed store, it is both a value and well-typed *)
(* store_wf_lookup_value_and_typed (matches Coq) *)
lemma store_wf_lookup_value_and_typed: "\<forall> Σ st l v, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> value v \<and> \<exists> T, has_type nil Σ Public v T EffectPure"
  by auto

(* A location has a runtime value iff it has a type assignment *)
(* store_wf_domain_iff (matches Coq) *)
lemma store_wf_domain_iff: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> (\<exists> v, store_lookup l st = Some v) <-> (\<exists> T sl, store_ty_lookup l Σ = Some (T, sl))"
  by auto

(* store_wf_extends_preserves_has_values (matches Coq) *)
lemma store_wf_extends_preserves_has_values: "\<forall> Σ Σ' st, store_wf Σ st \<longrightarrow> store_ty_extends Σ Σ' \<longrightarrow> store_has_values st"
  by auto

(* Type assignment implies runtime value exists *)
(* store_wf_ty_lookup_implies_st_lookup (matches Coq) *)
lemma store_wf_ty_lookup_implies_st_lookup: "\<forall> Σ st l T sl, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> \<exists> v, store_lookup l st = Some v"
  by auto

(* With empty type mapping, no location is typed *)
(* store_wf_empty_ty_no_typed_locs (matches Coq) *)
lemma store_wf_empty_ty_no_typed_locs: "\<forall> st l T sl, store_wf nil st \<longrightarrow> store_ty_lookup l nil \<noteq> Some (T, sl)"
  by auto

(* If no value at location, then no type assignment either *)
(* store_wf_none_implies_ty_none (matches Coq) *)
lemma store_wf_none_implies_ty_none: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> store_lookup l st = None \<longrightarrow> store_ty_lookup l Σ = None"
  by auto

(* If no type assignment, then no runtime value *)
(* store_wf_ty_none_implies_none (matches Coq) *)
lemma store_wf_ty_none_implies_none: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> store_ty_lookup l Σ = None \<longrightarrow> store_lookup l st = None"
  by auto

(* Absence is bidirectional *)
(* store_wf_absent_agree (matches Coq) *)
lemma store_wf_absent_agree: "\<forall> Σ st l, store_wf Σ st \<longrightarrow> store_lookup l st = None <-> store_ty_lookup l Σ = None"
  by auto

(* Direct typing from both lookups *)
(* store_wf_lookup_has_type (matches Coq) *)
lemma store_wf_lookup_has_type: "\<forall> Σ st l v T sl, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> store_ty_lookup l Σ = Some (T, sl) \<longrightarrow> has_type nil Σ Public v T EffectPure"
  by auto

(* Type assignment is functionally determined by location *)
(* store_wf_ty_deterministic (matches Coq) *)
lemma store_wf_ty_deterministic: "\<forall> Σ st l v T1 sl1 T2 sl2, store_wf Σ st \<longrightarrow> store_lookup l st = Some v \<longrightarrow> store_ty_lookup l Σ = Some (T1, sl1) \<longrightarrow> store_ty_lookup l Σ = Some (T2, sl2) \<longrightarrow> T1 = T2 \<and> sl1 = sl2"
  by auto

