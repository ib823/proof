theory ContextProperties
  imports Main
begin

(* Decidability of [free_in]: for any variable [x] and expression [e],
    we can decide whether [x] occurs free in [e]. This is essential for
    automation and case analysis in proofs about weakening/strengthening. *)
(* free_in_dec (matches Coq) *)
lemma free_in_dec: "\<forall> x e, {free_in x e} + {~ free_in x e}"
  by (cases rule: ‹_›.cases; simp)

(* If lookup finds a binding through a non-matching head, the binding is in the tail. *)
(* lookup_cons_neq_inv (matches Coq) *)
lemma lookup_cons_neq_inv: "\<forall> x y U Γ T, lookup x ((y, U) :: Γ) = Some T \<longrightarrow> x \<noteq> y \<longrightarrow> lookup x Γ = Some T"
  by auto

(* Lookup is deterministic (functional). *)
(* lookup_deterministic (matches Coq) *)
lemma lookup_deterministic: "\<forall> x Γ T1 T2, lookup x Γ = Some T1 \<longrightarrow> lookup x Γ = Some T2 \<longrightarrow> T1 = T2"
  by simp

(* Lookup in an extended context: either the head matches or it's in the tail. *)
(* lookup_cons_inv (matches Coq) *)
lemma lookup_cons_inv: "\<forall> x y U Γ T, lookup x ((y, U) :: Γ) = Some T \<longrightarrow> (x = y \<and> T = U) \<or> (x \<noteq> y \<and> lookup x Γ = Some T)"
  by (cases rule: ‹_›.cases; simp)

(* Weakening lookup: if x is found in Γ and x ≠ y, x is still found after prepending (y,U). *)
(* lookup_weaken_neq (matches Coq) *)
lemma lookup_weaken_neq: "\<forall> x Γ T y U, lookup x Γ = Some T \<longrightarrow> x \<noteq> y \<longrightarrow> lookup x ((y, U) :: Γ) = Some T"
  by auto

(* Adding an unused binding to the head of Γ preserves typing.
    This is a direct corollary of [context_invariance] from Preservation.v. *)
(* typing_weaken_head (matches Coq) *)
lemma typing_weaken_head: "\<forall> Γ Σ Δ e T ε y U, has_type Γ Σ Δ e T ε \<longrightarrow> ~ free_in y e \<longrightarrow> has_type ((y, U) :: Γ) Σ Δ e T ε"
  by (cases rule: ‹_›.cases; simp)

(* Unconditional weakening when the new binding's name is fresh
    (not in the domain of Γ and not free in e).
    Convenience wrapper combining free_in_context with typing_weaken_head. *)
(* typing_weaken_fresh (matches Coq) *)
lemma typing_weaken_fresh: "\<forall> Γ Σ Δ e T ε y U, has_type Γ Σ Δ e T ε \<longrightarrow> lookup y Γ = None \<longrightarrow> has_type ((y, U) :: Γ) Σ Δ e T ε"
  by auto

(* Removing an unused head binding preserves typing.
    Dual of [typing_weaken_head]. *)
(* typing_strengthen_head (matches Coq) *)
lemma typing_strengthen_head: "\<forall> Γ Σ Δ e T ε y U, has_type ((y, U) :: Γ) Σ Δ e T ε \<longrightarrow> ~ free_in y e \<longrightarrow> has_type Γ Σ Δ e T ε"
  by (cases rule: ‹_›.cases; simp)

(* Swapping two non-conflicting adjacent bindings preserves typing. *)
(* typing_exchange (matches Coq) *)
lemma typing_exchange: "\<forall> Γ Σ Δ e T ε x Tx y Ty, has_type ((x, Tx) :: (y, Ty) :: Γ) Σ Δ e T ε \<longrightarrow> x \<noteq> y \<longrightarrow> has_type ((y, Ty) :: (x, Tx) :: Γ) Σ Δ e T ε"
  by (cases rule: ‹_›.cases; simp)

(* The security context Δ does not affect typing derivations.
    This is because no typing rule discriminates on the value of Δ;
    it is threaded uniformly through all rules. *)
(* typing_delta_irrelevance (matches Coq) *)
lemma typing_delta_irrelevance: "\<forall> Γ Σ Δ1 Δ2 e T ε, has_type Γ Σ Δ1 e T ε \<longrightarrow> has_type Γ Σ Δ2 e T ε"
  by auto

(* If a binding (x, T1) shadows an earlier (x, T2), the earlier is irrelevant. *)
(* typing_shadow (matches Coq) *)
lemma typing_shadow: "\<forall> Γ Σ Δ e T ε x T1 T2, has_type ((x, T1) :: (x, T2) :: Γ) Σ Δ e T ε \<longrightarrow> has_type ((x, T1) :: Γ) Σ Δ e T ε"
  by (cases rule: ‹_›.cases; simp)

(* A well-typed closed term has no free variables.
    This is a direct consequence of [free_in_context]. *)
(* closed_no_free_vars (matches Coq) *)
lemma closed_no_free_vars: "\<forall> Σ Δ e T ε x, has_type nil Σ Δ e T ε \<longrightarrow> ~ free_in x e"
  by auto

(* Closed terms can be typed in any type environment.
    This re-exports [closed_typing_weakening] under a more discoverable name. *)
(* typing_weaken_closed (matches Coq) *)
lemma typing_weaken_closed: "\<forall> Γ Σ Δ e T ε, has_type nil Σ Δ e T ε \<longrightarrow> has_type Γ Σ Δ e T ε"
  by auto

(* Weakening by an entire list of bindings, when the expression is closed. *)
(* typing_weaken_multi_closed (matches Coq) *)
lemma typing_weaken_multi_closed: "\<forall> Γ1 Γ2 Σ Δ e T ε, has_type nil Σ Δ e T ε \<longrightarrow> has_type (Γ1 ++ Γ2) Σ Δ e T ε"
  by auto

(* Weakening by prepending a list of bindings when none shadow free variables. *)
(* typing_weaken_prefix (matches Coq) *)
lemma typing_weaken_prefix: "\<forall> Γ1 Γ2 Σ Δ e T ε, has_type Γ2 Σ Δ e T ε \<longrightarrow> (\<forall> x, free_in x e \<longrightarrow> lookup x Γ2 = lookup x (Γ1 ++ Γ2)) \<longrightarrow> has_type (Γ1 ++ Γ2) Σ Δ e T ε"
  by auto

(* Store typing extension is reflexive.
    Re-exported from StrongNorm.v for discoverability. *)
(* store_extends_refl (matches Coq) *)
lemma store_extends_refl: "\<forall> Σ, store_ty_extends Σ Σ"
  by auto

(* Store typing extension is transitive.
    Re-exported from Typing.v for discoverability. *)
(* store_extends_trans (matches Coq) *)
lemma store_extends_trans: "\<forall> Σ1 Σ2 Σ3, store_ty_extends Σ1 Σ2 \<longrightarrow> store_ty_extends Σ2 Σ3 \<longrightarrow> store_ty_extends Σ1 Σ3"
  by auto

(* Store extension preserves well-typedness (lifts store_ty_extends_preserves_typing
    to a more discoverable name). *)
(* typing_weaken_store (matches Coq) *)
lemma typing_weaken_store: "\<forall> Γ Σ Σ' Δ e T ε, has_type Γ Σ Δ e T ε \<longrightarrow> store_ty_extends Σ Σ' \<longrightarrow> has_type Γ Σ' Δ e T ε"
  by auto

(* Weaken both context and security level simultaneously. *)
(* typing_weaken_head_delta (matches Coq) *)
lemma typing_weaken_head_delta: "\<forall> Γ Σ Δ1 Δ2 e T ε y U, has_type Γ Σ Δ1 e T ε \<longrightarrow> ~ free_in y e \<longrightarrow> has_type ((y, U) :: Γ) Σ Δ2 e T ε"
  by auto

(* Weakening after exchange: if we have typing in Γ and x ≠ y,
    we can add both bindings in either order. *)
(* typing_weaken_two (matches Coq) *)
lemma typing_weaken_two: "\<forall> Γ Σ Δ e T ε x Tx y Ty, has_type Γ Σ Δ e T ε \<longrightarrow> ~ free_in x e \<longrightarrow> ~ free_in y e \<longrightarrow> has_type ((x, Tx) :: (y, Ty) :: Γ) Σ Δ e T ε"
  by auto

(* Weakening + store extension simultaneously. *)
(* typing_weaken_head_store (matches Coq) *)
lemma typing_weaken_head_store: "\<forall> Γ Σ Σ' Δ e T ε y U, has_type Γ Σ Δ e T ε \<longrightarrow> ~ free_in y e \<longrightarrow> store_ty_extends Σ Σ' \<longrightarrow> has_type ((y, U) :: Γ) Σ' Δ e T ε"
  by auto

end
