lemma val_rel_le_secret_always: "\<forall>n Σ T v1 v2. value v1 \<longrightarrow> value v2 \<longrightarrow> closed_expr v1 \<longrightarrow> closed_expr v2 \<longrightarrow> val_rel_le n Σ (TSecret T) v1 v2"
