(* effect_lt_leq_trans (matches Coq) *)
lemma effect_lt_leq_trans: "\<forall> e1 e2 e3, effect_lt e1 e2 \<longrightarrow> effect_leq e2 e3 \<longrightarrow> effect_lt e1 e3"
