(* effect_leq_lt_trans (matches Coq) *)
lemma effect_leq_lt_trans: "\<forall> e1 e2 e3, effect_leq e1 e2 \<longrightarrow> effect_lt e2 e3 \<longrightarrow> effect_lt e1 e3"
