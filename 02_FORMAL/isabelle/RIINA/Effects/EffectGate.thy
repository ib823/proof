(* is_gate (matches Coq: Definition is_gate) *)
definition is_gate :: "effect \<Rightarrow> expr \<Rightarrow> bool" where
  "is_gate eff e_gate \<equiv> forall e T eff_used,
    has_type_full nil nil Public e T eff_used ->
    effect_leq eff_used eff ->
    performs_within (EApp e_gate e) eff"

(* pure_performs_any (matches Coq) *)
lemma pure_performs_any: "\<forall> G S D e T, has_type G S D e T EffectPure \<longrightarrow> \<forall> eff, performs_within e eff"
  by auto

(* pure_full_performs_any (matches Coq) *)
lemma pure_full_performs_any: "\<forall> G S D e T, has_type_full G S D e T EffectPure \<longrightarrow> \<forall> eff, performs_within e eff"
  by auto

(* grant_no_escalation (matches Coq) *)
lemma grant_no_escalation: "\<forall> G S D eff e T ε, has_type G S D (EGrant eff e) T ε \<longrightarrow> has_type G S D e T ε"
  by auto

(* grant_effect_transparent (matches Coq) *)
lemma grant_effect_transparent: "\<forall> G S D eff e T ε, has_type G S D e T ε \<longrightarrow> has_type G S D (EGrant eff e) T ε"
  by auto

(* Grant preserves the performs_within bound *)
(* grant_preserves_bound (matches Coq) *)
lemma grant_preserves_bound: "\<forall> eff e eff_bound, performs_within e eff_bound \<longrightarrow> performs_within (EGrant eff e) eff_bound"
  by auto

(* handle_body_bound (matches Coq) *)
lemma handle_body_bound: "\<forall> e x h eff, performs_within (EHandle e x h) eff \<longrightarrow> performs_within e eff"
  by auto

(* handle_handler_bound (matches Coq) *)
lemma handle_handler_bound: "\<forall> e x h eff, performs_within (EHandle e x h) eff \<longrightarrow> performs_within h eff"
  by auto

(* handle_bound_combine (matches Coq) *)
lemma handle_bound_combine: "\<forall> e x h eff, performs_within e eff \<longrightarrow> performs_within h eff \<longrightarrow> performs_within (EHandle e x h) eff"
  by auto

(* perform_requires_license (matches Coq) *)
lemma perform_requires_license: "\<forall> eff' e, effect_level eff' > 0 \<longrightarrow> ~ performs_within (EPerform eff' e) EffectPure"
  by (cases rule: ‹_›.cases; simp)

(* Every non-pure effect has level > 0 *)
(* nonpure_level_pos (matches Coq) *)
lemma nonpure_level_pos: "\<forall> eff, eff \<noteq> EffPure \<longrightarrow> effect_level eff > 0"
  by (cases rule: ‹_›.cases; simp)

(* If a pure-typed expression IS a perform, the effect must be pure *)
(* pure_perform_is_pure (matches Coq) *)
lemma pure_perform_is_pure: "\<forall> G S D eff' e_inner T, has_type G S D (EPerform eff' e_inner) T EffectPure \<longrightarrow> eff' = EffPure"
  by (cases rule: ‹_›.cases; simp)

(* closed_pure_no_effects (matches Coq) *)
lemma closed_pure_no_effects: "\<forall> e T, has_type nil nil Public e T EffectPure \<longrightarrow> \<forall> eff, performs_within e eff"
  by auto

(* gate_enforcement (matches Coq) *)
lemma gate_enforcement: "\<forall> G S D e T eff_allowed eff_used, has_type_full G S D e T eff_used \<longrightarrow> effect_level eff_used \<le> effect_level eff_allowed \<longrightarrow> performs_within e eff_allowed"
  by auto

(* lambda_is_syntactic_gate (matches Coq) *)
lemma lambda_is_syntactic_gate: "\<forall> x T body eff, is_gate eff (ELam x T body)"
  by auto

(* gate_weakening (matches Coq) *)
lemma gate_weakening: "\<forall> eff1 eff2 g, is_gate eff1 g \<longrightarrow> effect_leq eff1 eff2 \<longrightarrow> is_gate eff2 g"
  by auto

(* effect_sound_after_step (matches Coq) *)
lemma effect_sound_after_step: "\<forall> e e' T ε st st' ctx ctx' Σ, has_type nil Σ Public e T ε \<longrightarrow> store_wf Σ st \<longrightarrow> (e, st, ctx) --> (e', st', ctx') \<longrightarrow> \<exists> Σ' ε', store_ty_extends Σ Σ' \<and> store_wf Σ' st' \<and> performs_within e' ε'"
  by auto

(* Multi-step effect soundness *)
(* effect_sound_multi_step (matches Coq) *)
lemma effect_sound_multi_step: "\<forall> cfg cfg' e e' T ε st st' ctx ctx' Σ, cfg = (e, st, ctx) \<longrightarrow> cfg' = (e', st', ctx') \<longrightarrow> has_type nil Σ Public e T ε \<longrightarrow> store_wf Σ st \<longrightarrow> cfg -->* cfg' \<longrightarrow> \<exists> Σ' ε', store_ty_extends Σ Σ' \<and> store_wf Σ' st' \<and> performs_within e' ε'"
  by auto

(* capability_lexical_scope (matches Coq) *)
lemma capability_lexical_scope: "\<forall> G S D eff e T ε, has_type G S D (EGrant eff e) T ε \<longrightarrow> has_type G S D e T ε"
  by auto

(* ERequire adds the required effect to the bound *)
(* require_effect_additive (matches Coq) *)
lemma require_effect_additive: "\<forall> G S D eff e T ε, has_type G S D (ERequire eff e) T (effect_join ε eff) \<longrightarrow> \<exists> ε', has_type G S D e T ε' \<and> effect_leq ε' (effect_join ε eff)"
  by auto

(* app_joins_effects (matches Coq) *)
lemma app_joins_effects: "\<forall> e1 e2 eff, performs_within e1 eff \<longrightarrow> performs_within e2 eff \<longrightarrow> performs_within (EApp e1 e2) eff"
  by auto

(* let_joins_effects (matches Coq) *)
lemma let_joins_effects: "\<forall> x e1 e2 eff, performs_within e1 eff \<longrightarrow> performs_within e2 eff \<longrightarrow> performs_within (ELet x e1 e2) eff"
  by auto

