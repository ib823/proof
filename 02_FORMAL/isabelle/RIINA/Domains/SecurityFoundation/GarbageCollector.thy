lemma unreachable_heap_cleared: "\<forall>(result :: gc_result). valid_gc result \<longrightarrow> (\<forall>oid. ~ reachable (gc_pre_state result) oid) \<longrightarrow> \<forall>obj. ~ \<exists>_obj (gc_post_state result) obj"
