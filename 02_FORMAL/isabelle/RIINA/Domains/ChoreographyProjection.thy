lemma CP_063_network_no_deadlock: "\<forall> g roles, well_formed_global g \<longrightarrow> ~ chor_deadlocked (network_of g roles)"
  by auto

(* CP_064_network_empty_end (matches Coq) *)
lemma CP_064_network_empty_end: "typed_network GEnd []"
  by auto

(* CP_065_protocol_fidelity_send (matches Coq) *)
lemma CP_065_protocol_fidelity_send: "\<forall> p q t g, p \<noteq> q \<longrightarrow> \<exists> l, project (GMsg p q t g) p = LSend q t l \<and> l = project g p"
  by auto

(* CP_066_protocol_fidelity_recv (matches Coq) *)
lemma CP_066_protocol_fidelity_recv: "\<forall> p q t g, p \<noteq> q \<longrightarrow> \<exists> l, project (GMsg p q t g) q = LRecv p t l \<and> l = project g q"
  by auto

(* CP_067_session_fidelity (matches Coq) *)
lemma CP_067_session_fidelity: "\<forall> p q t g, p \<noteq> q \<longrightarrow> match project (GMsg p q t g) p, project (GMsg p q t g) q with | LSend _ t1 _, LRecv _ t2 _ => t1 = t2 | _, _ => False end"
  by auto

(* CP_068_linearity_msg (matches Coq) *)
lemma CP_068_linearity_msg: "\<forall> p q t g g', GlobalStep (GMsg p q t g) g' \<longrightarrow> g' = g"
  by simp

(* CP_069_completeness_end (matches Coq) *)
lemma CP_069_completeness_end: "\<exists> g, project g 0 = LEnd"
  by simp

(* CP_069_completeness_var (matches Coq) *)
lemma CP_069_completeness_var: "\<forall> n, \<exists> g, project g 0 = LVar n"
  by simp

(* CP_069_completeness_send (matches Coq) *)
lemma CP_069_completeness_send: "\<forall> r t l, (\<exists> g, project g 0 = l) \<longrightarrow> \<exists> g, project g 0 = LSend r t l"
  by auto

(* CP_069_completeness_recv (matches Coq) *)
lemma CP_069_completeness_recv: "\<forall> r t l, r \<noteq> 0 \<longrightarrow> (\<exists> g, project g 0 = l) \<longrightarrow> \<exists> g, project g 0 = LRecv r t l"
  by (cases rule: ‹_›.cases; simp)

(* ============================================================================
    SECTION 9: RECURSION PROPERTIES
    ============================================================================ *)
(* CP_070_subst_local_end (matches Coq) *)
lemma CP_070_subst_local_end: "\<forall> x s, subst_local x s LEnd = LEnd"
  by simp

(* CP_071_subst_local_var_same (matches Coq) *)
lemma CP_071_subst_local_var_same: "\<forall> x s, subst_local x s (LVar x) = s"
  by simp

(* CP_072_subst_local_var_diff (matches Coq) *)
lemma CP_072_subst_local_var_diff: "\<forall> x y s, x \<noteq> y \<longrightarrow> subst_local x s (LVar y) = LVar y"
  by (cases rule: ‹_›.cases; simp)

(* CP_073_subst_local_rec_same (matches Coq) *)
lemma CP_073_subst_local_rec_same: "\<forall> x l s, subst_local x s (LRec x l) = LRec x l"
  by simp

(* CP_074_subst_local_rec_diff (matches Coq) *)
lemma CP_074_subst_local_rec_diff: "\<forall> x y l s, x \<noteq> y \<longrightarrow> subst_local x s (LRec y l) = LRec y (subst_local x s l)"
  by (cases rule: ‹_›.cases; simp)

(* CP_075_subst_local_send (matches Coq) *)
lemma CP_075_subst_local_send: "\<forall> x s r t l, subst_local x s (LSend r t l) = LSend r t (subst_local x s l)"
  by simp

(* CP_076_subst_local_recv (matches Coq) *)
lemma CP_076_subst_local_recv: "\<forall> x s r t l, subst_local x s (LRecv r t l) = LRecv r t (subst_local x s l)"
  by simp

(* CP_077_rec_unfold_well_formed (matches Coq) *)
lemma CP_077_rec_unfold_well_formed: "\<forall> n g, well_formed_global (GRec n g) \<longrightarrow> well_formed_global g"
  by auto

(* ============================================================================
    SECTION 10: PROJECTION COMPOSITION PROPERTIES
    ============================================================================ *)
(* CP_078_project_msg_chain (matches Coq) *)
lemma CP_078_project_msg_chain: "\<forall> p1 q1 t1 p2 q2 t2 g r, r = p1 \<longrightarrow> p1 \<noteq> q1 \<longrightarrow> p2 \<noteq> q2 \<longrightarrow> project (GMsg p1 q1 t1 (GMsg p2 q2 t2 g)) r = LSend q1 t1 (project (GMsg p2 q2 t2 g) r)"
  by auto

(* CP_079_project_msg_recv_chain (matches Coq) *)
lemma CP_079_project_msg_recv_chain: "\<forall> p q t1 t2 g, p \<noteq> q \<longrightarrow> project (GMsg p q t1 (GMsg q p t2 g)) p = LSend q t1 (LRecv q t2 (project g p))"
  by (cases rule: ‹_›.cases; simp)

(* CP_080_project_msg_recv_chain_q (matches Coq) *)
lemma CP_080_project_msg_recv_chain_q: "\<forall> p q t1 t2 g, p \<noteq> q \<longrightarrow> project (GMsg p q t1 (GMsg q p t2 g)) q = LRecv p t1 (LSend p t2 (project g q))"
  by auto

(* ============================================================================
    SECTION 11: PROJECTION AND DUALITY INTERACTION
    ============================================================================ *)
(* CP_081_dual_project_msg_sender (matches Coq) *)
lemma CP_081_dual_project_msg_sender: "\<forall> p q t g, local_dual (project (GMsg p q t g) p) = LRecv q t (local_dual (project g p))"
  by simp

(* CP_082_dual_project_msg_receiver (matches Coq) *)
lemma CP_082_dual_project_msg_receiver: "\<forall> p q t g, p \<noteq> q \<longrightarrow> local_dual (project (GMsg p q t g) q) = LSend p t (local_dual (project g q))"
  by auto

(* CP_083_dual_project_end (matches Coq) *)
lemma CP_083_dual_project_end: "\<forall> r, local_dual (project GEnd r) = LEnd"
  by simp

(* CP_084_dual_project_var (matches Coq) *)
lemma CP_084_dual_project_var: "\<forall> n r, local_dual (project (GVar n) r) = LVar n"
  by simp

(* CP_085_dual_project_rec (matches Coq) *)
lemma CP_085_dual_project_rec: "\<forall> n g r, local_dual (project (GRec n g) r) = LRec n (local_dual (project g r))"
  by simp

(* CP_086_dual_preserves_mergeable (matches Coq) *)
lemma CP_086_dual_preserves_mergeable: "\<forall> l1 l2, mergeable l1 l2 \<longrightarrow> mergeable (local_dual l1) (local_dual l2)"
  by auto

(* ============================================================================
    SECTION 12: WELL-FORMEDNESS AND PROJECTION INTERACTION
    ============================================================================ *)
(* CP_087_wf_step_preserves (matches Coq) *)
lemma CP_087_wf_step_preserves: "\<forall> g g', well_formed_global g \<longrightarrow> GlobalStep g g' \<longrightarrow> well_formed_global g' \<or> (\<exists> n body, g = GRec n body \<and> g' = subst_global n (GRec n body) body)"
  by (cases rule: ‹_›.cases; simp)

(* CP_088_wf_comm_step (matches Coq) *)
lemma CP_088_wf_comm_step: "\<forall> p q t g, well_formed_global (GMsg p q t g) \<longrightarrow> well_formed_global g"
  by auto

(* CP_089_wf_branch_step_left (matches Coq) *)
lemma CP_089_wf_branch_step_left: "\<forall> p q l1 g1 l2 g2, well_formed_global (GBranch p q l1 g1 l2 g2) \<longrightarrow> well_formed_global g1"
  by auto

(* CP_090_wf_branch_step_right (matches Coq) *)
lemma CP_090_wf_branch_step_right: "\<forall> p q l1 g1 l2 g2, well_formed_global (GBranch p q l1 g1 l2 g2) \<longrightarrow> well_formed_global g2"
  by auto

(* CP_091_project_step_uninvolved (matches Coq) *)
lemma CP_091_project_step_uninvolved: "\<forall> p q t g r, r \<noteq> p \<longrightarrow> r \<noteq> q \<longrightarrow> project (GMsg p q t g) r = project g r"
  by auto

(* CP_092_project_gend_all_lend (matches Coq) *)
lemma CP_092_project_gend_all_lend: "\<forall> roles, Forall (fun r => project GEnd r = LEnd) roles"
  by simp

(* CP_093_all_roles_end (matches Coq) *)
lemma CP_093_all_roles_end: "\<forall> g, g = GEnd \<longrightarrow> \<forall> r, project g r = LEnd"
  by simp

(* CP_094_step_reduces_msg (matches Coq) *)
lemma CP_094_step_reduces_msg: "\<forall> p q t g, global_size (GMsg p q t g) > global_size g"
  by simp

(* CP_095_step_reduces_branch (matches Coq) *)
lemma CP_095_step_reduces_branch: "\<forall> p q l1 g1 l2 g2, global_size (GBranch p q l1 g1 l2 g2) > global_size g1 \<and> global_size (GBranch p q l1 g1 l2 g2) > global_size g2"
  by simp

(* CP_096_wf_distinct_projection (matches Coq) *)
lemma CP_096_wf_distinct_projection: "\<forall> p q t g, p \<noteq> q \<longrightarrow> well_formed_global (GMsg p q t g) \<longrightarrow> project (GMsg p q t g) p \<noteq> project (GMsg p q t g) q"
  by auto

(* CP_097_merge_compat_implies_eq (matches Coq) *)
lemma CP_097_merge_compat_implies_eq: "\<forall> p q l1 g1 l2 g2 r, merge_compatible (GBranch p q l1 g1 l2 g2) \<longrightarrow> r \<noteq> p \<longrightarrow> r \<noteq> q \<longrightarrow> project (GBranch p q l1 g1 l2 g2) r = project g1 r \<and> project g1 r = project g2 r"
  by auto

(* CP_098_branch_end_merge (matches Coq) *)
lemma CP_098_branch_end_merge: "\<forall> p q l1 l2 r, r \<noteq> p \<longrightarrow> r \<noteq> q \<longrightarrow> project (GBranch p q l1 GEnd l2 GEnd) r = LEnd"
  by simp

(* CP_099_subject_reduction (matches Coq) *)
lemma CP_099_subject_reduction: "\<forall> g g', well_formed_global g \<longrightarrow> GlobalStep g g' \<longrightarrow> \<forall> p q, p \<noteq> q \<longrightarrow> (\<forall> r, r \<noteq> p \<longrightarrow> r \<noteq> q \<longrightarrow> match g with | GMsg p' q' _ _ => p' = p \<longrightarrow> q' = q \<longrightarrow> project g r = project g' r | _ => True end)"
  by auto

(* CP_100_subject_reduction_full (matches Coq) *)
lemma CP_100_subject_reduction_full: "\<forall> p q t g, p \<noteq> q \<longrightarrow> well_formed_global (GMsg p q t g) \<longrightarrow> (project (GMsg p q t g) p = LSend q t (project g p)) \<and> (project (GMsg p q t g) q = LRecv p t (project g q)) \<and> (\<forall> r, r \<noteq> p \<longrightarrow> r \<noteq> q \<longrightarrow> project (GMsg p q t g) r = project g r)"
  by auto

