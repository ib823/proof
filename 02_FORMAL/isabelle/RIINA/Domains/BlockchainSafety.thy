lemma BCS_079: "\<forall> c, blockchain_safe c = True \<longrightarrow> bsc_value_conservation c = True \<and> bsc_reentrancy_guard c = True \<and> bsc_token_supply c = True \<and> bsc_flash_loan_guard c = True \<and> bsc_consensus_safety c = True \<and> bsc_finality_guarantee c = True"
  by auto

