  by auto

(* nested_product_assoc (matches Coq) *)
lemma nested_product_assoc: "\<forall> (A B C D : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (mc : C \<longrightarrow> C \<longrightarrow> C) (md : D \<longrightarrow> D \<longrightarrow> D), (\<forall> a1 a2 a3, ma (ma a1 a2) a3 = ma a1 (ma a2 a3)) \<longrightarrow> (\<forall> b1 b2 b3, mb (mb b1 b2) b3 = mb b1 (mb b2 b3)) \<longrightarrow> (\<forall> c1 c2 c3, mc (mc c1 c2) c3 = mc c1 (mc c2 c3)) \<longrightarrow> (\<forall> d1 d2 d3, md (md d1 d2) d3 = md d1 (md d2 d3)) \<longrightarrow> \<forall> x y z : (A * B) * (C * D), prod_merge (prod_merge ma mb) (prod_merge mc md) (prod_merge (prod_merge ma mb) (prod_merge mc md) x y) z = prod_merge (prod_merge ma mb) (prod_merge mc md) x (prod_merge (prod_merge ma mb) (prod_merge mc md) y z)"
  by auto

(* nested_product_idem (matches Coq) *)
lemma nested_product_idem: "\<forall> (A B C D : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (mc : C \<longrightarrow> C \<longrightarrow> C) (md : D \<longrightarrow> D \<longrightarrow> D), (\<forall> a, ma a a = a) \<longrightarrow> (\<forall> b, mb b b = b) \<longrightarrow> (\<forall> c, mc c c = c) \<longrightarrow> (\<forall> d, md d d = d) \<longrightarrow> \<forall> x : (A * B) * (C * D), prod_merge (prod_merge ma mb) (prod_merge mc md) x x = x"
  by auto

(* Folding merges preserves idempotence *)
(* fold_merge_idem (matches Coq) *)
lemma fold_merge_idem: "\<forall> (A : Type) (merge : A \<longrightarrow> A \<longrightarrow> A), (\<forall> a b c : A, merge (merge a b) c = merge a (merge b c)) \<longrightarrow> (\<forall> a : A, merge a a = a) \<longrightarrow> \<forall> s : A, fold_left merge [s] s = s"
  by auto

(* Folding two copies of updates is same as one *)
(* fold_merge_double_update (matches Coq) *)
lemma fold_merge_double_update: "\<forall> (A : Type) (merge : A \<longrightarrow> A \<longrightarrow> A), (\<forall> a b c : A, merge (merge a b) c = merge a (merge b c)) \<longrightarrow> (\<forall> a : A, merge a a = a) \<longrightarrow> \<forall> s u : A, merge (merge s u) u = merge s u"
  by simp

(* merkle_create_valid (matches Coq) *)
lemma merkle_create_valid: "\<forall> s, merkle_valid (merkle_create s)"
  by simp

(* merkle_equal_states_equal_hashes (matches Coq) *)
lemma merkle_equal_states_equal_hashes: "\<forall> a b, merkle_state a = merkle_state b \<longrightarrow> hash (merkle_state a) = hash (merkle_state b)"
  by simp

(* merkle_hash_deterministic (matches Coq) *)
lemma merkle_hash_deterministic: "\<forall> s, hash s = hash s"
  by simp

(* merkle_merge_valid (matches Coq) *)
lemma merkle_merge_valid: "\<forall> a b, merkle_valid a \<longrightarrow> merkle_valid b \<longrightarrow> merkle_valid (merkle_merge a b)"
  by simp

(* merkle_merge_comm (matches Coq) *)
lemma merkle_merge_comm: "\<forall> a b, merkle_merge a b = merkle_merge b a"
  by auto

(* merkle_merge_assoc (matches Coq) *)
lemma merkle_merge_assoc: "\<forall> a b c, merkle_merge (merkle_merge a b) c = merkle_merge a (merkle_merge b c)"
  by auto

(* merkle_merge_idem (matches Coq) *)
lemma merkle_merge_idem: "\<forall> a, merkle_valid a \<longrightarrow> merkle_merge a a = a"
  by (cases rule: ‹_›.cases; simp)

(* merkle_crdt_tamper_evident (matches Coq) *)
lemma merkle_crdt_tamper_evident: "\<forall> a b, merkle_valid a \<longrightarrow> merkle_valid b \<longrightarrow> merkle_hash a \<noteq> merkle_hash b \<longrightarrow> merkle_state a \<noteq> merkle_state b"
  by simp

(* merkle_tamper_detected (matches Coq) *)
lemma merkle_tamper_detected: "\<forall> node fake_state, merkle_valid node \<longrightarrow> merkle_state node \<noteq> fake_state \<longrightarrow> merkle_hash node \<noteq> hash fake_state"
  by simp

(* merkle_merge_state_max (matches Coq) *)
lemma merkle_merge_state_max: "\<forall> a b, merkle_state (merkle_merge a b) = Nat.max (merkle_state a) (merkle_state b)"
  by simp

(* merkle_merge_state_geq_l (matches Coq) *)
lemma merkle_merge_state_geq_l: "\<forall> a b, merkle_state (merkle_merge a b) \<ge> merkle_state a"
  by simp

(* merkle_merge_state_geq_r (matches Coq) *)
lemma merkle_merge_state_geq_r: "\<forall> a b, merkle_state (merkle_merge a b) \<ge> merkle_state b"
  by simp

(* merkle_merge_preserves_hash_consistency (matches Coq) *)
lemma merkle_merge_preserves_hash_consistency: "\<forall> a b, merkle_valid a \<longrightarrow> merkle_valid b \<longrightarrow> merkle_hash (merkle_merge a b) = hash (merkle_state (merkle_merge a b))"
  by simp

(* merkle_merge_bottom_l (matches Coq) *)
lemma merkle_merge_bottom_l: "\<forall> a, merkle_valid a \<longrightarrow> merkle_merge (mkMerkle 0 0) a = a"
  by (cases rule: ‹_›.cases; simp)

(* merkle_content_addressed_eq (matches Coq) *)
lemma merkle_content_addressed_eq: "\<forall> s1 s2, s1 = s2 \<longrightarrow> merkle_create s1 = merkle_create s2"
  by simp

(* merkle_content_addressed_hash_eq (matches Coq) *)
lemma merkle_content_addressed_hash_eq: "\<forall> s1 s2, s1 = s2 \<longrightarrow> hash s1 = hash s2"
  by simp

(* dag_merge_contains_l (matches Coq) *)
lemma dag_merge_contains_l: "\<forall> a b node, In node a \<longrightarrow> In node (dag_merge a b)"
  by auto

(* dag_merge_contains_r (matches Coq) *)
lemma dag_merge_contains_r: "\<forall> a b node, In node b \<longrightarrow> In node (dag_merge a b)"
  by auto

(* dag_merge_length (matches Coq) *)
lemma dag_merge_length: "\<forall> a b, length (dag_merge a b) = length a + length b"
  by auto

(* existsb_app_local (matches Coq) *)
lemma existsb_app_local: "\<forall> {A : Type} (f : A \<longrightarrow> bool) l1 l2, \<exists>b f (l1 ++ l2) = \<exists>b f l1 || \<exists>b f l2"
  by simp

(* dag_has_hash_merge (matches Coq) *)
lemma dag_has_hash_merge: "\<forall> a b h, dag_has_hash a h = True \<longrightarrow> dag_has_hash (dag_merge a b) h = True"
  by simp

(* dag_has_hash_merge_r (matches Coq) *)
lemma dag_has_hash_merge_r: "\<forall> a b h, dag_has_hash b h = True \<longrightarrow> dag_has_hash (dag_merge a b) h = True"
  by simp

(* dag_merge_empty_l (matches Coq) *)
lemma dag_merge_empty_l: "\<forall> dag, dag_merge [] dag = dag"
  by simp

(* dag_merge_empty_r (matches Coq) *)
lemma dag_merge_empty_r: "\<forall> dag, dag_merge dag [] = dag ++ []"
  by simp

(* dag_hash_mismatch_detects_tamper (matches Coq) *)
lemma dag_hash_mismatch_detects_tamper: "\<forall> dag node1 node2, In node1 dag \<longrightarrow> In node2 dag \<longrightarrow> dag_node_hash node1 \<noteq> dag_node_hash node2 \<longrightarrow> node1 \<noteq> node2"
  by simp

(* dag_merge_assoc_structure (matches Coq) *)
lemma dag_merge_assoc_structure: "\<forall> a b c, dag_merge (dag_merge a b) c = a ++ b ++ c"
  by simp

(* Merkle DAG with CRDT values at leaves: merge is consistent *)
(* dag_crdt_merge_monotone (matches Coq) *)
lemma dag_crdt_merge_monotone: "\<forall> a b h, dag_has_hash a h = True \<longrightarrow> dag_has_hash (dag_merge a b) h = True"
  by auto

(* Merkle integrity after DAG merge *)
(* dag_merge_preserves_integrity (matches Coq) *)
lemma dag_merge_preserves_integrity: "\<forall> a b node ch, In node a \<longrightarrow> In ch (dag_children node) \<longrightarrow> dag_has_hash a ch = True \<longrightarrow> dag_has_hash (dag_merge a b) ch = True"
  by auto

(* DAG merge is commutative on has_hash *)
(* dag_merge_comm_hash (matches Coq) *)
lemma dag_merge_comm_hash: "\<forall> a b h, dag_has_hash (dag_merge a b) h = True \<longrightarrow> dag_has_hash (dag_merge b a) h = True"
  by auto

(* Merkle DAG valid node in merged DAG *)
(* dag_valid_merge_preserves (matches Coq) *)
lemma dag_valid_merge_preserves: "\<forall> a b, dag_valid a \<longrightarrow> dag_valid b \<longrightarrow> (\<forall> node, In node a \<longrightarrow> \<forall> ch, In ch (dag_children node) \<longrightarrow> dag_has_hash (a ++ b) ch = True) \<longrightarrow> (\<forall> node, In node b \<longrightarrow> \<forall> ch, In ch (dag_children node) \<longrightarrow> dag_has_hash (a ++ b) ch = True) \<longrightarrow> dag_valid (dag_merge a b)"
  by auto

(* Product CRDT convergence with 3 updates *)
(* prod_triple_convergence (matches Coq) *)
lemma prod_triple_convergence: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B), (\<forall> a1 a2, ma a1 a2 = ma a2 a1) \<longrightarrow> (\<forall> a1 a2 a3, ma (ma a1 a2) a3 = ma a1 (ma a2 a3)) \<longrightarrow> (\<forall> b1 b2, mb b1 b2 = mb b2 b1) \<longrightarrow> (\<forall> b1 b2 b3, mb (mb b1 b2) b3 = mb b1 (mb b2 b3)) \<longrightarrow> \<forall> s u1 u2 u3 : A * B, prod_merge ma mb (prod_merge ma mb (prod_merge ma mb s u1) u2) u3 = prod_merge ma mb (prod_merge ma mb (prod_merge ma mb s u3) u2) u1"
  by simp

(* Nat product: merge order independence *)
(* nat_prod_order_independent (matches Coq) *)
lemma nat_prod_order_independent: "\<forall> s a b, nat_prod_merge (nat_prod_merge s a) b = nat_prod_merge (nat_prod_merge s b) a"
  by simp

(* Merkle node: merge order independence *)
(* merkle_merge_order_independent (matches Coq) *)
lemma merkle_merge_order_independent: "\<forall> s a b, merkle_merge (merkle_merge s a) b = merkle_merge (merkle_merge s b) a"
  by simp

(* Merkle node: idempotent delivery *)
(* merkle_idempotent_delivery (matches Coq) *)
lemma merkle_idempotent_delivery: "\<forall> s u, merkle_valid u \<longrightarrow> merkle_merge (merkle_merge s u) u = merkle_merge s u"
  by simp

(* Map: insert then lookup retrieves value *)
(* map_insert_roundtrip (matches Coq) *)
lemma map_insert_roundtrip: "\<forall> k v, map_lookup (map_insert map_empty k v) k = v"
  by auto

(* Map: two inserts, last wins on lookup *)
(* map_insert_overwrite (matches Coq) *)
lemma map_insert_overwrite: "\<forall> m k v1 v2, map_lookup (map_insert (map_insert m k v1) k v2) k = v2"
  by auto

(* Map: insert different keys are independent *)
(* map_insert_independent (matches Coq) *)
lemma map_insert_independent: "\<forall> m k1 k2 v1 v2, k1 \<noteq> k2 \<longrightarrow> map_lookup (map_insert (map_insert m k1 v1) k2 v2) k1 = v1"
  by auto

(* Product CRDT: projections preserve merge *)
(* prod_merge_fst_preserves (matches Coq) *)
lemma prod_merge_fst_preserves: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) x y, fst (prod_merge ma mb x y) = ma (fst x) (fst y)"
  by simp

(* prod_merge_snd_preserves (matches Coq) *)
lemma prod_merge_snd_preserves: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) x y, snd (prod_merge ma mb x y) = mb (snd x) (snd y)"
  by simp

(* Product: merge with (bottom, x) when bottom is left identity *)
(* prod_merge_partial_bottom_l (matches Coq) *)
lemma prod_merge_partial_bottom_l: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (ba : A) b1 b2, (\<forall> a, ma ba a = a) \<longrightarrow> fst (prod_merge ma mb (ba, b1) (ba, b2)) = ba"
  by auto

(* Nat product: leq is reflexive *)
(* nat_prod_leq_refl (matches Coq) *)
lemma nat_prod_leq_refl: "\<forall> x : nat * nat, fst x \<le> fst x \<and> snd x \<le> snd x"
  by simp

(* Nat product: merge gives upper bound *)
(* nat_prod_merge_geq_l (matches Coq) *)
lemma nat_prod_merge_geq_l: "\<forall> x y : nat * nat, fst (nat_prod_merge x y) \<ge> fst x \<and> snd (nat_prod_merge x y) \<ge> snd x"
  by simp

(* nat_prod_merge_geq_r (matches Coq) *)
lemma nat_prod_merge_geq_r: "\<forall> x y : nat * nat, fst (nat_prod_merge x y) \<ge> fst y \<and> snd (nat_prod_merge x y) \<ge> snd y"
  by simp

(* Map: has_key after insert *)
(* map_has_key_insert_diff (matches Coq) *)
lemma map_has_key_insert_diff: "\<forall> m k k' v, map_has_key m k = True \<longrightarrow> map_has_key (map_insert m k' v) k = True"
  by auto

(* Map: empty merge_aux *)
(* map_merge_aux_nil_r (matches Coq) *)
lemma map_merge_aux_nil_r: "\<forall> m, map_merge_aux m [] = map (fun kv => (fst kv, Nat.max (snd kv) 0)) m"
  by simp

(* Merkle: creating then merging with self *)
(* merkle_create_merge_self (matches Coq) *)
lemma merkle_create_merge_self: "\<forall> s, merkle_merge (merkle_create s) (merkle_create s) = merkle_create s"
  by auto

(* Merkle: state after creation *)
(* merkle_create_state (matches Coq) *)
lemma merkle_create_state: "\<forall> s, merkle_state (merkle_create s) = s"
  by simp

(* Merkle: hash after creation *)
(* merkle_create_hash (matches Coq) *)
lemma merkle_create_hash: "\<forall> s, merkle_hash (merkle_create s) = hash s"
  by simp

(* DAG: merge preserves node count *)
(* dag_merge_node_count (matches Coq) *)
lemma dag_merge_node_count: "\<forall> a b, length (dag_merge a b) = length a + length b"
  by auto

(* DAG: singleton DAG *)
(* dag_singleton_has_hash (matches Coq) *)
lemma dag_singleton_has_hash: "\<forall> h children, dag_has_hash [(h, children)] h = True"
  by simp

(* DAG: singleton DAG doesn't have other hash *)
(* dag_singleton_no_other (matches Coq) *)
lemma dag_singleton_no_other: "\<forall> h h' children, h \<noteq> h' \<longrightarrow> dag_has_hash [(h, children)] h' = (h' = h)"
  by auto

(* Triple product: projection properties *)
(* triple_merge_fst_fst (matches Coq) *)
lemma triple_merge_fst_fst: "\<forall> (A B C : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (mc : C \<longrightarrow> C \<longrightarrow> C) x y, fst (fst (triple_merge ma mb mc x y)) = ma (fst (fst x)) (fst (fst y))"
  by simp

(* triple_merge_fst_snd (matches Coq) *)
lemma triple_merge_fst_snd: "\<forall> (A B C : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (mc : C \<longrightarrow> C \<longrightarrow> C) x y, snd (fst (triple_merge ma mb mc x y)) = mb (snd (fst x)) (snd (fst y))"
  by simp

(* triple_merge_snd (matches Coq) *)
lemma triple_merge_snd: "\<forall> (A B C : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (mc : C \<longrightarrow> C \<longrightarrow> C) x y, snd (triple_merge ma mb mc x y) = mc (snd x) (snd y)"
  by simp

(* Composition: general n-ary convergence principle *)
(* composition_idempotent_delivery (matches Coq) *)
lemma composition_idempotent_delivery: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B), (\<forall> a1 a2 a3, ma (ma a1 a2) a3 = ma a1 (ma a2 a3)) \<longrightarrow> (\<forall> a, ma a a = a) \<longrightarrow> (\<forall> b1 b2 b3, mb (mb b1 b2) b3 = mb b1 (mb b2 b3)) \<longrightarrow> (\<forall> b, mb b b = b) \<longrightarrow> \<forall> s u : A * B, prod_merge ma mb (prod_merge ma mb s u) u = prod_merge ma mb s u"
  by auto

(* Merkle DAG: merge three DAGs *)
(* dag_merge_triple_assoc (matches Coq) *)
lemma dag_merge_triple_assoc: "\<forall> a b c, dag_merge (dag_merge a b) c = dag_merge a (dag_merge b c)"
  by simp

(* Hash function properties *)
(* hash_deterministic (matches Coq) *)
lemma hash_deterministic: "\<forall> n, hash n = hash n"
  by simp

(* hash_eq_implies_state_eq (matches Coq) *)
lemma hash_eq_implies_state_eq: "\<forall> s1 s2, hash s1 = hash s2 \<longrightarrow> s1 = s2"
  by auto

(* hash_neq_implies_state_neq (matches Coq) *)
lemma hash_neq_implies_state_neq: "\<forall> s1 s2, hash s1 \<noteq> hash s2 \<longrightarrow> s1 \<noteq> s2"
  by simp

(* Content-addressed: equal content has equal address *)
(* content_addressed_eq (matches Coq) *)
lemma content_addressed_eq: "\<forall> s, hash s = hash s"
  by simp

(* Content-addressed CRDT merge preserves addressing *)
(* content_addressed_merge_consistent (matches Coq) *)
lemma content_addressed_merge_consistent: "\<forall> a b, merkle_hash (merkle_merge a b) = hash (Nat.max (merkle_state a) (merkle_state b))"
  by simp

(* Map CRDT: merge_aux does not lose keys from m1 *)
(* map_merge_aux_has_key (matches Coq) *)
lemma map_merge_aux_has_key: "\<forall> m1 m2 k, map_has_key m1 k = True \<longrightarrow> map_has_key (map_merge_aux m1 m2) k = True"
  by (cases rule: ‹_›.cases; simp)

(* Product CRDT: merge two bottoms gives bottom *)
(* prod_bottom_idem (matches Coq) *)
lemma prod_bottom_idem: "\<forall> (A B : Type) (ma : A \<longrightarrow> A \<longrightarrow> A) (mb : B \<longrightarrow> B \<longrightarrow> B) (ba : A) (bb : B), (\<forall> a, ma a a = a) \<longrightarrow> (\<forall> b, mb b b = b) \<longrightarrow> prod_merge ma mb (ba, bb) (ba, bb) = (ba, bb)"
  by auto

(* DAG: empty DAG has no hashes *)
(* dag_empty_no_hash (matches Coq) *)
lemma dag_empty_no_hash: "\<forall> h, dag_has_hash [] h = False"
  by simp

(* DAG: empty is valid *)
(* dag_empty_valid (matches Coq) *)
lemma dag_empty_valid: "dag_valid []"
  by auto

(* Merkle: merge two creates *)
(* merkle_merge_creates (matches Coq) *)
lemma merkle_merge_creates: "\<forall> s1 s2, merkle_merge (merkle_create s1) (merkle_create s2) = merkle_create (Nat.max s1 s2)"
  by simp

(* Merkle: valid node has consistent hash *)
(* merkle_valid_hash_matches (matches Coq) *)
lemma merkle_valid_hash_matches: "\<forall> node, merkle_valid node \<longrightarrow> merkle_hash node = hash (merkle_state node)"
  by auto

