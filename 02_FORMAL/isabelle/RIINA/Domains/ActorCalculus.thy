theory ActorCalculus
  imports Main CoqCompat
begin

(* MsgTag (matches Coq: Inductive MsgTag) *)
datatype msg_tag =
    TagNat
  |     TagBool
  |     TagUnit
  |     TagString
  |     TagPair
  |     TagActorRef

(* ActorStatus (matches Coq: Inductive ActorStatus) *)
datatype actor_status =
    Running
  |     Stopped
  |     Crashed
  |     Waiting
  |     Restarting

(* ActorSessionType (matches Coq: Inductive ActorSessionType) *)
datatype actor_session_type =
    ASTSend
  |     ASTRecv
  |     ASTSelect
  |     ASTOffer
  |     ASTEnd

(* CapKind (matches Coq: Inductive CapKind) *)
datatype cap_kind =
    CapSpawn
  |     CapSend
  |     CapRecv
  |     CapMonitor
  |     CapLink
  |     CapSupervise

(* Message (matches Coq: Record Message) *)
record message =
  msg_tag :: MsgTag
  msg_payload :: nat
  msg_sender :: nat
  msg_priority :: nat

(* ActorState (matches Coq: Record ActorState) *)
record actor_state =
  actor_id :: nat
  actor_status :: ActorStatus
  actor_mailbox :: Mailbox
  actor_local :: nat
  actor_msg_count :: nat
  actor_spawn_count :: nat
  actor_max_mailbox :: nat
  actor_restart_count :: nat

(* ActorChannel (matches Coq: Record ActorChannel) *)
record actor_channel =
  achan_id :: nat
  achan_session :: ActorSessionType
  achan_linear :: bool
  achan_active :: bool

(* ActorChannelPair (matches Coq: Record ActorChannelPair) *)
record actor_channel_pair =
  achan_endpoint_a :: ActorChannel
  achan_endpoint_b :: ActorChannel

(* ActorCapability (matches Coq: Record ActorCapability) *)
record actor_capability =
  acap_kind :: CapKind
  acap_granted :: bool
  acap_revocable :: bool
  acap_target :: nat

(* TypedActor (matches Coq: Record TypedActor) *)
record typed_actor =
  ta_state :: ActorState
  ta_expected :: 'a list
  ta_session :: option
  ta_caps :: 'a list
  ta_isolated :: bool

(* msg_tag_eqb - complex match, needs manual translation *)
definition msg_tag_eqb :: "bool" where "msg_tag_eqb = undefined"

(* status_eqb - complex match, needs manual translation *)
definition status_eqb :: "bool" where "status_eqb = undefined"

(* is_running (matches Coq: Definition is_running) *)
definition is_running :: "ActorState \<Rightarrow> bool" where
  "is_running a \<equiv> status_eqb (actor_status a) Running"

(* is_stopped (matches Coq: Definition is_stopped) *)
definition is_stopped :: "ActorState \<Rightarrow> bool" where
  "is_stopped a \<equiv> status_eqb (actor_status a) Stopped"

(* is_crashed (matches Coq: Definition is_crashed) *)
definition is_crashed :: "ActorState \<Rightarrow> bool" where
  "is_crashed a \<equiv> status_eqb (actor_status a) Crashed"

(* is_waiting (matches Coq: Definition is_waiting) *)
definition is_waiting :: "ActorState \<Rightarrow> bool" where
  "is_waiting a \<equiv> status_eqb (actor_status a) Waiting"

(* is_restarting (matches Coq: Definition is_restarting) *)
definition is_restarting :: "ActorState \<Rightarrow> bool" where
  "is_restarting a \<equiv> status_eqb (actor_status a) Restarting"

(* has_messages (matches Coq: Definition has_messages) *)
definition has_messages :: "ActorState \<Rightarrow> bool" where
  "has_messages a \<equiv> (\<not> (Nat.eqb) (length (actor_mailbox a)) 0)"

(* mailbox_empty (matches Coq: Definition mailbox_empty) *)
definition mailbox_empty :: "ActorState \<Rightarrow> bool" where
  "mailbox_empty a \<equiv> ((length = (actor_mailbox) a)) 0"

(* mailbox_full (matches Coq: Definition mailbox_full) *)
definition mailbox_full :: "ActorState \<Rightarrow> bool" where
  "mailbox_full a \<equiv> ((actor_max_mailbox \<le> a)) (length (actor_mailbox a))"

(* can_receive (matches Coq: Definition can_receive) *)
definition can_receive :: "ActorState \<Rightarrow> bool" where
  "can_receive a \<equiv> is_running a \<and> (\<not> (mailbox_full) a)"

(* ast_dual (matches Coq: Definition ast_dual) *)
fun ast_dual :: "ActorSessionType \<Rightarrow> ActorSessionType" where


(* achan_fresh (matches Coq: Definition achan_fresh) *)
definition achan_fresh :: "ActorChannel \<Rightarrow> bool" where
  "achan_fresh ch \<equiv> achan_linear ch \<and> achan_active ch"

(* achan_used (matches Coq: Definition achan_used) *)
definition achan_used :: "ActorChannel \<Rightarrow> ActorChannel" where
  "achan_used ch \<equiv> mkActorChan (achan_id ch) (achan_session ch) False (achan_active ch)"

(* achan_close (matches Coq: Definition achan_close) *)
definition achan_close :: "ActorChannel \<Rightarrow> ActorChannel" where
  "achan_close ch \<equiv> mkActorChan (achan_id ch) ASTEnd False False"

(* cap_kind_eqb - complex match, needs manual translation *)
definition cap_kind_eqb :: "bool" where "cap_kind_eqb = undefined"

(* acap_active (matches Coq: Definition acap_active) *)
definition acap_active :: "ActorCapability \<Rightarrow> bool" where
  "acap_active c \<equiv> acap_granted c"

(* has_cap_kind (matches Coq: Definition has_cap_kind) *)
definition has_cap_kind :: "CapKind \<Rightarrow> bool" where
  "has_cap_kind k \<equiv> existsb (fun c => cap_kind_eqb (acap_kind c) k \<and> acap_granted c) caps"

(* can_spawn (matches Coq: Definition can_spawn) *)
definition can_spawn :: "bool" where
  "can_spawn \<equiv> has_cap_kind caps CapSpawn"

(* can_send_cap (matches Coq: Definition can_send_cap) *)
definition can_send_cap :: "bool" where
  "can_send_cap \<equiv> has_cap_kind caps CapSend"

(* can_recv_cap (matches Coq: Definition can_recv_cap) *)
definition can_recv_cap :: "bool" where
  "can_recv_cap \<equiv> has_cap_kind caps CapRecv"

(* can_monitor (matches Coq: Definition can_monitor) *)
definition can_monitor :: "bool" where
  "can_monitor \<equiv> has_cap_kind caps CapMonitor"

(* can_link (matches Coq: Definition can_link) *)
definition can_link :: "bool" where
  "can_link \<equiv> has_cap_kind caps CapLink"

(* can_supervise (matches Coq: Definition can_supervise) *)
definition can_supervise :: "bool" where
  "can_supervise \<equiv> has_cap_kind caps CapSupervise"

(* msg_type_compatible (matches Coq: Definition msg_type_compatible) *)
definition msg_type_compatible :: "Message \<Rightarrow> bool" where
  "msg_type_compatible m \<equiv> existsb (msg_tag_eqb (msg_tag m)) expected"

(* mailbox_well_typed (matches Coq: Definition mailbox_well_typed) *)
definition mailbox_well_typed :: "Mailbox \<Rightarrow> bool" where
  "mailbox_well_typed mb \<equiv> forallb (fun m => msg_type_compatible m expected) mb"

(* actor_well_typed (matches Coq: Definition actor_well_typed) *)
definition actor_well_typed :: "TypedActor \<Rightarrow> bool" where
  "actor_well_typed ta \<equiv> mailbox_well_typed (actor_mailbox (ta_state ta)) (ta_expected ta) \<and>
  is_running (ta_state ta) \<and>
  ta_isolated ta"

(* find_actor (matches Coq: Definition find_actor) *)
fun find_actor :: "ActorConfig \<Rightarrow> nat \<Rightarrow> option ActorState" where


(* config_all_running (matches Coq: Definition config_all_running) *)
definition config_all_running :: "ActorConfig \<Rightarrow> bool" where
  "config_all_running cfg \<equiv> forallb is_running cfg"

(* config_no_crashed (matches Coq: Definition config_no_crashed) *)
definition config_no_crashed :: "ActorConfig \<Rightarrow> bool" where
  "config_no_crashed cfg \<equiv> forallb (fun a => (\<not> (is_crashed) a)) cfg"

(* config_all_isolated (matches Coq: Definition config_all_isolated) *)
definition config_all_isolated :: "ActorConfig \<Rightarrow> bool" where
  "config_all_isolated cfg \<equiv> forallb (fun a => ((actor_local = a)) (actor_id a)) cfg"

(* config_no_full_mailboxes (matches Coq: Definition config_no_full_mailboxes) *)
definition config_no_full_mailboxes :: "ActorConfig \<Rightarrow> bool" where
  "config_no_full_mailboxes cfg \<equiv> forallb (fun a => (\<not> (mailbox_full) a)) cfg"

(* config_size (matches Coq: Definition config_size) *)
definition config_size :: "ActorConfig \<Rightarrow> nat" where
  "config_size cfg \<equiv> length cfg"

(* total_messages (matches Coq: Definition total_messages) *)
definition total_messages :: "ActorConfig \<Rightarrow> nat" where
  "total_messages cfg \<equiv> fold_left (fun acc a => acc + length (actor_mailbox a)) cfg 0"

(* deliver_message (matches Coq: Definition deliver_message) *)
definition deliver_message :: "ActorConfig \<Rightarrow> nat \<Rightarrow> Message \<Rightarrow> ActorConfig" where
  "deliver_message cfg target m \<equiv> map (fun a =>
    if ((actor_id = a)) target
    then mkActor (actor_id a) (actor_status a) (actor_mailbox a ++ [m])
                 (actor_local a) (actor_msg_count a + 1) (actor_spawn_count a)
                 (actor_max_mailbox a) (actor_restart_count a)
    else a
  ) cfg"

(* spawn_actor (matches Coq: Definition spawn_actor) *)
definition spawn_actor :: "ActorConfig \<Rightarrow> nat \<Rightarrow> ActorConfig" where
  "spawn_actor cfg new_id \<equiv> cfg ++ [mkActor new_id Running [] 0 0 0 100 0]"

(* crash_actor (matches Coq: Definition crash_actor) *)
definition crash_actor :: "ActorConfig \<Rightarrow> nat \<Rightarrow> ActorConfig" where
  "crash_actor cfg aid \<equiv> map (fun a =>
    if ((actor_id = a)) aid
    then mkActor (actor_id a) Crashed (actor_mailbox a)
                 (actor_local a) (actor_msg_count a) (actor_spawn_count a)
                 (actor_max_mailbox a) (actor_restart_count a)
    else a
  ) cfg"

(* restart_actor (matches Coq: Definition restart_actor) *)
definition restart_actor :: "ActorConfig \<Rightarrow> nat \<Rightarrow> ActorConfig" where
  "restart_actor cfg aid \<equiv> map (fun a =>
    if ((actor_id = a)) aid
    then mkActor (actor_id a) Running []
                 (actor_local a) 0 0
                 (actor_max_mailbox a) (actor_restart_count a + 1)
    else a
  ) cfg"

