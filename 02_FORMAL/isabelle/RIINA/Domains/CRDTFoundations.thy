lemma pn_leq_refl: "\<forall> a, pn_leq a a"
  by auto

(* pn_leq_trans (matches Coq) *)
lemma pn_leq_trans: "\<forall> a b c, pn_leq a b \<longrightarrow> pn_leq b c \<longrightarrow> pn_leq a c"
  by auto

(* pn_leq_merge_l (matches Coq) *)
lemma pn_leq_merge_l: "\<forall> a b, length (fst a) = length (fst b) \<longrightarrow> length (snd a) = length (snd b) \<longrightarrow> pn_leq a (pn_merge a b)"
  by auto

(* pn_leq_merge_r (matches Coq) *)
lemma pn_leq_merge_r: "\<forall> a b, length (fst a) = length (fst b) \<longrightarrow> length (snd a) = length (snd b) \<longrightarrow> pn_leq b (pn_merge a b)"
  by auto

(* pn_bottom_merge_l (matches Coq) *)
lemma pn_bottom_merge_l: "\<forall> p n, length (fst p) = n \<longrightarrow> length (snd p) = n \<longrightarrow> pn_merge (pn_bottom n) p = p"
  by auto

(* pn_bottom_merge_r (matches Coq) *)
lemma pn_bottom_merge_r: "\<forall> p n, length (fst p) = n \<longrightarrow> length (snd p) = n \<longrightarrow> pn_merge p (pn_bottom n) = p"
  by auto

(* pn_bottom_leq (matches Coq) *)
lemma pn_bottom_leq: "\<forall> p n, length (fst p) = n \<longrightarrow> length (snd p) = n \<longrightarrow> pn_leq (pn_bottom n) p"
  by auto

(* pn_increment_preserves_neg (matches Coq) *)
lemma pn_increment_preserves_neg: "\<forall> p node, snd (pn_increment p node) = snd p"
  by simp

(* pn_decrement_preserves_pos (matches Coq) *)
lemma pn_decrement_preserves_pos: "\<forall> p node, fst (pn_decrement p node) = fst p"
  by simp

(* pn_increment_pos_length (matches Coq) *)
lemma pn_increment_pos_length: "\<forall> p node, length (fst (pn_increment p node)) = length (fst p)"
  by auto

(* pn_decrement_neg_length (matches Coq) *)
lemma pn_decrement_neg_length: "\<forall> p node, length (snd (pn_decrement p node)) = length (snd p)"
  by auto

(* pn_merge_pos_length (matches Coq) *)
lemma pn_merge_pos_length: "\<forall> a b, length (fst a) = length (fst b) \<longrightarrow> length (fst (pn_merge a b)) = length (fst a)"
  by auto

(* pn_merge_neg_length (matches Coq) *)
lemma pn_merge_neg_length: "\<forall> a b, length (snd a) = length (snd b) \<longrightarrow> length (snd (pn_merge a b)) = length (snd a)"
  by auto

(* member_cons (matches Coq) *)
lemma member_cons: "\<forall> v x s, member v (x :: s) = ((v = x)) || member v s"
  by simp

(* member_refl (matches Coq) *)
lemma member_refl: "\<forall> v s, In v s \<longrightarrow> member v s = True"
  by (cases rule: ‹_›.cases; simp)

(* gs_add_member (matches Coq) *)
lemma gs_add_member: "\<forall> s v, gs_member (gs_add s v) v = True"
  by (cases rule: ‹_›.cases; simp)

(* gs_add_preserves (matches Coq) *)
lemma gs_add_preserves: "\<forall> s v v', gs_member s v' = True \<longrightarrow> gs_member (gs_add s v) v' = True"
  by auto

(* gs_add_idempotent (matches Coq) *)
lemma gs_add_idempotent: "\<forall> s v, gs_member s v = True \<longrightarrow> gs_add s v = s"
  by simp

(* gs_merge_contains_l (matches Coq) *)
lemma gs_merge_contains_l: "\<forall> a b v, gs_member a v = True \<longrightarrow> gs_member (gs_merge a b) v = True"
  by auto

(* gs_merge_contains_r (matches Coq) *)
lemma gs_merge_contains_r: "\<forall> a b v, gs_member b v = True \<longrightarrow> gs_member (gs_merge a b) v = True"
  by auto

(* gs_merge_not_member (matches Coq) *)
lemma gs_merge_not_member: "\<forall> a b v, gs_member a v = False \<longrightarrow> gs_member b v = False \<longrightarrow> gs_member (gs_merge a b) v = False"
  by auto

(* gs_merge_comm_member (matches Coq) *)
lemma gs_merge_comm_member: "\<forall> a b v, gs_member (gs_merge a b) v = True <-> gs_member (gs_merge b a) v = True"
  by auto

(* gs_merge_add_idem (matches Coq) *)
lemma gs_merge_add_idem: "\<forall> b a, (\<forall> v, gs_member b v = True \<longrightarrow> gs_member a v = True) \<longrightarrow> gs_merge a b = a"
  by auto

(* gs_merge_idem (matches Coq) *)
lemma gs_merge_idem: "\<forall> a, gs_merge a a = a"
  by auto

(* gs_empty_merge_l (matches Coq) *)
lemma gs_empty_merge_l: "\<forall> s v, gs_member s v = True \<longrightarrow> gs_member (gs_merge gs_empty s) v = True"
  by auto

(* gs_empty_member (matches Coq) *)
lemma gs_empty_member: "\<forall> v, gs_member gs_empty v = False"
  by simp

(* gs_add_not_member (matches Coq) *)
lemma gs_add_not_member: "\<forall> s u w, w \<noteq> u \<longrightarrow> gs_member s w = False \<longrightarrow> gs_member (gs_add s u) w = False"
  by (cases rule: ‹_›.cases; simp)

(* gs_add_comm_member (matches Coq) *)
lemma gs_add_comm_member: "\<forall> s u v w, gs_member (gs_add (gs_add s u) v) w = gs_member (gs_add (gs_add s v) u) w"
  by auto

(* gs_member_add_cases (matches Coq) *)
lemma gs_member_add_cases: "\<forall> s v w, gs_member (gs_add s v) w = True \<longrightarrow> w = v \<or> gs_member s w = True"
  by (cases rule: ‹_›.cases; simp)

(* gs_merge_member_iff (matches Coq) *)
lemma gs_merge_member_iff: "\<forall> a b v, gs_member (gs_merge a b) v = True \<longrightarrow> gs_member a v = True \<or> gs_member b v = True"
  by (cases rule: ‹_›.cases; simp)

(* gs_merge_monotone (matches Coq) *)
lemma gs_merge_monotone: "\<forall> a b v, gs_member a v = True \<longrightarrow> gs_member (gs_merge a b) v = True"
  by auto

(* tp_add_visible (matches Coq) *)
lemma tp_add_visible: "\<forall> s v, gs_member (snd s) v = False \<longrightarrow> tp_lookup (tp_add s v) v = True"
  by simp

(* tp_remove_hides (matches Coq) *)
lemma tp_remove_hides: "\<forall> s v, tp_lookup (tp_remove s v) v = False"
  by simp

(* tp_remove_permanent (matches Coq) *)
lemma tp_remove_permanent: "\<forall> s v a b, gs_member (snd s) v = True \<longrightarrow> tp_lookup (tp_merge s (a, b)) v = False"
  by auto

(* tp_merge_comm_lookup (matches Coq) *)
lemma tp_merge_comm_lookup: "\<forall> a b v, tp_lookup (tp_merge a b) v = tp_lookup (tp_merge b a) v"
  by (cases rule: ‹_›.cases; simp)

(* tp_merge_idem (matches Coq) *)
lemma tp_merge_idem: "\<forall> s, tp_merge s s = s"
  by auto

(* tp_empty_merge_l (matches Coq) *)
lemma tp_empty_merge_l: "\<forall> s v, tp_lookup s v = True \<longrightarrow> tp_lookup (tp_merge tp_empty s) v = True"
  by (cases rule: ‹_›.cases; simp)

(* tp_add_preserves_removed (matches Coq) *)
lemma tp_add_preserves_removed: "\<forall> s v, snd (tp_add s v) = snd s"
  by simp

(* tp_remove_preserves_added (matches Coq) *)
lemma tp_remove_preserves_added: "\<forall> s v, fst (tp_remove s v) = fst s"
  by simp

(* tp_lookup_false_not_added (matches Coq) *)
lemma tp_lookup_false_not_added: "\<forall> v, tp_lookup tp_empty v = False"
  by simp

(* tp_merge_add_visible (matches Coq) *)
lemma tp_merge_add_visible: "\<forall> a b v, gs_member (fst a) v = True \<longrightarrow> gs_member (snd a) v = False \<longrightarrow> gs_member (gs_merge (snd a) (snd b)) v = False \<longrightarrow> tp_lookup (tp_merge a b) v = True"
  by auto

(* tp_merge_preserves_removal (matches Coq) *)
lemma tp_merge_preserves_removal: "\<forall> (a b : TwoPSet) v, gs_member (snd a) v = True \<longrightarrow> gs_member (gs_merge (snd a) (snd b)) v = True"
  by auto

(* tp_once_removed_stays_removed (matches Coq) *)
lemma tp_once_removed_stays_removed: "\<forall> s v ops, gs_member (snd s) v = True \<longrightarrow> gs_member (snd (fold_left (fun acc op => tp_merge acc op) ops s)) v = True"
  by auto

(* lww_merge_comm (matches Coq) *)
lemma lww_merge_comm: "\<forall> a b, lww_merge a b = lww_merge b a"
  by (cases rule: ‹_›.cases; simp)

(* lww_merge_idem (matches Coq) *)
lemma lww_merge_idem: "\<forall> a, lww_merge a a = a"
  by (cases rule: ‹_›.cases; simp)

(* lww_merge_assoc_idem (matches Coq) *)
lemma lww_merge_assoc_idem: "\<forall> a, lww_merge (lww_merge a a) a = lww_merge a a"
  by auto

(* lww_write_higher_wins (matches Coq) *)
lemma lww_write_higher_wins: "\<forall> r v1 v2 ts1 ts2, ts1 < ts2 \<longrightarrow> lww_merge (lww_write r v1 ts1) (lww_write r v2 ts2) = mkLWW v2 ts2"
  by (cases rule: ‹_›.cases; simp)

(* lww_read_after_write (matches Coq) *)
lemma lww_read_after_write: "\<forall> r v ts, lww_read (lww_write r v ts) = v"
  by simp

(* lww_merge_ts_nondecreasing (matches Coq) *)
lemma lww_merge_ts_nondecreasing: "\<forall> a b, lww_ts (lww_merge a b) \<ge> lww_ts a"
  by (cases rule: ‹_›.cases; simp)

(* lww_merge_ts_max (matches Coq) *)
lemma lww_merge_ts_max: "\<forall> a b, lww_ts (lww_merge a b) = Nat.max (lww_ts a) (lww_ts b)"
  by (cases rule: ‹_›.cases; simp)

(* lww_bottom_merge_l (matches Coq) *)
lemma lww_bottom_merge_l: "\<forall> r, lww_ts r \<ge> 0 \<longrightarrow> lww_merge lww_bottom r = r"
  by (cases rule: ‹_›.cases; simp)

(* lww_concurrent_same_ts (matches Coq) *)
lemma lww_concurrent_same_ts: "\<forall> v1 v2 ts, lww_merge (mkLWW v1 ts) (mkLWW v2 ts) = lww_merge (mkLWW v2 ts) (mkLWW v1 ts)"
  by auto

(* lww_merge_either (matches Coq) *)
lemma lww_merge_either: "\<forall> a b, lww_merge a b = a \<or> lww_merge a b = b"
  by simp

(* or_entry_eqb_refl (matches Coq) *)
lemma or_entry_eqb_refl: "\<forall> e, or_entry_eqb e e = True"
  by simp

(* existsb_app (matches Coq) *)
lemma existsb_app: "\<forall> {A} (f : A \<longrightarrow> bool) l1 l2, \<exists>b f (l1 ++ l2) = \<exists>b f l1 || \<exists>b f l2"
  by simp

(* or_add_lookup (matches Coq) *)
lemma or_add_lookup: "\<forall> s v tag, or_in_list (v, tag) (snd s) = False \<longrightarrow> or_lookup (or_add s v tag) v = True"
  by simp

end
