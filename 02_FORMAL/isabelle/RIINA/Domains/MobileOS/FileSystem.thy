definition reads :: "File \<Rightarrow> Data" where
  "reads f \<equiv> file_data f"

(* power_loss_at (matches Coq: Definition power_loss_at) *)
definition power_loss_at :: "Time \<Rightarrow> bool" where
  "power_loss_at t \<equiv> True"

