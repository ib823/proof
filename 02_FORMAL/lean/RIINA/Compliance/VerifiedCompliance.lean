/-- make_compliant_store (matches Coq: Definition make_compliant_store) -/
def make_compliant_store (data : List PersonalData) (purpose : String) : DataStore :=
  { store_data := data, store_purpose := purpose, store_compliant := true, store_encrypted := true }

/-- make_system_phi (matches Coq: Definition make_system_phi) -/
def make_system_phi (patient_id : Nat) (data : List Nat) (created : Nat)
                     (accessed_by : List Nat) : PHI :=
  { phi_patient_id := patient_id, phi_data := data, phi_created := created,
    phi_accessed_by := accessed_by, phi_encrypted := true, phi_access_controlled := true,
    phi_logged := true, phi_integrity_protected := true, phi_available := true,
    phi_in_system := true }

/-- make_cde_chd (matches Coq: Definition make_cde_chd) -/
def make_cde_chd (pan : List Nat) (expiry : Nat) (name : String) : CardholderData :=
  { chd_pan := pan, chd_pan_encrypted := true, chd_expiry := expiry,
    chd_cvv_stored := false, chd_cardholder_name := name, chd_in_cde := true }

/-- make_proven_control (matches Coq: Definition make_proven_control) -/
def make_proven_control (id desc : String) (reg : Regulation) : Control :=
  { control_id := id, control_regulation := reg, control_description := desc,
    control_satisfied := true, control_monitored := true, control_has_alert := true }

/-- make_valid_evidence (matches Coq: Definition make_valid_evidence) -/
def make_valid_evidence (ctrl : Control) (items : List (String × String))
                         (ts : Nat) (sig : List Nat) : EvidenceChain :=
  { evidence_control := ctrl, evidence_items := items, evidence_timestamp := ts,
    evidence_signature := sig, evidence_valid_flag := true }

/-- make_compliant_policy (matches Coq: Definition make_compliant_policy) -/
def make_compliant_policy (reg : Regulation) (ctrls : List Control)
                            (maps : List ControlMapping) : CompliancePolicy :=
  { policy_regulation := reg, policy_controls := ctrls, policy_mappings := maps,
    policy_compliant := true }

