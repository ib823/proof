    ∀ id desc reg,
    proof_as_evidence_holds (make_proven_control id desc reg) := by
  intro id desc reg
  unfold proof_as_evidence_holds make_proven_control
  simp
  exact ⟨make_valid_evidence
            { control_id := id, control_regulation := reg, control_description := desc,
              control_satisfied := true, control_monitored := true, control_has_alert := true }
            [] 0 [],
         rfl, rfl⟩

