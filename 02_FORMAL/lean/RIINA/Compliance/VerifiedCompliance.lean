/-- AJ_001_07_gdpr_erasure_right (matches Coq) -/
theorem AJ_001_07_gdpr_erasure_right :
    ∀ data purpose subject,
    (∀ pd, pd ∈ data → pd.pd_subject = subject →
      ¬ pd ∈ (data.filter (fun pd => negb (pd.pd_subject == subject)))) →
    (∀ pd, pd ∈ data → pd.pd_subject ≠ subject →
      pd ∈ (data.filter (fun pd => negb (pd.pd_subject == subject)))) →
    erasure_right_holds (make_compliant_store data purpose)
      (make_compliant_store (data.filter (fun pd => negb (pd.pd_subject == subject))) purpose)
      subject := by
  intro data purpose subject Herase1 Herase2
  unfold erasure_right_holds make_compliant_store
  intro _
  exact ⟨Herase1, Herase2⟩

