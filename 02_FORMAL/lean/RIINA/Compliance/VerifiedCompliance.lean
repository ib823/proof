    ∀ data purpose,
    (∀ pd, pd ∈ data → pd.pd_necessary = true) →
    data_minimization_holds (make_compliant_store data purpose) := by
  intro data purpose Hnec
  unfold data_minimization_holds make_compliant_store
  simp
  exact Hnec

/-- AJ_001_02_gdpr_purpose_limitation (matches Coq) -/
theorem AJ_001_02_gdpr_purpose_limitation :
    ∀ data purpose,
    (∀ pd, pd ∈ data → pd.pd_purpose = purpose) →
    purpose_limitation_holds (make_compliant_store data purpose) := by
  intro data purpose Hpurp
  unfold purpose_limitation_holds make_compliant_store
  simp
  exact Hpurp

/-- AJ_001_03_gdpr_storage_limitation (matches Coq) -/
