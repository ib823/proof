    mcdc_coverage_100 c.comp_coverage = true →
    c.comp_coverage.cov_mcdc_conditions = c.comp_coverage.cov_total_conditions := by
  intro c _ hcov
  unfold mcdc_coverage_100 at hcov
  have ⟨_, h2⟩ := (Bool.and_eq_true_iff _ _).mp hcov
  exact (Nat.beq_eq_true_iff _ _).mp h2

/-- COMPLY_003_05 (matches Coq): Dead Code Absence -/
theorem COMPLY_003_05 : ∀ (c : DO178CCompliance),
    no_dead_code c.comp_code_analysis = true →
    ∀ code_id, code_id ∈ c.comp_code_analysis.ca_all_code →
    code_id ∈ c.comp_code_analysis.ca_reachable_code ∨
    code_id ∈ c.comp_code_analysis.ca_deactivated_code := by
  intro c h code_id hin
  unfold no_dead_code is_subset at h
  have hall := (List.all_eq_true _ _).mp h code_id hin
  have ⟨x, hx, hbeq⟩ := (List.any_eq_true _ _).mp hall
  have := (Nat.beq_eq_true_iff _ _).mp hbeq
  subst this
  exact List.mem_append.mp hx

/-- COMPLY_003_06 (matches Coq): Deactivated Code Identification -/
theorem COMPLY_003_06 : ∀ (c : DO178CCompliance),
    all_deactivated_documented c.comp_code_analysis = true →
    ∀ code_id, code_id ∈ c.comp_code_analysis.ca_deactivated_code →
    code_id ∈ c.comp_code_analysis.ca_deactivated_documented := by
  intro c h code_id hin
  unfold all_deactivated_documented is_subset at h
  have hall := (List.all_eq_true _ _).mp h code_id hin
  have ⟨x, hx, hbeq⟩ := (List.any_eq_true _ _).mp hall
  have := (Nat.beq_eq_true_iff _ _).mp hbeq
  subst this
  exact hx

