  | nil => simp
  | cons hd tl ih => simp [List.all_cons, Bool.and_eq_true_iff, ih]

private theorem List.any_eq_true {α : Type} (f : α → Bool) (xs : List α) :
    xs.any f = true ↔ ∃ x, x ∈ xs ∧ f x = true := by
  induction xs with
  | nil => simp
