/-- DAL_A_Full_Compliance (matches Coq): Full DAL A compliance implies DAL A level -/
theorem DAL_A_Full_Compliance : ∀ (c : DO178CCompliance),
    full_dal_a_compliance c = true → c.comp_dal = DAL.DAL_A := by
  intro c h
  unfold full_dal_a_compliance at h
  have ⟨hdal, _⟩ := (Bool.and_eq_true_iff _ _).mp h
  revert hdal
  cases c.comp_dal <;> simp

