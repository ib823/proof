/-- COMPLY_003_15 (matches Coq): Absence of Unintended Function -/
theorem COMPLY_003_15 : ∀ (c : DO178CCompliance),
    no_unintended_functions c.comp_func_analysis = true →
    ∀ func_id, func_id ∈ c.comp_func_analysis.fa_implemented_functions →
    func_id ∈ c.comp_func_analysis.fa_specified_functions := by
  intro c h func_id hin
  unfold no_unintended_functions is_subset at h
  have hall := (List.all_eq_true _ _).mp h func_id hin
  have ⟨x, hx, hbeq⟩ := (List.any_eq_true _ _).mp hall
  have := (Nat.beq_eq_true_iff _ _).mp hbeq
  subst this
  exact hx

/-- COMPLY_003_16 (matches Coq): Robustness to Invalid Inputs -/
theorem COMPLY_003_16 : ∀ (c : DO178CCompliance),
    robustness_verified c.comp_robustness = true →
    c.comp_robustness.rt_all_gracefully_handled = true ∧
    ∀ inv_type, inv_type ∈ c.comp_robustness.rt_invalid_input_types →
    inv_type ∈ c.comp_robustness.rt_tested_invalid_inputs := by
  intro c h
  unfold robustness_verified at h
  have ⟨hsub, hgrace⟩ := (Bool.and_eq_true_iff _ _).mp h
  constructor
  · exact hgrace
  · intro inv_type hin
    unfold is_subset at hsub
    have hall := (List.all_eq_true _ _).mp hsub inv_type hin
    have ⟨x, hx, hbeq⟩ := (List.any_eq_true _ _).mp hall
    have := (Nat.beq_eq_true_iff _ _).mp hbeq
    subst this
    exact hx

/-- COMPLY_003_17 (matches Coq): Deterministic Execution -/
