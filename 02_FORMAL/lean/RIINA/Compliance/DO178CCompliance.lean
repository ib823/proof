/-- COMPLY_003_01 (matches Coq): Requirements Traceability -/
theorem COMPLY_003_01 : ∀ (c : DO178CCompliance),
    all_traces_complete c.comp_traces = true →
    ∀ t, t ∈ c.comp_traces → t.trace_code ≠ [] ∧ t.trace_tests ≠ [] := by
  intro c h t ht
  have hall := (List.all_eq_true trace_complete c.comp_traces).mp h t ht
  unfold trace_complete at hall
  have ⟨h1, h2⟩ := (Bool.and_eq_true_iff _ _).mp hall
  constructor
  · intro hc
    simp [hc] at h1
  · intro hc
    simp [hc] at h2

/-- COMPLY_003_02 (matches Coq): Statement Coverage 100% for DAL A -/
theorem COMPLY_003_02 : ∀ (c : DO178CCompliance),
    c.comp_dal = DAL.DAL_A →
    statement_coverage_100 c.comp_coverage = true →
    c.comp_coverage.cov_covered_statements = c.comp_coverage.cov_total_statements := by
  intro c _ hcov
  unfold statement_coverage_100 at hcov
  have ⟨_, h2⟩ := (Bool.and_eq_true_iff _ _).mp hcov
  exact (Nat.beq_eq_true_iff _ _).mp h2

