    c.comp_determinism.da_no_race_conditions = true ∧
    c.comp_determinism.da_no_undefined_behavior = true := by
  intro c h
  unfold execution_deterministic at h
  have ⟨h1, h2⟩ := (Bool.and_eq_true_iff _ _).mp h
  have ⟨h3, h4⟩ := (Bool.and_eq_true_iff _ _).mp h2
  exact ⟨h1, h3, h4⟩

/-- COMPLY_003_18 (matches Coq): Real-Time Constraints Met -/
theorem COMPLY_003_18 : ∀ (c : DO178CCompliance),
    all_tasks_meet_deadlines c.comp_rt_tasks = true →
