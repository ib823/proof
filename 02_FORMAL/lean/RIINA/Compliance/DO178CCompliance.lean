/-- COMPLY_003_14 (matches Coq): Formal Proof of Safety Properties -/
theorem COMPLY_003_14 : ∀ (c : DO178CCompliance),
    all_safety_properties_proven c.comp_safety_props = true →
    ∀ sp, sp ∈ c.comp_safety_props →
