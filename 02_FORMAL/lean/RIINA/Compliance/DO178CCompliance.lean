  cases a <;> cases b <;> simp

private theorem Bool.or_eq_true_iff (a b : Bool) :
    (a || b) = true ↔ a = true ∨ b = true := by
  cases a <;> cases b <;> simp

private theorem Nat.ble_eq_true_iff (a b : Nat) :
    Nat.ble a b = true ↔ a ≤ b := by
  simp [Nat.ble_eq]

private theorem Nat.beq_eq_true_iff (a b : Nat) :
    Nat.beq a b = true ↔ a = b := by
  simp [Nat.beq_eq]

private theorem List.all_eq_true {α : Type} (f : α → Bool) (xs : List α) :
    xs.all f = true ↔ ∀ x, x ∈ xs → f x = true := by
