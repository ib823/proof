  unfold decision_coverage_100 at hcov
  have ⟨_, h2⟩ := (Bool.and_eq_true_iff _ _).mp hcov
  exact (Nat.beq_eq_true_iff _ _).mp h2

/-- COMPLY_003_04 (matches Coq): MC/DC Coverage 100% for DAL A -/
