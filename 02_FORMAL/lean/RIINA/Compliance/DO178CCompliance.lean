/-- coverage_required (matches Coq: Definition coverage_required) -/
def coverage_required (dal : DAL) (cov : CoverageType) : Bool :=
  match dal, cov with
  | .DAL_A, _ => true
  | .DAL_B, .Statement => true
  | .DAL_B, .Decision => true
  | .DAL_B, .MCDC => true
  | .DAL_C, .Statement => true
  | .DAL_C, .Decision => true
  | .DAL_C, .MCDC => false
  | .DAL_D, .Statement => true
  | .DAL_D, _ => false
  | .DAL_E, _ => false

/-- trace_complete (matches Coq: Definition trace_complete) -/
def trace_complete (t : TraceLink) : Bool :=
  (!(Nat.beq t.trace_code.length 0)) && (!(Nat.beq t.trace_tests.length 0))

/-- all_traces_complete (matches Coq: Definition all_traces_complete) -/
def all_traces_complete (traces : List TraceLink) : Bool :=
  traces.all trace_complete

/-- statement_coverage_100 (matches Coq: Definition statement_coverage_100) -/
def statement_coverage_100 (c : CoverageData) : Bool :=
  (Nat.blt 0 c.cov_total_statements) && (Nat.beq c.cov_covered_statements c.cov_total_statements)

/-- decision_coverage_100 (matches Coq: Definition decision_coverage_100) -/
def decision_coverage_100 (c : CoverageData) : Bool :=
  (Nat.blt 0 c.cov_total_decisions) && (Nat.beq c.cov_covered_decisions c.cov_total_decisions)

/-- mcdc_coverage_100 (matches Coq: Definition mcdc_coverage_100) -/
def mcdc_coverage_100 (c : CoverageData) : Bool :=
  (Nat.blt 0 c.cov_total_conditions) && (Nat.beq c.cov_mcdc_conditions c.cov_total_conditions)

/-- dal_a_coverage_met (matches Coq: Definition dal_a_coverage_met) -/
def dal_a_coverage_met (c : CoverageData) : Bool :=
  (statement_coverage_100 c) && ((decision_coverage_100 c) && (mcdc_coverage_100 c))

/-- is_subset (matches Coq: Definition is_subset) -/
def is_subset (l1 l2 : List Nat) : Bool :=
  l1.all (fun x => l2.any (Nat.beq x))

/-- no_dead_code (matches Coq: Definition no_dead_code) -/
def no_dead_code (ca : CodeAnalysis) : Bool :=
  is_subset ca.ca_all_code (ca.ca_reachable_code ++ ca.ca_deactivated_code)

/-- all_deactivated_documented (matches Coq: Definition all_deactivated_documented) -/
def all_deactivated_documented (ca : CodeAnalysis) : Bool :=
  is_subset ca.ca_deactivated_code ca.ca_deactivated_documented

/-- stack_safe (matches Coq: Definition stack_safe) -/
def stack_safe (s : StackAnalysis) : Bool :=
  Nat.ble s.stack_max_usage s.stack_allocated

/-- all_functions_stack_safe (matches Coq: Definition all_functions_stack_safe) -/
def all_functions_stack_safe (s : StackAnalysis) : Bool :=
  s.stack_per_function.all (fun fu => Nat.ble fu.2 s.stack_allocated)

/-- timing_safe (matches Coq: Definition timing_safe) -/
def timing_safe (t : TimingAnalysis) : Bool :=
  Nat.ble (t.timing_wcet + t.timing_jitter) t.timing_deadline

/-- timing_deterministic (matches Coq: Definition timing_deterministic) -/
def timing_deterministic (t : TimingAnalysis) : Bool :=
  t.timing_bounded_loops && (timing_safe t)

/-- partitions_isolated (matches Coq: Definition partitions_isolated) -/
def partitions_isolated (p1 p2 : Partition) : Bool :=
  (Nat.ble (p1.part_memory_start + p1.part_memory_size) p2.part_memory_start) ||
  (Nat.ble (p2.part_memory_start + p2.part_memory_size) p1.part_memory_start)

/-- all_partitions_isolated (matches Coq: Definition all_partitions_isolated) -/
def all_partitions_isolated (parts : List Partition) : Bool :=
  parts.all (fun p1 => parts.all (fun p2 =>
    (Nat.beq p1.part_id p2.part_id) || (partitions_isolated p1 p2)
  ))

