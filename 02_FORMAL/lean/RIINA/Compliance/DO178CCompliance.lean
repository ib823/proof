/-- COMPLY_003_08 (matches Coq): Timing Determinism -/
theorem COMPLY_003_08 : ∀ (c : DO178CCompliance),
    timing_deterministic c.comp_timing = true →
    c.comp_timing.timing_bounded_loops = true ∧
    c.comp_timing.timing_wcet + c.comp_timing.timing_jitter ≤ c.comp_timing.timing_deadline := by
  intro c h
  unfold timing_deterministic at h
  have ⟨h1, h2⟩ := (Bool.and_eq_true_iff _ _).mp h
  exact ⟨h1, (Nat.ble_eq_true_iff _ _).mp h2⟩

/-- COMPLY_003_09 (matches Coq): Memory Partitioning -/
theorem COMPLY_003_09 : ∀ (c : DO178CCompliance),
    all_partitions_isolated c.comp_partitions = true →
    ∀ p1 p2, p1 ∈ c.comp_partitions → p2 ∈ c.comp_partitions →
    p1.part_id ≠ p2.part_id → partitions_isolated p1 p2 = true := by
  intro c h p1 p2 hin1 hin2 hneq
  unfold all_partitions_isolated at h
  have hall1 := (List.all_eq_true _ _).mp h p1 hin1
  have hall2 := (List.all_eq_true _ _).mp hall1 p2 hin2
  have hor := (Bool.or_eq_true_iff _ _).mp hall2
  cases hor with
  | inl heq =>
    have := (Nat.beq_eq_true_iff _ _).mp heq
    exact absurd this hneq
  | inr hiso => exact hiso

/-- COMPLY_003_10 (matches Coq): Defensive Programming - Input Validation -/
theorem COMPLY_003_10 : ∀ (c : DO178CCompliance),
    all_inputs_validated c.comp_inputs = true →
    ∀ iv, iv ∈ c.comp_inputs →
    iv.iv_range_checked = true ∧ iv.iv_type_checked = true ∧ iv.iv_null_checked = true := by
  intro c h iv hin
  unfold all_inputs_validated at h
  have hiv := (List.all_eq_true _ _).mp h iv hin
  unfold input_fully_validated at hiv
  have ⟨hr, h2⟩ := (Bool.and_eq_true_iff _ _).mp hiv
  have ⟨ht, hn⟩ := (Bool.and_eq_true_iff _ _).mp h2
  exact ⟨hr, ht, hn⟩

/-- COMPLY_003_11 (matches Coq): Exception Handling Completeness -/
theorem COMPLY_003_11 : ∀ (c : DO178CCompliance),
    all_exceptions_handled c.comp_exceptions = true →
    ∀ exc_type, exc_type ∈ c.comp_exceptions.eh_exception_types →
    exc_type ∈ c.comp_exceptions.eh_handled_types := by
  intro c h exc_type hin
  unfold all_exceptions_handled is_subset at h
  have hall := (List.all_eq_true _ _).mp h exc_type hin
  have ⟨x, hx, hbeq⟩ := (List.any_eq_true _ _).mp hall
  have := (Nat.beq_eq_true_iff _ _).mp hbeq
  subst this
  exact hx

