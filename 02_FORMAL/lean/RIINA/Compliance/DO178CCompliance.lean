    c.comp_resources.ru_cpu_usage ≤ c.comp_resources.ru_cpu_limit ∧
    c.comp_resources.ru_memory_usage ≤ c.comp_resources.ru_memory_limit ∧
    c.comp_resources.ru_io_usage ≤ c.comp_resources.ru_io_limit := by
  intro c h
