         (Nat.ble_eq_true_iff _ _).mp hmem,
         (Nat.ble_eq_true_iff _ _).mp hio⟩

/-- COMPLY_003_20 (matches Coq): Configuration Management -/
theorem COMPLY_003_20 : ∀ (c : DO178CCompliance),
    configuration_compliant c.comp_config = true →
    c.comp_config.cm_version_controlled = true ∧
    c.comp_config.cm_baseline_identified = true ∧
    c.comp_config.cm_changes_tracked = true ∧
    c.comp_config.cm_audit_trail = true := by
  intro c h
