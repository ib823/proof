/-- Helper: if (uid, r) is in rest, then existsb finds uid in rest -/
private theorem existsb_mem_uid {uid : Nat} {r : Role} {rest : List (Nat × Role)}
    (hmem : (uid, r) ∈ rest) : existsb (fun p => Nat.beq (fst p) uid) rest = true := by
  simp [existsb]
  induction rest with
  | nil => exact absurd hmem (List.not_mem_nil _)
  | cons hd tl ih =>
    simp [List.any]
    rw [List.mem_cons] at hmem
    cases hmem with
    | inl heq =>
      exact ⟨uid, r, Or.inl heq, by simp [fst, Nat.beq_refl]⟩
    | inr hmem =>
      obtain ⟨a, b, htl, hbeq⟩ := ih hmem
      exact ⟨a, b, Or.inr htl, hbeq⟩

/-- COMPLY_001_13 (matches Coq) -/
theorem COMPLY_001_13 : ∀ (users : List (Nat × Role)) (uid : Nat) (r1 r2 : Role),
    all_unique_ids users = true →
    (uid, r1) ∈ users →
    (uid, r2) ∈ users →
    r1 = r2 := by
  intro users uid r1 r2 hunique hin1 hin2
  induction users with
  | nil => exact absurd hin1 (List.not_mem_nil _)
  | cons hd rest ih =>
    obtain ⟨u, r⟩ := hd
    simp [all_unique_ids, andb, negb] at hunique
    obtain ⟨hnotexist, hrest⟩ := hunique
    rw [List.mem_cons] at hin1 hin2
    cases hin1 with
    | inl h1 =>
      have hr1 : r1 = r := (Prod.mk.inj h1).2
      have hu1 : uid = u := (Prod.mk.inj h1).1
      cases hin2 with
      | inl h2 =>
        have hr2 : r2 = r := (Prod.mk.inj h2).2
        rw [hr1, hr2]
      | inr h2 =>
        exfalso
        have hmem := existsb_mem_uid h2
        rw [← hu1] at hnotexist
        simp [hmem] at hnotexist
    | inr h1 =>
      cases hin2 with
      | inl h2 =>
        exfalso
        have hu2 : uid = u := (Prod.mk.inj h2).1
        have hmem := existsb_mem_uid h1
        rw [← hu2] at hnotexist
        simp [hmem] at hnotexist
      | inr h2 => exact ih hrest h1 h2

