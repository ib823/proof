  | PayNat, PayNat => true
  | PayBool, PayBool => true
  | PayUnit, PayUnit => true
  | PayString, PayString => true
  | _, _ => false

/-- role_eqb (matches Coq: Definition role_eqb) -/
def role_eqb (r1 r2 : Role) : Bool :=
