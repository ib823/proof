/-- chor_circular_wait (matches Coq: Definition chor_circular_wait) -/
def chor_circular_wait (net : Network) : Prop :=
  exists r1 r2, r1 <> r2 /\ chor_waiting net r1 r2 /\ chor_waiting net r2 r1

/-- chor_deadlocked (matches Coq: Definition chor_deadlocked) -/
def chor_deadlocked (net : Network) : Prop :=
  chor_circular_wait net

/-- well_typed_network (matches Coq: Definition well_typed_network) -/
def well_typed_network (net : Network) : Prop :=
  exists g roles, well_formed_global g /\ net = network_of g roles

/-- net_lookup (matches Coq: Definition net_lookup) -/
def net_lookup (net : Network) (r : Role) : Option LocalType :=
  match net with
  | [] => None
  | (r', l) :: rest => if Nat.eqb r r' then Some l else net_lookup rest r

