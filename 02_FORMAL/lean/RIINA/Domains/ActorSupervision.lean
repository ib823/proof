/-- supervisor_can_restart (matches Coq: Definition supervisor_can_restart) -/
def supervisor_can_restart (sup : Supervisor) : Bool :=
  Nat.ltb (sup_restart_count sup) (sup_max_restarts sup)

/-- supervisor_has_capacity (matches Coq: Definition supervisor_has_capacity) -/
def supervisor_has_capacity (sup : Supervisor) : Bool :=
  Nat.ltb (length (sup_children sup)) (sup_max_children sup)

/-- all_children_running (matches Coq: Definition all_children_running) -/
def all_children_running (sup : Supervisor) : Bool :=
  forallb child_running (sup_children sup)

/-- no_children_crashed (matches Coq: Definition no_children_crashed) -/
def no_children_crashed (sup : Supervisor) : Bool :=
  forallb (fun c => negb (child_crashed c)) (sup_children sup)

/-- supervisor_healthy (matches Coq: Definition supervisor_healthy) -/
def supervisor_healthy (sup : Supervisor) : Bool :=
  all_children_running sup &&
  supervisor_can_restart sup

/-- child_in_supervisor (matches Coq: Definition child_in_supervisor) -/
def child_in_supervisor (sup : Supervisor) (cid : Nat) : Bool :=
  existsb (fun c => Nat.eqb (cs_id (ch_spec c)) cid) (sup_children sup)

/-- find_child (matches Coq: Definition find_child) -/
def find_child (children : List ChildState) (cid : Nat) : Option ChildState :=
  match children with
  | [] => None
  | c :: rest => if Nat.eqb (cs_id (ch_spec c)) cid then Some c else find_child rest cid

/-- decide_restart (matches Coq: Definition decide_restart) -/
def decide_restart (strat : RestartStrategy) (can_restart : Bool) : RestartDecision :=
  match strat with
  | OneForOne => RestartChild
  | AllForOne => RestartAll
  | RestForOne => RestartRest

/-- restart_decision_eqb (matches Coq: Definition restart_decision_eqb) -/
def restart_decision_eqb (d1 d2 : RestartDecision) : Bool :=
  match d1, d2 with
  | RestartChild, RestartChild => true
  | RestartAll, RestartAll => true
  | RestartRest, RestartRest => true
  | Escalate, Escalate => true
  | DoNothing, DoNothing => true
  | _, _ => false

/-- apply_one_for_one (matches Coq: Definition apply_one_for_one) -/
def apply_one_for_one (children : List ChildState) (cid : Nat) : List ChildState :=
  map (fun c =>
    if Nat.eqb (cs_id (ch_spec c)) cid && child_crashed c
    then mkChildState (ch_spec c) ChildRunning (ch_restart_count c + 1) 0 (ch_pid c)
    else c
  ) children

/-- apply_all_for_one (matches Coq: Definition apply_all_for_one) -/
def apply_all_for_one (children : List ChildState) : List ChildState :=
  map (fun c =>
    mkChildState (ch_spec c) ChildRunning (ch_restart_count c + 1) 0 (ch_pid c)
  ) children

/-- apply_rest_for_one (matches Coq: Definition apply_rest_for_one) -/
def apply_rest_for_one (children : List ChildState) (cid : Nat) (found : Bool) : List ChildState :=
  match children with
  | [] => []
  | c :: rest => let is_target := Nat.eqb (cs_id (ch_spec c)) cid in
    let should_restart := found || is_target in
    let new_c := if should_restart
                 then mkChildState (ch_spec c) ChildRunning (ch_restart_count c + 1) 0 (ch_pid c)
                 else c in
    new_c :: apply_rest_for_one rest cid (found || is_target)

