/-- AS_105_sup_afo_children_count (matches Coq) -/
theorem AS_105_sup_afo_children_count : length (sup_children riina_supervisor_afo) = 2 := by
  rfl

/-- AS_106_ofo_idempotent_running (matches Coq) -/
theorem AS_106_ofo_idempotent_running : ∀ children cid, ∀b child_running children = true → (∀ c, In c children → cs_id (ch_spec c) ≠ cid) → apply_one_for_one children cid = children := by
  cases ‹_› <;> simp

/-- AS_107_find_child_in (matches Coq) -/
theorem AS_107_find_child_in : ∀ children cid c, find_child children cid = Some c → In c children := by
  cases ‹_› <;> simp

/-- AS_108_find_child_spec (matches Coq) -/
theorem AS_108_find_child_spec : ∀ children cid c, find_child children cid = Some c → cs_id (ch_spec c) = cid := by
  simp_all [Bool.and_eq_true]

/-- AS_109_ofo_does_not_remove_children (matches Coq) -/
theorem AS_109_ofo_does_not_remove_children : ∀ children cid, ∀ c, In c children → ∃ c', In c' (apply_one_for_one children cid) ∧ cs_id (ch_spec c') = cs_id (ch_spec c) := by
  cases ‹_› <;> simp

/-- AS_110_sup_healthy_implies_no_crashed (matches Coq) -/
theorem AS_110_sup_healthy_implies_no_crashed : ∀ sup, supervisor_healthy sup = true → no_children_crashed sup = true := by
  simp_all [Bool.and_eq_true]

end RIINA
