/-- child_needs_restart (matches Coq: Definition child_needs_restart) -/
def child_needs_restart (c : ChildState) : Bool :=
  child_crashed c &&
  negb (child_type_eqb (cs_type (ch_spec c)) Temporary) &&
  Nat.ltb (ch_restart_count c) (cs_max_restarts (ch_spec c))

