/-- is_secret (matches Coq: Definition is_secret) -/
def is_secret (v : DebugValue) : Bool :=
  match v with
  | DVRedacted => true
  | DVPublic _ => false
  | DVStruct fields => existsb (fun p => is_secret (snd p)) fields

/-- redact_secrets (matches Coq: Definition redact_secrets) -/
def redact_secrets (v : DebugValue) (secret_names : List string) : DebugValue :=
  match v with
  | DVPublic s => if existsb (String.eqb s) secret_names then DVRedacted else DVPublic s
  | DVRedacted => DVRedacted
  | DVStruct fields => DVStruct (map (fun '(name, fv) =>
      if existsb (String.eqb name) secret_names 
      then (name, DVRedacted)
      else (name, redact_secrets fv secret_names)) fields)

/-- secrets_redacted (matches Coq: Definition secrets_redacted) -/
def secrets_redacted (original : DebugValue) (output : DebugValue) 
  (secret_names : List string) : Prop :=
  output = redact_secrets original secret_names

