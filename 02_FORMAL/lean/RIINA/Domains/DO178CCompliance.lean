theorem DO178_026_fm_specification : ∀ f : FormalMethods, fm_compliant f = true → f.fm_specification_formal = true := by
  intro f h; unfold fm_compliant at h
  -- first field: 5 band_lefts
  exact band_left (band_left (band_left (band_left (band_left h))))

