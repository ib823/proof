theorem DR_032_rwlock_readers_nonneg :
    ∀ rw : RWLockState, rw.rwlock_readers ≥ 0 := by
  intro _; omega

/-- DR_033_mutex_acquire_release_cycle (matches Coq) -/
theorem DR_033_mutex_acquire_release_cycle :
    ∀ t, ∃ m', mutex_acquire init_mutex t = some m' ∧ mutex_release m' t = some init_mutex := by
  intro t
  exact ⟨⟨true, some t⟩, by simp [mutex_acquire, init_mutex, mutex_release, Nat.beq_refl]⟩

/-- DR_034_access_mode_cases (matches Coq) -/
theorem DR_034_access_mode_cases :
    ∀ m : AccessMode, m = Exclusive ∨ m = Shared ∨ m = NoAccess := by
  intro m
  cases m with
  | Exclusive => exact Or.inl rfl
  | Shared => exact Or.inr (Or.inl rfl)
  | NoAccess => exact Or.inr (Or.inr rfl)

/-- DR_035_no_concurrent_exclusive (matches Coq) -/
theorem DR_035_no_concurrent_exclusive :
    ∀ as_ t1 t2 l, well_formed_access as_ → t1 ≠ t2 → as_ t1 l = some Exclusive → as_ t2 l ≠ some Exclusive := by
  intro as_ t1 t2 l hwf hne h1
  have := hwf t1 t2 l hne h1
  simp [this]

end RIINA.Domains.DataRaceFreedom
