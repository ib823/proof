  forallb tokens_well_formed (macro_templates m)

/-- expand_macro_fuel (matches Coq: Definition expand_macro_fuel) -/
def expand_macro_fuel (fuel : ExpansionFuel) (m : MacroDef) (input : TokenStream) : Option TokenStream :=
  match fuel with
  | 0 => None
  | S fuel' => if macro_well_formed m then
      match macro_templates m with
  | [] => Some input
  | template :: _ => Some template

