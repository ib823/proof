/-- tag_compare_ct (matches Coq: Definition tag_compare_ct) -/
def tag_compare_ct (expected actual : Tag) : TagVerifyResult :=
  if Nat.beq (length expected) (length actual) then
    if forallb (fun p => Nat.beq (fst p) (snd p)) (combine expected actual) then
      .TagValid
    else
      .TagInvalid
  else
    .TagInvalid

