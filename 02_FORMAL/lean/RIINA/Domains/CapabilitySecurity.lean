/-- Helper: Nat.beq is false for unequal values -/
private theorem Nat.beq_false_of_ne {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hab : Nat.beq a b
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true hab) h

/-- Helper: Nat.blt is false when a ≥ b -/
private theorem blt_false_of_ge {a b : Nat} (h : a ≥ b) : Nat.blt a b = false := by
  unfold Nat.blt
  rw [show (Nat.ble (Nat.succ a) b = false) ↔ ¬(Nat.succ a ≤ b) from by
    rw [← Nat.ble_eq]; cases Nat.ble (Nat.succ a) b <;> simp]
  omega

/-- CAP_059_revoke_other_unchanged (matches Coq) -/
theorem CAP_059_revoke_other_unchanged : ∀ rt cap_id1 cap_id2, cap_id1 ≠ cap_id2 → is_revoked (revoke_capability rt cap_id1) cap_id2 = is_revoked rt cap_id2 := by
  intro rt cap_id1 cap_id2 hne
  simp only [is_revoked, revoke_capability, is_revoked_aux]
  rw [Nat.beq_false_of_ne (Ne.symm hne)]
  rfl

