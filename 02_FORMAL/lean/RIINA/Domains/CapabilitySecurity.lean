/-- perm_in_head (matches Coq) -/
theorem perm_in_head : ∀ p : Permission, ∀ ps : PermSet, perm_in p (p :: ps) = true := by
  intro p ps; simp [perm_in, perm_eq, Nat.beq_eq]

/-- perm_in_cons (matches Coq) -/
theorem perm_in_cons : ∀ (p q : Permission) (ps : PermSet), perm_in p ps = true → perm_in p (q :: ps) = true := by
  intro p q ps h
  simp only [perm_in]
  split
  · rfl
  · exact h

/-- forallb_impl (matches Coq) -/
theorem forallb_impl : ∀ (A : Type) (f g : A → Bool) (l : List A),
    (∀ x, f x = true → g x = true) → forallb f l = true → forallb g l = true := by
  intro A f g l hfg
  simp [forallb, List.all_eq_true]
  intro hall x hx
  exact hfg x (hall x hx)

/-- CAP_042_perms_subset_reflexive (matches Coq) -/
theorem CAP_042_perms_subset_reflexive : ∀ ps : PermSet, perms_subset ps ps = true := by
  intro ps
  induction ps with
  | nil => simp [perms_subset, forallb]
  | cons p rest ih =>
    simp only [perms_subset, forallb, List.all_eq_true] at *
    intro x hx
    rcases List.mem_cons.mp hx with rfl | htl
    · exact perm_in_head x rest
    · exact perm_in_cons x p rest (ih x htl)

/-- CAP_043_empty_perms_subset (matches Coq) -/
theorem CAP_043_empty_perms_subset : ∀ ps : PermSet, perms_subset [] ps = true := by
  intro ps; simp [perms_subset, forallb]

/-- CAP_044_derive_from_self (matches Coq) -/
theorem CAP_044_derive_from_self : ∀ mc : MemCapability, mc.mem_sealed = false → derive_mem_cap mc mc = true := by
  intro mc h
  simp only [derive_mem_cap, andb, negb]
  rw [h]
  simp only [Bool.not_false, Bool.and_true]
  have hble : Nat.ble mc.mem_base mc.mem_base = true := by simp [Nat.ble_eq]
  have hble2 : Nat.ble (mc.mem_base + mc.mem_length) (mc.mem_base + mc.mem_length) = true := by simp [Nat.ble_eq]
  rw [hble, hble2]
  simp only [Bool.true_and]
  exact CAP_042_perms_subset_reflexive mc.mem_perms

/-- CAP_045_derive_cannot_exceed_parent (matches Coq) -/
theorem CAP_045_derive_cannot_exceed_parent : ∀ parent child : MemCapability, derive_mem_cap parent child = true → Nat.ble parent.mem_base child.mem_base = true := by
  intro parent child h
