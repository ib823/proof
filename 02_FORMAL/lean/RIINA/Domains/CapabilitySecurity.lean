/-- CAP_099_zero_length_no_access (matches Coq) -/
theorem CAP_099_zero_length_no_access : ∀ base addr, addr ≥ base → mem_bounds_check (mkMemCap base 0 [] false true) addr = false := by
  intro base addr h
  unfold mem_bounds_check andb mkMemCap
  simp only []
  rw [blt_false_of_ge (by omega : addr ≥ base + 0)]; simp

/-- CAP_100_security_complete (matches Coq) -/
theorem CAP_100_security_complete : ∀ c, capability_secure c = true →
    c.cc_cap.cap_unforgeable = true ∧ c.cc_cap.cap_attenuatable = true ∧ c.cc_cap.cap_revocable = true ∧ c.cc_ocap.ocap_no_ambient_authority = true := by
  intro c h
  have hs := CAP_022 _ h
  exact ⟨CAP_011 _ hs, CAP_014 _ hs, CAP_013 _ hs, CAP_026 _ h⟩

end RIINA.Domains.CapabilitySecurity
