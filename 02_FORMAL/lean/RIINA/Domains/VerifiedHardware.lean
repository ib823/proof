theorem PHI_001_12_branch_constant_time : ∀ rs1 rs2 target s1 s2, rtl_public_equiv s1 s2 → cycles (IBranch rs1 rs2 target) = cycles (IBranch rs1 rs2 target) := by sorry

/-- PHI_001_13_memory_constant_time (matches Coq) -/
theorem PHI_001_13_memory_constant_time : ∀ rd rs imm, cycles (ILoad rd rs imm) = 1 ∧ cycles (IStore rd rs imm) = 1 := by sorry

