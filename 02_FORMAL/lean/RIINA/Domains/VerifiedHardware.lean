theorem PHI_001_35_checkpoint_correct : ∀ s, let chk := create_checkpoint s in chk_valid chk = true → rtl_regs (restore_checkpoint s chk) = chk_regs chk ∧ rtl_pc (restore_checkpoint s chk) = chk_pc chk := by sorry

