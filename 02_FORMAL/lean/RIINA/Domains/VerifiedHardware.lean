/-- PHI_001_32_ecc_single_correct (matches Coq) -/
theorem PHI_001_32_ecc_single_correct : ∀ w bit, bit > 0 → bit < 32 → let w_err := inject_single_error w bit in ecc_correct_single w_err = Nat.lxor (ecc_data w_err) (Nat.pow 2 (ecc_syndrome w_err)) := by sorry <;> omega

