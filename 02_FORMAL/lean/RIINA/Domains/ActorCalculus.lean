/-- riina_cap_spawn (matches Coq: Definition riina_cap_spawn) -/
def riina_cap_spawn : ActorCapability := mkActorCap CapSpawn true true 0

/-- riina_cap_send (matches Coq: Definition riina_cap_send) -/
