namespace RIINA

/-- Coq compatibility shim: boolean negation -/
@[inline] def negb (b : Bool) : Bool := !b
/-- Coq compatibility shim: boolean conjunction -/
@[inline] def andb (a b : Bool) : Bool := a && b
/-- Coq compatibility shim: boolean disjunction -/
@[inline] def orb (a b : Bool) : Bool := a || b
/-- Coq compatibility shim: list universal predicate -/
@[inline] def forallb {α : Type} (f : α → Bool) (xs : List α) : Bool := xs.all f
/-- Coq compatibility shim: list existential predicate -/
@[inline] def existsb {α : Type} (f : α → Bool) (xs : List α) : Bool := xs.any f
/-- Coq compatibility shim: list length alias -/
@[inline] def length {α : Type} (xs : List α) : Nat := xs.length
/-- Coq compatibility shim: list head option -/
@[inline] def hd_error {α : Type} (xs : List α) : Option α := xs.head?
/-- Coq compatibility shim: list find option -/
@[inline] def find {α : Type} (p : α → Bool) (xs : List α) : Option α := xs.find? p
/-- Coq compatibility shim: pair first projection -/
@[inline] def fst {α β : Type} (p : α × β) : α := p.1
/-- Coq compatibility shim: pair second projection -/
@[inline] def snd {α β : Type} (p : α × β) : β := p.2

/-- Boolean conjunction iff (matches Coq: andb_true_iff) -/
private theorem andb_true_iff (a b : Bool) :
    (a && b) = true ↔ a = true ∧ b = true := by
  constructor
  · intro h; cases a <;> cases b <;> simp_all
  · intro ⟨ha, hb⟩; simp [ha, hb]

/-- MsgTag (matches Coq: Inductive MsgTag) -/
inductive MsgTag where
  | TagNat : MsgTag
  | TagBool : MsgTag
  | TagUnit : MsgTag
  | TagString : MsgTag
  | TagPair : MsgTag
  | TagActorRef : MsgTag
  deriving DecidableEq, Repr

/-- ActorStatus (matches Coq: Inductive ActorStatus) -/
inductive ActorStatus where
  | Running : ActorStatus
  | Stopped : ActorStatus
  | Crashed : ActorStatus
  | Waiting : ActorStatus
  | Restarting : ActorStatus
  deriving DecidableEq, Repr

/-- ActorSessionType (matches Coq: Inductive ActorSessionType) -/
inductive ActorSessionType where
  | ASTSend : MsgTag → ActorSessionType → ActorSessionType
  | ASTRecv : MsgTag → ActorSessionType → ActorSessionType
  | ASTSelect : List (Nat * ActorSessionType) → ActorSessionType
  | ASTOffer : List (Nat * ActorSessionType) → ActorSessionType
  | ASTEnd : ActorSessionType
  deriving DecidableEq, Repr

/-- CapKind (matches Coq: Inductive CapKind) -/
inductive CapKind where
  | CapSpawn : CapKind
  | CapSend : CapKind
  | CapRecv : CapKind
  | CapMonitor : CapKind
  | CapLink : CapKind
  | CapSupervise : CapKind
  deriving DecidableEq, Repr

/-- Message (matches Coq: Record Message) -/
structure Message where
  msg_tag : MsgTag
  msg_payload : Nat
  msg_sender : Nat
  msg_priority : Nat
  deriving DecidableEq, Repr
/-- Coq constructor alias for Message. -/
abbrev mkMsg := Message.mk

/-- ActorState (matches Coq: Record ActorState) -/
structure ActorState where
  actor_id : Nat
  actor_status : ActorStatus
  actor_mailbox : Mailbox
  actor_local : Nat
  actor_msg_count : Nat
  actor_spawn_count : Nat
  actor_max_mailbox : Nat
  actor_restart_count : Nat
  deriving DecidableEq, Repr
/-- Coq constructor alias for ActorState. -/
abbrev mkActor := ActorState.mk

/-- ActorChannel (matches Coq: Record ActorChannel) -/
structure ActorChannel where
  achan_id : Nat
  achan_session : ActorSessionType
  achan_linear : Bool
  achan_active : Bool
  deriving DecidableEq, Repr
/-- Coq constructor alias for ActorChannel. -/
abbrev mkActorChan := ActorChannel.mk

/-- ActorChannelPair (matches Coq: Record ActorChannelPair) -/
structure ActorChannelPair where
  achan_endpoint_a : ActorChannel
  achan_endpoint_b : ActorChannel
  deriving DecidableEq, Repr
/-- Coq constructor alias for ActorChannelPair. -/
abbrev mkActorChanPair := ActorChannelPair.mk

/-- ActorCapability (matches Coq: Record ActorCapability) -/
structure ActorCapability where
  acap_kind : CapKind
  acap_granted : Bool
  acap_revocable : Bool
  acap_target : Nat
  deriving DecidableEq, Repr
/-- Coq constructor alias for ActorCapability. -/
abbrev mkActorCap := ActorCapability.mk

/-- TypedActor (matches Coq: Record TypedActor) -/
structure TypedActor where
  ta_state : ActorState
  ta_expected : List
  ta_session : Option
  ta_caps : List
  ta_isolated : Bool
  deriving DecidableEq, Repr
/-- Coq constructor alias for TypedActor. -/
abbrev mkTypedActor := TypedActor.mk

/-- msg_tag_eqb (matches Coq: Definition msg_tag_eqb) -/
def msg_tag_eqb (t1 t2 : MsgTag) : Bool :=
  match t1, t2 with
  | TagNat, TagNat => true
  | TagBool, TagBool => true
  | TagUnit, TagUnit => true
  | TagString, TagString => true
  | TagPair, TagPair => true
  | TagActorRef, TagActorRef => true
  | _, _ => false

/-- status_eqb (matches Coq: Definition status_eqb) -/
def status_eqb (s1 s2 : ActorStatus) : Bool :=
  match s1, s2 with
  | Running, Running => true
  | Stopped, Stopped => true
  | Crashed, Crashed => true
  | Waiting, Waiting => true
  | Restarting, Restarting => true
  | _, _ => false

/-- is_running (matches Coq: Definition is_running) -/
def is_running (a : ActorState) : Bool :=
  status_eqb (actor_status a) Running

/-- is_stopped (matches Coq: Definition is_stopped) -/
def is_stopped (a : ActorState) : Bool :=
  status_eqb (actor_status a) Stopped

/-- is_crashed (matches Coq: Definition is_crashed) -/
def is_crashed (a : ActorState) : Bool :=
  status_eqb (actor_status a) Crashed

/-- is_waiting (matches Coq: Definition is_waiting) -/
def is_waiting (a : ActorState) : Bool :=
  status_eqb (actor_status a) Waiting

/-- is_restarting (matches Coq: Definition is_restarting) -/
def is_restarting (a : ActorState) : Bool :=
  status_eqb (actor_status a) Restarting

/-- has_messages (matches Coq: Definition has_messages) -/
def has_messages (a : ActorState) : Bool :=
  negb (Nat.eqb (length (actor_mailbox a)) 0)

/-- mailbox_empty (matches Coq: Definition mailbox_empty) -/
def mailbox_empty (a : ActorState) : Bool :=
  Nat.eqb (length (actor_mailbox a)) 0

/-- mailbox_full (matches Coq: Definition mailbox_full) -/
def mailbox_full (a : ActorState) : Bool :=
  Nat.leb (actor_max_mailbox a) (length (actor_mailbox a))

/-- can_receive (matches Coq: Definition can_receive) -/
def can_receive (a : ActorState) : Bool :=
  is_running a && negb (mailbox_full a)

/-- ast_dual (matches Coq: Definition ast_dual) -/
axiom ast_dual (s : ActorSessionType) : ActorSessionType -- fallback: unresolved match translation

/-- achan_fresh (matches Coq: Definition achan_fresh) -/
def achan_fresh (ch : ActorChannel) : Bool :=
  achan_linear ch && achan_active ch

/-- achan_used (matches Coq: Definition achan_used) -/
def achan_used (ch : ActorChannel) : ActorChannel := mkActorChan (achan_id ch) (achan_session ch) false (achan_active ch)

/-- achan_close (matches Coq: Definition achan_close) -/
def achan_close (ch : ActorChannel) : ActorChannel := mkActorChan (achan_id ch) ASTEnd false false

/-- cap_kind_eqb (matches Coq: Definition cap_kind_eqb) -/
def cap_kind_eqb (k1 k2 : CapKind) : Bool :=
  match k1, k2 with
  | CapSpawn, CapSpawn => true

/-- acap_active (matches Coq: Definition acap_active) -/
def acap_active (c : ActorCapability) : Bool :=
  acap_granted c

/-- has_cap_kind (matches Coq: Definition has_cap_kind) -/
def has_cap_kind (caps : List ActorCapability) (k : CapKind) : Bool :=
  existsb (fun c => cap_kind_eqb (acap_kind c) k && acap_granted c) caps

/-- can_spawn (matches Coq: Definition can_spawn) -/
def can_spawn (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapSpawn

/-- can_send_cap (matches Coq: Definition can_send_cap) -/
def can_send_cap (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapSend

/-- can_recv_cap (matches Coq: Definition can_recv_cap) -/
def can_recv_cap (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapRecv

/-- can_monitor (matches Coq: Definition can_monitor) -/
def can_monitor (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapMonitor

/-- can_link (matches Coq: Definition can_link) -/
def can_link (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapLink

/-- can_supervise (matches Coq: Definition can_supervise) -/
def can_supervise (caps : List ActorCapability) : Bool :=
  has_cap_kind caps CapSupervise

/-- msg_type_compatible (matches Coq: Definition msg_type_compatible) -/
def msg_type_compatible (m : Message) (expected : List MsgTag) : Bool :=
  existsb (msg_tag_eqb (msg_tag m)) expected

/-- mailbox_well_typed (matches Coq: Definition mailbox_well_typed) -/
def mailbox_well_typed (mb : Mailbox) (expected : List MsgTag) : Bool :=
  forallb (fun m => msg_type_compatible m expected) mb

/-- actor_well_typed (matches Coq: Definition actor_well_typed) -/
def actor_well_typed (ta : TypedActor) : Bool :=
  mailbox_well_typed (actor_mailbox (ta_state ta)) (ta_expected ta) &&
  is_running (ta_state ta) &&
  ta_isolated ta

/-- find_actor (matches Coq: Definition find_actor) -/
def find_actor (cfg : ActorConfig) (aid : Nat) : Option ActorState :=
  match cfg with
  | [] => None
  | a :: rest => if Nat.eqb (actor_id a) aid then Some a else find_actor rest aid

/-- config_all_running (matches Coq: Definition config_all_running) -/
def config_all_running (cfg : ActorConfig) : Bool :=
  forallb is_running cfg

/-- config_no_crashed (matches Coq: Definition config_no_crashed) -/
def config_no_crashed (cfg : ActorConfig) : Bool :=
  forallb (fun a => negb (is_crashed a)) cfg

/-- config_all_isolated (matches Coq: Definition config_all_isolated) -/
def config_all_isolated (cfg : ActorConfig) : Bool :=
  forallb (fun a => Nat.eqb (actor_local a) (actor_id a)) cfg

/-- config_no_full_mailboxes (matches Coq: Definition config_no_full_mailboxes) -/
def config_no_full_mailboxes (cfg : ActorConfig) : Bool :=
  forallb (fun a => negb (mailbox_full a)) cfg

/-- config_size (matches Coq: Definition config_size) -/
def config_size (cfg : ActorConfig) : Nat :=
  length cfg

/-- total_messages (matches Coq: Definition total_messages) -/
def total_messages (cfg : ActorConfig) : Nat :=
  fold_left (fun acc a => acc + length (actor_mailbox a)) cfg 0

/-- deliver_message (matches Coq: Definition deliver_message) -/
def deliver_message (cfg : ActorConfig) (target : Nat) (m : Message) : ActorConfig :=
  map (fun a =>
    if Nat.eqb (actor_id a) target
    then mkActor (actor_id a) (actor_status a) (actor_mailbox a ++ [m])
                 (actor_local a) (actor_msg_count a + 1) (actor_spawn_count a)
                 (actor_max_mailbox a) (actor_restart_count a)
    else a
  ) cfg

/-- spawn_actor (matches Coq: Definition spawn_actor) -/
def spawn_actor (cfg : ActorConfig) (new_id : Nat) : ActorConfig :=
  cfg ++ [mkActor new_id Running [] 0 0 0 100 0]

/-- crash_actor (matches Coq: Definition crash_actor) -/
def crash_actor (cfg : ActorConfig) (aid : Nat) : ActorConfig :=
  map (fun a =>
    if Nat.eqb (actor_id a) aid
    then mkActor (actor_id a) Crashed (actor_mailbox a)
                 (actor_local a) (actor_msg_count a) (actor_spawn_count a)
                 (actor_max_mailbox a) (actor_restart_count a)
    else a
  ) cfg

/-- restart_actor (matches Coq: Definition restart_actor) -/
def restart_actor (cfg : ActorConfig) (aid : Nat) : ActorConfig :=
  map (fun a =>
    if Nat.eqb (actor_id a) aid
    then mkActor (actor_id a) Running []
                 (actor_local a) 0 0
                 (actor_max_mailbox a) (actor_restart_count a + 1)
    else a
  ) cfg

