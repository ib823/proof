/-- visibility_eqb (matches Coq: Definition visibility_eqb) -/
def visibility_eqb (v1 v2 : Visibility) : Bool :=
  match v1, v2 with
  | VPrivate, VPrivate => true
  | VCrate, VCrate => true
  | VPublic, VPublic => true
  | VSecurityLevel n, VSecurityLevel m => Nat.eqb n m
  | _, _ => false

/-- vis_accessible (matches Coq: Definition vis_accessible) -/
def vis_accessible (caller callee : Visibility) : Bool :=
  match callee with
  | VPublic => true
  | VPrivate => false
  | VCrate => true
  | VSecurityLevel n => match caller with
  | VSecurityLevel m => Nat.leb n m
  | _ => false

