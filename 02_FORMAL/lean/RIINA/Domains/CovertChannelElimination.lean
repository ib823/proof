    ∀ (high_data : LabeledData Nat) (low_dest : IFCLabel),
    high_data.data_label.label_level > low_dest.label_level →
    can_flow high_data.data_label low_dest = false := by
  intro high_data low_dest hgt
  unfold can_flow
  cases h : Nat.ble high_data.data_label.label_level low_dest.label_level with
  | true =>
    exfalso
    have := Nat.le_of_ble_eq_true h
    omega
  | false => rfl

