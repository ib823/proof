-- THEOREM TYPE_005_14: Decidable equality reflection
-- Dec (x = y) for types with decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

/-- Decidability type (matches Coq: Inductive Dec) -/
inductive DDec (P : Prop) : Type where
  | Yes : P → DDec P
  | No : (P → False) → DDec P

def TYPE_005_14 :
    ∀ (A : Type),
      (∀ x y : A, x = y ∨ x ≠ y) →
      ∀ (x y : A), Decidable (x = y) → DDec (x = y) := by
  intro A _ x y hdec
  match hdec with
  | isTrue h => exact DDec.Yes h
  | isFalse h => exact DDec.No h

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_eq_nat: Nat has decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

def dec_eq_nat : ∀ (x y : Nat), DDec (x = y) := by
  intro x y
  match decEq x y with
  | isTrue h => exact DDec.Yes h
  | isFalse h => exact DDec.No h

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_eq_bool: Bool has decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

def dec_eq_bool : ∀ (x y : Bool), DDec (x = y) := by
  intro x y
  match decEq x y with
  | isTrue h => exact DDec.Yes h
  | isFalse h => exact DDec.No h

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_eq_prod: Product preserves decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

def dec_eq_prod :
    ∀ (A B : Type),
      (∀ x y : A, DDec (x = y)) →
      (∀ x y : B, DDec (x = y)) →
      ∀ (p1 p2 : A × B), DDec (p1 = p2) := by
  intro A B hA hB p1 p2
  match hA p1.1 p2.1, hB p1.2 p2.2 with
  | DDec.Yes ha, DDec.Yes hb =>
    exact DDec.Yes (by cases p1; cases p2; simp at *; exact ⟨ha, hb⟩)
  | DDec.Yes _, DDec.No hb =>
    exact DDec.No (fun h => hb (by cases p1; cases p2; simp at *; exact h.2))
  | DDec.No ha, _ =>
    exact DDec.No (fun h => ha (by cases p1; cases p2; simp at *; exact h.1))

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_eq_option: Option preserves decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

def dec_eq_option :
    ∀ (A : Type),
      (∀ x y : A, DDec (x = y)) →
      ∀ (o1 o2 : Option A), DDec (o1 = o2) := by
  intro A hA o1 o2
  match o1, o2 with
  | some a1, some a2 =>
    match hA a1 a2 with
    | DDec.Yes h => exact DDec.Yes (by rw [h])
    | DDec.No h => exact DDec.No (fun heq => h (by injection heq))
  | some _, none => exact DDec.No (fun h => by injection h)
  | none, some _ => exact DDec.No (fun h => by injection h)
  | none, none => exact DDec.Yes rfl

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_eq_list: List preserves decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

noncomputable def dec_eq_list :
    ∀ (A : Type),
      (∀ x y : A, DDec (x = y)) →
      ∀ (l1 l2 : List A), DDec (l1 = l2) :=
  fun A hA => let rec go : (l1 l2 : List A) → DDec (l1 = l2)
    | [], [] => DDec.Yes rfl
    | [], _ :: _ => DDec.No (fun h => List.noConfusion h)
    | _ :: _, [] => DDec.No (fun h => List.noConfusion h)
    | h1 :: t1, h2 :: t2 =>
      match hA h1 h2, go t1 t2 with
      | DDec.Yes hh, DDec.Yes ht => DDec.Yes (by rw [hh, ht])
      | DDec.Yes _, DDec.No ht =>
        DDec.No (fun h => ht (List.noConfusion h (fun _ ht' => ht')))
      | DDec.No hh, _ =>
        DDec.No (fun h => hh (List.noConfusion h (fun hh' _ => hh')))
  go

-- ═══════════════════════════════════════════════════════════════════════════
-- dec_to_bool: Decidability implies boolean decision procedure
-- ═══════════════════════════════════════════════════════════════════════════

theorem dec_to_bool : ∀ (P : Prop), DDec P → P ∨ ¬P := by
  intro P h
  match h with
  | DDec.Yes hp => exact Or.inl hp
  | DDec.No hnp => exact Or.inr hnp

-- ═══════════════════════════════════════════════════════════════════════════
-- nat_eq_reflect: Boolean equality reflects propositional equality for nat
-- ═══════════════════════════════════════════════════════════════════════════

theorem nat_eq_reflect : ∀ (x y : Nat), Nat.beq x y = true ↔ x = y := by
  intro x y
  constructor
  · intro h; exact Nat.eq_of_beq_eq_true h
  · intro h; subst h; exact Nat.beq_refl x

-- ═══════════════════════════════════════════════════════════════════════════
-- uip_dec: UIP for types with decidable equality
-- ═══════════════════════════════════════════════════════════════════════════

theorem uip_dec (A : Type) [DecidableEq A] :
    ∀ (x : A) (p : x = x), p = rfl := by
  intro x p
  exact proof_irrel p rfl

end RIINA.Domains.DependentTypes
