-- THEOREM TYPE_005_11: Transport along equality
-- transport : (P : A → Type) → x = y → P x → P y
-- ═══════════════════════════════════════════════════════════════════════════

/-- Transport along equality (matches Coq: Definition transport) -/
def transport {A : Type} (P : A → Type) {x y : A} (eq : x = y) (px : P x) : P y :=
  eq ▸ px

theorem TYPE_005_11 :
    ∀ (A : Type) (P : A → Type) (x y : A) (eq : x = y) (px : P x),
      ∃ (py : P y), py = transport P eq px := by
  intro A P x y eq px
  exact ⟨transport P eq px, rfl⟩

-- ═══════════════════════════════════════════════════════════════════════════
-- transport_refl: Transport preserves identity
-- ═══════════════════════════════════════════════════════════════════════════

theorem transport_refl :
    ∀ (A : Type) (P : A → Type) (x : A) (px : P x),
      transport P rfl px = px := by
  intro A P x px
  rfl

-- ═══════════════════════════════════════════════════════════════════════════
-- transport_trans: Transport composition
-- ═══════════════════════════════════════════════════════════════════════════

theorem transport_trans :
    ∀ (A : Type) (P : A → Type) (x y z : A) (eq1 : x = y) (eq2 : y = z) (px : P x),
      transport P eq2 (transport P eq1 px) = transport P (eq1.trans eq2) px := by
  intro A P x y z eq1 eq2 px
  subst eq1; subst eq2
  rfl

