-- vec_dep_pattern_match: Vector-based dependent pattern matching
-- ═══════════════════════════════════════════════════════════════════════════

/-- Dependent eliminator for Vec -/
def Vec.rect {A : Type} {P : ∀ n, Vec A n → Type}
    (base : P 0 Vec.nil)
    (step : ∀ (h : A) (n : Nat) (t : Vec A n), P n t → P (n + 1) (Vec.cons h t))
    : ∀ (n : Nat) (v : Vec A n), P n v
  | 0, Vec.nil => base
  | n + 1, Vec.cons h t => step h n t (Vec.rect base step n t)

theorem vec_dep_pattern_match :
    ∀ (A : Type) (P : ∀ n, Vec A n → Type)
      (base : P 0 (Vec.nil))
      (step : ∀ h n t, P n t → P (n + 1) (Vec.cons h t))
      (n : Nat) (v : Vec A n),
      ∃ (result : P n v),
        result = Vec.rect base (fun h n t ih => step h n t ih) n v := by
  intro A P base step n v
  exact ⟨Vec.rect base (fun h n t ih => step h n t ih) n v, rfl⟩

