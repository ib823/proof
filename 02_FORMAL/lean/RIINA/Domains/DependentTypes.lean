-- THEOREM TYPE_005_10: Dependent pattern matching
-- Π elimination with motive — dependent elimination preserves types
-- ═══════════════════════════════════════════════════════════════════════════

/-- Motive for dependent elimination on natural numbers -/
abbrev nat_motive := Nat → Type

/-- Dependent eliminator for nat -/
def nat_rect_dep (P : nat_motive) (base : P 0) (step : ∀ n, P n → P (n + 1)) : ∀ n, P n
  | 0 => base
  | n + 1 => step n (nat_rect_dep P base step n)

theorem TYPE_005_10 :
    ∀ (P : nat_motive) (base : P 0) (step : ∀ n, P n → P (n + 1)) (m : Nat),
      ∃ (result : P m), result = nat_rect_dep P base step m := by
  intro P base step m
  exact ⟨nat_rect_dep P base step m, rfl⟩

