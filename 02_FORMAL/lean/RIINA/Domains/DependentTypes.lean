-- dep_congruence: Dependent congruence
-- ═══════════════════════════════════════════════════════════════════════════

theorem dep_congruence :
    ∀ (A : Type) (B : A → Type) (f : ∀ a, B a) (x y : A) (eq : x = y),
      transport B eq (f x) = f y := by
  intro A B f x y eq
  subst eq
  rfl

-- ═══════════════════════════════════════════════════════════════════════════
-- congruence2: Congruence for binary functions
-- ═══════════════════════════════════════════════════════════════════════════

theorem congruence2 :
    ∀ (A B C : Type) (f : A → B → C) (x1 x2 : A) (y1 y2 : B),
      x1 = x2 → y1 = y2 → f x1 y1 = f x2 y2 := by
  intro A B C f x1 x2 y1 y2 hx hy
  subst hx; subst hy
  rfl

-- ═══════════════════════════════════════════════════════════════════════════
-- lt_wf_aux: Less-than on nat is well-founded (auxiliary)
-- ═══════════════════════════════════════════════════════════════════════════

theorem lt_wf_aux : ∀ (n m : Nat), m < n → Acc Nat.lt m := by
  intro n
  induction n with
  | zero => intro m hm; exact absurd hm (Nat.not_lt_zero m)
  | succ n ih =>
    intro m hm
    exact Acc.intro m (fun y hy => ih y (Nat.lt_of_lt_of_le hy (Nat.lt_succ_iff.mp hm)))

-- ═══════════════════════════════════════════════════════════════════════════
-- lt_well_founded: Less-than on nat is well-founded
-- ═══════════════════════════════════════════════════════════════════════════

theorem lt_well_founded : WellFounded (α := Nat) Nat.lt := by
  exact ⟨fun n => lt_wf_aux (n + 1) n (Nat.lt_succ_of_le (Nat.le_refl n))⟩

