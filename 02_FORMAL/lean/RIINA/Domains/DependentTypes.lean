-- THEOREM TYPE_005_13: Dependent induction principle
-- Well-founded recursion with dependent types
-- ═══════════════════════════════════════════════════════════════════════════

noncomputable def TYPE_005_13 :
    ∀ (A : Type) (R : A → A → Prop) (P : A → Type),
      WellFounded R →
      (∀ x, (∀ y, R y x → P y) → P x) →
      ∀ x, P x := by
  intro A R P hwf hstep x
  have : Acc R x := hwf.apply x
  induction this with
  | intro x' _ ih =>
    exact hstep x' (fun y hy => ih y hy)

-- ═══════════════════════════════════════════════════════════════════════════
-- nat_dep_ind: Dependent induction on nat
-- ═══════════════════════════════════════════════════════════════════════════

def nat_dep_ind :
    ∀ (P : Nat → Type),
      P 0 →
      (∀ n, P n → P (n + 1)) →
      ∀ n, P n := by
  intro P h0 hs n
  induction n with
  | zero => exact h0
  | succ n ih => exact hs n ih

-- ═══════════════════════════════════════════════════════════════════════════
-- strong_ind: Strong induction principle
-- ═══════════════════════════════════════════════════════════════════════════

theorem strong_ind :
    ∀ (P : Nat → Prop),
      (∀ n, (∀ m, m < n → P m) → P n) →
      ∀ n, P n := by
  intro P h n
  suffices haux : ∀ m, m ≤ n → P m by
    exact haux n (Nat.le_refl n)
  induction n with
  | zero =>
    intro m hm
    have : m = 0 := Nat.le_zero.mp hm
    subst this
    exact h 0 (fun k hk => absurd hk (Nat.not_lt_zero k))
  | succ n ih =>
    intro m hm
    rcases Nat.lt_or_eq_of_le hm with hlt | heq
    · exact ih m (Nat.lt_succ_iff.mp hlt)
    · subst heq
      exact h (n + 1) (fun k hk => ih k (Nat.lt_succ_iff.mp hk))

