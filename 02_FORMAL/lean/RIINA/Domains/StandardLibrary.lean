/-- verify_timestamp (matches Coq: Definition verify_timestamp) -/
def verify_timestamp (ts : SecureTimestamp) (expected_sig : Nat) : Bool :=
  andb (st_signed ts) (Nat.eqb (st_signature ts) expected_sig)

