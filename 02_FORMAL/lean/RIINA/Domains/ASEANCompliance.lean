namespace RIINA.Domains.ASEANCompliance

-- Jurisdiction model: natural numbers
-- 0 = Malaysia, 1 = Singapore, 2 = Indonesia, 3 = Thailand,
-- 4 = Philippines, 5 = Vietnam, 6 = Brunei, 7 = Cambodia,
-- 8 = Laos, 9 = Myanmar
abbrev jurisdiction := Nat

/-- A data item tagged with its home jurisdiction -/
structure DataItem where
  data_id : Nat
  data_jurisdiction : jurisdiction
  data_classification : Nat  -- 0=public, 1=internal, 2=confidential, 3=restricted
  deriving DecidableEq, Repr

/-- An authorization for cross-border transfer -/
structure Authorization where
  auth_from : jurisdiction
  auth_to : jurisdiction
  auth_min_classification : Nat
  deriving DecidableEq, Repr

/-- A transfer log entry -/
structure TransferEntry where
  te_data_id : Nat
  te_from : jurisdiction
  te_to : jurisdiction
  deriving DecidableEq, Repr

abbrev Agreements := List Authorization
abbrev AuditTrail := List TransferEntry

/-- DataLocalization (matches Coq: Inductive DataLocalization) -/
inductive DataLocalization where
  | LocalOnly : DataLocalization
  | RegionalASEAN : DataLocalization
  | GlobalAllowed : DataLocalization
  deriving DecidableEq, Repr

open DataLocalization

/-- ASEANDataPolicy record -/
structure ASEANDataPolicy where
  adp_jurisdiction : jurisdiction
  adp_localization : DataLocalization
  adp_adequacy_recognized : List jurisdiction
  adp_consent_required : Bool
  adp_breach_notification_hours : Nat
  adp_dpo_required : Bool
  deriving DecidableEq, Repr

/-- Cross-Border Data Flow record -/
structure CBDataFlow where
  cbf_data : DataItem
  cbf_source_policy : ASEANDataPolicy
  cbf_target_jurisdiction : jurisdiction
  cbf_consent_obtained : Bool
  cbf_safeguards_in_place : Bool
  deriving Repr

/-- Model Contractual Clause record -/
structure ModelContractualClause where
  mcc_id : Nat
  mcc_from_jurisdiction : jurisdiction
  mcc_to_jurisdiction : jurisdiction
  mcc_data_protection_standard : Nat  -- 0-3: increasing strictness
  mcc_audit_rights : Bool
  mcc_termination_clause : Bool
  deriving DecidableEq, Repr

-- Helper: construct a TransferEntry (matches Coq mkTransfer)
private def mkTransfer (did src dst : Nat) : TransferEntry :=
  { te_data_id := did, te_from := src, te_to := dst }

/-- auth_covers (matches Coq: Definition auth_covers) -/
def auth_covers (a : Authorization) (src dst : jurisdiction) (cls : Nat) : Prop :=
  a.auth_from = src ∧ a.auth_to = dst ∧ cls ≤ a.auth_min_classification

/-- authorized (matches Coq: Definition authorized) -/
def authorized (agreements : Agreements) (src dst : jurisdiction) (cls : Nat) : Prop :=
  ∃ a, a ∈ agreements ∧ auth_covers a src dst cls

/-- transfer_logged (matches Coq: Definition transfer_logged) -/
def transfer_logged (trail : AuditTrail) (did src dst : Nat) : Prop :=
  mkTransfer did src dst ∈ trail

/-- policy_stricter (matches Coq: Definition policy_stricter) -/
def policy_stricter (p1 p2 : Nat) : Prop :=
  p1 ≤ p2

/-- jurisdiction_leq (matches Coq: Definition jurisdiction_leq) -/
def jurisdiction_leq (j1 j2 : jurisdiction) : Prop :=
  j1 ≤ j2

/-- data_resident (matches Coq: Definition data_resident) -/
def data_resident (d : DataItem) (loc : jurisdiction) : Prop :=
  d.data_jurisdiction = loc

/-- well_formed_transfer (matches Coq: Definition well_formed_transfer) -/
def well_formed_transfer (agreements : Agreements) (trail : AuditTrail)
  (d : DataItem) (target : jurisdiction) : Prop :=
  d.data_jurisdiction ≠ target →
  transfer_logged trail d.data_id d.data_jurisdiction target →
  authorized agreements d.data_jurisdiction target d.data_classification

/-- compliant_op (matches Coq: Definition compliant_op) -/
def compliant_op (agreements : Agreements) (src dst : jurisdiction) (cls : Nat) : Prop :=
  src = dst ∨ authorized agreements src dst cls

/-- log_transfer (matches Coq: Definition log_transfer) -/
def log_transfer (trail : AuditTrail) (did src dst : Nat) : AuditTrail :=
  mkTransfer did src dst :: trail

/-- policy_allows (matches Coq: Definition policy_allows) -/
def policy_allows (threshold : Nat) (cls : Nat) : Prop :=
  cls ≤ threshold

/-- localization_permits_transfer (matches Coq: Definition localization_permits_transfer) -/
def localization_permits_transfer (loc : DataLocalization) (src dst : jurisdiction) : Prop :=
  match loc with
  | LocalOnly => src = dst
  | RegionalASEAN => src ≤ 9 ∧ dst ≤ 9
  | GlobalAllowed => True

/-- adequacy_recognized (matches Coq: Definition adequacy_recognized) -/
def adequacy_recognized (policy : ASEANDataPolicy) (target : jurisdiction) : Prop :=
  target ∈ policy.adp_adequacy_recognized

/-- cbf_compliant (matches Coq: Definition cbf_compliant) -/
def cbf_compliant (flow : CBDataFlow) : Prop :=
  (flow.cbf_source_policy.adp_consent_required = true →
   flow.cbf_consent_obtained = true) ∧
  localization_permits_transfer
    flow.cbf_source_policy.adp_localization
    flow.cbf_data.data_jurisdiction
    flow.cbf_target_jurisdiction ∧
  (flow.cbf_safeguards_in_place = true)

/-- breach_notification_compliant (matches Coq: Definition breach_notification_compliant) -/
def breach_notification_compliant (policy : ASEANDataPolicy) (detected_at notified_at : Nat) : Prop :=
  notified_at ≤ detected_at + policy.adp_breach_notification_hours

/-- mcc_adequate (matches Coq: Definition mcc_adequate) -/
def mcc_adequate (mcc : ModelContractualClause) (min_standard : Nat) : Prop :=
  mcc.mcc_data_protection_standard ≥ min_standard ∧
  mcc.mcc_audit_rights = true ∧
  mcc.mcc_termination_clause = true

/-- mutual_recognition (matches Coq: Definition mutual_recognition) -/
def mutual_recognition (j1 j2 : jurisdiction) (agreements : Agreements) : Prop :=
  authorized agreements j1 j2 0 ∧ authorized agreements j2 j1 0

/-- all_localizations (matches Coq: Definition all_localizations) -/
def all_localizations : List DataLocalization :=
  [LocalOnly, RegionalASEAN, GlobalAllowed]

/-- dpo_requirement_met (matches Coq: Definition dpo_requirement_met) -/
def dpo_requirement_met (policy : ASEANDataPolicy) (dpo_appointed : Bool) : Prop :=
  policy.adp_dpo_required = true → dpo_appointed = true

