-- Helper lemma: Bool.and_eq_true decomposition
private theorem band_true {a b : Bool} (h : (a && b) = true) : a = true ∧ b = true := by
  simp [Bool.and_eq_true] at h; exact h

/-- fut_001_quantum_shor_mitigated (matches Coq) -/
theorem fut_001_quantum_shor_mitigated :
    ∀ (classical : ClassicalCrypto) (pq : PQCryptoConfig),
    vulnerable_to_shor classical = true →
    pq_config_secure pq = true →
    Nat.ble 3 (kem_security_level pq.pqc_kem) = true := by
  intro _ pq _ h
  unfold pq_config_secure at h
  have ⟨h1, _⟩ := band_true h
  have ⟨h2, _⟩ := band_true h1
  exact h2

