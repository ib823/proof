  match sig with
  | .ML_DSA_44 => 2
  | .ML_DSA_65 => 3
  | .ML_DSA_87 => 5
  | .SLH_DSA_128f => 1
  | .SLH_DSA_192f => 3
  | .SLH_DSA_256f => 5

