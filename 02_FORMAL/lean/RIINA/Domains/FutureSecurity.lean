    ∀ (did : DefenseInDepth),
    did_robust did = true →
    Nat.ble 3 did.did_layers.length = true ∧
    Nat.ble 2 (count_verified_layers did.did_layers) = true ∧
    did.did_composition_verified = true := by
  intro did h
  unfold did_robust at h
  have ⟨h1, h4⟩ := band_true h
  have ⟨h2, h3⟩ := band_true h1
  have ⟨h5, h6⟩ := band_true h2
  exact ⟨h5, h6, h3⟩

/-- fut_003_verified_layer_guarantee (matches Coq) -/
theorem fut_003_verified_layer_guarantee :
    ∀ (layers : List SecurityLayer),
    count_verified_layers layers ≥ 1 →
    ∃ l, l ∈ layers ∧ l.sl_verified = true := by
  intro layers h
  induction layers with
  | nil => simp [count_verified_layers] at h
  | cons l rest ih =>
    simp [count_verified_layers] at h
    by_cases hv : l.sl_verified = true
    · exact ⟨l, List.mem_cons_self l rest, hv⟩
    · simp [hv] at h
      have ⟨l', hl', hv'⟩ := ih (by omega)
      exact ⟨l', List.mem_cons_of_mem l hl', hv'⟩

/-- fut_004_unknown_cpu_vuln_mitigated (matches Coq) -/
theorem fut_004_unknown_cpu_vuln_mitigated :
    ∀ (sm : SpeculationMitigation),
    speculation_conservative sm = true →
    sm.sm_conservative = true ∧ sm.sm_ssbd = true := by
  intro sm h
  unfold speculation_conservative at h
  have ⟨h1, h2⟩ := band_true h
  have ⟨h3, _⟩ := band_true h1
  exact ⟨h3, h2⟩

