  Nat.ble 13 tls.tls_version &&
  (match tls.tls_pq_kem with
   | some kem => Nat.ble 3 (kem_security_level kem)
   | none => false) &&
  (tls.tls_hybrid || !(match tls.tls_classical_kex with | some _ => true | none => false))

