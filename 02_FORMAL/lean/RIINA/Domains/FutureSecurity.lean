/-- kem_security_level (matches Coq: Definition kem_security_level) -/
def kem_security_level (kem : PQ_KEM) : Nat :=
  match kem with
  | .ML_KEM_512 => 1
  | .ML_KEM_768 => 3
  | .ML_KEM_1024 => 5

/-- sig_security_level (matches Coq: Definition sig_security_level) -/
