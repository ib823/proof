    ∀ (pq : PQCryptoConfig),
    pq.pqc_hybrid_mode = true →
    pq_config_secure pq = true →
    pq.pqc_hybrid_mode = true ∧ pq_config_secure pq = true := by
  intro _ h1 h2; exact ⟨h1, h2⟩

