def symmetric_quantum_safe (bits : Nat) : Bool :=
  Nat.ble 256 bits

/-- pq_config_secure (matches Coq: Definition pq_config_secure) -/
def pq_config_secure (cfg : PQCryptoConfig) : Bool :=
  Nat.ble 3 (kem_security_level cfg.pqc_kem) &&
  Nat.ble 3 (sig_security_level cfg.pqc_signature) &&
  symmetric_quantum_safe cfg.pqc_symmetric_bits

/-- vulnerable_to_shor (matches Coq: Definition vulnerable_to_shor) -/
def vulnerable_to_shor (cc : ClassicalCrypto) : Bool :=
  (match cc.cc_rsa_bits with | some _ => true | none => false) ||
  (match cc.cc_dh_bits with | some _ => true | none => false) ||
  (match cc.cc_ecc_bits with | some _ => true | none => false)

/-- grover_effective_bits (matches Coq: Definition grover_effective_bits) -/
def grover_effective_bits (bits : Nat) : Nat :=
  bits / 2

/-- count_verified_layers (matches Coq: Definition count_verified_layers) -/
def count_verified_layers (layers : List SecurityLayer) : Nat :=
  match layers with
  | [] => 0
  | l :: rest => (if l.sl_verified then 1 else 0) + count_verified_layers rest

/-- all_layers_independent (matches Coq: Definition all_layers_independent) -/
def all_layers_independent (layers : List SecurityLayer) : Bool :=
