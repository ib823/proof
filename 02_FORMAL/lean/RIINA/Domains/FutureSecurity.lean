  match cc_rsa_bits cc with
  | None => false

/-- grover_effective_bits (matches Coq: Definition grover_effective_bits) -/
def grover_effective_bits (bits : Nat) : Nat :=
  bits / 2

/-- count_verified_layers (matches Coq: Definition count_verified_layers) -/
def count_verified_layers (layers : List SecurityLayer) : Nat :=
  match layers with
  | [] => 0
  | l :: rest => (if sl_verified l then 1 else 0) + count_verified_layers rest

/-- all_layers_independent (matches Coq: Definition all_layers_independent) -/
def all_layers_independent (layers : List SecurityLayer) : Bool :=
  match layers with
  | [] => true
  | l :: rest => sl_indep

/-- did_robust (matches Coq: Definition did_robust) -/
def did_robust (did : DefenseInDepth) : Bool :=
  Nat.leb 3 (length (did_layers did)) &&
  Nat.leb 2 (count_verified_layers (did_layers did)) &&
  did_composition_verified did &&
  did_no_common_mode_failure did

/-- has_full_serialize (matches Coq: Definition has_full_serialize) -/
def has_full_serialize (barriers : List SpeculationBarrier) : Bool :=
  match barriers with
  | [] => false
  | FullSerialize :: _ => true
  | _ :: rest => has_full_serialize rest

/-- speculation_conservative (matches Coq: Definition speculation_conservative) -/
def speculation_conservative (sm : SpeculationMitigation) : Bool :=
  sm_conservative sm &&
  (has_full_serialize (sm_barriers sm) || (sm_retpoline sm && sm_ibrs sm)) &&
  sm_ssbd sm

/-- leakage_minimal (matches Coq: Definition leakage_minimal) -/
def leakage_minimal (lb : LeakageBound) : Bool :=
  Nat.eqb (lb_bits_per_operation lb) 0 &&
  Nat.leb (lb_timing_variance_ns lb) 1

/-- scm_comprehensive (matches Coq: Definition scm_comprehensive) -/
