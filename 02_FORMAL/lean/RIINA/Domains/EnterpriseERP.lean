        Nat.beq_eq, Nat.blt] at hrule
  rcases hrule with h1 | h2 | ⟨h3a, h3b⟩
  · left; intro heq; rw [heq] at h1; simp at h1
  · right; left; exact h2
  · right; right; exact ⟨h3a, h3b⟩

