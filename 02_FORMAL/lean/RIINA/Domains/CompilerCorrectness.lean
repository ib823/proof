-- ============================================================================
-- Helper: ir_value implies not ir_step
-- ============================================================================

private theorem ir_value_no_step (v e : ir_expr) (hv : ir_value v) (hs : ir_step v e) : False := by
  induction hs with
  | S_IfTrue _ _ => cases hv
  | S_IfFalse _ _ => cases hv
  | S_IfCond _ _ _ _ _ _ => cases hv
  | S_FstPair _ _ _ _ => cases hv
  | S_SndPair _ _ _ _ => cases hv
  | S_Fst _ _ _ _ => cases hv
  | S_Snd _ _ _ _ => cases hv
  | S_PairL e1 e1' e2 _ ih =>
    cases hv with | V_Pair _ _ hv1 _ => exact ih hv1
  | S_PairR v1 e2 e2' _ _ ih =>
    cases hv with | V_Pair _ _ _ hv2 => exact ih hv2

-- Values don't step
/-- ir_value_not_step (matches Coq) -/
theorem ir_value_not_step : ∀ v e, ir_value v → ¬ ir_step v e := by
  intro v e hv hs; exact ir_value_no_step v e hv hs

-- IR Type Preservation Theorem
/-- ir_preservation (matches Coq) -/
theorem ir_preservation (e e' : ir_expr) (T : ir_ty) (ht : ir_has_type e T) (hs : ir_step e e') : ir_has_type e' T := by
  induction hs generalizing T with
  | S_IfTrue e1 e2 => cases ht with | T_If _ _ _ _ _ h1 _ => exact h1
  | S_IfFalse e1 e2 => cases ht with | T_If _ _ _ _ _ _ h2 => exact h2
  | S_IfCond ec ec' e1 e2 _ ih =>
    cases ht with | T_If _ _ _ _ hc h1 h2 => exact ir_has_type.T_If ec' e1 e2 T (ih _ hc) h1 h2
  | S_FstPair v1 v2 _ _ =>
    cases ht with | T_Fst _ _ t2 hp => cases hp with | T_Pair _ _ _ _ h1 _ => exact h1
  | S_SndPair v1 v2 _ _ =>
    cases ht with | T_Snd _ t1 _ hp => cases hp with | T_Pair _ _ _ _ _ h2 => exact h2
  | S_Fst e e' _ ih =>
    match ht with | .T_Fst _ ta tb he => exact ir_has_type.T_Fst e' ta tb (ih _ he)
  | S_Snd e e' _ ih =>
    match ht with | .T_Snd _ ta tb he => exact ir_has_type.T_Snd e' ta tb (ih _ he)
  | S_PairL e1 e1' e2 _ ih =>
    match ht with | .T_Pair _ _ ta tb h1 h2 => exact ir_has_type.T_Pair e1' e2 ta tb (ih _ h1) h2
  | S_PairR v1 e2 e2' _ _ ih =>
    match ht with | .T_Pair _ _ ta tb h1 h2 => exact ir_has_type.T_Pair v1 e2' ta tb h1 (ih _ h2)

-- Multi-step preserves typing
/-- ir_multi_preservation (matches Coq) -/
theorem ir_multi_preservation : ∀ e e' T, ir_has_type e T → ir_multi_step e e' → ir_has_type e' T := by
  intro e e' T ht hm
  induction hm with
  | MS_Refl _ => exact ht
  | MS_Step _ _ _ hs _ ih => exact ih (ir_preservation _ _ T ht hs)

-- Helper: pair of values doesn't step
/-- ir_pair_value_not_step (matches Coq) -/
theorem ir_pair_value_not_step : ∀ v1 v2 e, ir_value v1 → ir_value v2 → ¬ ir_step (ir_expr.IR_Pair v1 v2) e := by
  intro v1 v2 e hv1 hv2 hs
  exact ir_value_no_step _ _ (ir_value.V_Pair v1 v2 hv1 hv2) hs

-- Helper: bool doesn't step
/-- ir_bool_not_step (matches Coq) -/
theorem ir_bool_not_step : ∀ b e, ¬ ir_step (ir_expr.IR_Bool b) e := by
  intro b e hs
  exact ir_value_no_step _ _ (ir_value.V_Bool b) hs

-- IR step is deterministic
/-- ir_step_deterministic (matches Coq) -/
theorem ir_step_deterministic (e e1 e2 : ir_expr) (h1 : ir_step e e1) (h2 : ir_step e e2) : e1 = e2 := by
  induction h1 generalizing e2 with
  | S_IfTrue et ef =>
    cases h2 with
    | S_IfTrue => rfl
    | S_IfCond _ _ _ _ hs => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Bool true))
  | S_IfFalse et ef =>
    cases h2 with
    | S_IfFalse => rfl
    | S_IfCond _ _ _ _ hs => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Bool false))
  | S_IfCond ec ec' e1' e2' hs ih =>
    cases h2 with
    | S_IfTrue => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Bool true))
    | S_IfFalse => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Bool false))
    | S_IfCond _ ec'' _ _ hs' => congr 1; exact ih _ hs'
  | S_FstPair v1 v2 hv1 hv2 =>
    cases h2 with
    | S_FstPair => rfl
    | S_Fst _ _ hs => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Pair v1 v2 hv1 hv2))
  | S_SndPair v1 v2 hv1 hv2 =>
    cases h2 with
    | S_SndPair => rfl
    | S_Snd _ _ hs => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Pair v1 v2 hv1 hv2))
  | S_Fst e e' hs ih =>
    cases h2 with
    | S_FstPair _ _ hv1 hv2 => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Pair _ _ hv1 hv2))
    | S_Fst _ e'' hs' => congr 1; exact ih _ hs'
  | S_Snd e e' hs ih =>
    cases h2 with
    | S_SndPair _ _ hv1 hv2 => exact absurd hs (ir_value_not_step _ _ (ir_value.V_Pair _ _ hv1 hv2))
    | S_Snd _ e'' hs' => congr 1; exact ih _ hs'
  | S_PairL e1' e1'' e2' hs ih =>
    cases h2 with
    | S_PairL _ e1''' _ hs' => congr 1; exact ih _ hs'
    | S_PairR _ _ _ hv1 _ => exact absurd hs (ir_value_not_step _ _ hv1)
  | S_PairR v1 e2' e2'' hv1 hs ih =>
    cases h2 with
    | S_PairL _ e1' _ hs' => exact absurd hs' (ir_value_not_step _ _ hv1)
    | S_PairR _ _ e2''' _ hs' => congr 1; exact ih _ hs'

-- IR Progress theorem
/-- ir_progress (matches Coq) -/
theorem ir_progress (e : ir_expr) (T : ir_ty) (ht : ir_has_type e T) : ir_value e ∨ ∃ e', ir_step e e' := by
  induction ht with
  | T_Unit => exact Or.inl ir_value.V_Unit
  | T_Bool b => exact Or.inl (ir_value.V_Bool b)
  | T_Int n => exact Or.inl (ir_value.V_Int n)
  | T_Pair e1 e2 t1 t2 _ _ ih1 ih2 =>
    match ih1, ih2 with
    | .inl hv1, .inl hv2 => exact Or.inl (ir_value.V_Pair e1 e2 hv1 hv2)
    | .inl hv1, .inr ⟨e2', hs2⟩ => exact Or.inr ⟨.IR_Pair e1 e2', ir_step.S_PairR e1 e2 e2' hv1 hs2⟩
    | .inr ⟨e1', hs1⟩, _ => exact Or.inr ⟨.IR_Pair e1' e2, ir_step.S_PairL e1 e1' e2 hs1⟩
  | T_Fst e t1 t2 _ ih =>
    match ih with
    | .inl hv =>
      match hv with
      | .V_Pair v1 v2 hv1 hv2 => exact Or.inr ⟨v1, ir_step.S_FstPair v1 v2 hv1 hv2⟩
    | .inr ⟨e', hs⟩ => exact Or.inr ⟨.IR_Fst e', ir_step.S_Fst e e' hs⟩
  | T_Snd e t1 t2 _ ih =>
    match ih with
    | .inl hv =>
      match hv with
      | .V_Pair v1 v2 hv1 hv2 => exact Or.inr ⟨v2, ir_step.S_SndPair v1 v2 hv1 hv2⟩
    | .inr ⟨e', hs⟩ => exact Or.inr ⟨.IR_Snd e', ir_step.S_Snd e e' hs⟩
  | T_Inl e _ t2 _ _ => exact Or.inl (ir_value.V_Inl e t2)
  | T_Inr e t1 _ _ _ => exact Or.inl (ir_value.V_Inr e t1)
  | T_If ec e1 e2 t htc _ _ ihc _ _ =>
    match ihc with
    | .inl hv =>
      -- ec has type IR_TBool and is a value, must be IR_Bool b
      match ec, hv, htc with
      | .IR_Bool true, _, _ => exact Or.inr ⟨e1, ir_step.S_IfTrue e1 e2⟩
      | .IR_Bool false, _, _ => exact Or.inr ⟨e2, ir_step.S_IfFalse e1 e2⟩
    | .inr ⟨ec', hs⟩ => exact Or.inr ⟨.IR_If ec' e1 e2, ir_step.S_IfCond ec ec' e1 e2 hs⟩

-- Reflexivity of equivalence
/-- ir_equiv_refl (matches Coq) -/
theorem ir_equiv_refl : ∀ e, ir_equiv e e := by
  intro e v; exact Iff.rfl

-- Symmetry of equivalence
/-- ir_equiv_sym (matches Coq) -/
theorem ir_equiv_sym : ∀ e1 e2, ir_equiv e1 e2 → ir_equiv e2 e1 := by
  intro e1 e2 h v; exact (h v).symm

-- Transitivity of equivalence
/-- ir_equiv_trans (matches Coq) -/
theorem ir_equiv_trans : ∀ e1 e2 e3, ir_equiv e1 e2 → ir_equiv e2 e3 → ir_equiv e1 e3 := by
  intro e1 e2 e3 h12 h23 v; exact (h12 v).trans (h23 v)

-- Multi-step transitivity
/-- ir_multi_trans (matches Coq) -/
theorem ir_multi_trans : ∀ e1 e2 e3, ir_multi_step e1 e2 → ir_multi_step e2 e3 → ir_multi_step e1 e3 := by
  intro e1 e2 e3 h12 h23
  induction h12 with
  | MS_Refl _ => exact h23
  | MS_Step _ em _ hs _ ih => exact ir_multi_step.MS_Step _ em e3 hs (ih h23)

/-- ir_multi_pair_cong1 (matches Coq) -/
theorem ir_multi_pair_cong1 : ∀ e1 e1' e2, ir_multi_step e1 e1' → ir_multi_step (.IR_Pair e1 e2) (.IR_Pair e1' e2) := by
  intro e1 e1' e2 h
  induction h with
  | MS_Refl _ => exact ir_multi_step.MS_Refl _
  | MS_Step _ em _ hs _ ih =>
    exact ir_multi_step.MS_Step _ (.IR_Pair em e2) _ (ir_step.S_PairL _ em e2 hs) ih

-- Congruence for Pair (right)
/-- ir_multi_pair_cong2 (matches Coq) -/
theorem ir_multi_pair_cong2 : ∀ v1 e2 e2', ir_value v1 → ir_multi_step e2 e2' → ir_multi_step (.IR_Pair v1 e2) (.IR_Pair v1 e2') := by
  intro v1 e2 e2' hv h
  induction h with
  | MS_Refl _ => exact ir_multi_step.MS_Refl _
  | MS_Step _ em _ hs _ ih =>
    exact ir_multi_step.MS_Step _ (.IR_Pair v1 em) _ (ir_step.S_PairR v1 _ em hv hs) ih

/-- opt_if_true_sound (matches Coq) -/
theorem opt_if_true_sound : ∀ e1 e2, ir_multi_step (.IR_If (.IR_Bool true) e1 e2) e1 := by
  intro e1 e2
  exact ir_multi_step.MS_Step _ e1 e1 (ir_step.S_IfTrue e1 e2) (ir_multi_step.MS_Refl e1)

/-- opt_if_false_sound (matches Coq) -/
theorem opt_if_false_sound : ∀ e1 e2, ir_multi_step (.IR_If (.IR_Bool false) e1 e2) e2 := by
  intro e1 e2
  exact ir_multi_step.MS_Step _ e2 e2 (ir_step.S_IfFalse e1 e2) (ir_multi_step.MS_Refl e2)

/-- opt_fst_pair_sound (matches Coq) -/
theorem opt_fst_pair_sound : ∀ v1 v2, ir_value v1 → ir_value v2 → ir_multi_step (.IR_Fst (.IR_Pair v1 v2)) v1 := by
  intro v1 v2 hv1 hv2
  exact ir_multi_step.MS_Step _ v1 v1 (ir_step.S_FstPair v1 v2 hv1 hv2) (ir_multi_step.MS_Refl v1)

/-- opt_snd_pair_sound (matches Coq) -/
theorem opt_snd_pair_sound : ∀ v1 v2, ir_value v1 → ir_value v2 → ir_multi_step (.IR_Snd (.IR_Pair v1 v2)) v2 := by
  intro v1 v2 hv1 hv2
  exact ir_multi_step.MS_Step _ v2 v2 (ir_step.S_SndPair v1 v2 hv1 hv2) (ir_multi_step.MS_Refl v2)

-- Values are normal forms
/-- ir_value_normal (matches Coq) -/
theorem ir_value_normal : ∀ v, ir_value v → ¬ ∃ e, ir_step v e := by
  intro v hv ⟨e, hs⟩; exact ir_value_no_step v e hv hs

-- Values reduce to themselves
/-- ir_value_reduces_self (matches Coq) -/
theorem ir_value_reduces_self : ∀ v, ir_value v → ir_multi_step v v := by
  intro v _; exact ir_multi_step.MS_Refl v

-- Equivalence preserves typing
/-- equiv_preserves_typing (matches Coq) -/
theorem equiv_preserves_typing : ∀ e1 e2 v T, ir_equiv e1 e2 → ir_has_type e1 T → ir_has_type e2 T → ir_multi_step e1 v → ir_value v → ir_has_type v T := by
  intro e1 _ v T _ ht1 _ hm _
  exact ir_multi_preservation e1 v T ht1 hm

-- ============================================================================
-- Source language lemmas
-- ============================================================================

private theorem src_value_no_step (v e : src_expr) (hv : src_value v) (hs : src_step v e) : False := by
  induction hs with
  | SS_IfTrue _ _ => cases hv
  | SS_IfFalse _ _ => cases hv
  | SS_IfCond _ _ _ _ _ _ => cases hv
  | SS_FstPair _ _ _ _ => cases hv
  | SS_SndPair _ _ _ _ => cases hv
  | SS_Fst _ _ _ _ => cases hv
  | SS_Snd _ _ _ _ => cases hv
  | SS_PairL e1 e1' e2 _ ih =>
    cases hv with | SV_Pair _ _ hv1 _ => exact ih hv1
  | SS_PairR v1 e2 e2' _ _ ih =>
    cases hv with | SV_Pair _ _ _ hv2 => exact ih hv2

-- Source values don't step
/-- src_value_not_step (matches Coq) -/
theorem src_value_not_step : ∀ v e, src_value v → ¬ src_step v e := by
  intro v e hv hs; exact src_value_no_step v e hv hs

-- Source step is deterministic
/-- src_step_deterministic (matches Coq) -/
theorem src_step_deterministic (e e1 e2 : src_expr) (h1 : src_step e e1) (h2 : src_step e e2) : e1 = e2 := by
  induction h1 generalizing e2 with
  | SS_IfTrue _ _ =>
    cases h2 with
    | SS_IfTrue => rfl
    | SS_IfCond _ _ _ _ hs => exact absurd hs (src_value_not_step _ _ (src_value.SV_Bool true))
  | SS_IfFalse _ _ =>
    cases h2 with
    | SS_IfFalse => rfl
    | SS_IfCond _ _ _ _ hs => exact absurd hs (src_value_not_step _ _ (src_value.SV_Bool false))
  | SS_IfCond ec ec' e1' e2' hs ih =>
    cases h2 with
    | SS_IfTrue => exact absurd hs (src_value_not_step _ _ (src_value.SV_Bool true))
    | SS_IfFalse => exact absurd hs (src_value_not_step _ _ (src_value.SV_Bool false))
    | SS_IfCond _ ec'' _ _ hs' => congr 1; exact ih _ hs'
  | SS_FstPair v1 v2 hv1 hv2 =>
    cases h2 with
    | SS_FstPair => rfl
    | SS_Fst _ _ hs => exact absurd hs (src_value_not_step _ _ (src_value.SV_Pair v1 v2 hv1 hv2))
  | SS_SndPair v1 v2 hv1 hv2 =>
    cases h2 with
    | SS_SndPair => rfl
    | SS_Snd _ _ hs => exact absurd hs (src_value_not_step _ _ (src_value.SV_Pair v1 v2 hv1 hv2))
  | SS_Fst e e' hs ih =>
    cases h2 with
    | SS_FstPair _ _ hv1 hv2 => exact absurd hs (src_value_not_step _ _ (src_value.SV_Pair _ _ hv1 hv2))
    | SS_Fst _ e'' hs' => congr 1; exact ih _ hs'
  | SS_Snd e e' hs ih =>
    cases h2 with
    | SS_SndPair _ _ hv1 hv2 => exact absurd hs (src_value_not_step _ _ (src_value.SV_Pair _ _ hv1 hv2))
    | SS_Snd _ e'' hs' => congr 1; exact ih _ hs'
  | SS_PairL e1' e1'' e2' hs ih =>
    cases h2 with
    | SS_PairL _ e1''' _ hs' => congr 1; exact ih _ hs'
    | SS_PairR _ _ _ hv1 _ => exact absurd hs (src_value_not_step _ _ hv1)
  | SS_PairR v1 e2' e2'' hv1 hs ih =>
    cases h2 with
    | SS_PairL _ e1' _ hs' => exact absurd hs' (src_value_not_step _ _ hv1)
    | SS_PairR _ _ e2''' _ hs' => congr 1; exact ih _ hs'

-- Source type preservation
/-- src_preservation (matches Coq) -/
theorem src_preservation (e e' : src_expr) (T : src_ty) (ht : src_has_type e T) (hs : src_step e e') : src_has_type e' T := by
  induction hs generalizing T with
  | SS_IfTrue e1 e2 => cases ht with | ST_If _ _ _ _ _ h1 _ => exact h1
  | SS_IfFalse e1 e2 => cases ht with | ST_If _ _ _ _ _ _ h2 => exact h2
  | SS_IfCond ec ec' e1 e2 _ ih =>
    cases ht with | ST_If _ _ _ _ hc h1 h2 => exact src_has_type.ST_If ec' e1 e2 T (ih _ hc) h1 h2
  | SS_FstPair v1 v2 _ _ =>
    cases ht with | ST_Fst _ _ t2 hp => cases hp with | ST_Pair _ _ _ _ h1 _ => exact h1
  | SS_SndPair v1 v2 _ _ =>
    cases ht with | ST_Snd _ t1 _ hp => cases hp with | ST_Pair _ _ _ _ _ h2 => exact h2
  | SS_Fst e e' _ ih =>
    match ht with | .ST_Fst _ ta tb he => exact src_has_type.ST_Fst e' ta tb (ih _ he)
  | SS_Snd e e' _ ih =>
    match ht with | .ST_Snd _ ta tb he => exact src_has_type.ST_Snd e' ta tb (ih _ he)
  | SS_PairL e1 e1' e2 _ ih =>
    match ht with | .ST_Pair _ _ ta tb h1 h2 => exact src_has_type.ST_Pair e1' e2 ta tb (ih _ h1) h2
  | SS_PairR v1 e2 e2' _ _ ih =>
    match ht with | .ST_Pair _ _ ta tb h1 h2 => exact src_has_type.ST_Pair v1 e2' ta tb h1 (ih _ h2)

-- Source progress
/-- src_progress (matches Coq) -/
theorem src_progress (e : src_expr) (T : src_ty) (ht : src_has_type e T) : src_value e ∨ ∃ e', src_step e e' := by
  induction ht with
  | ST_Unit => exact Or.inl src_value.SV_Unit
  | ST_Bool b => exact Or.inl (src_value.SV_Bool b)
  | ST_Int n => exact Or.inl (src_value.SV_Int n)
  | ST_Pair e1 e2 t1 t2 _ _ ih1 ih2 =>
    match ih1, ih2 with
    | .inl hv1, .inl hv2 => exact Or.inl (src_value.SV_Pair e1 e2 hv1 hv2)
    | .inl hv1, .inr ⟨e2', hs2⟩ => exact Or.inr ⟨.Src_Pair e1 e2', src_step.SS_PairR e1 e2 e2' hv1 hs2⟩
    | .inr ⟨e1', hs1⟩, _ => exact Or.inr ⟨.Src_Pair e1' e2, src_step.SS_PairL e1 e1' e2 hs1⟩
  | ST_Fst e t1 t2 _ ih =>
    match ih with
    | .inl hv =>
      match hv with
      | .SV_Pair v1 v2 hv1 hv2 => exact Or.inr ⟨v1, src_step.SS_FstPair v1 v2 hv1 hv2⟩
    | .inr ⟨e', hs⟩ => exact Or.inr ⟨.Src_Fst e', src_step.SS_Fst e e' hs⟩
  | ST_Snd e t1 t2 _ ih =>
    match ih with
    | .inl hv =>
      match hv with
      | .SV_Pair v1 v2 hv1 hv2 => exact Or.inr ⟨v2, src_step.SS_SndPair v1 v2 hv1 hv2⟩
    | .inr ⟨e', hs⟩ => exact Or.inr ⟨.Src_Snd e', src_step.SS_Snd e e' hs⟩
  | ST_Inl e _ t2 _ _ => exact Or.inl (src_value.SV_Inl e t2)
  | ST_Inr e t1 _ _ _ => exact Or.inl (src_value.SV_Inr e t1)
  | ST_If ec e1 e2 t htc _ _ ihc _ _ =>
    match ihc with
    | .inl hv =>
      match ec, hv, htc with
      | .Src_Bool true, _, _ => exact Or.inr ⟨e1, src_step.SS_IfTrue e1 e2⟩
      | .Src_Bool false, _, _ => exact Or.inr ⟨e2, src_step.SS_IfFalse e1 e2⟩
    | .inr ⟨ec', hs⟩ => exact Or.inr ⟨.Src_If ec' e1 e2, src_step.SS_IfCond ec ec' e1 e2 hs⟩

-- Compilation preserves values
/-- compile_preserves_value (matches Coq) -/
theorem compile_preserves_value : ∀ e, src_value e → ir_value (compile_expr e) := by
  intro e hv
  induction hv with
  | SV_Unit => exact ir_value.V_Unit
  | SV_Bool b => exact ir_value.V_Bool b
  | SV_Int n => exact ir_value.V_Int n
  | SV_Pair v1 v2 _ _ ih1 ih2 => exact ir_value.V_Pair _ _ ih1 ih2
  | SV_Inl e t => exact ir_value.V_Inl _ _
  | SV_Inr e t => exact ir_value.V_Inr _ _

-- Compilation preserves typing
/-- compile_preserves_typing (matches Coq) -/
theorem compile_preserves_typing : ∀ e T, src_has_type e T → ir_has_type (compile_expr e) (compile_ty T) := by
  intro e T ht
  induction ht with
  | ST_Unit => exact ir_has_type.T_Unit
  | ST_Bool b => exact ir_has_type.T_Bool b
  | ST_Int n => exact ir_has_type.T_Int n
  | ST_Pair _ _ _ _ _ _ ih1 ih2 => exact ir_has_type.T_Pair _ _ _ _ ih1 ih2
  | ST_Fst _ _ _ _ ih => exact ir_has_type.T_Fst _ _ _ ih
  | ST_Snd _ _ _ _ ih => exact ir_has_type.T_Snd _ _ _ ih
  | ST_Inl _ _ _ _ ih => exact ir_has_type.T_Inl _ _ _ ih
  | ST_Inr _ _ _ _ ih => exact ir_has_type.T_Inr _ _ _ ih
  | ST_If _ _ _ _ _ _ _ ihc ih1 ih2 => exact ir_has_type.T_If _ _ _ _ ihc ih1 ih2

-- Forward simulation: source step implies IR step
/-- compile_forward_simulation (matches Coq) -/
theorem compile_forward_simulation : ∀ e e', src_step e e' → ir_step (compile_expr e) (compile_expr e') := by
  intro e e' hs
  induction hs with
  | SS_IfTrue e1 e2 => exact ir_step.S_IfTrue _ _
  | SS_IfFalse e1 e2 => exact ir_step.S_IfFalse _ _
  | SS_IfCond ec ec' e1 e2 _ ih => exact ir_step.S_IfCond _ _ _ _ ih
  | SS_FstPair v1 v2 hv1 hv2 =>
    exact ir_step.S_FstPair _ _ (compile_preserves_value _ hv1) (compile_preserves_value _ hv2)
  | SS_SndPair v1 v2 hv1 hv2 =>
    exact ir_step.S_SndPair _ _ (compile_preserves_value _ hv1) (compile_preserves_value _ hv2)
  | SS_Fst e e' _ ih => exact ir_step.S_Fst _ _ ih
  | SS_Snd e e' _ ih => exact ir_step.S_Snd _ _ ih
  | SS_PairL e1 e1' e2 _ ih => exact ir_step.S_PairL _ _ _ ih
  | SS_PairR v1 e2 e2' hv1 _ ih =>
    exact ir_step.S_PairR _ _ _ (compile_preserves_value _ hv1) ih

-- Forward simulation for multi-step
/-- compile_forward_multi_simulation (matches Coq) -/
theorem compile_forward_multi_simulation : ∀ e e', src_multi_step e e' → ir_multi_step (compile_expr e) (compile_expr e') := by
  intro e e' hm
  induction hm with
  | SMS_Refl _ => exact ir_multi_step.MS_Refl _
  | SMS_Step _ em _ hs _ ih =>
    exact ir_multi_step.MS_Step _ (compile_expr em) _ (compile_forward_simulation _ em hs) ih

-- Helper: compiled value means source value
/-- compile_value_inv (matches Coq) -/
theorem compile_value_inv : ∀ e, ir_value (compile_expr e) → src_value e := by
  intro e hv
  match e with
  | .Src_Unit => exact src_value.SV_Unit
  | .Src_Bool b => exact src_value.SV_Bool b
  | .Src_Int n => exact src_value.SV_Int n
  | .Src_Pair e1 e2 =>
    simp [compile_expr] at hv
    match hv with
    | .V_Pair _ _ hv1 hv2 => exact src_value.SV_Pair e1 e2 (compile_value_inv e1 hv1) (compile_value_inv e2 hv2)
  | .Src_Fst _ => simp [compile_expr] at hv; cases hv
  | .Src_Snd _ => simp [compile_expr] at hv; cases hv
  | .Src_Inl e t => exact src_value.SV_Inl e t
  | .Src_Inr e t => exact src_value.SV_Inr e t
  | .Src_If _ _ _ => simp [compile_expr] at hv; cases hv

private theorem compile_expr_pair_inv (e : src_expr) (v1 v2 : ir_expr)
    (h : compile_expr e = ir_expr.IR_Pair v1 v2) :
    ∃ e1 e2, e = src_expr.Src_Pair e1 e2 ∧ compile_expr e1 = v1 ∧ compile_expr e2 = v2 := by
  cases e with
  | Src_Pair e1 e2 => simp [compile_expr] at h; exact ⟨e1, e2, rfl, h.1, h.2⟩
  | _ => simp [compile_expr] at h

-- Backward simulation: IR step from compiled implies source step
/-- compile_backward_simulation (matches Coq) -/
theorem compile_backward_simulation : ∀ e e_ir', ir_step (compile_expr e) e_ir' → ∃ e', src_step e e' ∧ compile_expr e' = e_ir' := by
  intro e
  match e with
  | .Src_Unit => intro _ hs; simp [compile_expr] at hs; cases hs
  | .Src_Bool _ => intro _ hs; simp [compile_expr] at hs; cases hs
  | .Src_Int _ => intro _ hs; simp [compile_expr] at hs; cases hs
  | .Src_If ec e1 e2 =>
    intro e_ir' hs
    simp [compile_expr] at hs
    match ec with
    | .Src_Bool true =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfTrue => exact ⟨e1, src_step.SS_IfTrue e1 e2, rfl⟩
      | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Bool true))
    | .Src_Bool false =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfFalse => exact ⟨e2, src_step.SS_IfFalse e1 e2, rfl⟩
      | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Bool false))
    | .Src_Unit =>
      simp [compile_expr] at hs
      cases hs with | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ ir_value.V_Unit)
    | .Src_Int n =>
      simp [compile_expr] at hs
      cases hs with | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Int n))
    | .Src_Pair a b =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        have ⟨ec'', hss, heq⟩ := compile_backward_simulation (.Src_Pair a b) ec' hs'
        exact ⟨.Src_If ec'' e1 e2, src_step.SS_IfCond _ ec'' e1 e2 hss, by simp [compile_expr, heq]⟩
    | .Src_Fst a =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        have ⟨ec'', hss, heq⟩ := compile_backward_simulation (.Src_Fst a) ec' hs'
        exact ⟨.Src_If ec'' e1 e2, src_step.SS_IfCond _ ec'' e1 e2 hss, by simp [compile_expr, heq]⟩
    | .Src_Snd a =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        have ⟨ec'', hss, heq⟩ := compile_backward_simulation (.Src_Snd a) ec' hs'
        exact ⟨.Src_If ec'' e1 e2, src_step.SS_IfCond _ ec'' e1 e2 hss, by simp [compile_expr, heq]⟩
    | .Src_Inl a t =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Inl (compile_expr a) (compile_ty t)))
    | .Src_Inr a t =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Inr (compile_expr a) (compile_ty t)))
    | .Src_If a b c =>
      simp [compile_expr] at hs
      cases hs with
      | S_IfCond _ ec' _ _ hs' =>
        have ⟨ec'', hss, heq⟩ := compile_backward_simulation (.Src_If a b c) ec' hs'
        exact ⟨.Src_If ec'' e1 e2, src_step.SS_IfCond _ ec'' e1 e2 hss, by simp [compile_expr, heq]⟩
  | .Src_Pair e1 e2 =>
    intro e_ir' hs
    simp [compile_expr] at hs
    cases hs with
    | S_PairL _ e1' _ hs1 =>
      have ⟨e1'', hss, heq⟩ := compile_backward_simulation e1 e1' hs1
      exact ⟨.Src_Pair e1'' e2, src_step.SS_PairL e1 e1'' e2 hss, by simp [compile_expr, heq]⟩
    | S_PairR _ _ e2' hv1 hs2 =>
      have hv1' := compile_value_inv e1 hv1
      have ⟨e2'', hss, heq⟩ := compile_backward_simulation e2 e2' hs2
      exact ⟨.Src_Pair e1 e2'', src_step.SS_PairR e1 e2 e2'' hv1' hss, by simp [compile_expr, heq]⟩
  | .Src_Fst e =>
    intro e_ir' hs
    -- hs : ir_step (IR_Fst (compile_expr e)) e_ir'
    -- Need to case-split on e to determine if compile_expr e is a Pair
    match e with
    | .Src_Pair e1 e2 =>
      simp [compile_expr] at hs
      cases hs with
      | S_FstPair _ _ hv1 hv2 =>
        exact ⟨e1, src_step.SS_FstPair e1 e2 (compile_value_inv e1 hv1) (compile_value_inv e2 hv2), rfl⟩
      | S_Fst _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Pair e1 e2) e' hs'
        exact ⟨.Src_Fst e'', src_step.SS_Fst (.Src_Pair e1 e2) e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Unit => simp [compile_expr] at hs; cases hs with | S_Fst _ e' hs' => cases hs'
    | .Src_Bool b => simp [compile_expr] at hs; cases hs with | S_Fst _ e' hs' => cases hs'
    | .Src_Int n => simp [compile_expr] at hs; cases hs with | S_Fst _ e' hs' => cases hs'
    | .Src_Fst a =>
      simp [compile_expr] at hs
      cases hs with
      | S_Fst _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Fst a) e' hs'
        exact ⟨.Src_Fst e'', src_step.SS_Fst _ e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Snd a =>
      simp [compile_expr] at hs
      cases hs with
      | S_Fst _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Snd a) e' hs'
        exact ⟨.Src_Fst e'', src_step.SS_Fst _ e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Inl a t =>
      simp [compile_expr] at hs; cases hs with | S_Fst _ e' hs' => cases hs'
    | .Src_Inr a t =>
      simp [compile_expr] at hs; cases hs with | S_Fst _ e' hs' => cases hs'
    | .Src_If a b c =>
      simp [compile_expr] at hs
      cases hs with
      | S_Fst _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_If a b c) e' hs'
        exact ⟨.Src_Fst e'', src_step.SS_Fst _ e'' hss, by simp [compile_expr, heq]⟩
  | .Src_Snd e =>
    intro e_ir' hs
    match e with
    | .Src_Pair e1 e2 =>
      simp [compile_expr] at hs
      cases hs with
      | S_SndPair _ _ hv1 hv2 =>
        exact ⟨e2, src_step.SS_SndPair e1 e2 (compile_value_inv e1 hv1) (compile_value_inv e2 hv2), rfl⟩
      | S_Snd _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Pair e1 e2) e' hs'
        exact ⟨.Src_Snd e'', src_step.SS_Snd (.Src_Pair e1 e2) e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Unit => simp [compile_expr] at hs; cases hs with | S_Snd _ e' hs' => cases hs'
    | .Src_Bool b => simp [compile_expr] at hs; cases hs with | S_Snd _ e' hs' => cases hs'
    | .Src_Int n => simp [compile_expr] at hs; cases hs with | S_Snd _ e' hs' => cases hs'
    | .Src_Fst a =>
      simp [compile_expr] at hs
      cases hs with
      | S_Snd _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Fst a) e' hs'
        exact ⟨.Src_Snd e'', src_step.SS_Snd _ e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Snd a =>
      simp [compile_expr] at hs
      cases hs with
      | S_Snd _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_Snd a) e' hs'
        exact ⟨.Src_Snd e'', src_step.SS_Snd _ e'' hss, by simp [compile_expr, heq]⟩
    | .Src_Inl a t =>
      simp [compile_expr] at hs; cases hs with | S_Snd _ e' hs' => cases hs'
    | .Src_Inr a t =>
      simp [compile_expr] at hs; cases hs with | S_Snd _ e' hs' => cases hs'
    | .Src_If a b c =>
      simp [compile_expr] at hs
      cases hs with
      | S_Snd _ e' hs' =>
        have ⟨e'', hss, heq⟩ := compile_backward_simulation (.Src_If a b c) e' hs'
        exact ⟨.Src_Snd e'', src_step.SS_Snd _ e'' hss, by simp [compile_expr, heq]⟩
  | .Src_Inl _ _ => intro _ hs; simp [compile_expr] at hs; cases hs
  | .Src_Inr _ _ => intro _ hs; simp [compile_expr] at hs; cases hs

-- Compilation establishes equivalence
/-- compile_establishes_equiv (matches Coq) -/
theorem compile_establishes_equiv : ∀ e, src_ir_equiv e (compile_expr e) := by
  intro _; exact rfl

-- Equivalence is preserved by stepping
/-- equiv_preserved_forward (matches Coq) -/
theorem equiv_preserved_forward : ∀ e_src e_src', src_step e_src e_src' → src_ir_equiv e_src' (compile_expr e_src') := by
  intro _ _ _; exact rfl

-- If source terminates at value, compiled terminates at corresponding value
/-- compile_terminates_equivalently (matches Coq) -/
theorem compile_terminates_equivalently : ∀ e v, (src_has_type e .Src_TUnit ∨ src_has_type e .Src_TBool ∨ src_has_type e .Src_TInt) → src_multi_step e v → src_value v → ir_multi_step (compile_expr e) (compile_expr v) ∧ ir_value (compile_expr v) := by
  intro e v _ hm hv
  exact ⟨compile_forward_multi_simulation e v hm, compile_preserves_value v hv⟩

-- Compilation preserves type-safety: compiled well-typed source is type-safe
/-- compile_type_safety (matches Coq) -/
theorem compile_type_safety : ∀ e T, src_has_type e T → ir_value (compile_expr e) ∨ ∃ e', ir_step (compile_expr e) e' := by
  intro e T ht; exact ir_progress _ _ (compile_preserves_typing e T ht)

-- Dead code elimination: if (true) e1 e2 is equivalent to e1
/-- opt_dead_code_if_true (matches Coq) -/
theorem opt_dead_code_if_true : ∀ e1 e2, ir_equiv (.IR_If (.IR_Bool true) e1 e2) e1 := by
  intro e1 e2 v
  constructor
  · intro ⟨hm, hv⟩
    cases hm with
    | MS_Refl => cases hv
    | MS_Step _ e2' _ hs hm' =>
      cases hs with
      | S_IfTrue => exact ⟨hm', hv⟩
      | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Bool true))
  · intro ⟨hm, hv⟩
    exact ⟨ir_multi_step.MS_Step _ e1 v (ir_step.S_IfTrue e1 e2) hm, hv⟩

-- Dead code elimination: if (false) e1 e2 is equivalent to e2
/-- opt_dead_code_if_false (matches Coq) -/
theorem opt_dead_code_if_false : ∀ e1 e2, ir_equiv (.IR_If (.IR_Bool false) e1 e2) e2 := by
  intro e1 e2 v
  constructor
  · intro ⟨hm, hv⟩
    cases hm with
    | MS_Refl => cases hv
    | MS_Step _ e2' _ hs hm' =>
      cases hs with
      | S_IfFalse => exact ⟨hm', hv⟩
      | S_IfCond _ _ _ _ hs' => exact absurd hs' (ir_value_not_step _ _ (ir_value.V_Bool false))
  · intro ⟨hm, hv⟩
    exact ⟨ir_multi_step.MS_Step _ e2 v (ir_step.S_IfFalse e1 e2) hm, hv⟩

-- Pair projection optimization with type preservation
/-- opt_fst_pair_typed (matches Coq) -/
theorem opt_fst_pair_typed : ∀ v1 v2 T1 T2, ir_value v1 → ir_value v2 → ir_has_type (.IR_Pair v1 v2) (.IR_TProd T1 T2) → ir_has_type v1 T1 := by
  intro v1 v2 T1 T2 _ _ ht
  cases ht with | T_Pair _ _ _ _ h1 _ => exact h1

-- Pair projection optimization with type preservation
/-- opt_snd_pair_typed (matches Coq) -/
theorem opt_snd_pair_typed : ∀ v1 v2 T1 T2, ir_value v1 → ir_value v2 → ir_has_type (.IR_Pair v1 v2) (.IR_TProd T1 T2) → ir_has_type v2 T2 := by
  intro v1 v2 T1 T2 _ _ ht
  cases ht with | T_Pair _ _ _ _ _ h2 => exact h2

-- Constant propagation: compiling a known constant gives a value
/-- const_prop_bool (matches Coq) -/
theorem const_prop_bool : ∀ b, ir_value (compile_expr (.Src_Bool b)) := by
  intro b; exact ir_value.V_Bool b

/-- const_prop_int (matches Coq) -/
theorem const_prop_int : ∀ n, ir_value (compile_expr (.Src_Int n)) := by
  intro n; exact ir_value.V_Int n

/-- const_prop_unit (matches Coq) -/
theorem const_prop_unit : ir_value (compile_expr .Src_Unit) := by
  exact ir_value.V_Unit

/-- parsing_correct_prop (matches Coq) -/
theorem parsing_correct_prop : parsing_correctness := by
  exact CC_001

-- Optimization is correct: IR equivalence relation is an equivalence
/-- optimization_relation_reflexive (matches Coq) -/
theorem optimization_relation_reflexive : ∀ e, ir_equiv e e := ir_equiv_refl

/-- optimization_relation_symmetric (matches Coq) -/
theorem optimization_relation_symmetric : ∀ e1 e2, ir_equiv e1 e2 → ir_equiv e2 e1 := ir_equiv_sym

/-- optimization_relation_transitive (matches Coq) -/
theorem optimization_relation_transitive : ∀ e1 e2 e3, ir_equiv e1 e2 → ir_equiv e2 e3 → ir_equiv e1 e3 := ir_equiv_trans

-- The full pipeline: source to IR preserves semantics
/-- full_pipeline_correctness (matches Coq) -/
theorem full_pipeline_correctness : ∀ e T, src_has_type e T → ir_has_type (compile_expr e) (compile_ty T) ∧ (src_value e ∨ ∃ e', src_step e e') ∧ (∀ e', src_step e e' → ir_step (compile_expr e) (compile_expr e')) := by
  intro e T ht
  exact ⟨compile_preserves_typing e T ht,
         src_progress e T ht,
         fun e' hs => compile_forward_simulation e e' hs⟩

-- The full pipeline: termination behavior is preserved
/-- full_pipeline_termination (matches Coq) -/
theorem full_pipeline_termination : ∀ e v T, src_has_type e T → src_multi_step e v → src_value v → ir_multi_step (compile_expr e) (compile_expr v) ∧ ir_value (compile_expr v) ∧ ir_has_type (compile_expr v) (compile_ty T) := by
  intro e v T ht hm hv
  exact ⟨compile_forward_multi_simulation e v hm,
         compile_preserves_value v hv,
         ir_multi_preservation _ _ _ (compile_preserves_typing e T ht) (compile_forward_multi_simulation e v hm)⟩

end RIINA.Domains.CompilerCorrectness
