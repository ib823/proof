def is_constant_time (tm : TimingMeasurement) (tolerance : Nat) : Bool :=
  let diff := if Nat.leb tm.(tm_time1) tm.(tm_time2)
              then tm.(tm_time2) - tm.(tm_time1)
              else tm.(tm_time1) - tm.(tm_time2) in
  Nat.leb diff tolerance

