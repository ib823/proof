  scope2_tracked : ∀ s, s ∈ sys_emissions →
    (s.source_type = .Scope2_Location ∨ s.source_type = .Scope2_Market) →
    s.emission_factor > 0 ∧ s.is_tracked = true
  emissions_unique : ∀ s1 s2, s1 ∈ sys_emissions → s2 ∈ sys_emissions →
    same_emission s1 s2 → s1 = s2
  scope3_complete : ∀ n, valid_scope3_category n →
    ∃ s, s ∈ sys_emissions ∧ s.source_type = .Scope3 n
  emission_factors_verified : ∀ s, s ∈ sys_emissions → s.emission_factor > 0
  renewables_unique : ∀ r, r ∈ sys_renewables → r.unique_claim = true
  water_documented : ∀ w, w ∈ sys_water → w.source_documented = true
  waste_consistent : ∀ w, w ∈ sys_waste → waste_accounting_correct w
  biodiversity_mapped : ∀ b, b ∈ sys_biodiversity → b.dependencies_mapped = true
  circular_verified : ∀ c, c ∈ sys_circular → c.measurement_verified = true
  pollution_within_limits : ∀ p, p ∈ sys_pollution → pollution_compliant p
  employees_paid_fairly : ∀ e, e ∈ sys_employees → e.employed_flag = true → paid_living_wage e
  employees_voluntary : ∀ e, e ∈ sys_employees → e.employed_flag = true → no_forced_labor e
  employees_adult : ∀ e, e ∈ sys_employees → e.employed_flag = true → no_child_labor e
  incidents_handled : ∀ i, i ∈ sys_incidents → incident_properly_handled i
  decisions_fair : ∀ d, d ∈ sys_decisions → non_discriminatory d
  paygap_disclosed : ∀ p, p ∈ sys_paygap → p.gap_calculated = true ∧ p.gap_disclosed = true
  hrdd_active : hrdd_implemented sys_hrdd
  suppliers_assessed : ∀ s, s ∈ sys_suppliers → ∀ year, supplier_recently_assessed s year
  indigenous_consent : ∀ c, c ∈ sys_indigenous → fpic_satisfied c
  grievance_available : grievance_adequate sys_grievance
  stakeholders_engaged : ∀ s, s ∈ sys_stakeholder → stakeholder_engaged s
