/-- pn_leq_refl (matches Coq) -/
theorem pn_leq_refl : ∀ a, pn_leq a a := by
  constructor <;> simp_all [Bool.and_eq_true]

/-- pn_leq_trans (matches Coq) -/
theorem pn_leq_trans : ∀ a b c, pn_leq a b → pn_leq b c → pn_leq a c := by
  constructor <;> simp_all [Bool.and_eq_true]

/-- pn_leq_merge_l (matches Coq) -/
theorem pn_leq_merge_l : ∀ a b, length (fst a) = length (fst b) → length (snd a) = length (snd b) → pn_leq a (pn_merge a b) := by
  constructor <;> simp_all [Bool.and_eq_true]

/-- pn_leq_merge_r (matches Coq) -/
theorem pn_leq_merge_r : ∀ a b, length (fst a) = length (fst b) → length (snd a) = length (snd b) → pn_leq b (pn_merge a b) := by
  constructor <;> simp_all [Bool.and_eq_true]

/-- pn_bottom_merge_l (matches Coq) -/
theorem pn_bottom_merge_l : ∀ p n, length (fst p) = n → length (snd p) = n → pn_merge (pn_bottom n) p = p := by
  simp_all [Bool.and_eq_true]

/-- pn_bottom_merge_r (matches Coq) -/
theorem pn_bottom_merge_r : ∀ p n, length (fst p) = n → length (snd p) = n → pn_merge p (pn_bottom n) = p := by
  simp_all [Bool.and_eq_true]

/-- pn_bottom_leq (matches Coq) -/
theorem pn_bottom_leq : ∀ p n, length (fst p) = n → length (snd p) = n → pn_leq (pn_bottom n) p := by
  constructor <;> simp_all [Bool.and_eq_true]

/-- pn_increment_preserves_neg (matches Coq) -/
theorem pn_increment_preserves_neg : ∀ p node, snd (pn_increment p node) = snd p := by
  rfl

/-- pn_decrement_preserves_pos (matches Coq) -/
theorem pn_decrement_preserves_pos : ∀ p node, fst (pn_decrement p node) = fst p := by
  rfl

/-- pn_increment_pos_length (matches Coq) -/
theorem pn_increment_pos_length : ∀ p node, length (fst (pn_increment p node)) = length (fst p) := by
  simp_all [Bool.and_eq_true]

/-- pn_decrement_neg_length (matches Coq) -/
theorem pn_decrement_neg_length : ∀ p node, length (snd (pn_decrement p node)) = length (snd p) := by
  simp_all [Bool.and_eq_true]

/-- pn_merge_pos_length (matches Coq) -/
theorem pn_merge_pos_length : ∀ a b, length (fst a) = length (fst b) → length (fst (pn_merge a b)) = length (fst a) := by
  simp_all [Bool.and_eq_true]

/-- pn_merge_neg_length (matches Coq) -/
theorem pn_merge_neg_length : ∀ a b, length (snd a) = length (snd b) → length (snd (pn_merge a b)) = length (snd a) := by
  simp_all [Bool.and_eq_true]

/-- member_cons (matches Coq) -/
theorem member_cons : ∀ v x s, member v (x :: s) = (Nat.eqb v x) || member v s := by
  simp

/-- member_refl (matches Coq) -/
theorem member_refl : ∀ v s, In v s → member v s = true := by
  cases ‹_› <;> simp

/-- gs_add_member (matches Coq) -/
theorem gs_add_member : ∀ s v, gs_member (gs_add s v) v = true := by
  cases ‹_› <;> simp

/-- gs_add_preserves (matches Coq) -/
theorem gs_add_preserves : ∀ s v v', gs_member s v' = true → gs_member (gs_add s v) v' = true := by
  intro h; exact h

/-- gs_add_idempotent (matches Coq) -/
theorem gs_add_idempotent : ∀ s v, gs_member s v = true → gs_add s v = s := by
  rfl

/-- gs_merge_contains_l (matches Coq) -/
theorem gs_merge_contains_l : ∀ a b v, gs_member a v = true → gs_member (gs_merge a b) v = true := by
  simp_all [Bool.and_eq_true]

/-- gs_merge_contains_r (matches Coq) -/
theorem gs_merge_contains_r : ∀ a b v, gs_member b v = true → gs_member (gs_merge a b) v = true := by
  simp_all [Bool.and_eq_true]

/-- gs_merge_not_member (matches Coq) -/
theorem gs_merge_not_member : ∀ a b v, gs_member a v = false → gs_member b v = false → gs_member (gs_merge a b) v = false := by
  simp_all [Bool.and_eq_true]

/-- gs_merge_comm_member (matches Coq) -/
theorem gs_merge_comm_member : ∀ a b v, gs_member (gs_merge a b) v = true <-> gs_member (gs_merge b a) v = true := by
  simp_all [Bool.and_eq_true]

/-- gs_merge_add_idem (matches Coq) -/
theorem gs_merge_add_idem : ∀ b a, (∀ v, gs_member b v = true → gs_member a v = true) → gs_merge a b = a := by
  simp_all [Bool.and_eq_true]

/-- gs_merge_idem (matches Coq) -/
theorem gs_merge_idem : ∀ a, gs_merge a a = a := by
  simp_all [Bool.and_eq_true]

/-- gs_empty_merge_l (matches Coq) -/
theorem gs_empty_merge_l : ∀ s v, gs_member s v = true → gs_member (gs_merge gs_empty s) v = true := by
  simp_all [Bool.and_eq_true]

/-- gs_empty_member (matches Coq) -/
theorem gs_empty_member : ∀ v, gs_member gs_empty v = false := by
  rfl

/-- gs_add_not_member (matches Coq) -/
theorem gs_add_not_member : ∀ s u w, w ≠ u → gs_member s w = false → gs_member (gs_add s u) w = false := by
  cases ‹_› <;> simp <;> omega

/-- gs_add_comm_member (matches Coq) -/
theorem gs_add_comm_member : ∀ s u v w, gs_member (gs_add (gs_add s u) v) w = gs_member (gs_add (gs_add s v) u) w := by
  simp_all [Bool.and_eq_true]

/-- gs_member_add_cases (matches Coq) -/
theorem gs_member_add_cases : ∀ s v w, gs_member (gs_add s v) w = true → w = v ∨ gs_member s w = true := by
  cases ‹_› <;> simp <;> omega

/-- gs_merge_member_iff (matches Coq) -/
theorem gs_merge_member_iff : ∀ a b v, gs_member (gs_merge a b) v = true → gs_member a v = true ∨ gs_member b v = true := by
  cases ‹_› <;> simp

/-- gs_merge_monotone (matches Coq) -/
theorem gs_merge_monotone : ∀ a b v, gs_member a v = true → gs_member (gs_merge a b) v = true := by
  simp_all [Bool.and_eq_true]

/-- tp_add_visible (matches Coq) -/
theorem tp_add_visible : ∀ s v, gs_member (snd s) v = false → tp_lookup (tp_add s v) v = true := by
  simp

/-- tp_remove_hides (matches Coq) -/
theorem tp_remove_hides : ∀ s v, tp_lookup (tp_remove s v) v = false := by
  simp

/-- tp_remove_permanent (matches Coq) -/
theorem tp_remove_permanent : ∀ s v a b, gs_member (snd s) v = true → tp_lookup (tp_merge s (a, b)) v = false := by
  simp_all [Bool.and_eq_true]

/-- tp_merge_comm_lookup (matches Coq) -/
theorem tp_merge_comm_lookup : ∀ a b v, tp_lookup (tp_merge a b) v = tp_lookup (tp_merge b a) v := by
  cases ‹_› <;> simp

/-- tp_merge_idem (matches Coq) -/
theorem tp_merge_idem : ∀ s, tp_merge s s = s := by
  simp_all [Bool.and_eq_true]

/-- tp_empty_merge_l (matches Coq) -/
theorem tp_empty_merge_l : ∀ s v, tp_lookup s v = true → tp_lookup (tp_merge tp_empty s) v = true := by
  cases ‹_› <;> simp

/-- tp_add_preserves_removed (matches Coq) -/
theorem tp_add_preserves_removed : ∀ s v, snd (tp_add s v) = snd s := by
  rfl

/-- tp_remove_preserves_added (matches Coq) -/
theorem tp_remove_preserves_added : ∀ s v, fst (tp_remove s v) = fst s := by
  rfl

/-- tp_lookup_false_not_added (matches Coq) -/
theorem tp_lookup_false_not_added : ∀ v, tp_lookup tp_empty v = false := by
  rfl

/-- tp_merge_add_visible (matches Coq) -/
theorem tp_merge_add_visible : ∀ a b v, gs_member (fst a) v = true → gs_member (snd a) v = false → gs_member (gs_merge (snd a) (snd b)) v = false → tp_lookup (tp_merge a b) v = true := by
  simp_all [Bool.and_eq_true]

/-- tp_merge_preserves_removal (matches Coq) -/
theorem tp_merge_preserves_removal : ∀ (a b : TwoPSet) v, gs_member (snd a) v = true → gs_member (gs_merge (snd a) (snd b)) v = true := by
  simp_all [Bool.and_eq_true]

/-- tp_once_removed_stays_removed (matches Coq) -/
theorem tp_once_removed_stays_removed : ∀ s v ops, gs_member (snd s) v = true → gs_member (snd (fold_left (fun acc op => tp_merge acc op) ops s)) v = true := by
  simp_all [Bool.and_eq_true]

/-- lww_merge_comm (matches Coq) -/
theorem lww_merge_comm : ∀ a b, lww_merge a b = lww_merge b a := by
  cases ‹_› <;> simp <;> omega

/-- lww_merge_idem (matches Coq) -/
theorem lww_merge_idem : ∀ a, lww_merge a a = a := by
  cases ‹_› <;> simp <;> omega

/-- lww_merge_assoc_idem (matches Coq) -/
theorem lww_merge_assoc_idem : ∀ a, lww_merge (lww_merge a a) a = lww_merge a a := by
  simp_all [Bool.and_eq_true]

/-- lww_write_higher_wins (matches Coq) -/
theorem lww_write_higher_wins : ∀ r v1 v2 ts1 ts2, ts1 < ts2 → lww_merge (lww_write r v1 ts1) (lww_write r v2 ts2) = mkLWW v2 ts2 := by
  cases ‹_› <;> simp <;> omega

/-- lww_read_after_write (matches Coq) -/
theorem lww_read_after_write : ∀ r v ts, lww_read (lww_write r v ts) = v := by
  rfl

/-- lww_merge_ts_nondecreasing (matches Coq) -/
theorem lww_merge_ts_nondecreasing : ∀ a b, lww_ts (lww_merge a b) ≥ lww_ts a := by
  cases ‹_› <;> simp <;> omega

/-- lww_merge_ts_max (matches Coq) -/
theorem lww_merge_ts_max : ∀ a b, lww_ts (lww_merge a b) = Nat.max (lww_ts a) (lww_ts b) := by
  cases ‹_› <;> simp <;> omega

/-- lww_bottom_merge_l (matches Coq) -/
theorem lww_bottom_merge_l : ∀ r, lww_ts r ≥ 0 → lww_merge lww_bottom r = r := by
  cases ‹_› <;> simp <;> omega

/-- lww_concurrent_same_ts (matches Coq) -/
theorem lww_concurrent_same_ts : ∀ v1 v2 ts, lww_merge (mkLWW v1 ts) (mkLWW v2 ts) = lww_merge (mkLWW v2 ts) (mkLWW v1 ts) := by
  simp_all [Bool.and_eq_true]

/-- lww_merge_either (matches Coq) -/
theorem lww_merge_either : ∀ a b, lww_merge a b = a ∨ lww_merge a b = b := by
  rfl

/-- or_entry_eqb_refl (matches Coq) -/
theorem or_entry_eqb_refl : ∀ e, or_entry_eqb e e = true := by
  simp

/-- existsb_app (matches Coq) -/
theorem existsb_app : ∀ {A} (f : A → bool) l1 l2, ∃b f (l1 ++ l2) = ∃b f l1 || ∃b f l2 := by
  rfl

/-- or_add_lookup (matches Coq) -/
theorem or_add_lookup : ∀ s v tag, or_in_list (v, tag) (snd s) = false → or_lookup (or_add s v tag) v = true := by
  simp

