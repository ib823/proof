/-- Theorem 1: Agreement — If the configuration satisfies decided_nodes_agree,
    then any two honest decided nodes have the same decision. -/
theorem agreement :
    ∀ (c : Config) (n1 n2 : Node),
      decided_nodes_agree c →
      n1 ∈ c.nodes → n2 ∈ c.nodes →
      honest_decided c n1 → honest_decided c n2 →
      n1.node_decision = n2.node_decision := by
  intro c n1 n2 hagree hin1 hin2 hd1 hd2
  exact hagree n1 n2 hin1 hin2 hd1 hd2

/-- Theorem 2: Validity — If all honest nodes propose v, and the protocol
    decides based on honest proposals, then the decision equals v. -/
theorem validity :
    ∀ (c : Config) (nd : Node) (v : Nat),
      all_honest_propose c v →
      nd ∈ c.nodes →
      c.honest nd.node_id = true →
      nd.node_decision = nd.node_value →
      nd.node_decision = v := by
  intro c nd v hallv hin hhonest hfollow
  rw [hfollow]
  exact hallv nd hin hhonest

/-- Theorem 3: Quorum Intersection (pigeonhole) — if |Q1| + |Q2| > total, they intersect. -/
theorem pigeonhole_overlap :
    ∀ (n a b : Nat),
      a ≤ n → b ≤ n → a + b > n →
      a + b - n ≥ 1 := by
  omega

/-- quorum_intersection_size (matches Coq) -/
theorem quorum_intersection_size :
    ∀ (n q1_size q2_size : Nat),
      q1_size + q2_size > n →
      q1_size ≤ n → q2_size ≤ n →
      q1_size + q2_size - n ≥ 1 := by
  omega

/-- quorum_intersection (matches Coq) -/
theorem quorum_intersection :
    ∀ (n q1s q2s : Nat),
      3 * q1s > 2 * n →
      3 * q2s > 2 * n →
      q1s ≤ n → q2s ≤ n →
      q1s + q2s > n := by
  omega

/-- Theorem 4: Round Monotonicity -/
theorem round_monotonicity :
    ∀ (old new_ : Node),
      round_update old new_ →
      new_.node_round ≥ old.node_round := by
  intro old new_ ⟨_, h⟩
  exact h

/-- round_monotonicity_transitive (matches Coq) -/
theorem round_monotonicity_transitive :
    ∀ (a b c_ : Node),
      a.node_id = b.node_id → b.node_id = c_.node_id →
      b.node_round ≥ a.node_round →
      c_.node_round ≥ b.node_round →
      c_.node_round ≥ a.node_round := by
  intro a b c_ _ _ hab hbc
  omega

/-- Theorem 5: Vote Uniqueness -/
theorem vote_uniqueness :
    ∀ (c : Config) (v1 v2 : Vote),
      honest_votes_once_per_round c →
      v1 ∈ c.votes → v2 ∈ c.votes →
      c.honest v1.vote_sender = true →
      v1.vote_sender = v2.vote_sender →
      v1.vote_round = v2.vote_round →
      v1.vote_value = v2.vote_value := by
  intro c v1 v2 huniq hin1 hin2 hhon hsender hround
  exact huniq v1 v2 hin1 hin2 hhon hsender hround

/-- Theorem 6: Quorum Sufficiency — When f < n/3, honest nodes (n - f) form a quorum (> 2n/3). -/
theorem quorum_sufficiency :
    ∀ (n f : Nat),
      n > 0 →
      3 * f < n →
      3 * (n - f) > 2 * n := by
