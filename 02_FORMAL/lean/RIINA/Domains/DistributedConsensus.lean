/-- Theorem 8: Decision Stability -/
theorem decision_stability_thm :
    ∀ (nd_before nd_after : Node),
      decision_stable nd_before nd_after →
      nd_before.node_id = nd_after.node_id →
      nd_before.node_decided = true →
      nd_after.node_decided = true ∧ nd_after.node_decision = nd_before.node_decision := by
