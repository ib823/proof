  simp [mem_nat, existsb, List.any, BEq.beq]

/-- Theorem 16: Quorum size is positive when num_nodes > 0 -/
theorem quorum_size_pos :
    ∀ (c : Config),
      c.num_nodes > 0 → quorum_size c ≥ 1 := by
  intro c _
  unfold quorum_size
  omega

/-- Theorem 17: Agreement is preserved when adding non-decided node -/
theorem agreement_non_decided :
    ∀ (c : Config) (n1 n2 : Node),
      decided_nodes_agree c →
      n1 ∈ c.nodes → n2 ∈ c.nodes →
      honest_decided c n1 →
      n2.node_decided = false →
      True := by
  intros; trivial

/-- Theorem 18: Round update is reflexive -/
theorem round_update_refl :
    ∀ (nd : Node), round_update nd nd := by
  intro nd
  exact ⟨rfl, Nat.le_refl _⟩

/-- Theorem 19: BFT for f=0 any positive n works -/
