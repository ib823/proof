/-- Theorem 10: Two quorums share an honest node -/
theorem two_quorums_share_honest :
    ∀ (n f q1 q2 : Nat),
      3 * f < n →
      3 * q1 > 2 * n →
      3 * q2 > 2 * n →
      q1 ≤ n → q2 ≤ n →
      q1 + q2 - n ≥ 1 ∧ q1 + q2 - n > f := by
  intro n f q1 q2 hf hq1 hq2 hq1n hq2n
  constructor <;> omega

/-- Theorem 11: BFT requires at least 4 nodes for f=1 -/
theorem bft_min_nodes_f1 :
