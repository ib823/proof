  intro op row
  simp [in_row, existsb, List.any_eq_true]
  constructor
  · rintro ⟨x, hx_mem, hx_eq⟩
    have := (effectOp_eqb_eq op x).mp hx_eq
    subst this; exact hx_mem
  · intro h
    exact ⟨op, h, effectOp_eqb_refl op⟩

/-- row_subset_incl (matches Coq) -/
