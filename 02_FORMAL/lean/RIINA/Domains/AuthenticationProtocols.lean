-- Helper lemma for simp to unfold password_secure
private theorem password_secure_unfold (p : PasswordSecurity) :
    password_secure p = (p.pwd_bcrypt_argon && p.pwd_salt_unique && p.pwd_min_entropy && p.pwd_breach_check) := rfl

-- Helper lemma for simp to unfold mfa_secure
private theorem mfa_secure_unfold (m : MFASecurity) :
    mfa_secure m = (m.mfa_totp_support && m.mfa_webauthn && m.mfa_backup_codes && m.mfa_recovery) := rfl

-- Helper lemma for simp to unfold session_secure
private theorem session_secure_unfold (s : SessionSecurity) :
    session_secure s = (s.sess_secure_token && s.sess_rotation && s.sess_timeout && s.sess_binding) := rfl

-- Helper lemma for simp to unfold auth_complete
private theorem auth_complete_unfold (a : AuthConfig) :
    auth_complete a = (password_secure a.auth_pwd && mfa_secure a.auth_mfa && session_secure a.auth_session) := rfl

-- Helper lemma for simp to unfold pbkdf2_secure
private theorem pbkdf2_secure_unfold (cfg : PBKDF2Config) :
    pbkdf2_secure cfg = ((600000 <=? cfg.pbkdf2_iterations) && (128 <=? cfg.pbkdf2_salt_bits) && (256 <=? cfg.pbkdf2_output_bits) && (cfg.pbkdf2_hash_alg <=? 1)) := rfl

-- Helper lemma for simp to unfold argon2_secure
private theorem argon2_secure_unfold (cfg : Argon2Config) :
    argon2_secure cfg = ((3 <=? cfg.argon2_time_cost) && (65536 <=? cfg.argon2_memory_cost) && (1 <=? cfg.argon2_parallelism) && (128 <=? cfg.argon2_salt_bits) && (256 <=? cfg.argon2_output_bits) && (cfg.argon2_variant =? 2)) := rfl

-- Helper lemma for simp to unfold bcrypt_secure
private theorem bcrypt_secure_unfold (cfg : BcryptConfig) :
    bcrypt_secure cfg = ((12 <=? cfg.bcrypt_cost_factor) && (cfg.bcrypt_salt_bits =? 128) && (cfg.bcrypt_output_bits =? 184)) := rfl

-- Helper lemma for simp to unfold totp_secure
private theorem totp_secure_unfold (cfg : TOTPConfig) :
    totp_secure cfg = ((160 <=? cfg.totp_secret_bits) && (6 <=? cfg.totp_digits) && (cfg.totp_period =? 30) && (cfg.totp_drift_window <=? 1)) := rfl

-- Helper lemma for simp to unfold webauthn_secure
private theorem webauthn_secure_unfold (cfg : WebAuthnConfig) :
    webauthn_secure cfg = ((cfg.webauthn_user_verification =? 2) && (128 <=? cfg.webauthn_challenge_bits) && (60000 <=? cfg.webauthn_timeout_ms) && (cfg.webauthn_timeout_ms <=? 300000)) := rfl

-- Helper lemma for simp to unfold session_token_secure
private theorem session_token_secure_unfold (cfg : SessionTokenConfig) :
    session_token_secure cfg = ((256 <=? cfg.token_entropy_bits) && (86400 <=? cfg.token_expiry_seconds) && (cfg.token_expiry_seconds <=? 604800) && cfg.token_rotation && cfg.token_binding && cfg.token_secure_flag && cfg.token_httponly_flag && (1 <=? cfg.token_samesite)) := rfl

-- Helper lemma for simp to unfold oauth2_secure
private theorem oauth2_secure_unfold (cfg : OAuth2Config) :
    oauth2_secure cfg = (cfg.oauth2_pkce && cfg.oauth2_state_param && (128 <=? cfg.oauth2_code_bits) && (cfg.oauth2_code_expiry <=? 60) && cfg.oauth2_refresh_rotation) := rfl

-- Helper lemma for simp to unfold oidc_secure
private theorem oidc_secure_unfold (cfg : OIDCConfig) :
    oidc_secure cfg = (oauth2_secure cfg.oidc_base && (1 <=? cfg.oidc_id_token_alg) && (cfg.oidc_id_token_expiry <=? 3600) && cfg.oidc_claims_verified) := rfl

-- Helper lemma for simp to unfold challenge_secure
private theorem challenge_secure_unfold (cfg : ChallengeConfig) :
    challenge_secure cfg = ((128 <=? cfg.challenge_bits) && (cfg.challenge_expiry_ms <=? 300000) && cfg.challenge_single_use && cfg.challenge_bound) := rfl

-- Helper lemma for simp to unfold replay_prevention_secure
private theorem replay_prevention_secure_unfold (cfg : NonceTracker) :
    replay_prevention_secure cfg = ((128 <=? cfg.nonce_size_bits) && (1000 <=? cfg.nonce_window_size) && (cfg.nonce_timestamp_bound <=? 300)) := rfl

-- Nat.leb/eqb simp lemmas
private theorem leb_true_iff (n m : Nat) : (n <=? m) = true ↔ n ≤ m := by
  simp only [Nat.leb, decide_eq_true_eq]

private theorem eqb_true_iff (n m : Nat) : (n =? m) = true ↔ n = m := by
  simp only [Nat.eqb, beq_iff_eq]

