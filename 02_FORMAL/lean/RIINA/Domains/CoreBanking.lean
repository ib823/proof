/-- fold_left_add_acc_general (matches Coq) -/
theorem fold_left_add_acc_general :
    ∀ (A : Type) (f : A → Z) (l : List A) (acc : Z),
    List.foldl (fun a x => a + f x) acc l =
    acc + List.foldl (fun a x => a + f x) 0 l := by
  intro A f l
  induction l with
  | nil => intro acc; simp [List.foldl]
  | cons hd tl ih =>
    intro acc
    simp only [List.foldl]
    rw [ih (acc + f hd), ih (0 + f hd)]
    simp only [Int.add_assoc, Int.zero_add]

/-- BANK_001_08_double_entry_invariant (matches Coq) -/
theorem BANK_001_08_double_entry_invariant :
    ∀ (entries : List JournalEntry), valid_entries entries →
    debits entries = credits entries := by
  intro entries hvalid
  simp only [debits, credits]
  induction entries with
  | nil => simp [List.foldl]
  | cons hd tl ih =>
    simp only [List.foldl]
    have hv := hvalid hd (List.mem_cons_self hd tl)
    simp [valid_entry] at hv
    have htl : valid_entries tl := by
      intro e he; exact hvalid e (List.mem_cons_of_mem hd he)
    rw [fold_left_add_acc_general _ (fun e => e.debit_amount) tl]
    rw [fold_left_add_acc_general _ (fun e => e.credit_amount) tl]
    have ih' := ih htl
    simp only [debits, credits] at ih'
    rw [ih']
    obtain ⟨heq, _⟩ := hv
    simp only [Int.add_assoc, Int.zero_add]
    exact congrArg (· + List.foldl (fun a x => a + x.credit_amount) 0 tl) heq

