/-- exp_rel_step1_app_typed (matches Coq) -/
theorem exp_rel_step1_app_typed :
    ∀ St T1 T2 f f' a a' st1 st2 ctx St' ε ε',
      has_type nil St' Public f (TFn T1 T2 ε) ε' →
      has_type nil St' Public f' (TFn T1 T2 ε) ε' →
      value f → value f' →
      value a → value a' →
      store_rel_0 St' st1 st2 →
      store_ty_extends St St' →
      (∀ x body, f = ELam x T1 body → terminates ([x := a] body) st1 ctx) →
      (∀ x body, f' = ELam x T1 body → terminates ([x := a'] body) st2 ctx) →
      ∃ r1 r2 st1' st2' ctx1' ctx2' St'',
        store_ty_extends St' St'' ∧
        (EApp f a, st1, ctx) -→* (r1, st1', ctx1') ∧
        (EApp f' a', st2, ctx) -→* (r2, st2', ctx2') ∧
        value r1 ∧ value r2 ∧
        val_rel_0 St'' T2 r1 r2 ∧
        store_rel_0 St'' st1' st2' := by
  intro St T1 T2 f f' a a' st1 st2 ctx St' ε ε'
        htyp htyp' hvalf hvalf' hvala hvala' _hsr _hext hterm hterm'
  obtain ⟨x, body, rfl⟩ := canonical_forms_fn hvalf htyp
  obtain ⟨x', body', rfl⟩ := canonical_forms_fn hvalf' htyp'
  obtain ⟨r1, st1'', ctx1'', hms1, hvr1⟩ := hterm x body rfl
  obtain ⟨r2, st2'', ctx2'', hms2, hvr2⟩ := hterm' x' body' rfl
  refine ⟨r1, r2, st1'', st2'', ctx1'', ctx2'', St', ste_refl St',
          ?_, ?_, hvr1, hvr2, trivial, trivial⟩
  · exact multi_step.MS_Step _ _ _ (step.ST_AppAbs _ _ _ _ _ _ hvala)
           (multi_step_trans _ _ _ hms1 (multi_step.MS_Refl _))
  · exact multi_step.MS_Step _ _ _ (step.ST_AppAbs _ _ _ _ _ _ hvala')
           (multi_step_trans _ _ _ hms2 (multi_step.MS_Refl _))

/-! ## Multi-step / step composition -/

-- Multi-step composed with single step
/-- multi_step_step_left (matches Coq) -/
theorem multi_step_step_left :
    ∀ cfg1 cfg2 cfg3 : config,
      cfg1 -→ cfg2 → cfg2 -→* cfg3 → cfg1 -→* cfg3 := by
  intro cfg1 cfg2 cfg3 hs hm
  exact multi_step.MS_Step _ _ _ hs hm

/-! ## Trivial relation properties -/

-- val_rel_0 is trivially true for any type
/-- val_rel_0_trivial (matches Coq) -/
theorem val_rel_0_trivial : ∀ St T v1 v2, val_rel_0 St T v1 v2 := by
  intro _ _ _ _; exact trivial

-- store_rel_0 is trivially true for any stores
/-- store_rel_0_trivial (matches Coq) -/
theorem store_rel_0_trivial : ∀ St st1 st2, store_rel_0 St st1 st2 := by
  intro _ _ _; exact trivial

-- val_rel_0 is irrelevant to the type parameter
/-- val_rel_0_type_irrelevant (matches Coq) -/
theorem val_rel_0_type_irrelevant :
    ∀ St T1 T2 v1 v2, val_rel_0 St T1 v1 v2 ↔ val_rel_0 St T2 v1 v2 := by
  intro _ _ _ _ _; exact ⟨fun _ => trivial, fun _ => trivial⟩

-- val_rel_0 is irrelevant to the store typing
/-- val_rel_0_store_irrelevant (matches Coq) -/
theorem val_rel_0_store_irrelevant :
    ∀ St1 St2 T v1 v2, val_rel_0 St1 T v1 v2 ↔ val_rel_0 St2 T v1 v2 := by
  intro _ _ _ _ _; exact ⟨fun _ => trivial, fun _ => trivial⟩

-- store_rel_0 is symmetric
/-- store_rel_0_sym (matches Coq) -/
theorem store_rel_0_sym : ∀ St st1 st2, store_rel_0 St st1 st2 → store_rel_0 St st2 st1 := by
  intro _ _ _ _; exact trivial

/-! ## Termination lemmas -/

-- Fst terminates in exactly one step on a pair value
/-- fst_terminates (matches Coq) -/
theorem fst_terminates :
    ∀ v1 v2 st ctx, value v1 → value v2 →
      terminates (EFst (EPair v1 v2)) st ctx := by
  intro v1 v2 st ctx hv1 hv2
  exact ⟨v1, st, ctx,
         multi_step.MS_Step _ _ _ (step.ST_Fst _ _ _ _ hv1 hv2) (multi_step.MS_Refl _),
         hv1⟩

-- Snd terminates in exactly one step on a pair value
/-- snd_terminates (matches Coq) -/
theorem snd_terminates :
    ∀ v1 v2 st ctx, value v1 → value v2 →
      terminates (ESnd (EPair v1 v2)) st ctx := by
  intro v1 v2 st ctx hv1 hv2
  exact ⟨v2, st, ctx,
         multi_step.MS_Step _ _ _ (step.ST_Snd _ _ _ _ hv1 hv2) (multi_step.MS_Refl _),
         hv2⟩

-- If with true terminates if the true branch terminates
/-- if_true_terminates (matches Coq) -/
theorem if_true_terminates :
    ∀ e2 e3 st ctx, terminates e2 st ctx →
      terminates (EIf (EBool true) e2 e3) st ctx := by
  intro e2 e3 st ctx ⟨v, st', ctx', hms, hv⟩
  exact ⟨v, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_IfTrue _ _ _ _)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hv⟩

-- If with false terminates if the false branch terminates
/-- if_false_terminates (matches Coq) -/
theorem if_false_terminates :
    ∀ e2 e3 st ctx, terminates e3 st ctx →
      terminates (EIf (EBool false) e2 e3) st ctx := by
  intro e2 e3 st ctx ⟨v, st', ctx', hms, hv⟩
  exact ⟨v, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_IfFalse _ _ _ _)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hv⟩

-- Let terminates if the substituted body terminates
/-- let_terminates (matches Coq) -/
theorem let_terminates :
    ∀ x v e2 st ctx, value v → terminates ([x := v] e2) st ctx →
      terminates (ELet x v e2) st ctx := by
  intro x v e2 st ctx hval ⟨r, st', ctx', hms, hr⟩
  exact ⟨r, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_LetVal _ _ _ _ _ hval)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hr⟩

-- App terminates if the substituted body terminates
/-- app_lam_terminates (matches Coq) -/
theorem app_lam_terminates :
    ∀ x T body v st ctx, value v → terminates ([x := v] body) st ctx →
      terminates (EApp (ELam x T body) v) st ctx := by
  intro x T body v st ctx hval ⟨r, st', ctx', hms, hr⟩
  exact ⟨r, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_AppAbs _ _ _ _ _ _ hval)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hr⟩

-- Values terminate immediately
/-- value_terminates (matches Coq) -/
theorem value_terminates :
    ∀ v st ctx, value v → terminates v st ctx := by
  intro v st ctx hv
  exact ⟨v, st, ctx, multi_step.MS_Refl _, hv⟩

/-- case_inl_terminates (matches Coq) -/
theorem case_inl_terminates :
    ∀ v T x1 e1 x2 e2 st ctx, value v → terminates ([x1 := v] e1) st ctx →
      terminates (ECase (EInl v T) x1 e1 x2 e2) st ctx := by
  intro v T x1 e1 x2 e2 st ctx hv ⟨r, st', ctx', hms, hr⟩
  exact ⟨r, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_CaseInl _ _ _ _ _ _ _ _ hv)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hr⟩

/-- case_inr_terminates (matches Coq) -/
theorem case_inr_terminates :
    ∀ v T x1 e1 x2 e2 st ctx, value v → terminates ([x2 := v] e2) st ctx →
      terminates (ECase (EInr v T) x1 e1 x2 e2) st ctx := by
  intro v T x1 e1 x2 e2 st ctx hv ⟨r, st', ctx', hms, hr⟩
  exact ⟨r, st', ctx',
         multi_step.MS_Step _ _ _ (step.ST_CaseInr _ _ _ _ _ _ _ _ hv)
           (multi_step_trans _ _ _ hms (multi_step.MS_Refl _)),
         hr⟩

