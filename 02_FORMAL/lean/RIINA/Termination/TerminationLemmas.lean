/-- terminates_trans (matches Coq) -/
theorem terminates_trans :
    ∀ e e' st st' ctx ctx',
      (e, st, ctx) -→* (e', st', ctx') →
      terminates e' st' ctx' →
      terminates e st ctx := by
  intro e e' st st' ctx ctx' hms ⟨v, st'', ctx'', hms', hv⟩
  exact ⟨v, st'', ctx'', multi_step_trans _ _ _ hms hms', hv⟩

/-- value_terminates_refl (matches Coq) -/
theorem value_terminates_refl :
    ∀ v st ctx, value v → terminates v st ctx := by
  intro v st ctx hv
  exact ⟨v, st, ctx, multi_step.MS_Refl _, hv⟩

-- val_rel_0 is reflexive
/-- val_rel_0_refl (matches Coq) -/
theorem val_rel_0_refl : ∀ St T v, val_rel_0 St T v v := by
  intro _ _ _; exact trivial

-- val_rel_0 is symmetric
/-- val_rel_0_sym (matches Coq) -/
theorem val_rel_0_sym :
    ∀ St T v1 v2, val_rel_0 St T v1 v2 → val_rel_0 St T v2 v1 := by
  intro _ _ _ _ _; exact trivial

-- store_rel_0 is transitive
/-- store_rel_0_trans (matches Coq) -/
theorem store_rel_0_trans :
    ∀ St st1 st2 st3, store_rel_0 St st1 st2 → store_rel_0 St st2 st3 →
      store_rel_0 St st1 st3 := by
  intro _ _ _ _ _ _; exact trivial

-- If e steps to e' and e' terminates, then e terminates
/-- terminates_step (matches Coq) -/
theorem terminates_step :
    ∀ e e' st st' ctx ctx',
      (e, st, ctx) -→ (e', st', ctx') →
      terminates e' st' ctx' →
      terminates e st ctx := by
  intro e e' st st' ctx ctx' hs ⟨v, st'', ctx'', hms, hv⟩
  exact ⟨v, st'', ctx'',
         multi_step.MS_Step _ _ _ hs hms,
         hv⟩

-- Combined if termination: if value is a bool and both branches terminate
/-- if_terminates (matches Coq) -/
theorem if_terminates :
    ∀ b e2 e3 st ctx, terminates e2 st ctx → terminates e3 st ctx →
      terminates (EIf (EBool b) e2 e3) st ctx := by
  intro b e2 e3 st ctx ht2 ht3
  cases b
  · -- false
    exact if_false_terminates e2 e3 st ctx ht3
  · -- true
    exact if_true_terminates e2 e3 st ctx ht2

