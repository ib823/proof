/-- exp_rel_step1_if_typed (matches Coq) -/
theorem exp_rel_step1_if_typed :
    ∀ St T v v' e2 e2' e3 e3' st1 st2 ctx St' ε,
      has_type nil St' Public v TBool ε →
      has_type nil St' Public v' TBool ε →
      value v → value v' →
      store_rel_0 St' st1 st2 →
      store_ty_extends St St' →
      terminates e2 st1 ctx → terminates e3 st1 ctx →
      terminates e2' st2 ctx → terminates e3' st2 ctx →
      ∃ r1 r2 st1' st2' ctx1' ctx2' St'',
        store_ty_extends St' St'' ∧
        (EIf v e2 e3, st1, ctx) -→* (r1, st1', ctx1') ∧
        (EIf v' e2' e3', st2, ctx) -→* (r2, st2', ctx2') ∧
        value r1 ∧ value r2 ∧
        val_rel_0 St'' T r1 r2 ∧
        store_rel_0 St'' st1' st2' := by
  intro St T v v' e2 e2' e3 e3' st1 st2 ctx St' ε
        htyp htyp' hval hval' _hsr _hext ht2 ht3 ht2' ht3'
  obtain ⟨b, rfl⟩ := canonical_forms_bool hval htyp
  obtain ⟨b', rfl⟩ := canonical_forms_bool hval' htyp'
  cases b <;> cases b'
  · -- b = false, b' = false
    obtain ⟨r1, st1'', ctx1'', hms1, hvr1⟩ := ht3
    obtain ⟨r2, st2'', ctx2'', hms2, hvr2⟩ := ht3'
    exact ⟨r1, r2, st1'', st2'', ctx1'', ctx2'', St', ste_refl St',
           multi_step.MS_Step _ _ _ (step.ST_IfFalse _ _ _ _) hms1,
           multi_step.MS_Step _ _ _ (step.ST_IfFalse _ _ _ _) hms2,
           hvr1, hvr2, trivial, trivial⟩
  · -- b = false, b' = true
    obtain ⟨r1, st1'', ctx1'', hms1, hvr1⟩ := ht3
    obtain ⟨r2, st2'', ctx2'', hms2, hvr2⟩ := ht2'
    exact ⟨r1, r2, st1'', st2'', ctx1'', ctx2'', St', ste_refl St',
           multi_step.MS_Step _ _ _ (step.ST_IfFalse _ _ _ _) hms1,
           multi_step.MS_Step _ _ _ (step.ST_IfTrue _ _ _ _) hms2,
           hvr1, hvr2, trivial, trivial⟩
  · -- b = true, b' = false
    obtain ⟨r1, st1'', ctx1'', hms1, hvr1⟩ := ht2
    obtain ⟨r2, st2'', ctx2'', hms2, hvr2⟩ := ht3'
    exact ⟨r1, r2, st1'', st2'', ctx1'', ctx2'', St', ste_refl St',
           multi_step.MS_Step _ _ _ (step.ST_IfTrue _ _ _ _) hms1,
           multi_step.MS_Step _ _ _ (step.ST_IfFalse _ _ _ _) hms2,
           hvr1, hvr2, trivial, trivial⟩
  · -- b = true, b' = true
    obtain ⟨r1, st1'', ctx1'', hms1, hvr1⟩ := ht2
    obtain ⟨r2, st2'', ctx2'', hms2, hvr2⟩ := ht2'
    exact ⟨r1, r2, st1'', st2'', ctx1'', ctx2'', St', ste_refl St',
           multi_step.MS_Step _ _ _ (step.ST_IfTrue _ _ _ _) hms1,
