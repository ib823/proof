theorem SN_step : ∀ e st ctx e' st' ctx',
    SN (e, st, ctx) → (e, st, ctx) -→ (e', st', ctx') → SN (e', st', ctx') := by
  intro e st ctx e' st' ctx' hsn hstep
  exact hsn.inv hstep

