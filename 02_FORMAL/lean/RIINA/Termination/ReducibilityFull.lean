/-- step_inv (matches Coq: Definition step_inv) -/
def step_inv (cfg1 cfg2 : config) : Prop :=
  let (e2, st2, ctx2) := cfg2
  let (e1, st1, ctx1) := cfg1
  (e2, st2, ctx2) -→ (e1, st1, ctx1)

/-- SN (matches Coq: Definition SN) -/
def SN (cfg : config) : Prop :=
  Acc step_inv cfg

/-- SN_expr (matches Coq: Definition SN_expr) -/
def SN_expr (e : expr) : Prop :=
  ∀ (st : store) (ctx : effect_ctx), SN (e, st, ctx)

/-- id_rho (matches Coq: Definition id_rho) -/
def id_rho : ident → expr :=
  fun x => EVar x

/-- extend_rho (matches Coq: Definition extend_rho) -/
def extend_rho (ρ : ident → expr) (x : ident) (v : expr) : ident → expr :=
  fun y => if String.eqb y x then v else ρ y

/-- subst_env (matches Coq: Definition subst_env) -/
def subst_env (ρ : ident → expr) (e : expr) : expr :=
  match e with
  | EUnit => EUnit
  | EBool b => EBool b
  | EInt n => EInt n
  | EString s => EString s
  | ELoc l => ELoc l
  | EVar x => ρ x
  | ELam x T body => ELam x T (subst_env (extend_rho ρ x (EVar x)) body)
  | EApp e1 e2 => EApp (subst_env ρ e1) (subst_env ρ e2)
  | EPair e1 e2 => EPair (subst_env ρ e1) (subst_env ρ e2)
  | EFst e1 => EFst (subst_env ρ e1)
  | ESnd e1 => ESnd (subst_env ρ e1)
  | EInl e1 T => EInl (subst_env ρ e1) T
  | EInr e1 T => EInr (subst_env ρ e1) T
  | ECase e0 y1 e1 y2 e2 =>
      ECase (subst_env ρ e0)
        y1 (subst_env (extend_rho ρ y1 (EVar y1)) e1)
        y2 (subst_env (extend_rho ρ y2 (EVar y2)) e2)
  | EIf e1 e2 e3 => EIf (subst_env ρ e1) (subst_env ρ e2) (subst_env ρ e3)
  | ELet y e1 e2 => ELet y (subst_env ρ e1) (subst_env (extend_rho ρ y (EVar y)) e2)
  | EPerform eff e1 => EPerform eff (subst_env ρ e1)
  | EHandle e1 y h => EHandle (subst_env ρ e1) y (subst_env (extend_rho ρ y (EVar y)) h)
  | ERef e1 sl => ERef (subst_env ρ e1) sl
  | EDeref e1 => EDeref (subst_env ρ e1)
  | EAssign e1 e2 => EAssign (subst_env ρ e1) (subst_env ρ e2)
  | EClassify e1 => EClassify (subst_env ρ e1)
  | EDeclassify e1 e2 => EDeclassify (subst_env ρ e1) (subst_env ρ e2)
  | EProve e1 => EProve (subst_env ρ e1)
  | ERequire eff e1 => ERequire eff (subst_env ρ e1)
  | EGrant eff e1 => EGrant eff (subst_env ρ e1)

/-- closed_rho (matches Coq: Definition closed_rho) -/
def closed_rho (ρ : ident → expr) : Prop :=
  ∀ y, closed_expr (ρ y)

/-- neutral: an expression that is not a value -/
def neutral (e : expr) : Prop :=
  ¬ value e

/-- env_reducible: all bindings in the environment are reducible -/
def env_reducible (Γ : type_env) (ρ : ident → expr) : Prop :=
  ∀ x T, type_env_lookup x Γ = some T → SN_expr (ρ x)

/-- Reducible (matches Coq: Definition Reducible) -/
def Reducible (_T : ty) (e : expr) : Prop :=
  SN_expr e

