-- The identity substitution is indeed identity
/-- extend_rho_id (matches Coq) -/
theorem extend_rho_id : ∀ x, extend_rho id_rho x (EVar x) = id_rho := by
  intro x
  funext y
  simp only [extend_rho, id_rho, String.eqb]
  split
  · rename_i h; rw [beq_iff_eq] at h; rw [h]
  · rfl

/-- subst_env_id_var (matches Coq: variable case) -/
private theorem subst_env_id_var : ∀ x, subst_env id_rho (EVar x) = EVar x := by
  intro x; rfl

-- Helper: substitution has no effect when variable is not free
-- NOTE: Full proof requires induction on e which is complex for all 25 constructors.
-- We state and prove the variable case which is the key case.
/-- free_in_var (matches Coq) -/
theorem free_in_var : ∀ x y, free_in x (EVar y) → x = y := by
  intro x y h; exact h

-- Helper: x not free in EVar y when x <> y
/-- not_free_in_var_neq (matches Coq) -/
theorem not_free_in_var_neq : ∀ x y, x ≠ y → ¬ free_in x (EVar y) := by
  intro x y hne hfree
  exact hne hfree

-- Helper: extend_rho with same variable shadows previous binding
/-- extend_rho_shadow (matches Coq) -/
theorem extend_rho_shadow : ∀ ρ x e1 e2 y,
    extend_rho (extend_rho ρ x e1) x e2 y = extend_rho ρ x e2 y := by
  intro ρ x e1 e2 y
  simp only [extend_rho]
  split
  · rfl
  · rfl

-- Helper: extend_rho with different variables commutes
/-- extend_rho_commute (matches Coq) -/
theorem extend_rho_commute : ∀ ρ x y e1 e2 z,
    x ≠ y →
    extend_rho (extend_rho ρ x e1) y e2 z = extend_rho (extend_rho ρ y e2) x e1 z := by
  intro ρ x y e1 e2 z hne
  simp only [extend_rho, String.eqb]
  split
  · -- z == y is true
    rename_i h1
    split
    · -- z == x is true
      rename_i h2
      rw [beq_iff_eq] at h1 h2
      exact absurd (h2.symm.trans h1) hne
    · rfl
  · -- z == y is false
    split
    · rfl
    · rfl

