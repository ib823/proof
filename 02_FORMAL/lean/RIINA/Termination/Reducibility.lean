-- Values are strongly normalizing (no reduction possible)
/-- value_SN (matches Coq) -/
theorem value_SN : ∀ v st ctx, value v → SN_red st ctx v := by
  intro v st ctx hv
  apply Acc.intro
  intro ⟨e', st', ctx'⟩ hstep
  dsimp [step_inv_local] at hstep
  exact absurd hstep (value_not_step_local v st ctx e' st' ctx' hv)

-- SN is closed under single-step reduction
/-- SN_step (matches Coq) -/
theorem SN_step : ∀ e e' st st' ctx ctx',
    SN_red st ctx e → (e, st, ctx) -→ (e', st', ctx') → SN_red st' ctx' e' := by
  intro e e' st st' ctx ctx' hsn hstep
  cases hsn with
  | intro _ hf =>
    exact hf (e', st', ctx') hstep

-- SN values are irreducible
/-- SN_value_irreducible (matches Coq) -/
theorem SN_value_irreducible : ∀ v st ctx, value v → SN_red st ctx v →
    ∀ e' st' ctx', ¬ ((v, st, ctx) -→ (e', st', ctx')) := by
  intro v st ctx hv _ e' st' ctx' hstep
  exact value_not_step_local v st ctx e' st' ctx' hv hstep

-- SN is closed under multiple steps
/-- SN_multi_step_closed (matches Coq) -/
theorem SN_multi_step_closed : ∀ cfg cfg', cfg -→* cfg' →
    ∀ e st ctx e' st' ctx',
    cfg = (e, st, ctx) → cfg' = (e', st', ctx') →
    SN_red st ctx e → SN_red st' ctx' e' := by
  intro cfg cfg' hm
  induction hm with
  | MS_Refl _ =>
    intro e st ctx e' st' ctx' heq heq' hsn
    rw [heq] at heq'
    simp [Prod.mk.injEq] at heq'
    obtain ⟨rfl, rfl, rfl⟩ := heq'
    exact hsn
  | MS_Step cfg1 cfg2 cfg3 hs _ ih =>
    intro e st ctx e' st' ctx' heq1 heq3 hsn
    subst heq1
    obtain ⟨e2, st2, ctx2⟩ := cfg2
    have hsn2 : SN_red st2 ctx2 e2 := SN_step e e2 st st2 ctx ctx2 hsn hs
    exact ih e2 st2 ctx2 e' st' ctx' rfl heq3 hsn2

-- Unit is always SN
/-- unit_SN (matches Coq) -/
theorem unit_SN : ∀ st ctx, SN_red st ctx EUnit := by
  intro st ctx; exact value_SN EUnit st ctx value.VUnit

-- Bool is always SN
/-- bool_SN (matches Coq) -/
theorem bool_SN : ∀ b st ctx, SN_red st ctx (EBool b) := by
  intro b st ctx; exact value_SN (EBool b) st ctx (value.VBool b)

-- Int is always SN
/-- int_SN (matches Coq) -/
theorem int_SN : ∀ n st ctx, SN_red st ctx (EInt n) := by
  intro n st ctx; exact value_SN (EInt n) st ctx (value.VInt n)

-- String is always SN
/-- string_SN (matches Coq) -/
theorem string_SN : ∀ s st ctx, SN_red st ctx (EString s) := by
  intro s st ctx; exact value_SN (EString s) st ctx (value.VString s)

-- Loc is always SN
/-- loc_SN (matches Coq) -/
theorem loc_SN : ∀ l st ctx, SN_red st ctx (ELoc l) := by
  intro l st ctx; exact value_SN (ELoc l) st ctx (value.VLoc l)

-- Lambda is always SN
/-- lam_SN (matches Coq) -/
theorem lam_SN : ∀ x T body st ctx, SN_red st ctx (ELam x T body) := by
  intro x T body st ctx
  exact value_SN (ELam x T body) st ctx (value.VLam x T body)

-- Pair of SN values is SN
/-- pair_SN (matches Coq) -/
theorem pair_SN : ∀ v1 v2 st ctx, value v1 → value v2 →
    SN_red st ctx (EPair v1 v2) := by
  intro v1 v2 st ctx hv1 hv2
  exact value_SN (EPair v1 v2) st ctx (value.VPair v1 v2 hv1 hv2)

-- Inl of SN value is SN
/-- inl_SN (matches Coq) -/
theorem inl_SN : ∀ v T st ctx, value v → SN_red st ctx (EInl v T) := by
  intro v T st ctx hv
  exact value_SN (EInl v T) st ctx (value.VInl v T hv)

-- Inr of SN value is SN
/-- inr_SN (matches Coq) -/
theorem inr_SN : ∀ v T st ctx, value v → SN_red st ctx (EInr v T) := by
  intro v T st ctx hv
  exact value_SN (EInr v T) st ctx (value.VInr v T hv)

-- Classify of value is SN
/-- classify_value_SN (matches Coq) -/
theorem classify_value_SN : ∀ v st ctx, value v → SN_red st ctx (EClassify v) := by
  intro v st ctx hv
  exact value_SN (EClassify v) st ctx (value.VClassify v hv)

-- Prove of value is SN
/-- prove_SN (matches Coq) -/
theorem prove_SN : ∀ v st ctx, value v → SN_red st ctx (EProve v) := by
  intro v st ctx hv
  exact value_SN (EProve v) st ctx (value.VProve v hv)

