-- App with typed function value steps in one step
/-- app_typed_steps_once (matches Coq) -/
theorem app_typed_steps_once :
    ∀ f T1 T2 ε ε' σ a st ctx,
    has_type nil σ Public f (TFn T1 T2 ε) ε' → value f → value a →
    ∃ e' st' ctx', (EApp f a, st, ctx) -→ (e', st', ctx') ∧
      st' = st ∧ ctx' = ctx := by
  intro f T1 T2 ε ε' σ a st ctx ht hf ha
  obtain ⟨x, body, rfl⟩ := canonical_fn T1 T2 f σ ε ε' ht hf
  exact ⟨substExpr x a body, st, ctx,
    step.ST_AppAbs x T1 body a st ctx ha, rfl, rfl⟩

-- Case on inl steps to the left branch
/-- case_inl_typed_steps (matches Coq) -/
theorem case_inl_typed_steps :
    ∀ v T2 x1 e1 x2 e2 st ctx, value v →
    ∃ e' st' ctx', (ECase (EInl v T2) x1 e1 x2 e2, st, ctx) -→ (e', st', ctx') ∧
      e' = substExpr x1 v e1 ∧ st' = st ∧ ctx' = ctx := by
  intro v T2 x1 e1 x2 e2 st ctx hv
  exact ⟨substExpr x1 v e1, st, ctx,
    step.ST_CaseInl v T2 x1 e1 x2 e2 st ctx hv, rfl, rfl, rfl⟩

-- Case on inr steps to the right branch
/-- case_inr_typed_steps (matches Coq) -/
theorem case_inr_typed_steps :
    ∀ v T1 x1 e1 x2 e2 st ctx, value v →
    ∃ e' st' ctx', (ECase (EInr v T1) x1 e1 x2 e2, st, ctx) -→ (e', st', ctx') ∧
      e' = substExpr x2 v e2 ∧ st' = st ∧ ctx' = ctx := by
  intro v T1 x1 e1 x2 e2 st ctx hv
  exact ⟨substExpr x2 v e2, st, ctx,
    step.ST_CaseInr v T1 x1 e1 x2 e2 st ctx hv, rfl, rfl, rfl⟩

-- Fst of pair value steps to a value
/-- fst_pair_step_value (matches Coq) -/
theorem fst_pair_step_value :
    ∀ v1 v2 st ctx, value v1 → value v2 →
    ∃ v, (EFst (EPair v1 v2), st, ctx) -→ (v, st, ctx) ∧ value v := by
  intro v1 v2 st ctx hv1 hv2
  exact ⟨v1, step.ST_Fst v1 v2 st ctx hv1 hv2, hv1⟩

-- Snd of pair value steps to a value
/-- snd_pair_step_value (matches Coq) -/
theorem snd_pair_step_value :
    ∀ v1 v2 st ctx, value v1 → value v2 →
    ∃ v, (ESnd (EPair v1 v2), st, ctx) -→ (v, st, ctx) ∧ value v := by
  intro v1 v2 st ctx hv1 hv2
  exact ⟨v2, step.ST_Snd v1 v2 st ctx hv1 hv2, hv2⟩

-- App with lambda and value steps
/-- app_lam_steps (matches Coq) -/
theorem app_lam_steps :
    ∀ x T body v st ctx, value v →
    (EApp (ELam x T body) v, st, ctx) -→ (substExpr x v body, st, ctx) := by
  intro x T body v st ctx hv
  exact step.ST_AppAbs x T body v st ctx hv

