-- ============================================================================
-- Local SN definition (3-arg convenience wrapper)
-- ============================================================================

/-- step_inv for well-founded SN definition -/
private def step_inv_local (cfg1 cfg2 : config) : Prop :=
  let (e2, st2, ctx2) := cfg2
  let (e1, st1, ctx1) := cfg1
  (e2, st2, ctx2) -→ (e1, st1, ctx1)

/-- SN as 3-arg function matching Coq's `SN st ctx e` -/
def SN_red (st : store) (ctx : effect_ctx) (e : expr) : Prop :=
  Acc step_inv_local (e, st, ctx)

/-- strongly_normalizing (matches Coq: Definition strongly_normalizing) -/
def strongly_normalizing (e : expr) (st : store) (ctx : effect_ctx) : Prop :=
  SN_red st ctx e

-- ============================================================================
-- Canonical Forms (helpers for typed-stepping theorems)
-- ============================================================================

/-- A closed value of product type must be a pair of values -/
private theorem canonical_pair (T1 T2 : ty) :
    ∀ v St ε, has_type nil St Public v (TProd T1 T2) ε → value v →
    ∃ v1 v2, v = EPair v1 v2 ∧ value v1 ∧ value v2 := by
  intro v St ε ht hv
  cases hv with
  | VPair v1 v2 hv1 hv2 =>
    exact ⟨v1, v2, rfl, hv1, hv2⟩
  | VUnit => cases ht
  | VBool _ => cases ht
  | VInt _ => cases ht
  | VString _ => cases ht
  | VLoc _ => cases ht
  | VLam _ _ _ => cases ht
  | VInl _ _ _ => cases ht
  | VInr _ _ _ => cases ht
  | VClassify _ _ => cases ht
  | VProve _ _ => cases ht

/-- A closed value of sum type must be inl or inr -/
private theorem canonical_sum (T1 T2 : ty) :
    ∀ v St ε, has_type nil St Public v (TSum T1 T2) ε → value v →
    (∃ v1 T, v = EInl v1 T ∧ value v1) ∨ (∃ v2 T, v = EInr v2 T ∧ value v2) := by
  intro v St ε ht hv
  cases hv with
  | VInl v1 T1' hv1 => exact Or.inl ⟨v1, T1', rfl, hv1⟩
  | VInr v2 T2' hv2 => exact Or.inr ⟨v2, T2', rfl, hv2⟩
  | VUnit => cases ht
  | VBool _ => cases ht
  | VInt _ => cases ht
  | VString _ => cases ht
  | VLoc _ => cases ht
  | VLam _ _ _ => cases ht
  | VPair _ _ _ _ => cases ht
  | VClassify _ _ => cases ht
  | VProve _ _ => cases ht

/-- A closed value of bool type must be EBool -/
private theorem canonical_bool :
    ∀ v St ε, has_type nil St Public v TBool ε → value v →
    ∃ b, v = EBool b := by
  intro v St ε ht hv
  cases hv with
  | VBool b => exact ⟨b, rfl⟩
  | VUnit => cases ht
  | VInt _ => cases ht
  | VString _ => cases ht
  | VLoc _ => cases ht
  | VLam _ _ _ => cases ht
  | VPair _ _ _ _ => cases ht
  | VInl _ _ _ => cases ht
  | VInr _ _ _ => cases ht
  | VClassify _ _ => cases ht
  | VProve _ _ => cases ht

/-- A closed value of function type must be a lambda -/
private theorem canonical_fn (T1 T2 : ty) :
    ∀ v St ε ε', has_type nil St Public v (TFn T1 T2 ε) ε' → value v →
    ∃ x body, v = ELam x T1 body := by
  intro v St ε ε' ht hv
  cases hv with
  | VLam x T body => cases ht with | T_Lam => exact ⟨x, body, rfl⟩
  | VUnit => cases ht
  | VBool _ => cases ht
  | VInt _ => cases ht
  | VString _ => cases ht
  | VLoc _ => cases ht
  | VPair _ _ _ _ => cases ht
  | VInl _ _ _ => cases ht
  | VInr _ _ _ => cases ht
  | VClassify _ _ => cases ht
  | VProve _ _ => cases ht

-- ============================================================================
-- Helper: values don't step
-- ============================================================================

/-- Values do not step (used locally) -/
private theorem value_not_step_local : ∀ v st ctx e' st' ctx',
    value v → (v, st, ctx) -→ (e', st', ctx') → False := by
  intro v st ctx e' st' ctx' hv hs
  induction hv generalizing st ctx e' st' ctx' with
  | VUnit => exact nomatch hs
  | VBool _ => exact nomatch hs
  | VInt _ => exact nomatch hs
  | VString _ => exact nomatch hs
  | VLoc _ => exact nomatch hs
  | VLam _ _ _ => exact nomatch hs
  | VPair _ _ _ _ ih1 ih2 =>
    cases hs with
    | ST_Pair1 _ _ _ _ _ _ _ hs1 => exact ih1 _ _ _ _ _ hs1
    | ST_Pair2 _ _ _ _ _ _ _ _ hs2 => exact ih2 _ _ _ _ _ hs2
  | VInl _ _ _ ih =>
    cases hs with
    | ST_Inl1 _ _ _ _ _ _ _ hs1 => exact ih _ _ _ _ _ hs1
  | VInr _ _ _ ih =>
    cases hs with
    | ST_Inr1 _ _ _ _ _ _ _ hs1 => exact ih _ _ _ _ _ hs1
  | VClassify _ _ ih =>
    cases hs with
    | ST_Classify1 _ _ _ _ _ _ hs1 => exact ih _ _ _ _ _ hs1
  | VProve _ _ ih =>
    cases hs with
    | ST_Prove1 _ _ _ _ _ _ hs1 => exact ih _ _ _ _ _ hs1

