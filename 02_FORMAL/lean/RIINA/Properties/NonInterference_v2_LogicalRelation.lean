-- Decompose val_rel_n at TSum to get the sum structure
/-- val_rel_n_sum_decompose (matches Coq) -/
theorem val_rel_n_sum_decompose : ∀ n St T1 T2 v1 v2, n > 0 → val_rel_n n St (TSum T1 T2) v1 v2 → (∃ a1 a2, v1 = EInl a1 T2 ∧ v2 = EInl a2 T2 ∧ value a1 ∧ value a2 ∧ closed_expr a1 ∧ closed_expr a2 ∧ val_rel_at_type St (store_rel_n (n-1)) (val_rel_n (n-1)) (store_rel_n (n-1)) (store_vals_rel (n-1)) T1 a1 a2) ∨ (∃ b1 b2, v1 = EInr b1 T1 ∧ v2 = EInr b2 T1 ∧ value b1 ∧ value b2 ∧ closed_expr b1 ∧ closed_expr b2 ∧ val_rel_at_type St (store_rel_n (n-1)) (val_rel_n (n-1)) (store_rel_n (n-1)) (store_vals_rel (n-1)) T2 b1 b2) := by
  intro n St T1 T2 v1 v2 hn ⟨hv1, hv2, hc1, hc2, ht1, ht2, hfo⟩
  rcases canonical_forms_sum hv1 ht1 with ⟨a1, rfl, hva1⟩ | ⟨b1, rfl, hvb1⟩
  · -- v1 = EInl a1 T2
    rcases canonical_forms_sum hv2 ht2 with ⟨a2, rfl, hva2⟩ | ⟨b2, rfl, hvb2⟩
    · left
      refine ⟨a1, a2, rfl, rfl, hva1, hva2,
        fun x hf => hc1 x hf, fun x hf => hc2 x hf, ?_⟩
      simp only [first_order_type] at hfo
      split at hfo
      · exact hfo
      · trivial
    · -- v1 = EInl, v2 = EInr: contradicts val_rel_at_type_fo
      simp only [first_order_type] at hfo
      split at hfo
      · simp [val_rel_at_type_fo] at hfo
      · trivial
  · -- v1 = EInr b1 T1
    rcases canonical_forms_sum hv2 ht2 with ⟨a2, rfl, hva2⟩ | ⟨b2, rfl, hvb2⟩
    · -- v1 = EInr, v2 = EInl: contradicts val_rel_at_type_fo
      simp only [first_order_type] at hfo
      split at hfo
      · simp [val_rel_at_type_fo] at hfo
      · trivial
    · right
      refine ⟨b1, b2, rfl, rfl, hvb1, hvb2,
        fun x hf => hc1 x hf, fun x hf => hc2 x hf, ?_⟩
      simp only [first_order_type] at hfo
      split at hfo
      · exact hfo
      · trivial

