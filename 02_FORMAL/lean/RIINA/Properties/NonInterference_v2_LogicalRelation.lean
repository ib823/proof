  have hcb2 : closed_expr b2 := fun x hf => hc' x (Or.inr hf)
  obtain ⟨_, _, _, htb1, _⟩ := has_type_pair_inv St a1 b1 T1 T2 _ ht
  obtain ⟨_, _, _, htb2, _⟩ := has_type_pair_inv St a2 b2 T1 T2 _ ht'
  refine ⟨hvb1, hvb2, hcb1, hcb2, htb1, htb2, ?_⟩
  split
  · rename_i hfo2
    simp [first_order_type] at hfo
    split at hfo
    · rename_i hfo_prod
      have ⟨_, hf2⟩ := (andb_true_iff _ _).mp hfo_prod
      rw [if_pos hf2] at hfo ⊢
      exact hfo.2
    · rw [if_pos hfo2] at hfo; exact hfo
  · trivial

-- Construct val_rel_n for sum types from components
