-- Construct val_rel_n for products from components.
--     Requires typing premises for all component values, since
--     HO product types need has_type for the constructed pair.
/-- val_rel_n_prod_compose (matches Coq) -/
theorem val_rel_n_prod_compose : ∀ n St T1 T2 v1 v1' v2 v2', val_rel_n n St T1 v1 v1' → val_rel_n n St T2 v2 v2' → has_type nil St Public v1 T1 EffectPure → has_type nil St Public v1' T1 EffectPure → has_type nil St Public v2 T2 EffectPure → has_type nil St Public v2' T2 EffectPure → val_rel_n n St (TProd T1 T2) (EPair v1 v2) (EPair v1' v2') := by
  intro n St T1 T2 v1 v1' v2 v2' h1 h2 ht1 ht1' ht2 ht2'
  refine ⟨value.VPair _ _ h1.1 h2.1, value.VPair _ _ h1.2.1 h2.2.1,
    fun x hf => hf.elim (h1.2.2.1 x) (h2.2.2.1 x),
    fun x hf => hf.elim (h1.2.2.2.1 x) (h2.2.2.2.1 x),
    has_type.T_Pair ht1 ht2, has_type.T_Pair ht1' ht2', ?_⟩
  simp [first_order_type]
  split
  · rename_i hfo
    have ⟨hfo1, hfo2⟩ := (andb_true_iff _ _).mp hfo
    constructor
    · rw [if_pos hfo1] at h1; exact h1.2.2.2.2.2.2
    · rw [if_pos hfo2] at h2; exact h2.2.2.2.2.2.2
  · trivial

-- Extract val_rel_n for first projection from product (general version).
--     This works for any type because val_rel_at_type for products
--     recursively contains val_rel_at_type for components at the same level.
/-- val_rel_n_from_prod_fst (matches Coq) -/
theorem val_rel_n_from_prod_fst : ∀ n St T1 T2 a1 b1 a2 b2, n > 0 → val_rel_n n St (TProd T1 T2) (EPair a1 b1) (EPair a2 b2) → val_rel_n n St T1 a1 a2 := by
  intro n St T1 T2 a1 b1 a2 b2 _ ⟨hv, hv', hc, hc', ht, ht', hfo⟩
  have ⟨hva1, _⟩ := value_pair_inv _ _ hv
  have ⟨hva2, _⟩ := value_pair_inv _ _ hv'
  have hca1 : closed_expr a1 := fun x hf => hc x (Or.inl hf)
  have hca2 : closed_expr a2 := fun x hf => hc' x (Or.inl hf)
  obtain ⟨_, _, hta1, _⟩ := has_type_pair_inv St a1 b1 T1 T2 _ ht
  obtain ⟨_, _, hta2, _⟩ := has_type_pair_inv St a2 b2 T1 T2 _ ht'
  refine ⟨hva1, hva2, hca1, hca2, hta1, hta2, ?_⟩
  split
  · rename_i hfo1
    simp [first_order_type] at hfo
    split at hfo
    · rename_i hfo_prod
      have ⟨hf1, _⟩ := (andb_true_iff _ _).mp hfo_prod
      rw [if_pos hf1] at hfo ⊢
      exact hfo.1
    · rw [if_pos hfo1] at hfo; exact hfo
  · trivial

-- Extract val_rel_n for second projection from product (general version).
/-- val_rel_n_from_prod_snd (matches Coq) -/
theorem val_rel_n_from_prod_snd : ∀ n St T1 T2 a1 b1 a2 b2, n > 0 → val_rel_n n St (TProd T1 T2) (EPair a1 b1) (EPair a2 b2) → val_rel_n n St T2 b1 b2 := by
