-- Extract equal booleans from val_rel_n at TBool
/-- val_rel_n_bool_eq (matches Coq) -/
theorem val_rel_n_bool_eq : ∀ n St v1 v2, n > 0 → val_rel_n n St TBool v1 v2 → ∃ b, v1 = EBool b ∧ v2 = EBool b := by
  intro n St v1 v2 _ ⟨hv1, hv2, _, _, ht1, ht2, hfo⟩
  simp [first_order_type] at hfo
  -- val_rel_at_type_fo TBool v1 v2 means v1 = EBool b1, v2 = EBool b2, b1 = b2
