-- Helper to extract val_rel_at_type from val_rel_n for products.
--     Note: With the cumulative structure, we get val_rel_at_type directly,
--     and can combine with value/closed properties separately if needed.
/-- val_rel_n_prod_decompose (matches Coq) -/
theorem val_rel_n_prod_decompose : ∀ n St T1 T2 v1 v2, n > 0 → val_rel_n n St (TProd T1 T2) v1 v2 → ∃ a1 b1 a2 b2, v1 = EPair a1 b1 ∧ v2 = EPair a2 b2 ∧ value a1 ∧ value b1 ∧ value a2 ∧ value b2 ∧ closed_expr a1 ∧ closed_expr b1 ∧ closed_expr a2 ∧ closed_expr b2 ∧ val_rel_at_type St (store_rel_n (n-1)) (val_rel_n (n-1)) (store_rel_n (n-1)) (store_vals_rel (n-1)) T1 a1 a2 ∧ val_rel_at_type St (store_rel_n (n-1)) (val_rel_n (n-1)) (store_rel_n (n-1)) (store_vals_rel (n-1)) T2 b1 b2 := by
  intro n St T1 T2 v1 v2 hn h
  obtain ⟨a1, b1, rfl, hva1, hvb1⟩ := canonical_forms_prod h.1 h.2.2.2.2.1
  obtain ⟨a2, b2, rfl, hva2, hvb2⟩ := canonical_forms_prod h.2.1 h.2.2.2.2.2.1
  refine ⟨a1, b1, a2, b2, rfl, rfl, hva1, hvb1, hva2, hvb2,
    fun x hf => h.2.2.1 x (Or.inl hf), fun x hf => h.2.2.1 x (Or.inr hf),
    fun x hf => h.2.2.2.1 x (Or.inl hf), fun x hf => h.2.2.2.1 x (Or.inr hf), ?_, ?_⟩
  -- val_rel_at_type = val_rel_at_type_fo, which follows from val_rel_n product structure
  · simp only [first_order_type] at h
    have h7 := h.2.2.2.2.2.2
    split at h7
    · exact h7.1
    · trivial
  · simp only [first_order_type] at h
    have h7 := h.2.2.2.2.2.2
    split at h7
    · exact h7.2
    · trivial

-- For first-order types, we can construct val_rel_n from val_rel_at_type.
--     This is a general building lemma for first-order types.
/-- val_rel_n_of_first_order (matches Coq) -/
theorem val_rel_n_of_first_order : ∀ n St T v1 v2, first_order_type T = true → value v1 → value v2 → closed_expr v1 → closed_expr v2 → has_type nil St Public v1 T EffectPure → has_type nil St Public v2 T EffectPure → (∀ sp vl sl svp, val_rel_at_type St sp vl sl svp T v1 v2) → val_rel_n n St T v1 v2 := by
  intro n St T v1 v2 hfo hv1 hv2 hc1 hc2 ht1 ht2 hrel
  exact ⟨hv1, hv2, hc1, hc2, ht1, ht2, by rw [if_pos hfo]; exact hrel _ _ _ _⟩

-- LEMMA: For first-order types, convert val_rel_n to val_rel.
/-- val_rel_n_to_val_rel_fo (matches Coq) -/
theorem val_rel_n_to_val_rel_fo : ∀ St T v1 v2, first_order_type T = true → value v1 → value v2 → closed_expr v1 → closed_expr v2 → (∃ n, val_rel_n (S n) St T v1 v2) → val_rel St T v1 v2 := by
  intro St T v1 v2 _ _ _ _ _ ⟨n, h⟩ m; exact h

-- For first-order types, convert val_rel_at_type to val_rel.
--
--     REVOLUTIONARY CHANGE: Instead of axiomatizing value/closed extraction
--     from val_rel_at_type (which doesn't hold for TBytes/TSecret), we take
--     value and closed_expr as explicit premises. This allows callers who
--     already have these properties (from the strengthened TFn definition)
--     to use this lemma without needing unsound axioms.
--
--     This ELIMINATES 4 axioms:
--     - val_rel_at_type_value_left
--     - val_rel_at_type_value_right
--     - val_rel_at_type_closed_left
--     - val_rel_at_type_closed_right
/-- val_rel_at_type_to_val_rel_fo (matches Coq) -/
theorem val_rel_at_type_to_val_rel_fo : ∀ St sp vl sl svp T v1 v2, first_order_type T = true → val_rel_at_type St sp vl sl svp T v1 v2 → value v1 → value v2 → closed_expr v1 → closed_expr v2 → has_type nil St Public v1 T EffectPure → has_type nil St Public v2 T EffectPure → val_rel St T v1 v2 := by
  intro St sp vl sl svp T v1 v2 hfo hrel hv1 hv2 hc1 hc2 ht1 ht2 n
  exact ⟨hv1, hv2, hc1, hc2, ht1, ht2, by rw [if_pos hfo]; exact hrel⟩

/-- has_type_pair_inv (matches Coq) -/
theorem has_type_pair_inv : ∀ St e1 e2 T1 T2 ε, has_type nil St Public (EPair e1 e2) (TProd T1 T2) ε → ∃ ε1 ε2, has_type nil St Public e1 T1 ε1 ∧ has_type nil St Public e2 T2 ε2 ∧ ε = effect_join ε1 ε2 := by
  intro St e1 e2 T1 T2 ε h
  generalize hε : ε = ε' at *
  cases h with
  | T_Pair h1 h2 => exact ⟨_, _, h1, h2, rfl⟩

/-- val_rel_n_prod_fst (matches Coq) -/
theorem val_rel_n_prod_fst : ∀ n St T1 T2 v1 v2, first_order_type T1 = true → n > 0 → val_rel_n n St (TProd T1 T2) v1 v2 → ∃ a1 b1 a2 b2, v1 = EPair a1 b1 ∧ v2 = EPair a2 b2 ∧ val_rel_n n St T1 a1 a2 := by
  intro n St T1 T2 v1 v2 _ hn h
  obtain ⟨a1, b1, rfl, _, _⟩ := canonical_forms_prod h.1 h.2.2.2.2.1
  obtain ⟨a2, b2, rfl, _, _⟩ := canonical_forms_prod h.2.1 h.2.2.2.2.2.1
  exact ⟨a1, b1, a2, b2, rfl, rfl, val_rel_n_from_prod_fst n St T1 T2 a1 b1 a2 b2 hn h⟩

/-- val_rel_n_prod_snd (matches Coq) -/
theorem val_rel_n_prod_snd : ∀ n St T1 T2 v1 v2, first_order_type T2 = true → n > 0 → val_rel_n n St (TProd T1 T2) v1 v2 → ∃ a1 b1 a2 b2, v1 = EPair a1 b1 ∧ v2 = EPair a2 b2 ∧ val_rel_n n St T2 b1 b2 := by
  intro n St T1 T2 v1 v2 _ hn h
  obtain ⟨a1, b1, rfl, _, _⟩ := canonical_forms_prod h.1 h.2.2.2.2.1
  obtain ⟨a2, b2, rfl, _, _⟩ := canonical_forms_prod h.2.1 h.2.2.2.2.2.1
  exact ⟨a1, b1, a2, b2, rfl, rfl, val_rel_n_from_prod_snd n St T1 T2 a1 b1 a2 b2 hn h⟩

