  simp_all [Bool.and_eq_true]

-- Build unit relation
/-- val_rel_le_unit (matches Coq) -/
theorem val_rel_le_unit : ∀ n St, val_rel_le n St TUnit EUnit EUnit := by
  simp_all [Bool.and_eq_true]

-- Empty stores with empty store typing are trivially related
/-- store_rel_le_empty (matches Coq) -/
theorem store_rel_le_empty : ∀ n, store_rel_le n nil nil nil := by
  simp

-- Empty stores have simple relation
/-- store_rel_simple_empty (matches Coq) -/
theorem store_rel_simple_empty : ∀ St, store_rel_simple St nil nil := by
  simp

-- If store_rel_le holds, both stores have values at every typed location
/-- store_rel_le_both_some (matches Coq) -/
theorem store_rel_le_both_some : ∀ n St st1 st2 l T sl, store_rel_le n St st1 st2 → store_ty_lookup l St = Some (T, sl) → ∃ v1 v2, store_lookup l st1 = Some v1 ∧ store_lookup l st2 = Some v2 := by
  simp_all [Bool.and_eq_true]

-- store_ty_update preserves existing entries at different locations
/-- store_ty_update_preserves (matches Coq) -/
theorem store_ty_update_preserves : ∀ l1 l2 T1 sl1 T2 sl2 St, l1 ≠ l2 → store_ty_lookup l2 St = Some (T2, sl2) → store_ty_lookup l2 (store_ty_update l1 T1 sl1 St) = Some (T2, sl2) := by
  simp_all [Bool.and_eq_true]

-- store_max of nil is 0
/-- store_max_nil (matches Coq) -/
theorem store_max_nil : store_max nil = 0 := by
  rfl

-- store_max of singleton
/-- store_max_singleton (matches Coq) -/
theorem store_max_singleton : ∀ l v, store_max ((l, v) :: nil) = Nat.max l 0 := by
  rfl

-- Secret values at a typed location are always related
/-- store_rel_le_secret_loc (matches Coq) -/
theorem store_rel_le_secret_loc : ∀ n St st1 st2 l T, store_rel_le n St st1 st2 → store_ty_lookup l St = Some (TSecret T, Public) → ∃ v1 v2, store_lookup l st1 = Some v1 ∧ store_lookup l st2 = Some v2 ∧ val_rel_le n St (TSecret T) v1 v2 := by
  intro h; exact h

-- Fresh location has no store entry
/-- store_lookup_fresh_loc (matches Coq) -/
theorem store_lookup_fresh_loc : ∀ st, store_lookup (fresh_loc st) st = None := by
  simp_all [Bool.and_eq_true]

-- Two ELoc values that are val_rel_le at TRef must be the same location
/-- val_rel_le_ref_loc_eq (matches Coq) -/
theorem val_rel_le_ref_loc_eq : ∀ n St T sl l1 l2, n > 0 → val_rel_le n St (TRef T sl) (ELoc l1) (ELoc l2) → l1 = l2 := by
  rfl

-- Simple store relation is reflexive
/-- store_rel_simple_refl (matches Coq) -/
theorem store_rel_simple_refl : ∀ St st, store_rel_simple St st st := by
  simp

-- Store relation is monotone in step index
/-- store_rel_le_step_mono (matches Coq) -/
theorem store_rel_le_step_mono : ∀ n m St st1 st2, m ≤ n → store_rel_le n St st1 st2 → store_rel_le m St st1 st2 := by
  simp_all [Bool.and_eq_true]

-- Labeled values are always related (like secrets)
/-- val_rel_le_labeled_always (matches Coq) -/
theorem val_rel_le_labeled_always : ∀ n St T sl v1 v2, value v1 → value v2 → closed_expr v1 → closed_expr v2 → val_rel_le n St (TLabeled T sl) v1 v2 := by
  simp_all [Bool.and_eq_true]

-- Tainted values are always related
