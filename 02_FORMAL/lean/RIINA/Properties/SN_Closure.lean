-- SECTION 11: SN CLOSURE FOR HANDLE
-- ========================================================================

/-- SN_handle_aux (matches Coq) -/
theorem SN_handle_aux : ∀ e x h st ctx, SN (e, st, ctx) →
    (∀ v st' ctx', value v → SN ([x := v] h, st', ctx')) →
    SN (EHandle e x h, st, ctx) := by
  intro e x h st ctx hsn hbody
  suffices ∀ (cfg : config), SN cfg →
      SN (EHandle cfg.1 x h, cfg.2.1, cfg.2.2) from
    this (e, st, ctx) hsn
  intro cfg hacc
  induction hacc with
  | intro y _ ih =>
    apply Acc.intro
    intro ⟨e'', st'', ctx''⟩ hstep
    obtain ⟨e', st', ctx'⟩ := y
    dsimp at hstep
    cases hstep with
    | ST_Handle1 _ _ _ _ _ _ _ _ hstep1 => exact ih ⟨_, _, _⟩ hstep1
    | ST_HandleValue _ _ _ _ _ hval => exact hbody _ _ _ hval

/-- SN_handle (matches Coq) -/
theorem SN_handle : ∀ e x h st ctx, SN (e, st, ctx) →
    (∀ v st' ctx', value v → SN ([x := v] h, st', ctx')) →
    SN (EHandle e x h, st, ctx) :=
  SN_handle_aux

end SN_Closure

