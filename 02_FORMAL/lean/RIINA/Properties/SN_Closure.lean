-- Empty store is trivially well-formed
/-- store_wf_nil (matches Coq) -/
theorem store_wf_nil : store_wf [] := by
  intro l v h
  simp [store_lookup] at h

-- Helper: store_lookup at the updated location returns the new value
/-- store_lookup_update_eq (matches Coq) -/
theorem store_lookup_update_eq : ∀ l v st,
    store_lookup l (store_update l v st) = Some v := by
  intro l v st
  induction st with
  | «nil» => simp [store_update, store_lookup]
  | «cons» p st' ih =>
    obtain ⟨l', v'⟩ := p
    simp only [store_update]
    split
    · -- l == l' is true
      simp only [store_lookup]
      rename_i h
      simp [BEq.beq] at h
      simp [store_lookup, BEq.beq, h]
    · -- l == l' is false
      rename_i h
      simp only [store_lookup]
      simp [BEq.beq] at h
      simp [store_lookup, BEq.beq, h, ih]

-- Helper: store_lookup at a different location is unchanged
/-- store_lookup_update_neq (matches Coq) -/
theorem store_lookup_update_neq : ∀ l0 l v st, l0 ≠ l →
    store_lookup l0 (store_update l v st) = store_lookup l0 st := by
  intro l0 l v st hneq
  induction st with
  | «nil» =>
    simp [store_update, store_lookup, BEq.beq]
    intro h
    exact absurd h hneq
  | «cons» p st' ih =>
    obtain ⟨l', v'⟩ := p
    simp only [store_update]
    split
    · -- l == l' is true
      rename_i h
      simp [BEq.beq] at h
      subst h
      -- Now l = l', need: store_lookup l0 ((l, v) :: st') = store_lookup l0 ((l, v') :: st')
      simp only [store_lookup]
      split
      · -- l0 == l is true → but l0 ≠ l, contradiction
        rename_i h2
        simp [BEq.beq] at h2
        exact absurd h2 hneq
      · rfl
    · -- l == l' is false
      rename_i h
      simp only [store_lookup]
      split
      · rfl
      · exact ih

-- store_update preserves store_wf when storing a value
/-- store_update_preserves_wf (matches Coq) -/
theorem store_update_preserves_wf : ∀ st l v,
    store_wf st → value v → store_wf (store_update l v st) := by
  intro st l v hwf hval l' v' hlookup
  by_cases h : l' = l
  · subst h
    rw [store_lookup_update_eq] at hlookup
    cases hlookup; exact hval
  · rw [store_lookup_update_neq _ _ _ _ h] at hlookup
    exact hwf l' v' hlookup

