-- Combined type+effect uniqueness (needed for mutual dependency)
private theorem type_effect_unique : ∀ Γ St Δ e T1 ε1 T2 ε2,
    has_type Γ St Δ e T1 ε1 → has_type Γ St Δ e T2 ε2 → T1 = T2 ∧ ε1 = ε2 := by
  intro Γ St Δ e T1 ε1 T2 ε2 h1 h2
  induction h1 generalizing T2 ε2 with
  | T_Unit => cases h2; exact ⟨rfl, rfl⟩
  | T_Bool => cases h2; exact ⟨rfl, rfl⟩
  | T_Int => cases h2; exact ⟨rfl, rfl⟩
  | T_String => cases h2; exact ⟨rfl, rfl⟩
  | T_Var hlook1 => cases h2 with | T_Var hlook2 =>
    rw [hlook1] at hlook2; injection hlook2 with h; exact ⟨h, rfl⟩
  | T_Loc hlook1 => cases h2 with | T_Loc hlook2 =>
    rw [hlook1] at hlook2; injection hlook2 with h; cases h; exact ⟨rfl, rfl⟩
  | T_Lam _ ih => cases h2 with | T_Lam h2b =>
    have ⟨hT, hε⟩ := ih _ _ h2b; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_App _ _ ih1 ih2 => cases h2 with | T_App h2a h2b =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a
    have ⟨_, hε2⟩ := ih2 _ _ h2b
    injection hT1 with _ hret heff; subst hret; subst heff; subst hε1; subst hε2
    exact ⟨rfl, rfl⟩
  | T_Pair _ _ ih1 ih2 => cases h2 with | T_Pair h2a h2b =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a
    have ⟨hT2, hε2⟩ := ih2 _ _ h2b
    subst hT1; subst hT2; subst hε1; subst hε2; exact ⟨rfl, rfl⟩
  | T_Fst _ ih => cases h2 with | T_Fst h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a
    injection hT with hret _; subst hret; subst hε; exact ⟨rfl, rfl⟩
  | T_Snd _ ih => cases h2 with | T_Snd h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a
    injection hT with _ hret; subst hret; subst hε; exact ⟨rfl, rfl⟩
  | T_Inl _ ih => cases h2 with | T_Inl h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Inr _ ih => cases h2 with | T_Inr h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Case _ _ _ ih0 ih1 ih2 => cases h2 with | T_Case h2a h2b h2c =>
    have ⟨hT0, hε0⟩ := ih0 _ _ h2a
    injection hT0 with hT0a hT0b; subst hT0a; subst hT0b
    have ⟨hT1, hε1⟩ := ih1 _ _ h2b; subst hT1
    have ⟨_, hε2⟩ := ih2 _ _ h2c; subst hε0; subst hε1; subst hε2
    exact ⟨rfl, rfl⟩
  | T_If _ _ _ ih1 ih2 ih3 => cases h2 with | T_If h2a h2b h2c =>
    have ⟨_, hε1⟩ := ih1 _ _ h2a
    have ⟨hT2, hε2⟩ := ih2 _ _ h2b
    have ⟨_, hε3⟩ := ih3 _ _ h2c
    subst hT2; subst hε1; subst hε2; subst hε3; exact ⟨rfl, rfl⟩
  | T_Let _ _ ih1 ih2 => cases h2 with | T_Let h2a h2b =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a; subst hT1
    have ⟨hT2, hε2⟩ := ih2 _ _ h2b
    subst hT2; subst hε1; subst hε2; exact ⟨rfl, rfl⟩
  | T_Perform _ ih => cases h2 with | T_Perform h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Handle _ _ ih1 ih2 => cases h2 with | T_Handle h2a h2b =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a; subst hT1
    have ⟨hT2, hε2⟩ := ih2 _ _ h2b
    subst hT2; subst hε1; subst hε2; exact ⟨rfl, rfl⟩
  | T_Ref _ ih => cases h2 with | T_Ref h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Deref _ ih => cases h2 with | T_Deref h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a
    injection hT with hret _; subst hret; subst hε; exact ⟨rfl, rfl⟩
  | T_Assign _ _ ih1 ih2 => cases h2 with | T_Assign h2a h2b =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a
    have ⟨_, hε2⟩ := ih2 _ _ h2b
    injection hT1 with _ _; subst hε1; subst hε2; exact ⟨rfl, rfl⟩
  | T_Classify _ ih => cases h2 with | T_Classify h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Declassify _ _ _ ih1 ih2 => cases h2 with | T_Declassify h2a h2b _ =>
    have ⟨hT1, hε1⟩ := ih1 _ _ h2a
    have ⟨_, hε2⟩ := ih2 _ _ h2b
    injection hT1 with hret; subst hret; subst hε1; subst hε2; exact ⟨rfl, rfl⟩
  | T_Prove _ ih => cases h2 with | T_Prove h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Require _ ih => cases h2 with | T_Require h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩
  | T_Grant _ ih => cases h2 with | T_Grant h2a =>
    have ⟨hT, hε⟩ := ih _ _ h2a; subst hT; subst hε; exact ⟨rfl, rfl⟩

-- Effect is uniquely determined by the expression and context
/-- effect_unique (matches Coq) -/
theorem effect_unique : ∀ Γ St Δ e T1 ε1 T2 ε2, has_type Γ St Δ e T1 ε1 → has_type Γ St Δ e T2 ε2 → ε1 = ε2 := by
  intro Γ St Δ e T1 ε1 T2 ε2 h1 h2; exact (type_effect_unique Γ St Δ e T1 ε1 T2 ε2 h1 h2).2

-- Type is uniquely determined
/-- type_unique (matches Coq) -/
theorem type_unique : ∀ Γ St Δ e T1 ε1 T2 ε2, has_type Γ St Δ e T1 ε1 → has_type Γ St Δ e T2 ε2 → T1 = T2 := by
  intro Γ St Δ e T1 ε1 T2 ε2 h1 h2; exact (type_effect_unique Γ St Δ e T1 ε1 T2 ε2 h1 h2).1

end RIINA
