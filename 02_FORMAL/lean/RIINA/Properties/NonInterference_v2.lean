  intro m n St st1 st2 _ hRel
  intro l T sl hLookup
  rcases hRel l T sl hLookup with ⟨v1, v2, h1, h2, hVal⟩
  exact ⟨v1, v2, h1, h2, by simpa [val_rel_n] using hVal⟩

