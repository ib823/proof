/-- val_rel_n_sum_structure (matches Coq) -/
theorem val_rel_n_sum_structure : ∀ n St T1 T2 v1 v2, first_order_type T1 = true → first_order_type T2 = true → val_rel_n n St (TSum T1 T2) v1 v2 → (∃ a1 a2, v1 = EInl a1 T2 ∧ v2 = EInl a2 T2 ∧ value a1 ∧ value a2) ∨ (∃ b1 b2, v1 = EInr b1 T1 ∧ v2 = EInr b2 T1 ∧ value b1 ∧ value b2) := by
  intro n St T1 T2 v1 v2 hfo1 hfo2 ⟨hv1, hv2, _, _, ht1, ht2, hfo⟩
  have hfo_sum : first_order_type (TSum T1 T2) = true := by
    show (first_order_type T1 && first_order_type T2) = true
    simp [hfo1, hfo2]
  rw [if_pos hfo_sum] at hfo
  rcases canonical_forms_sum hv1 ht1 with ⟨a1, rfl, hva1⟩ | ⟨b1, rfl, hvb1⟩
  · rcases canonical_forms_sum hv2 ht2 with ⟨a2, rfl, hva2⟩ | ⟨b2, rfl, hvb2⟩
    · exact Or.inl ⟨a1, a2, rfl, rfl, hva1, hva2⟩
    · exfalso; exact hfo
  · rcases canonical_forms_sum hv2 ht2 with ⟨a2, rfl, hva2⟩ | ⟨b2, rfl, hvb2⟩
    · exfalso; exact hfo
    · exact Or.inr ⟨b1, b2, rfl, rfl, hvb1, hvb2⟩

-- Downward monotonicity for val_rel_n
/-- val_rel_n_mono (matches Coq) -/
theorem val_rel_n_mono : ∀ m n St T v1 v2, m ≤ n → val_rel_n n St T v1 v2 → val_rel_n m St T v1 v2 := by
  intro _ _ _ _ _ _ _ h; exact h

-- Downward monotonicity for store_rel_n
/-- store_rel_n_mono (matches Coq) -/
theorem store_rel_n_mono : ∀ m n St st1 st2, m ≤ n → store_rel_n n St st1 st2 → store_rel_n m St st1 st2 := by
  intro m n St st1 st2 hle hrel
  induction hle generalizing st1 st2 with
  | refl =>
    exact hrel
  | @step n hle ih =>
    rcases hrel with ⟨hprev, _, _⟩
    exact ih _ _ hprev

-- Helper: invert pair typing to get component typing at EffectPure
/-- pair_typing_pure_inv (matches Coq) -/
private theorem eff_join_eq_EffPure {ε1 ε2 : effect} (h : eff_join ε1 ε2 = EffPure) : ε1 = EffPure ∧ ε2 = EffPure := by
  unfold eff_join effect_join at h
  split at h
  · subst h; rename_i hlt; cases ε1 <;> simp_all [effect_level]
  · subst h; constructor; rfl
    rename_i hlt; cases ε2 <;> simp_all [effect_level]

theorem pair_typing_pure_inv : ∀ Γ St Δ e1 e2 T1 T2, has_type Γ St Δ (EPair e1 e2) (TProd T1 T2) EffectPure → has_type Γ St Δ e1 T1 EffectPure ∧ has_type Γ St Δ e2 T2 EffectPure := by
  intro Γ St Δ e1 e2 T1 T2 h
  generalize hε : EffectPure = ε at h
  cases h with
  | T_Pair h1 h2 =>
    have ⟨he1, he2⟩ := eff_join_eq_EffPure hε.symm
    subst he1; subst he2
    exact ⟨h1, h2⟩

-- FORMER AXIOM 1: exp_rel_step1_fst - NOW PROVEN
/-- exp_rel_step1_fst (matches Coq) -/
theorem exp_rel_step1_fst : ∀ St T1 T2 v v' st1 st2 ctx St', first_order_type T1 = true → first_order_type T2 = true → val_rel_n 0 St' (TProd T1 T2) v v' → store_rel_n 0 St' st1 st2 → store_ty_extends St St' → ∃ a1 a2 st1' st2' ctx' St'', store_ty_extends St' St'' ∧ (EFst v, st1, ctx) -→* (a1, st1', ctx') ∧ (EFst v', st2, ctx) -→* (a2, st2', ctx') ∧ value a1 ∧ value a2 ∧ val_rel_n 0 St'' T1 a1 a2 ∧ store_rel_n 0 St'' st1' st2' := by
  intro St T1 T2 v v' st1 st2 ctx St' hfo1 hfo2 ⟨hv, hv', hc, hc', ht, ht', hfo⟩ hstore _
  obtain ⟨a1, b1, rfl, hva1, hvb1⟩ := canonical_forms_prod hv ht
  obtain ⟨a2, b2, rfl, hva2, hvb2⟩ := canonical_forms_prod hv' ht'
  obtain ⟨hta1, _⟩ := pair_typing_pure_inv _ _ _ _ _ _ _ ht
  obtain ⟨hta2, _⟩ := pair_typing_pure_inv _ _ _ _ _ _ _ ht'
  have hfo_prod : first_order_type (TProd T1 T2) = true := by
    show (first_order_type T1 && first_order_type T2) = true; simp [hfo1, hfo2]
  rw [if_pos hfo_prod] at hfo
  refine ⟨a1, a2, st1, st2, ctx, St', fun l T sl h => h,
    step_to_multi_step _ _ (step.ST_Fst a1 b1 st1 ctx hva1 hvb1),
    step_to_multi_step _ _ (step.ST_Fst a2 b2 st2 ctx hva2 hvb2),
    hva1, hva2,
    ⟨hva1, hva2, fun x hf => hc x (Or.inl hf), fun x hf => hc' x (Or.inl hf),
     hta1, hta2, by rw [if_pos hfo1]; exact hfo.1⟩,
    hstore⟩

