-- ============================================================================
-- Foundational helper: lift lookup agreement through a binder
-- ============================================================================

private theorem lookup_agree_binder {z : ident} {U : ty} {Γ1 Γ2 : type_env}
    {e_outer : expr} {body : expr}
    (hagree : ∀ y, free_in y e_outer → lookup y Γ1 = lookup y Γ2)
    (hfree_implies : ∀ y, free_in y body → y ≠ z → free_in y e_outer) :
    ∀ y, free_in y body → lookup y ((z, U) :: Γ1) = lookup y ((z, U) :: Γ2) := by
  intro y hfree
  simp [lookup, type_env_lookup]
  split
  · rfl
  · rename_i hne
    exact hagree y (hfree_implies y hfree hne)

-- ============================================================================
-- Key lemma: free_in_context
-- If x is free in e and e is well-typed in Γ, then x is bound in Γ.
-- ============================================================================

private theorem lookup_extend_inv {x y : ident} {U : ty} {Γ : type_env} {T' : ty}
    (h : lookup x ((y, U) :: Γ) = Some T') (hneq : x ≠ y) :
    lookup x Γ = Some T' := by
  simp [lookup, type_env_lookup, hneq] at h; exact h

theorem free_in_context : ∀ x e (Γ : type_env) St Δ T ε,
    free_in x e → has_type Γ St Δ e T ε → ∃ T', lookup x Γ = Some T' := by
  intro x e Γ St Δ T ε hfree htype
  induction htype with
  | T_Unit => exact absurd hfree id
  | T_Bool => exact absurd hfree id
  | T_Int => exact absurd hfree id
  | T_String => exact absurd hfree id
  | T_Loc _ => exact absurd hfree id
  | T_Var hlookup =>
    simp [free_in] at hfree
    rw [hfree]; exact ⟨_, hlookup⟩
  | T_Lam hbody ih =>
    simp [free_in] at hfree
    obtain ⟨hneq, hfree'⟩ := hfree
    obtain ⟨T', hlookup⟩ := ih hfree'
    exact ⟨T', lookup_extend_inv hlookup hneq⟩
  | T_App _ _ ih1 ih2 =>
    simp [free_in] at hfree
    cases hfree with
    | inl h => exact ih1 h
    | inr h => exact ih2 h
  | T_Pair _ _ ih1 ih2 =>
    simp [free_in] at hfree
    cases hfree with
    | inl h => exact ih1 h
    | inr h => exact ih2 h
  | T_Fst _ ih => exact ih hfree
  | T_Snd _ ih => exact ih hfree
  | T_Inl _ ih => exact ih hfree
  | T_Inr _ ih => exact ih hfree
  | T_Case _ _ _ ih0 ih1 ih2 =>
    simp [free_in] at hfree
    rcases hfree with h | ⟨hneq, hfree'⟩ | ⟨hneq, hfree'⟩
    · exact ih0 h
    · obtain ⟨T', hlookup⟩ := ih1 hfree'
      exact ⟨T', lookup_extend_inv hlookup hneq⟩
    · obtain ⟨T', hlookup⟩ := ih2 hfree'
      exact ⟨T', lookup_extend_inv hlookup hneq⟩
  | T_If _ _ _ ih1 ih2 ih3 =>
    simp [free_in] at hfree
    rcases hfree with h | h | h
    · exact ih1 h
    · exact ih2 h
    · exact ih3 h
  | T_Let _ _ ih1 ih2 =>
    simp [free_in] at hfree
    rcases hfree with h | ⟨hneq, hfree'⟩
    · exact ih1 h
    · obtain ⟨T', hlookup⟩ := ih2 hfree'
      exact ⟨T', lookup_extend_inv hlookup hneq⟩
  | T_Perform _ ih => exact ih hfree
  | T_Handle _ _ ih1 ih2 =>
    simp [free_in] at hfree
    rcases hfree with h | ⟨hneq, hfree'⟩
    · exact ih1 h
    · obtain ⟨T', hlookup⟩ := ih2 hfree'
      exact ⟨T', lookup_extend_inv hlookup hneq⟩
  | T_Ref _ ih => exact ih hfree
  | T_Deref _ ih => exact ih hfree
  | T_Assign _ _ ih1 ih2 =>
    simp [free_in] at hfree
    cases hfree with
    | inl h => exact ih1 h
    | inr h => exact ih2 h
  | T_Classify _ ih => exact ih hfree
  | T_Declassify _ _ _ ih1 ih2 =>
    simp [free_in] at hfree
    cases hfree with
    | inl h => exact ih1 h
    | inr h => exact ih2 h
  | T_Prove _ ih => exact ih hfree
  | T_Require _ ih => exact ih hfree
  | T_Grant _ ih => exact ih hfree

-- ============================================================================
-- Key lemma: context_invariance
-- Typing depends only on the context's behavior on free variables.
-- ============================================================================

theorem context_invariance : ∀ (Γ1 Γ2 : type_env) St Δ e T ε,
    has_type Γ1 St Δ e T ε →
    (∀ x, free_in x e → lookup x Γ1 = lookup x Γ2) →
    has_type Γ2 St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype
  revert Γ2
  induction htype with
  | T_Unit => intros; exact has_type.T_Unit
  | T_Bool => intros; exact has_type.T_Bool
  | T_Int => intros; exact has_type.T_Int
  | T_String => intros; exact has_type.T_String
  | T_Loc hlookup => intros; exact has_type.T_Loc hlookup
  | T_Var hlookup =>
    intro Γ2 hagree
    apply has_type.T_Var
    rename_i _ _ _ var_name _
    have heq := hagree var_name (show free_in var_name (EVar var_name) from rfl)
    simp [lookup] at heq; rw [← heq]; exact hlookup
  | T_Lam _ ih =>
    intro Γ2 hagree
    apply has_type.T_Lam
    apply ih
    apply lookup_agree_binder hagree
    intro y hfree hneq; exact ⟨hneq, hfree⟩
  | T_App _ _ ih1 ih2 =>
    intro Γ2 hagree
    exact has_type.T_App
      (ih1 Γ2 (fun y h => hagree y (Or.inl h)))
      (ih2 Γ2 (fun y h => hagree y (Or.inr h)))
  | T_Pair _ _ ih1 ih2 =>
    intro Γ2 hagree
    exact has_type.T_Pair
      (ih1 Γ2 (fun y h => hagree y (Or.inl h)))
      (ih2 Γ2 (fun y h => hagree y (Or.inr h)))
  | T_Fst _ ih => intro Γ2 hagree; exact has_type.T_Fst (ih Γ2 hagree)
  | T_Snd _ ih => intro Γ2 hagree; exact has_type.T_Snd (ih Γ2 hagree)
  | T_Inl _ ih => intro Γ2 hagree; exact has_type.T_Inl (ih Γ2 hagree)
  | T_Inr _ ih => intro Γ2 hagree; exact has_type.T_Inr (ih Γ2 hagree)
  | T_Case _ _ _ ih0 ih1 ih2 =>
    intro Γ2 hagree
    apply has_type.T_Case
    · exact ih0 Γ2 (fun y h => hagree y (Or.inl h))
    · apply ih1; apply lookup_agree_binder hagree
      intro y hfree hneq; exact Or.inr (Or.inl ⟨hneq, hfree⟩)
    · apply ih2; apply lookup_agree_binder hagree
      intro y hfree hneq; exact Or.inr (Or.inr ⟨hneq, hfree⟩)
  | T_If _ _ _ ih1 ih2 ih3 =>
    intro Γ2 hagree
    exact has_type.T_If
      (ih1 Γ2 (fun y h => hagree y (Or.inl h)))
      (ih2 Γ2 (fun y h => hagree y (Or.inr (Or.inl h))))
      (ih3 Γ2 (fun y h => hagree y (Or.inr (Or.inr h))))
  | T_Let _ _ ih1 ih2 =>
    intro Γ2 hagree
    apply has_type.T_Let
    · exact ih1 Γ2 (fun y h => hagree y (Or.inl h))
    · apply ih2; apply lookup_agree_binder hagree
      intro y hfree hneq; exact Or.inr ⟨hneq, hfree⟩
  | T_Perform _ ih =>
    intro Γ2 hagree; exact has_type.T_Perform (ih Γ2 hagree)
  | T_Handle _ _ ih1 ih2 =>
    intro Γ2 hagree
    apply has_type.T_Handle
    · exact ih1 Γ2 (fun y h => hagree y (Or.inl h))
    · apply ih2; apply lookup_agree_binder hagree
      intro y hfree hneq; exact Or.inr ⟨hneq, hfree⟩
  | T_Ref _ ih => intro Γ2 hagree; exact has_type.T_Ref (ih Γ2 hagree)
  | T_Deref _ ih => intro Γ2 hagree; exact has_type.T_Deref (ih Γ2 hagree)
  | T_Assign _ _ ih1 ih2 =>
    intro Γ2 hagree
    exact has_type.T_Assign
      (ih1 Γ2 (fun y h => hagree y (Or.inl h)))
      (ih2 Γ2 (fun y h => hagree y (Or.inr h)))
  | T_Classify _ ih => intro Γ2 hagree; exact has_type.T_Classify (ih Γ2 hagree)
  | T_Declassify _ _ hd ih1 ih2 =>
    intro Γ2 hagree
    exact has_type.T_Declassify
      (ih1 Γ2 (fun y h => hagree y (Or.inl h)))
      (ih2 Γ2 (fun y h => hagree y (Or.inr h)))
      hd
  | T_Prove _ ih => intro Γ2 hagree; exact has_type.T_Prove (ih Γ2 hagree)
  | T_Require _ ih => intro Γ2 hagree; exact has_type.T_Require (ih Γ2 hagree)
  | T_Grant _ ih => intro Γ2 hagree; exact has_type.T_Grant (ih Γ2 hagree)

-- ============================================================================
-- Derived lemma: closed terms can be typed in any context
-- ============================================================================

theorem closed_typing_weakening : ∀ St Δ e T ε (Γ : type_env),
    has_type nil St Δ e T ε → has_type Γ St Δ e T ε := by
  intro St Δ e T ε Γ htype
  apply context_invariance nil Γ St Δ e T ε htype
  intro x hfree
  exfalso
  have ⟨T', hlookup⟩ := free_in_context x e nil St Δ T ε hfree htype
  simp [lookup, type_env_lookup] at hlookup

-- ============================================================================
-- Lookup properties
-- ============================================================================

-- Decidability of [free_in]: for any variable [x] and expression [e],
-- we can decide whether [x] occurs free in [e]. This is essential for
-- automation and case analysis in proofs about weakening/strengthening.
/-- free_in_dec (matches Coq) -/
def free_in_dec (x : ident) : (e : expr) → Decidable (free_in x e)
  | EUnit => isFalse id
  | EBool _ => isFalse id
  | EInt _ => isFalse id
  | EString _ => isFalse id
  | ELoc _ => isFalse id
  | EVar y => if h : x = y then isTrue h else isFalse h
  | ELam y _ body =>
    if hneq : x = y then isFalse (fun ⟨h, _⟩ => h hneq)
    else match free_in_dec x body with
      | isTrue hf => isTrue ⟨hneq, hf⟩
      | isFalse hf => isFalse (fun ⟨_, hf'⟩ => hf hf')
  | EApp e1 e2 =>
    match free_in_dec x e1, free_in_dec x e2 with
    | isTrue h, _ => isTrue (Or.inl h)
    | _, isTrue h => isTrue (Or.inr h)
    | isFalse h1, isFalse h2 => isFalse (fun h => h.elim h1 h2)
  | EPair e1 e2 =>
    match free_in_dec x e1, free_in_dec x e2 with
    | isTrue h, _ => isTrue (Or.inl h)
    | _, isTrue h => isTrue (Or.inr h)
    | isFalse h1, isFalse h2 => isFalse (fun h => h.elim h1 h2)
  | EFst e => free_in_dec x e
  | ESnd e => free_in_dec x e
  | EInl e _ => free_in_dec x e
  | EInr e _ => free_in_dec x e
  | ECase e y1 e1 y2 e2 =>
    match free_in_dec x e with
    | isTrue h => isTrue (Or.inl h)
    | isFalse h0 =>
      have d1 : Decidable (x ≠ y1 ∧ free_in x e1) :=
        if heq1 : x = y1 then isFalse (fun ⟨h, _⟩ => h heq1)
        else match free_in_dec x e1 with
          | isTrue hf => isTrue ⟨heq1, hf⟩
          | isFalse hf => isFalse (fun ⟨_, hf'⟩ => hf hf')
      have d2 : Decidable (x ≠ y2 ∧ free_in x e2) :=
        if heq2 : x = y2 then isFalse (fun ⟨h, _⟩ => h heq2)
        else match free_in_dec x e2 with
          | isTrue hf => isTrue ⟨heq2, hf⟩
          | isFalse hf => isFalse (fun ⟨_, hf'⟩ => hf hf')
      match d1, d2 with
      | isTrue h1, _ => isTrue (Or.inr (Or.inl h1))
      | _, isTrue h2 => isTrue (Or.inr (Or.inr h2))
      | isFalse h1, isFalse h2 =>
        isFalse (fun h => h.elim h0 (fun h => h.elim h1 h2))
  | EIf e1 e2 e3 =>
    match free_in_dec x e1, free_in_dec x e2, free_in_dec x e3 with
    | isTrue h, _, _ => isTrue (Or.inl h)
    | _, isTrue h, _ => isTrue (Or.inr (Or.inl h))
    | _, _, isTrue h => isTrue (Or.inr (Or.inr h))
    | isFalse h1, isFalse h2, isFalse h3 =>
      isFalse (fun h => h.elim h1 (fun h => h.elim h2 h3))
  | ELet y e1 e2 =>
    match free_in_dec x e1 with
    | isTrue h => isTrue (Or.inl h)
    | isFalse h1 =>
      have d2 : Decidable (x ≠ y ∧ free_in x e2) :=
        if heq : x = y then isFalse (fun ⟨h, _⟩ => h heq)
        else match free_in_dec x e2 with
          | isTrue hf => isTrue ⟨heq, hf⟩
          | isFalse hf => isFalse (fun ⟨_, hf'⟩ => hf hf')
      match d2 with
      | isTrue h2 => isTrue (Or.inr h2)
      | isFalse h2 => isFalse (fun h => h.elim h1 h2)
  | EPerform _ e => free_in_dec x e
  | EHandle e y h =>
    match free_in_dec x e with
    | isTrue hf => isTrue (Or.inl hf)
    | isFalse hfe =>
      have dh : Decidable (x ≠ y ∧ free_in x h) :=
        if heq : x = y then isFalse (fun ⟨h, _⟩ => h heq)
        else match free_in_dec x h with
          | isTrue hfh => isTrue ⟨heq, hfh⟩
          | isFalse hfh => isFalse (fun ⟨_, hfh'⟩ => hfh hfh')
      match dh with
      | isTrue hh => isTrue (Or.inr hh)
      | isFalse hh => isFalse (fun hf => hf.elim hfe hh)
  | ERef e _ => free_in_dec x e
  | EDeref e => free_in_dec x e
  | EAssign e1 e2 =>
    match free_in_dec x e1, free_in_dec x e2 with
    | isTrue h, _ => isTrue (Or.inl h)
    | _, isTrue h => isTrue (Or.inr h)
    | isFalse h1, isFalse h2 => isFalse (fun h => h.elim h1 h2)
  | EClassify e => free_in_dec x e
  | EDeclassify e1 e2 =>
    match free_in_dec x e1, free_in_dec x e2 with
    | isTrue h, _ => isTrue (Or.inl h)
    | _, isTrue h => isTrue (Or.inr h)
    | isFalse h1, isFalse h2 => isFalse (fun h => h.elim h1 h2)
  | EProve e => free_in_dec x e
  | ERequire _ e => free_in_dec x e
  | EGrant _ e => free_in_dec x e

-- If lookup finds a binding through a non-matching head, the binding is in the tail.
/-- lookup_cons_neq_inv (matches Coq) -/
theorem lookup_cons_neq_inv : ∀ x y U Γ T, lookup x ((y, U) :: Γ) = Some T → x ≠ y → lookup x Γ = Some T := by
  intro x y U Γ T h hneq
  simp [lookup, type_env_lookup, hneq] at h
  exact h

-- Lookup is deterministic (functional).
/-- lookup_deterministic (matches Coq) -/
theorem lookup_deterministic : ∀ x Γ T1 T2, lookup x Γ = Some T1 → lookup x Γ = Some T2 → T1 = T2 := by
  intro x Γ T1 T2 h1 h2
  rw [h1] at h2
  exact Option.some.inj h2

-- Lookup in an extended context: either the head matches or it's in the tail.
/-- lookup_cons_inv (matches Coq) -/
theorem lookup_cons_inv : ∀ x y U Γ T, lookup x ((y, U) :: Γ) = Some T → (x = y ∧ T = U) ∨ (x ≠ y ∧ lookup x Γ = Some T) := by
  intro x y U Γ T h
  simp [lookup, type_env_lookup] at h
  by_cases heq : x = y
  · simp [heq] at h; left; exact ⟨heq, h.symm⟩
  · simp [heq] at h; right; exact ⟨heq, h⟩

-- Weakening lookup: if x is found in Γ and x ≠ y, x is still found after prepending (y,U).
/-- lookup_weaken_neq (matches Coq) -/
theorem lookup_weaken_neq : ∀ x Γ T y U, lookup x Γ = Some T → x ≠ y → lookup x ((y, U) :: Γ) = Some T := by
  intro x Γ T y U h hneq
  simp [lookup, type_env_lookup, hneq]
  exact h

-- Adding an unused binding to the head of Γ preserves typing.
-- This is a direct corollary of [context_invariance].
/-- typing_weaken_head (matches Coq) -/
theorem typing_weaken_head : ∀ Γ St Δ e T ε y U, has_type Γ St Δ e T ε → ~ free_in y e → has_type ((y, U) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε y U htype hnfree
  apply context_invariance Γ ((y, U) :: Γ) St Δ e T ε htype
  intro x hfree
  simp [lookup, type_env_lookup]
  by_cases heq : x = y
  · exfalso; rw [heq] at hfree; exact hnfree hfree
  · simp [heq]

-- Unconditional weakening when the new binding's name is fresh
-- (not in the domain of Γ and not free in e).
-- Convenience wrapper combining free_in_context with typing_weaken_head.
/-- typing_weaken_fresh (matches Coq) -/
theorem typing_weaken_fresh : ∀ Γ St Δ e T ε y U, has_type Γ St Δ e T ε → lookup y Γ = None → has_type ((y, U) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε y U htype hlookup_none
  apply context_invariance Γ ((y, U) :: Γ) St Δ e T ε htype
  intro x hfree
  simp [lookup, type_env_lookup]
  by_cases heq : x = y
  · exfalso
    have ⟨T', hlookup⟩ := free_in_context x e Γ St Δ T ε hfree htype
    rw [heq] at hlookup; rw [hlookup] at hlookup_none; exact Option.noConfusion hlookup_none
  · simp [heq]

-- Removing an unused head binding preserves typing.
-- Dual of [typing_weaken_head].
/-- typing_strengthen_head (matches Coq) -/
theorem typing_strengthen_head : ∀ Γ St Δ e T ε y U, has_type ((y, U) :: Γ) St Δ e T ε → ~ free_in y e → has_type Γ St Δ e T ε := by
  intro Γ St Δ e T ε y U htype hnfree
  apply context_invariance ((y, U) :: Γ) Γ St Δ e T ε htype
  intro x hfree
  simp [lookup, type_env_lookup]
  by_cases heq : x = y
  · exfalso; rw [heq] at hfree; exact hnfree hfree
  · simp [heq]

-- Swapping two non-conflicting adjacent bindings preserves typing.
/-- typing_exchange (matches Coq) -/
theorem typing_exchange : ∀ Γ St Δ e T ε x Tx y Ty, has_type ((x, Tx) :: (y, Ty) :: Γ) St Δ e T ε → x ≠ y → has_type ((y, Ty) :: (x, Tx) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε x Tx y Ty htype hneq
  apply context_invariance ((x, Tx) :: (y, Ty) :: Γ) ((y, Ty) :: (x, Tx) :: Γ) St Δ e T ε htype
  intro z hfree
  by_cases hzx : z = x <;> by_cases hzy : z = y
  · exfalso; exact hneq (hzx.symm.trans hzy)
  · subst hzx; simp [lookup, type_env_lookup, hzy, hneq]
  · subst hzy; simp [lookup, type_env_lookup, hzx, Ne.symm hneq]
  · simp [lookup, type_env_lookup, hzx, hzy]

-- The security context Δ does not affect typing derivations.
-- This is because no typing rule discriminates on the value of Δ;
-- it is threaded uniformly through all rules.
/-- typing_delta_irrelevance (matches Coq) -/
theorem typing_delta_irrelevance : ∀ Γ St Δ1 Δ2 e T ε, has_type Γ St Δ1 e T ε → has_type Γ St Δ2 e T ε := by
  intro Γ St Δ1 Δ2 e T ε htype
  induction htype with
  | T_Unit => exact has_type.T_Unit
  | T_Bool => exact has_type.T_Bool
  | T_Int => exact has_type.T_Int
  | T_String => exact has_type.T_String
  | T_Loc h => exact has_type.T_Loc h
  | T_Var h => exact has_type.T_Var h
  | T_Lam _ ih => exact has_type.T_Lam ih
  | T_App _ _ ih1 ih2 => exact has_type.T_App ih1 ih2
  | T_Pair _ _ ih1 ih2 => exact has_type.T_Pair ih1 ih2
  | T_Fst _ ih => exact has_type.T_Fst ih
  | T_Snd _ ih => exact has_type.T_Snd ih
  | T_Inl _ ih => exact has_type.T_Inl ih
  | T_Inr _ ih => exact has_type.T_Inr ih
  | T_Case _ _ _ ih1 ih2 ih3 => exact has_type.T_Case ih1 ih2 ih3
  | T_If _ _ _ ih1 ih2 ih3 => exact has_type.T_If ih1 ih2 ih3
  | T_Let _ _ ih1 ih2 => exact has_type.T_Let ih1 ih2
  | T_Perform _ ih => exact has_type.T_Perform ih
  | T_Handle _ _ ih1 ih2 => exact has_type.T_Handle ih1 ih2
  | T_Ref _ ih => exact has_type.T_Ref ih
  | T_Deref _ ih => exact has_type.T_Deref ih
  | T_Assign _ _ ih1 ih2 => exact has_type.T_Assign ih1 ih2
  | T_Classify _ ih => exact has_type.T_Classify ih
  | T_Declassify _ _ hd ih1 ih2 => exact has_type.T_Declassify ih1 ih2 hd
  | T_Prove _ ih => exact has_type.T_Prove ih
  | T_Require _ ih => exact has_type.T_Require ih
  | T_Grant _ ih => exact has_type.T_Grant ih

-- If a binding (x, T1) shadows an earlier (x, T2), the earlier is irrelevant.
/-- typing_shadow (matches Coq) -/
theorem typing_shadow : ∀ Γ St Δ e T ε x T1 T2, has_type ((x, T1) :: (x, T2) :: Γ) St Δ e T ε → has_type ((x, T1) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε x T1 T2 htype
  apply context_invariance ((x, T1) :: (x, T2) :: Γ) ((x, T1) :: Γ) St Δ e T ε htype
  intro z hfree
  simp [lookup, type_env_lookup]
  by_cases heq : z = x <;> simp [heq]

-- A well-typed closed term has no free variables.
-- This is a direct consequence of [free_in_context].
/-- closed_no_free_vars (matches Coq) -/
theorem closed_no_free_vars : ∀ St Δ e T ε x, has_type nil St Δ e T ε → ~ free_in x e := by
  intro St Δ e T ε x htype hfree
  have ⟨T', hlookup⟩ := free_in_context x e nil St Δ T ε hfree htype
  simp [lookup, type_env_lookup] at hlookup

-- Closed terms can be typed in any type environment.
-- This re-exports [closed_typing_weakening] under a more discoverable name.
/-- typing_weaken_closed (matches Coq) -/
theorem typing_weaken_closed : ∀ Γ St Δ e T ε, has_type nil St Δ e T ε → has_type Γ St Δ e T ε := by
  intro Γ St Δ e T ε htype
  exact closed_typing_weakening St Δ e T ε Γ htype

-- Weakening by an entire list of bindings, when the expression is closed.
/-- typing_weaken_multi_closed (matches Coq) -/
theorem typing_weaken_multi_closed : ∀ Γ1 Γ2 St Δ e T ε, has_type nil St Δ e T ε → has_type (Γ1 ++ Γ2) St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype
  exact closed_typing_weakening St Δ e T ε (Γ1 ++ Γ2) htype

-- Weakening by prepending a list of bindings when none shadow free variables.
/-- typing_weaken_prefix (matches Coq) -/
theorem typing_weaken_prefix : ∀ Γ1 Γ2 St Δ e T ε, has_type Γ2 St Δ e T ε → (∀ x, free_in x e → lookup x Γ2 = lookup x (Γ1 ++ Γ2)) → has_type (Γ1 ++ Γ2) St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype hagree
  exact context_invariance Γ2 (Γ1 ++ Γ2) St Δ e T ε htype hagree

-- Store typing extension is reflexive.
/-- store_extends_refl (matches Coq) -/
theorem store_extends_refl : ∀ St, store_ty_extends St St := by
  intro St l T sl h; exact h

-- Store typing extension is transitive.
/-- store_extends_trans (matches Coq) -/
theorem store_extends_trans : ∀ St1 St2 St3, store_ty_extends St1 St2 → store_ty_extends St2 St3 → store_ty_extends St1 St3 := by
  intro St1 St2 St3 h12 h23 l T sl h
  exact h23 l T sl (h12 l T sl h)

-- Store extension preserves well-typedness.
/-- typing_weaken_store (matches Coq) -/
theorem typing_weaken_store : ∀ Γ St St' Δ e T ε, has_type Γ St Δ e T ε → store_ty_extends St St' → has_type Γ St' Δ e T ε := by
  intro Γ St St' Δ e T ε htype hext
  exact has_type_store_weaken htype hext

-- Weaken both context and security level simultaneously.
/-- typing_weaken_head_delta (matches Coq) -/
theorem typing_weaken_head_delta : ∀ Γ St Δ1 Δ2 e T ε y U, has_type Γ St Δ1 e T ε → ~ free_in y e → has_type ((y, U) :: Γ) St Δ2 e T ε := by
  intro Γ St Δ1 Δ2 e T ε y U htype hnfree
  have h1 := typing_delta_irrelevance Γ St Δ1 Δ2 e T ε htype
  exact typing_weaken_head Γ St Δ2 e T ε y U h1 hnfree

-- Weakening after exchange: if we have typing in Γ and x ≠ y,
-- we can add both bindings in either order.
/-- typing_weaken_two (matches Coq) -/
theorem typing_weaken_two : ∀ Γ St Δ e T ε x Tx y Ty, has_type Γ St Δ e T ε → ~ free_in x e → ~ free_in y e → has_type ((x, Tx) :: (y, Ty) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε x Tx y Ty htype hnfx hnfy
  have h1 := typing_weaken_head Γ St Δ e T ε y Ty htype hnfy
  exact typing_weaken_head ((y, Ty) :: Γ) St Δ e T ε x Tx h1 hnfx

-- Weakening + store extension simultaneously.
/-- typing_weaken_head_store (matches Coq) -/
theorem typing_weaken_head_store : ∀ Γ St St' Δ e T ε y U, has_type Γ St Δ e T ε → ~ free_in y e → store_ty_extends St St' → has_type ((y, U) :: Γ) St' Δ e T ε := by
  intro Γ St St' Δ e T ε y U htype hnfree hext
  have h1 := typing_weaken_store Γ St St' Δ e T ε htype hext
  exact typing_weaken_head Γ St' Δ e T ε y U h1 hnfree

-- If x is found in the first context, it's found in the append.
/-- lookup_app_l (matches Coq) -/
theorem lookup_app_l : ∀ x Γ1 Γ2 T, lookup x Γ1 = Some T → lookup x (Γ1 ++ Γ2) = Some T := by
  intro x Γ1 Γ2 T h
  induction Γ1 with
  | «nil» => simp [lookup, type_env_lookup] at h
  | cons hd tl ih =>
    simp [lookup, type_env_lookup] at h ⊢
    split at h <;> simp_all

-- If x is not in the first context, lookup in append depends on the tail.
/-- lookup_app_r (matches Coq) -/
theorem lookup_app_r : ∀ x Γ1 Γ2, lookup x Γ1 = None → lookup x (Γ1 ++ Γ2) = lookup x Γ2 := by
  intro x Γ1 Γ2 h
  induction Γ1 with
  | «nil» => rfl
  | cons hd tl ih =>
    simp [lookup, type_env_lookup] at h ⊢
    split at h
    · exact absurd h (by simp)
    · simp_all

-- Lookup in nil is always None.
/-- lookup_nil (matches Coq) -/
theorem lookup_nil : ∀ x, lookup x (nil : type_env) = None := by
  intro x; rfl

-- If lookup succeeds in the head, x equals the head's name.
/-- lookup_head_eq (matches Coq) -/
theorem lookup_head_eq : ∀ x T Γ, lookup x ((x, T) :: Γ) = Some T := by
  intro x T Γ; simp [lookup, type_env_lookup]

-- Duplicate adjacent bindings can be contracted.
--    (x,T)::(x,T)::Γ ≡ (x,T)::Γ
/-- typing_contract (matches Coq) -/
theorem typing_contract : ∀ Γ St Δ e T ε x Tx, has_type ((x, Tx) :: (x, Tx) :: Γ) St Δ e T ε → has_type ((x, Tx) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε x Tx htype
  apply context_invariance ((x, Tx) :: (x, Tx) :: Γ) ((x, Tx) :: Γ) St Δ e T ε htype
  intro z hfree
  simp [lookup, type_env_lookup]
  by_cases heq : z = x <;> simp [heq]

-- If store is well-formed, every runtime value has a store typing entry.
/-- store_wf_runtime_entry_typed (matches Coq) -/
theorem store_wf_runtime_entry_typed : ∀ St st l v, store_wf St st → store_lookup l st = Some v → ∃ T sl, store_ty_lookup l St = Some (T, sl) := by
  intro St st l v hwf hlookup
  obtain ⟨_, hwf2⟩ := hwf
  obtain ⟨T, sl, hentry, _, _⟩ := hwf2 l v hlookup
  exact ⟨T, sl, hentry⟩

-- Store well-formedness implies typed and runtime stores agree on domain.
/-- store_wf_bidirectional (matches Coq) -/
theorem store_wf_bidirectional : ∀ St st l, store_wf St st → ((∃ T sl, store_ty_lookup l St = Some (T, sl)) ↔ (∃ v, store_lookup l st = Some v)) := by
  intro St st l hwf
  obtain ⟨hwf1, hwf2⟩ := hwf
  constructor
  · intro ⟨T, sl, hentry⟩
    obtain ⟨v, hlookup, _, _⟩ := hwf1 l T sl hentry
    exact ⟨v, hlookup⟩
  · intro ⟨v, hlookup⟩
    obtain ⟨T, sl, hentry, _, _⟩ := hwf2 l v hlookup
    exact ⟨T, sl, hentry⟩

-- Helper: substitution does nothing to expressions where x is not free
private theorem subst_not_free (x : ident) (v : expr) : ∀ (e : expr), ~ free_in x e →
    substExpr x v e = e := by
  intro e hnf
  induction e with
  | EUnit => rfl
  | EBool _ => rfl
  | EInt _ => rfl
  | EString _ => rfl
  | ELoc _ => rfl
  | EVar y =>
    simp [free_in] at hnf
    simp [substExpr, beq_iff_eq, hnf]
  | ELam y _ body ih =>
    simp [substExpr]
    by_cases heq : x = y
    · simp [beq_iff_eq, heq]
    · simp [beq_iff_eq, heq]; apply ih
      intro hfree; exact hnf ⟨heq, hfree⟩
  | EApp e1 e2 ih1 ih2 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    have hnf2 : ~ free_in x e2 := fun h => hnf (Or.inr h)
    simp [substExpr, ih1 hnf1, ih2 hnf2]
  | EPair e1 e2 ih1 ih2 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    have hnf2 : ~ free_in x e2 := fun h => hnf (Or.inr h)
    simp [substExpr, ih1 hnf1, ih2 hnf2]
  | EFst e ih =>
    simp [substExpr, ih hnf]
  | ESnd e ih =>
    simp [substExpr, ih hnf]
  | EInl e _ ih =>
    simp [substExpr, ih hnf]
  | EInr e _ ih =>
    simp [substExpr, ih hnf]
  | ECase e y1 e1 y2 e2 ih ih1 ih2 =>
    have hnf0 : ~ free_in x e := fun h => hnf (Or.inl h)
    have hnf1 : ∀ h : x ≠ y1, ~ free_in x e1 :=
      fun hneq hf => hnf (Or.inr (Or.inl ⟨hneq, hf⟩))
    have hnf2 : ∀ h : x ≠ y2, ~ free_in x e2 :=
      fun hneq hf => hnf (Or.inr (Or.inr ⟨hneq, hf⟩))
    simp [substExpr, ih hnf0]
    constructor
    · by_cases heq1 : x = y1
      · simp [beq_iff_eq, heq1]
      · simp [beq_iff_eq, heq1]; exact ih1 (hnf1 heq1)
    · by_cases heq2 : x = y2
      · simp [beq_iff_eq, heq2]
      · simp [beq_iff_eq, heq2]; exact ih2 (hnf2 heq2)
  | EIf e1 e2 e3 ih1 ih2 ih3 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    have hnf2 : ~ free_in x e2 := fun h => hnf (Or.inr (Or.inl h))
    have hnf3 : ~ free_in x e3 := fun h => hnf (Or.inr (Or.inr h))
    simp [substExpr, ih1 hnf1, ih2 hnf2, ih3 hnf3]
  | ELet y e1 e2 ih1 ih2 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    simp [substExpr, ih1 hnf1]
    by_cases heq : x = y
    · simp [beq_iff_eq, heq]
    · simp [beq_iff_eq, heq]
      exact ih2 (fun hf => hnf (Or.inr ⟨heq, hf⟩))
  | EPerform _ e ih =>
    simp [substExpr, ih hnf]
  | EHandle e y h ih1 ih2 =>
    have hnf1 : ~ free_in x e := fun hf => hnf (Or.inl hf)
    simp [substExpr, ih1 hnf1]
    by_cases heq : x = y
    · simp [beq_iff_eq, heq]
    · simp [beq_iff_eq, heq]
      exact ih2 (fun hf => hnf (Or.inr ⟨heq, hf⟩))
  | ERef e _ ih =>
    simp [substExpr, ih hnf]
  | EDeref e ih =>
    simp [substExpr, ih hnf]
  | EAssign e1 e2 ih1 ih2 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    have hnf2 : ~ free_in x e2 := fun h => hnf (Or.inr h)
    simp [substExpr, ih1 hnf1, ih2 hnf2]
  | EClassify e ih =>
    simp [substExpr, ih hnf]
  | EDeclassify e1 e2 ih1 ih2 =>
    have hnf1 : ~ free_in x e1 := fun h => hnf (Or.inl h)
    have hnf2 : ~ free_in x e2 := fun h => hnf (Or.inr h)
    simp [substExpr, ih1 hnf1, ih2 hnf2]
  | EProve e ih =>
    simp [substExpr, ih hnf]
  | ERequire _ e ih =>
    simp [substExpr, ih hnf]
  | EGrant _ e ih =>
    simp [substExpr, ih hnf]

-- Substitution into closed (well-typed in empty context) terms is the identity.
/-- subst_closed_typing (matches Coq) -/
theorem subst_closed_typing : ∀ St Δ e T ε x v, has_type ([] : type_env) St Δ e T ε → substExpr x v e = e := by
  intro St Δ e T ε x v htype
  apply subst_not_free
  exact closed_no_free_vars St Δ e T ε x htype

-- Weakening by a list of fresh bindings preserves typing for open terms.
/-- typing_weaken_fresh_list (matches Coq) -/
theorem typing_weaken_fresh_list : ∀ Γ1 Γ2 St Δ e T ε, has_type Γ2 St Δ e T ε → (∀ x, free_in x e → lookup x Γ1 = None) → has_type (Γ1 ++ Γ2) St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype hfresh
  apply context_invariance Γ2 (Γ1 ++ Γ2) St Δ e T ε htype
  intro x hfree
  have hnil := hfresh x hfree
  rw [← lookup_app_r x Γ1 Γ2 hnil]

-- Lookup in a singleton context.
/-- lookup_singleton (matches Coq) -/
theorem lookup_singleton : ∀ x T, lookup x ((x, T) :: nil) = Some T := by
  intro x T; simp [lookup, type_env_lookup]

-- If lookup in (y,U)::Γ returns T and x ≠ y, then T comes from Γ.
--    (Same as lookup_cons_inv above but with reordered args for ergonomics.)
/-- lookup_cons_tail (matches Coq) -/
theorem lookup_cons_tail : ∀ x y U T Γ, x ≠ y → lookup x ((y, U) :: Γ) = Some T → lookup x Γ = Some T := by
  intro x y U T Γ hneq h
  simp [lookup, type_env_lookup, hneq] at h
  exact h

-- Lookup is decidable.
/-- lookup_dec (matches Coq) -/
theorem lookup_dec : ∀ x (Γ : type_env), (∃ T, lookup x Γ = Some T) ∨ lookup x Γ = None := by
  intro x Γ
  induction Γ with
  | «nil» => right; rfl
  | cons hd tl ih =>
    simp [lookup, type_env_lookup]
    split
    · left; exact ⟨_, rfl⟩
    · exact ih

-- Closed terms are invariant under any context and security level change.
/-- closed_typing_any_ctx (matches Coq) -/
theorem closed_typing_any_ctx : ∀ Γ St Δ1 Δ2 e T ε, has_type nil St Δ1 e T ε → has_type Γ St Δ2 e T ε := by
  intro Γ St Δ1 Δ2 e T ε htype
  have h1 := closed_typing_weakening St Δ1 e T ε Γ htype
  exact typing_delta_irrelevance Γ St Δ1 Δ2 e T ε h1

-- Weakening commutes with exchange: can weaken and exchange simultaneously.
/-- typing_weaken_exchange (matches Coq) -/
theorem typing_weaken_exchange : ∀ Γ St Δ e T ε x Tx y Ty, has_type Γ St Δ e T ε → ~ free_in x e → ~ free_in y e → x ≠ y → has_type ((y, Ty) :: (x, Tx) :: Γ) St Δ e T ε := by
  intro Γ St Δ e T ε x Tx y Ty htype hnfx hnfy _hneq
  exact typing_weaken_two Γ St Δ e T ε y Ty x Tx htype hnfy hnfx

-- Weakening by appending: typing is preserved when we append to the context.
/-- typing_weaken_append (matches Coq) -/
theorem typing_weaken_append : ∀ Γ1 Γ2 St Δ e T ε, has_type Γ1 St Δ e T ε → has_type (Γ1 ++ Γ2) St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype
  apply context_invariance Γ1 (Γ1 ++ Γ2) St Δ e T ε htype
  intro x hfree
  have ⟨T', hlookup⟩ := free_in_context x e Γ1 St Δ T ε hfree htype
  rw [hlookup]
  exact (lookup_app_l x Γ1 Γ2 T' hlookup).symm

-- Removing a suffix from Γ preserves typing if all free variables
-- are bound in the prefix.
/-- typing_prefix_sufficient (matches Coq) -/
theorem typing_prefix_sufficient : ∀ Γ1 Γ2 St Δ e T ε, has_type (Γ1 ++ Γ2) St Δ e T ε → (∀ x, free_in x e → lookup x Γ1 = lookup x (Γ1 ++ Γ2)) → has_type Γ1 St Δ e T ε := by
  intro Γ1 Γ2 St Δ e T ε htype hagree
  apply context_invariance (Γ1 ++ Γ2) Γ1 St Δ e T ε htype
  intro x hfree
  exact (hagree x hfree).symm

-- Typing in singleton context: a variable is well-typed with pure effect.
/-- typing_singleton_var (matches Coq) -/
theorem typing_singleton_var : ∀ x T St Δ, has_type ((x, T) :: nil) St Δ (EVar x) T EffectPure := by
  intro x T St Δ
  apply has_type.T_Var
  simp [type_env_lookup]

-- Typing in empty context: free variables must not exist
/-- nil_ctx_no_free_vars (matches Coq) -/
theorem nil_ctx_no_free_vars : ∀ St Δ e T ε x, has_type nil St Δ e T ε → ~ free_in x e := by
  exact closed_no_free_vars

-- Weakening by cons on the right side
/-- typing_weaken_cons_right (matches Coq) -/
theorem typing_weaken_cons_right : ∀ Γ St Δ e T ε y Ty, has_type Γ St Δ e T ε → has_type (Γ ++ (y, Ty) :: nil) St Δ e T ε := by
  intro Γ St Δ e T ε y Ty htype
  exact typing_weaken_append Γ ((y, Ty) :: nil) St Δ e T ε htype

-- Singleton context extension
/-- typing_weaken_singleton (matches Coq) -/
theorem typing_weaken_singleton : ∀ St Δ e T ε x Tx, has_type nil St Δ e T ε → has_type ((x, Tx) :: nil) St Δ e T ε := by
  intro St Δ e T ε x Tx htype
  exact closed_typing_weakening St Δ e T ε ((x, Tx) :: nil) htype

-- Double singleton context extension
/-- typing_weaken_double (matches Coq) -/
theorem typing_weaken_double : ∀ St Δ e T ε x Tx y Ty, has_type nil St Δ e T ε → has_type ((x, Tx) :: (y, Ty) :: nil) St Δ e T ε := by
  intro St Δ e T ε x Tx y Ty htype
  exact closed_typing_weakening St Δ e T ε ((x, Tx) :: (y, Ty) :: nil) htype

-- Typing in empty context is closed
/-- nil_ctx_typed_closed (matches Coq) -/
theorem nil_ctx_typed_closed : ∀ St Δ e T ε, has_type nil St Δ e T ε → ∀ x, ~ free_in x e := by
  intro St Δ e T ε htype x
  exact closed_no_free_vars St Δ e T ε x htype

end RIINA
