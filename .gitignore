# Node
**/node_modules/
# package-lock.json files are COMMITTED: deploys use `npm ci`, which installs
# exactly the locked versions (an ignored lockfile meant every deploy
# resolved fresh `^` ranges from the registry).

# Nix
result
.lia.cache
.nia.cache

# Constant-time timing evidence — host-specific runtime artifacts (regenerated by
# scripts/ct-timing-certify.sh); not committed (an indicative in-container run must
# not be mistaken for controlled-host certification).
reports/ct_evidence/

# Durable-store files written by running the REQ-73 persistence examples
# (07_EXAMPLES/11_servis) from the repo root. Runtime data, never source —
# one was committed by accident at b5815399 and removed immediately after.
*.simpan

# Package build output (`riinac pkg build` writes artifacts here). The reference
