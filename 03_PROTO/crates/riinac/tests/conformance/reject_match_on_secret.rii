// A match on a secret sum. riinac used to accept it and label the result
// Rahsia; the Coq core's T_Case requires a plain TSum. Rejected since
// 2026-10-23, as a branch on a secret is.
fungsi utama() -> () kesan Bersih {
    biar s = sulit (inl 5 : Hasil<Nombor, Teks>);
    biar hasil = padan s {
        inl x => 1,
        inr y => 0,
    };
    ()
}
