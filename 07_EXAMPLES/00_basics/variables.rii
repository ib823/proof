/// VARIABLES.RII - Variable Bindings with Bahasa Melayu
/// Menunjukkan cara mengikat pembolehubah dengan biar
/// Demonstrates: let bindings, type annotations, shadowing, tuples

fungsi contohPembolehubah() -> Nombor kesan Bersih {
    /// Ikat pembolehubah dengan inferens jenis
    /// Bind variable with type inference
    biar x = 42;

    /// Ikat dengan jenis eksplisit
    /// Bind with explicit type annotation
    biar nama: Teks = "Ahmad";

    /// Bindings di RIINA tidak berubah; gunakan 'biar' semula untuk nilai baharu
    /// (shadowing). Bindings are immutable; rebind with 'biar' for a new value.
    biar jumlah: Nombor = 0;
    biar jumlah = jumlah + 10;

    /// Ikat pasangan (tuple)
    /// Bind a pair/tuple
    biar pasangan = (1, 2);
    biar pertama_elemen = pasangan.0;

    pulang x + jumlah + pertama_elemen;
}

fungsi utama() -> Nombor kesan Bersih {
    pulang contohPembolehubah();
}
