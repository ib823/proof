/// BOOLEANS.RII - Boolean Logic & Operators
/// Operasi logik boolean dalam RIINA
/// Demonstrates: &&, ||, bukan, comparison operators

fungsi operasiLogik() -> Bool kesan Bersih {
    /// Nilai boolean asas
    biar benar_nilai = betul;
    biar palsu_nilai = salah;

    /// DAN logik (AND)
    biar hasil_dan = betul && betul;

    /// ATAU logik (OR)
    biar hasil_atau = betul || salah;

    /// BUKAN logik (NOT)
    biar songsang = bukan betul;

    /// Gabungan ungkapan
    biar gabungan = (betul && salah) || (bukan salah);

    pulang gabungan;
}

fungsi bandingan() -> Bool kesan Bersih {
    biar sama = 5 == 5;
    biar tak_sama = 5 != 3;
    biar lebih_besar = 10 > 5;
    biar lebih_kecil = 3 < 8;

    pulang sama && lebih_besar;
}

fungsi utama() -> Bool kesan Bersih {
    pulang operasiLogik();
}
