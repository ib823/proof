/// PAIRS.RII - Tuples and Pairs
/// Pasangan dan tuple dalam RIINA

fungsi operasiPasangan() -> Nombor kesan Bersih {
    /// Cipta pasangan / Create a pair
    biar pasangan = (42, "Ahmad");

    /// Akses elemen dengan .0 dan .1 / Access elements with .0 and .1
    biar elemen_pertama = pasangan.0;
    biar elemen_kedua = pasangan.1;

    pulang elemen_pertama;
}

fungsi utama() -> Nombor kesan Bersih {
    pulang operasiPasangan();
}
