/// STRINGS.RII - String Operations
/// Operasi rentetan teks dalam RIINA

fungsi operasiTeks() -> Teks kesan Bersih {
    /// Cipta rentetan / Create strings
    biar nama = "Ahmad";
    biar salam = "Selamat datang";

    /// Gabungan rentetan / String concatenation
    biar sapaan = "Selamat " + "pagi " + nama;

    /// Panjang rentetan / String length
    biar panjang_nama = teks_panjang(nama);

    pulang sapaan;
}

fungsi utama() -> Teks kesan Bersih {
    pulang operasiTeks();
}
