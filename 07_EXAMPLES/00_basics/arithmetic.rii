/// ARITHMETIC.RII - Arithmetic Operations
/// Operasi matematik dalam RIINA
/// Demonstrates: +, -, *, /, %, operator precedence

fungsi operasiMatematik() -> Nombor kesan Bersih {
    /// Penambahan / Addition: 8
    biar penambahan = 5 + 3;

    /// Penolakan / Subtraction: 6
    biar penolakan = 10 - 4;

    /// Pendaraban / Multiplication: 42
    biar pendaraban = 6 * 7;

    /// Pembahagian / Division: 5
    biar pembahagian = 20 / 4;

    /// Modulo (sisa) / Modulo: 2
    biar sisa = 17 % 5;

    /// Operasi dengan preseden / precedence: 2 + (3*4) = 14
    biar campuran = 2 + 3 * 4;

    /// Gunakan kurungan untuk ubah preseden / (2+3)*4 = 20
    biar dalam_kurungan = (2 + 3) * 4;

    /// Operasi rantaian / Chained operations
    biar rantaian = 100 - 25 + 15 / 3;

    pulang campuran + dalam_kurungan;
}

fungsi utama() -> Nombor kesan Tulis {
    biar hasil = operasiMatematik();
    cetak("Hasil: ");
    cetak(hasil);
    cetak("\n");
    pulang 0;
}

/// NUMERIC TYPES: Nombor is a fixed-width integer type.
/// All operations are on machine integers with defined overflow semantics.
