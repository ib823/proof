// procurement.rii — TELUS Procurement Workflow
// Full JALINAN example: choreography + actors + state

koreografi Perolehan {
    peranan Pemohon, Pelulus, Vendor;

    Pemohon -> Pelulus: hantar Nombor;
    Pelulus -> Pemohon: pilih {
        Lulus -> {
            Pelulus -> Vendor: hantar Nombor;
            Vendor -> Pemohon: hantar Nombor;
        },
        Tolak -> {
            Pelulus -> Pemohon: hantar Nombor;
        }
    }
    tamat;
}

// Each role is an actor
pelaku PelakuPemohon { keadaan: Nombor kendalikan Permintaan(n) { n } }
pelaku PelakuPelulus { keadaan: Nombor kendalikan Semak(n) { n } }

biar pemohon = lahir PelakuPemohon(0);
biar pelulus = lahir PelakuPelulus(0);

hantar(pemohon, 1000);
hantar(pelulus, 1000);

terima(pelulus)
