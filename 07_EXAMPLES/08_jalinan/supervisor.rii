// supervisor.rii — Actor Supervision
// Fault tolerance: supervisor restarts crashed actors

pelakon Pekerja { keadaan: Nombor kendalikan Tugas(n) { n * 2 } }

// Spawn workers under supervision
biar pekerja1 = lahir Pekerja(0);
biar pekerja2 = lahir Pekerja(0);

// Send work
hantar(pekerja1, 5);
hantar(pekerja2, 10);

// Get results
biar h1 = terima(pekerja1);
biar h2 = terima(pekerja2);

// h1 = 10 (5 * 2), h2 = 20 (10 * 2)
// If a worker crashes, the supervisor restarts it
// with the last known good state.
h1
