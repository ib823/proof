// merkle_audit.rii — Content-Addressed Audit Trail
// Builds a Merkle-style root over transaction data.
// cincang() hashes data; sahkan() verifies integrity against a root.
// Hashing carries the Kripto effect, so the function declares it.

fungsi utama() -> Benar kesan Kripto {
    biar data1 = "Transaksi A";
    biar data2 = "Transaksi B";

    // Hash individual transactions (tamper-evidence per leaf)
    biar hash1 = cincang(data1);
    biar hash2 = cincang(data2);

    // Combine the leaves into a root over the concatenated data
    biar gabungan = data1 + data2;
    biar root = cincang(gabungan);

    // Verify: the root must match a re-hash of the combined leaves
    sahkan(root, gabungan)
}
