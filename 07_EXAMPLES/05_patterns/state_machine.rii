/// state_machine.rii
/// State machine pattern for managing object state transitions
/// Demonstrates finite state machine with validation
/// Gaya ungkapan: transisi memulangkan pesanan BARU (RIINA tiada mutasi medan)

jenis KeadaanPesanan =
    | BELUM_DIPROSES
    | SEDANG_DIPROSES
    | LENGKAP
    | DIBATALKAN;

jenis Pesanan {
    id: Teks,
    keadaan_semasa: KeadaanPesanan,
    nilai: Nombor,
}

/// Validate state transitions
fungsi sah_transisi(dari: KeadaanPesanan, ke: KeadaanPesanan) -> Benar kesan Bersih {
    padan (dari, ke) {
        (BELUM_DIPROSES, SEDANG_DIPROSES) => betul,
        (BELUM_DIPROSES, DIBATALKAN) => betul,
        (SEDANG_DIPROSES, LENGKAP) => betul,
        (SEDANG_DIPROSES, DIBATALKAN) => betul,
        _ => salah,
    }
}

fungsi keadaan_txt(keadaan: KeadaanPesanan) -> Teks kesan Bersih {
    padan keadaan {
        BELUM_DIPROSES => "Belum Diproses",
        SEDANG_DIPROSES => "Sedang Diproses",
        LENGKAP => "Lengkap",
        DIBATALKAN => "Dibatalkan",
    }
}

/// Attempt a transition: returns the NEW order state
/// (unchanged order if the transition is invalid)
fungsi ubah_keadaan(pesanan: Pesanan, keadaan_baru: KeadaanPesanan) -> Pesanan kesan Tulis {
    kalau !sah_transisi(pesanan.keadaan_semasa, keadaan_baru) {
        cetak("Transisi tidak sah: ");
        cetak(keadaan_txt(pesanan.keadaan_semasa));
        cetak(" -> ");
        cetak(keadaan_txt(keadaan_baru));
        cetak("\n");
        pulang pesanan;
    }

    cetak("Pesanan ");
    cetak(pesanan.id);
    cetak(" sekarang: ");
    cetak(keadaan_txt(keadaan_baru));
    cetak("\n");

    Pesanan {
        id: pesanan.id,
        keadaan_semasa: keadaan_baru,
        nilai: pesanan.nilai,
    }
}

fungsi utama() -> Nombor kesan Tulis {
    cetak("=== MESIN KEADAAN ===\n");

    biar pesanan = Pesanan {
        id: "ORD-123",
        keadaan_semasa: BELUM_DIPROSES,
        nilai: 500,
    };

    biar p1 = ubah_keadaan(pesanan, SEDANG_DIPROSES);
    biar p2 = ubah_keadaan(p1, LENGKAP);
    biar p3 = ubah_keadaan(p2, DIBATALKAN);  /// Transisi tidak sah (LENGKAP muktamad)

    pulang 0;
}
