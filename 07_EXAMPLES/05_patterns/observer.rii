/// observer.rii
/// Observer pattern for event-driven updates
/// Demonstrates publish-subscribe mechanism
/// Gaya ungkapan: subjek diedarkan secara eksplisit (RIINA tiada mutasi global)

/// Observer callback record
jenis PemerhatiPerubahan {
    nama: Teks,
    fungsi_update: Teks,
}

/// Subject that notifies observers
jenis SubjekPerubahan {
    keadaan: Teks,
    pemerhati: Senarai<PemerhatiPerubahan>,
}

/// Daftar pemerhati baru: pulangkan SUBJEK BARU dengan senarai dilanjutkan
fungsi daftarkan_pemerhati(subjek: SubjekPerubahan, nama: Teks) -> SubjekPerubahan kesan Tulis {
    biar pemerhati_baru = PemerhatiPerubahan {
        nama: nama,
        fungsi_update: "update_" + nama,
    };

    cetak("Pemerhati ");
    cetak(nama);
    cetak(" didaftarkan\n");

    SubjekPerubahan {
        keadaan: subjek.keadaan,
        pemerhati: subjek.pemerhati + [pemerhati_baru],
    }
}

/// Tukar keadaan dan maklumkan semua pemerhati; pulangkan subjek baru
fungsi ubah_keadaan(subjek: SubjekPerubahan, keadaan_baru: Teks) -> SubjekPerubahan kesan Tulis {
    cetak("Keadaan berubah ke: ");
    cetak(keadaan_baru);
    cetak("\n");

    /// Notify all observers
    untuk pemerhati dalam subjek.pemerhati {
        cetak("Memaklumi ");
        cetak(pemerhati.nama);
        cetak(": ");
        cetak(keadaan_baru);
        cetak("\n");
    }

    SubjekPerubahan {
        keadaan: keadaan_baru,
        pemerhati: subjek.pemerhati,
    }
}

fungsi utama() -> Nombor kesan Tulis {
    cetak("=== CORAK PEMERHATI ===\n");

    biar subjek_awal = SubjekPerubahan {
        keadaan: "awal",
        pemerhati: [],
    };

    biar s1 = daftarkan_pemerhati(subjek_awal, "Logger");
    biar s2 = daftarkan_pemerhati(s1, "AlertingSystem");
    biar s3 = daftarkan_pemerhati(s2, "Dashboard");

    biar s4 = ubah_keadaan(s3, "sedang memproses");
    biar s5 = ubah_keadaan(s4, "siap");

    pulang 0;
}
