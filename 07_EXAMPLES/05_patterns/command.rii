/// command.rii
/// Command pattern with undo capability
/// Demonstrates encapsulating requests as objects
/// Gaya ungkapan: keadaan diedarkan secara eksplisit (RIINA tiada mutasi global)

jenis Arahan =
    | TAMBAH(Nombor)
    | TOLAK(Nombor)
    | DARAB(Nombor)
    | BAHAGI(Nombor);

jenis RekodArah {
    nilai_lama: Nombor,
    nilai_baru: Nombor,
}

/// Terjemah satu arahan kepada nilai baru (tulen — tiada kesan)
fungsi laksana_arahan(nilai: Nombor, arahan: Arahan) -> Nombor kesan Bersih {
    padan arahan {
        TAMBAH(n) => nilai + n,
        TOLAK(n) => nilai - n,
        DARAB(n) => nilai * n,
        BAHAGI(n) => kalau n != 0 { nilai / n } lain { nilai },
    }
}

/// Jalankan arahan dan pulangkan rekod (untuk sokongan buat-semula)
fungsi jalankan(nilai: Nombor, arahan: Arahan) -> RekodArah kesan Tulis {
    biar nilai_baru = laksana_arahan(nilai, arahan);
    cetak("Arahan dijalankan: ");
    cetak(nilai);
    cetak(" -> ");
    cetak(nilai_baru);
    cetak("\n");
    RekodArah { nilai_lama: nilai, nilai_baru: nilai_baru }
}

/// Buat semula (undo): pulangkan nilai sebelum arahan terakhir
fungsi buat_semula(rekod: RekodArah) -> Nombor kesan Tulis {
    cetak("Buat semula: ");
    cetak(rekod.nilai_lama);
    cetak(" <- ");
    cetak(rekod.nilai_baru);
    cetak("\n");
    rekod.nilai_lama
}

fungsi utama() -> Nombor kesan Tulis {
    cetak("=== CORAK ARAHAN ===\n");

    biar r1 = jalankan(0, TAMBAH(10));
    biar r2 = jalankan(r1.nilai_baru, DARAB(2));
    biar r3 = jalankan(r2.nilai_baru, TOLAK(5));

    cetak("Nilai akhir: ");
    cetak(r3.nilai_baru);
    cetak("\n");

    biar nilai_undo = buat_semula(r3);
    cetak("Selepas buat semula: ");
    cetak(nilai_undo);
    cetak("\n");

    pulang 0;
}
