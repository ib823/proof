/// iterator.rii
/// Iterator pattern for sequential access to collection elements
/// Demonstrates abstraction of iteration logic
/// Gaya ungkapan: `dapat_seterusnya` memulangkan (nilai, pengulangi BARU)

jenis Pengulangi {
    elemen_semasa: Nombor,
    senarai_lengkap: Senarai<Teks>,
}

fungsi cipta_pengulangi(senarai: Senarai<Teks>) -> Pengulangi kesan Bersih {
    Pengulangi {
        elemen_semasa: 0,
        senarai_lengkap: senarai,
    }
}

fungsi ada_seterusnya(pengulangi: Pengulangi) -> Benar kesan Bersih {
    pengulangi.elemen_semasa < senarai_panjang(pengulangi.senarai_lengkap)
}

/// Pulangkan elemen semasa BERSAMA pengulangi yang sudah maju satu langkah
fungsi dapat_seterusnya(pengulangi: Pengulangi) -> Mungkin<(Teks, Pengulangi)> kesan Bersih {
    kalau ada_seterusnya(pengulangi) {
        biar nilai: Teks = pengulangi.senarai_lengkap[pengulangi.elemen_semasa];
        biar berikut = Pengulangi {
            elemen_semasa: pengulangi.elemen_semasa + 1,
            senarai_lengkap: pengulangi.senarai_lengkap,
        };
        Ada((nilai, berikut))
    } lain {
        Tiada
    }
}

/// Pandu pengulangi sehingga habis (rekursif — tiada mutasi)
fungsi cetak_semua(pengulangi: Pengulangi) -> Nombor kesan Tulis {
    padan dapat_seterusnya(pengulangi) {
        Ada(pasangan) => {
            cetak("- ");
            cetak(pertama pasangan);
            cetak("\n");
            cetak_semua(kedua pasangan)
        },
        Tiada => 0,
    }
}

fungsi utama() -> Nombor kesan Tulis {
    cetak("=== CORAK PENGULANGI ===\n");

    biar senarai = ["pertama", "kedua", "ketiga"];
    biar pengulangi = cipta_pengulangi(senarai);
    biar jumlah_dicetak = cetak_semua(pengulangi);

    pulang 0;
}
