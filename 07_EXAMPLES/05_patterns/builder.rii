/// builder.rii
/// Builder pattern for complex object construction
/// Demonstrates step-by-step object building with validation
/// Gaya ungkapan: setiap langkah memulangkan pembina BARU (tiada mutasi medan)
///
/// Pattern: Creational - Builder

/// Product: Complex configuration object
jenis KonfigurasiPelayan {
    nama_hos: Teks,
    pelabuhan: Nombor,
    kedalaman_thread: Nombor,
    masa_timeout: Nombor,
    membolehkan_gzip: Benar,
    sertifikat_ssl: Mungkin<Teks>,
}

/// Builder: Step-by-step construction
jenis PembinaKonfigurasi {
    hos: Teks,
    port: Nombor,
    threads: Nombor,
    timeout: Nombor,
    gzip_enabled: Benar,
    ssl_cert: Mungkin<Teks>,
}

/// Create default builder
fungsi pembina_baru() -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: "localhost",
        port: 8080,
        threads: 10,
        timeout: 30,
        gzip_enabled: betul,
        ssl_cert: Tiada,
    }
}

/// Builder steps — each returns a NEW builder with one field replaced
fungsi tetapkan_hos(pembina: PembinaKonfigurasi, hos: Teks) -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: hos,
        port: pembina.port,
        threads: pembina.threads,
        timeout: pembina.timeout,
        gzip_enabled: pembina.gzip_enabled,
        ssl_cert: pembina.ssl_cert,
    }
}

fungsi tetapkan_pelabuhan(pembina: PembinaKonfigurasi, pelabuhan: Nombor) -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: pembina.hos,
        port: pelabuhan,
        threads: pembina.threads,
        timeout: pembina.timeout,
        gzip_enabled: pembina.gzip_enabled,
        ssl_cert: pembina.ssl_cert,
    }
}

fungsi tetapkan_thread(pembina: PembinaKonfigurasi, jumlah: Nombor) -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: pembina.hos,
        port: pembina.port,
        threads: jumlah,
        timeout: pembina.timeout,
        gzip_enabled: pembina.gzip_enabled,
        ssl_cert: pembina.ssl_cert,
    }
}

fungsi tetapkan_timeout(pembina: PembinaKonfigurasi, saat: Nombor) -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: pembina.hos,
        port: pembina.port,
        threads: pembina.threads,
        timeout: saat,
        gzip_enabled: pembina.gzip_enabled,
        ssl_cert: pembina.ssl_cert,
    }
}

fungsi tetapkan_ssl(pembina: PembinaKonfigurasi, laluan_cert: Teks) -> PembinaKonfigurasi kesan Bersih {
    PembinaKonfigurasi {
        hos: pembina.hos,
        port: pembina.port,
        threads: pembina.threads,
        timeout: pembina.timeout,
        gzip_enabled: pembina.gzip_enabled,
        ssl_cert: Ada(laluan_cert),
    }
}

/// Build final object with validation
fungsi bina(pembina: PembinaKonfigurasi) -> Mungkin<KonfigurasiPelayan> kesan Tulis {
    kalau pembina.port <= 0 || pembina.port > 65535 {
        cetak("Ralat: Pelabuhan tidak sah\n");
        pulang Tiada;
    }

    kalau pembina.threads <= 0 {
        cetak("Ralat: Thread harus > 0\n");
        pulang Tiada;
    }

    cetak("Konfigurasi pembina berjaya\n");
    Ada(KonfigurasiPelayan {
        nama_hos: pembina.hos,
        pelabuhan: pembina.port,
        kedalaman_thread: pembina.threads,
        masa_timeout: pembina.timeout,
        membolehkan_gzip: pembina.gzip_enabled,
        sertifikat_ssl: pembina.ssl_cert,
    })
}

/// Display configuration
fungsi papar_konfigurasi(config: KonfigurasiPelayan) -> Nombor kesan Tulis {
    cetak("=== KONFIGURASI PELAYAN ===\n");
    cetak("Hos: ");
    cetak(config.nama_hos);
    cetak("\nPelabuhan: ");
    cetak(config.pelabuhan);
    cetak("\nThread: ");
    cetak(config.kedalaman_thread);
    cetak("\nTimeout (saat): ");
    cetak(config.masa_timeout);
    cetak("\n");

    padan config.sertifikat_ssl {
        Ada(cert) => {
            cetak("Sertifikat SSL: ");
            cetak(cert);
            cetak("\n");
        },
        Tiada => cetak("SSL: Dimatikan\n"),
    }

    pulang 0;
}

/// Example usage
fungsi utama() -> Nombor kesan Tulis {
    cetak("=== CORAK PEMBINA ===\n");

    /// Bina konfigurasi langkah demi langkah
    biar p1 = pembina_baru();
    biar p2 = tetapkan_hos(p1, "api.contoh.my");
    biar p3 = tetapkan_pelabuhan(p2, 443);
    biar p4 = tetapkan_thread(p3, 50);
    biar p5 = tetapkan_timeout(p4, 60);
    biar p6 = tetapkan_ssl(p5, "/etc/ssl/cert.pem");

    /// Build and validate
    padan bina(p6) {
        Ada(config) => {
            biar hasil_papar = papar_konfigurasi(config);
        },
        Tiada => cetak("Konfigurasi tidak sah\n"),
    }

    pulang 0;
}
