/// auth_flow.rii
/// OAuth2-style authentication flow with secret management
/// Demonstrates: Rahsia<Teks> for tokens/passwords, dedah for audit,
/// effect Kripto for cryptographic operations
///
/// Pattern: Secrets never leak to lower security levels. All
/// declassification points are auditable with explicit proof.

modul aliran_pengesahan;

guna std::kripto;
guna std::masa;

/// Token types — all wrapped in Rahsia
jenis TokenAkses = {
    nilai: Rahsia<Teks>,
    tamat_tempoh: Nombor,
};

jenis TokenSegarSemula = {
    nilai: Rahsia<Teks>,
    tamat_tempoh: Nombor,
};

jenis Kelayakan = {
    nama_pengguna: Teks,
    kata_laluan_hash: Rahsia<Teks>,
    garam: Teks,
};

jenis HasilPengesahan =
    | Berjaya(TokenAkses, TokenSegarSemula)
    | KataLaluanSalah
    | PenggunaTidakWujud
    | TokenTamatTempoh;

/// Hash password with salt — cryptographic effect required
fungsi jana_rawak_hex(panjang_bait: Nombor) -> Teks kesan Kripto {
    /// Simulasi penjanaan heks rawak
    "af03bc9d1e"
}

fungsi bandingkan_malar(a: Teks, b: Teks) -> Benar kesan MasaTetap {
    /// Simulasi perbandingan masa-tetap
    a == b
}

fungsi sha256(data: Teks) -> Teks kesan Kripto {
    /// Simulasi hash SHA-256 (primitif kripto sebenar belum dalam stdlib contoh)
    "hash_" + data
}

fungsi hash_kata_laluan(kata_laluan: Teks, garam: Teks) -> Rahsia<Teks> kesan Kripto {
    biar dicampur = kata_laluan + ":" + garam;
    biar hash = sha256(dicampur);
    pulang (sulit hash);
}

/// Generate a cryptographically random token
fungsi jana_token(panjang_bait: Nombor) -> Rahsia<Teks> kesan Kripto {
    biar rawak = jana_rawak_hex(panjang_bait);
    pulang (sulit rawak);
}

/// Authenticate user against stored credentials
/// Kesan: Kripto (hashing for comparison)
fungsi sahkan_pengguna(
    nama_pengguna: Teks,
    kata_laluan: Teks,
    simpanan: Senarai<Kelayakan>
) -> HasilPengesahan kesan Kripto {
    /// Find user
    biar ubah kelayakan_dijumpai: Mungkin<Kelayakan> = Tiada;

    untuk k dalam simpanan {
        kalau k.nama_pengguna == nama_pengguna {
            kelayakan_dijumpai = Ada(k);
        }
    }

    padan kelayakan_dijumpai {
        Tiada => pulang PenggunaTidakWujud,
        Ada(k) => {
            /// Hash the attempted password with stored salt
            biar hash_cubaan = hash_kata_laluan(kata_laluan, k.garam);

            /// Constant-time comparison of secrets
            biar sama = bandingkan_malar(
                (dedah hash_cubaan dengan bukti hash_cubaan),
                (dedah k.kata_laluan_hash dengan bukti k.kata_laluan_hash)
            );

            kalau sama {
                /// Issue tokens
                biar token_akses = {
                    nilai: jana_token(32),
                    tamat_tempoh: Masa::masa_unix() + 3600,
                };
                biar token_segar = {
                    nilai: jana_token(64),
                    tamat_tempoh: Masa::masa_unix() + 604800,
                };
                pulang Berjaya((token_akses, token_segar));
            } lain {
                pulang KataLaluanSalah;
            }
        },
    };
}

/// Validate an access token (check expiry)
fungsi sahkan_token(token_akses: TokenAkses) -> Hasil<Teks, Teks> kesan Bersih {
    biar sekarang = 0; /// Simulated current time
    kalau sekarang > token_akses.tamat_tempoh {
        pulang Ralat("Token tamat tempoh");
    }
    /// Declassify token for internal lookup — auditable
    biar nilai_token = (dedah token_akses.nilai dengan bukti token_akses.nilai);
    pulang Ok(nilai_token);
}

/// Refresh access token using refresh token
fungsi segar_semula_token(
    token_segar: TokenSegarSemula
) -> Hasil<TokenAkses, Teks> kesan Kripto {
    biar sekarang = Masa::masa_unix();

    kalau sekarang > token_segar.tamat_tempoh {
        pulang Ralat("Token segar semula tamat tempoh");
    }

    biar token_baru = {
        nilai: jana_token(32),
        tamat_tempoh: sekarang + 3600,
    };

    pulang Ok(token_baru);
}

/// Log authentication event — dedah with audit proof
/// Kesan: Tulis (audit log output)
fungsi log_pengesahan(
    nama_pengguna: Teks,
    berjaya: Benar,
    token_akses: Mungkin<TokenAkses>
) -> kesan Tulis {
    cetak_baris("=== LOG PENGESAHAN ===");
    cetak_baris("Pengguna: " + nama_pengguna);
    biar teks_status = kalau berjaya { "BERJAYA" } lain { "GAGAL" };
    cetak_baris("Status: " + teks_status);

    /// Only log token prefix for audit — never full token
    padan token_akses {
        Ada(t) => {
            biar nilai_penuh = (dedah t.nilai dengan bukti t.nilai);
            biar prefiks = potong(nilai_penuh, 0, 8);
            cetak_baris("Token (prefiks): " + prefiks + "...");
        },
        Tiada => {
            cetak_baris("Token: tiada");
        },
    };
}

/// Helper
fungsi potong(teks: Teks, mula: Nombor, hujung: Nombor) -> Teks kesan Bersih {
    pulang teks;
}

ujian "pengesahan_kata_laluan_betul" {
    biar garam = "random_salt_123";
    biar hash = hash_kata_laluan("kata_laluan_sebenar", garam);
    biar kelayakan = [{
        nama_pengguna: "ahmad",
        kata_laluan_hash: hash,
        garam: garam,
    }];

    biar hasil = sahkan_pengguna("ahmad", "kata_laluan_sebenar", kelayakan);
    padan hasil {
        Berjaya((_, _)) => tegaskan(betul),
        _ => tegaskan(salah),
    };
}

ujian "tolak_kata_laluan_salah" {
    biar garam = "garam_001";
    biar hash = hash_kata_laluan("betul", garam);
    biar kelayakan = [{
        nama_pengguna: "siti",
        kata_laluan_hash: hash,
        garam: garam,
    }];

    biar hasil = sahkan_pengguna("siti", "salah", kelayakan);
    padan hasil {
        KataLaluanSalah => tegaskan(betul),
        _ => tegaskan(salah),
    };
}
