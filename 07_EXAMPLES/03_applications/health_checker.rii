/// health_checker.rii
/// Service health monitoring and status aggregation
/// Demonstrates Rangkaian effect for remote service checks
///
/// Features:
/// - Health check execution (simulated HTTP)
/// - Status aggregation
/// - Alert generation on state change
/// Gaya ungkapan: keadaan diedarkan secara eksplisit (RIINA tiada mutasi global)

jenis KeadaanKesihatan =
    | SIHAT
    | AMARAN
    | SAKIT
    | TIDAK_DIKETAHUI;

jenis HasilSemakan {
    nama_perkhidmatan: Teks,
    keadaan: KeadaanKesihatan,
    kod_respons: Nombor,
    masa_tindakbalas_ms: Nombor,
}

jenis KonfigurPerkhidmatan {
    nama: Teks,
    alamat_url: Teks,
    timeout_ms: Nombor,
    had_kesuksesan_ms: Nombor,
}

/// Simulasi permintaan HTTP — pulangkan masa tindak balas (ms)
fungsi http_semak_simulasi(alamat_url: Teks, timeout_ms: Nombor) -> Nombor kesan Rangkaian {
    350
}

/// Check single service health
/// Kesan: Rangkaian (makes HTTP requests)
fungsi semak_perkhidmatan(konfigur: KonfigurPerkhidmatan) -> HasilSemakan kesan Rangkaian {
    biar masa_tindakbalas = http_semak_simulasi(konfigur.alamat_url, konfigur.timeout_ms);

    biar keadaan = kalau masa_tindakbalas > konfigur.had_kesuksesan_ms {
        AMARAN
    } lain {
        SIHAT
    };

    HasilSemakan {
        nama_perkhidmatan: konfigur.nama,
        keadaan: keadaan,
        kod_respons: 200,
        masa_tindakbalas_ms: masa_tindakbalas,
    }
}

/// Adakah mana-mana hasil berkeadaan SAKIT?
fungsi ada_keadaan_sakit(senarai_hasil: Senarai<HasilSemakan>) -> Benar kesan Bersih {
    untuk hasil dalam senarai_hasil {
        padan hasil.keadaan {
            SAKIT => { pulang betul; },
            _ => (),
        };
    }
    pulang salah;
}

/// Adakah mana-mana hasil berkeadaan AMARAN?
fungsi ada_keadaan_amaran(senarai_hasil: Senarai<HasilSemakan>) -> Benar kesan Bersih {
    untuk hasil dalam senarai_hasil {
        padan hasil.keadaan {
            AMARAN => { pulang betul; },
            _ => (),
        };
    }
    pulang salah;
}

/// Aggregate health status across services (gaya ungkapan)
fungsi agregat_kesihatan(senarai_hasil: Senarai<HasilSemakan>) -> KeadaanKesihatan kesan Bersih {
    kalau ada_keadaan_sakit(senarai_hasil) {
        SAKIT
    } lain kalau ada_keadaan_amaran(senarai_hasil) {
        AMARAN
    } lain {
        SIHAT
    }
}

/// Generate alert message if status changed (Tiada = no alert needed)
fungsi jana_amaran(
    nama: Teks,
    keadaan_lama: KeadaanKesihatan,
    keadaan_baru: KeadaanKesihatan
) -> Mungkin<Teks> kesan Bersih {
    biar perlu_amaran = padan (keadaan_lama, keadaan_baru) {
        (SIHAT, SAKIT) => betul,
        (SIHAT, AMARAN) => betul,
        (AMARAN, SAKIT) => betul,
        (SAKIT, SIHAT) => betul,
        (SAKIT, AMARAN) => betul,
        _ => salah,
    };

    kalau perlu_amaran {
        Ada("AMARAN: " + nama + " berubah dari " + keadaan_ke_teks(keadaan_lama)
            + " kepada " + keadaan_ke_teks(keadaan_baru))
    } lain {
        Tiada
    }
}

/// Format health state as text
fungsi keadaan_ke_teks(keadaan: KeadaanKesihatan) -> Teks kesan Bersih {
    padan keadaan {
        SIHAT => "SIHAT",
        AMARAN => "AMARAN",
        SAKIT => "SAKIT",
        TIDAK_DIKETAHUI => "TIDAK_DIKETAHUI",
    }
}

/// Main health checker (satu pusingan semakan)
fungsi utama() -> Nombor kesan (Rangkaian, Tulis) {
    cetak("=== PENYEMAK KESIHATAN PERKHIDMATAN ===\n");

    biar konfigur_api = KonfigurPerkhidmatan {
        nama: "API Pengguna",
        alamat_url: "http://api-pengguna:8080/kesihatan",
        timeout_ms: 5000,
        had_kesuksesan_ms: 1000,
    };

    biar konfigur_db = KonfigurPerkhidmatan {
        nama: "Pangkalan Data",
        alamat_url: "http://db-utama:5432/kesihatan",
        timeout_ms: 5000,
        had_kesuksesan_ms: 500,
    };

    biar hasil_api = semak_perkhidmatan(konfigur_api);
    biar hasil_db = semak_perkhidmatan(konfigur_db);

    biar semua_hasil = [hasil_api, hasil_db];
    biar keadaan = agregat_kesihatan(semua_hasil);

    cetak("Status keseluruhan: ");
    cetak(keadaan_ke_teks(keadaan));
    cetak("\n");

    /// Semak perubahan status — contoh amaran
    padan jana_amaran("Pangkalan Data", SIHAT, hasil_db.keadaan) {
        Ada(mesej) => {
            cetak(mesej);
            cetak("\n");
        },
        Tiada => (),
    }

    cetak("Selesai\n");
    pulang 0;
}
