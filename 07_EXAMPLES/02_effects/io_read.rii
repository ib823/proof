/// IO_READ.RII - Reading Input Operations
/// Operasi membaca input
/// Demonstrates: Baca effect, input operations, file reading

fungsi buka_fail(nama_fail: Teks) -> Hasil<Teks, Teks> kesan Baca {
    /// Simulasi pembukaan fail (tiada IO fail sebenar dalam contoh)
    Ok("pemegang_fail_simulasi")
}

fungsi baca_baris_dari_fail(fail: Teks) -> Hasil<Teks, Teks> kesan Baca {
    /// Simulasi pembacaan satu baris dari fail
    Ok("baris_simulasi")
}

fungsi ambil_alam_sekitar(nama: Teks) -> Mungkin<Teks> kesan Baca {
    /// Simulasi pembacaan pembolehubah persekitaran
    Tiada
}

fungsi baca_semua_dari_fail(fail: Teks) -> Teks kesan Baca {
    /// Simulasi pembacaan keseluruhan fail
    "kandungan_fail_simulasi"
}

fungsi tutup_fail(fail: Teks) -> Kosong kesan Baca {
    /// Simulasi penutupan fail
    ()
}

fungsi mengandungi_teks(teks: Teks, cari: Teks) -> Benar kesan Bersih {
    /// Simulasi semakan subteks
    salah
}

fungsi tukar_string_ke_nombor(t: Teks) -> Mungkin<Nombor> kesan Bersih {
    /// Simulasi penukaran teks ke nombor
    Tiada
}

fungsi baca_baris_dari_pengguna() -> Teks kesan Baca {
    /// Baca satu baris dari stdin
    baca_garisan()
}

fungsi baca_nombor_dari_pengguna() -> Hasil<Nombor, Teks> kesan Baca {
    /// Baca nombor dari pengguna
    biar teks_masuk = baca_garisan();
    padan tukar_string_ke_nombor(teks_masuk) {
        Ada(n) -> Ok(n),
        Tiada -> Ralat("Bukan nombor sah"),
    }
}

fungsi baca_fail_sepenuhnya(nama_fail: Teks) -> Hasil<Teks, Teks> kesan Baca {
    /// Baca isi fail sepenuhnya
    padan buka_fail(nama_fail) {
        Ok(fail) -> {
            biar kandungan = baca_semua_dari_fail(fail);
            tutup_fail(fail);
            Ok(kandungan)
        },
        Ralat(e) -> Ralat("Tidak dapat buka fail: {e}"),
    }
}

fungsi baca_baris_berulang(
    fail: Teks,
    f: Fn(Teks) -> Nombor,
    jumlah: Nombor,
    baki: Nombor
) -> Nombor kesan Baca {
    /// Baca baris secara rekursif sehingga habis (atau had baki)
    kalau baki == 0 {
        pulang jumlah;
    }
    padan baca_baris_dari_fail(fail) {
        Ok(baris_teks) -> {
            f(baris_teks);
            baca_baris_berulang(fail, f, jumlah + 1, baki - 1)
        },
        Ralat(_) -> jumlah,
    }
}

fungsi baca_fail_baris_demi_baris(
    nama_fail: Teks,
    f: Fn(Teks) -> Nombor
) -> Hasil<Nombor, Teks> kesan Baca {
    /// Baca fail baris demi baris (gaya ungkapan, tanpa mutasi)
    padan buka_fail(nama_fail) {
        Ok(fail) -> {
            biar jumlah = baca_baris_berulang(fail, f, 0, 3);
            tutup_fail(fail);
            Ok(jumlah)
        },
        Ralat(e) -> Ralat("Fail tidak dapat dibuka"),
    }
}

fungsi baca_alam_sekitar(nama_pembolehubah: Teks) -> Mungkin<Teks> kesan Baca {
    /// Baca pembolehubah alam sekitar
    padan ambil_alam_sekitar(nama_pembolehubah) {
        Ada(nilai) -> Ada(nilai),
        Tiada -> Tiada,
    }
}

fungsi baca_konfigurasi_dari_fail(nama_fail: Teks) -> Hasil<Teks, Teks> kesan Baca {
    /// Baca fail konfigurasi
    padan baca_fail_sepenuhnya(nama_fail) {
        Ok(kandungan) -> Ok(kandungan),
        Ralat(e) -> Ralat("Tidak dapat baca konfigurasi: {e}"),
    }
}

fungsi baca_json_dari_fail(nama_fail: Teks) -> Hasil<Teks, Teks> kesan Baca {
    /// Baca JSON dari fail
    padan baca_fail_sepenuhnya(nama_fail) {
        Ok(kandungan) -> {
            /// Validasi JSON mudah
            kalau mengandungi_teks(kandungan, "{") {
                Ok(kandungan)
            } lain {
                Ralat("JSON tidak sah")
            }
        },
        Ralat(e) -> Ralat(e),
    }
}

fungsi minta_input(
    gesaan: Teks
) -> Teks kesan (Tulis, Baca) {
    /// Minta input dengan gesaan
    cetak(gesaan);
    cetak(": ");
    baca_garisan()
}

fungsi minta_input_nombor(
    gesaan: Teks
) -> Hasil<Nombor, Teks> kesan (Tulis, Baca) {
    /// Minta input nombor dengan gesaan
    cetak(gesaan);
    cetak(": ");
    biar teks_masuk = baca_garisan();
    padan tukar_string_ke_nombor(teks_masuk) {
        Ada(n) -> Ok(n),
        Tiada -> Ralat("Input bukan nombor sah"),
    }
}

fungsi utama() -> Nombor kesan (Tulis, Baca) {
    cetak("=== Operasi Baca ===\n");

    /// Minta nama
    biar nama = minta_input("Masukkan nama");
    cetak("Nama: ");
    cetak(nama);
    cetak("\n");

    /// Minta umur
    padan minta_input_nombor("Masukkan umur") {
        Ok(umur) -> {
            cetak("Umur: ");
            cetak(umur);
            cetak("\n");
        },
        Ralat(e) -> {
            cetak("Ralat: ");
            cetak(e);
            cetak("\n");
        },
    }

    /// Baca pembolehubah alam sekitar
    padan baca_alam_sekitar("PATH") {
        Ada(path) -> {
            cetak("PATH dijumpai\n");
        },
        Tiada -> {
            cetak("PATH tidak dijumpai\n");
        },
    }

    cetak("Selesai\n");
    pulang 0;
}

/// GRAMMAR NOTE: kesan Baca indicates input operations.
/// Side effect tracked in type system.
/// Functions with Baca cannot be called from pure contexts.
/// Order of Baca effects matters.
