{
    "name": "riina-lang",
    "displayName": "RIINA Language",
    "description": "Language support for RIINA (Rigorous Immutable Invariant, No Assumptions), a programming language with a Coq-verified core model",
    "version": "0.1.0",
    "publisher": "ib823",
    "repository": {
        "type": "git",
        "url": "https://github.com/ib823/riina"
    },
    "license": "SEE LICENSE IN ../LICENSE",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": ["Programming Languages"],
    "activationEvents": ["onLanguage:riina"],
    "main": "./out/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In an untrusted workspace the language server is not started, and riina.riinacPath is taken only from user (not workspace) settings.",
            "restrictedConfigurations": ["riina.riinacPath"]
        }
    },
    "contributes": {
        "configuration": {
            "title": "RIINA",
            "properties": {
                "riina.riinacPath": {
                    "type": "string",
                    "default": "riinac",
                    "scope": "machine",
                    "description": "Path to the riinac compiler used for the language server and formatting. Machine-scoped: a workspace's .vscode/settings.json cannot override it, so opening an untrusted repository cannot choose which binary the extension runs."
                }
            }
        },
        "languages": [{
            "id": "riina",
            "aliases": ["RIINA", "riina"],
            "extensions": [".rii", ".riih"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "riina",
            "scopeName": "source.riina",
            "path": "./syntaxes/riina.tmLanguage.json"
        }],
        "snippets": [{
            "language": "riina",
            "path": "./snippets/riina.json"
        }]
    },
    "scripts": {
        "compile": "tsc -p ./tsconfig.json",
        "watch": "tsc -watch -p ./tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.3.0"
    }
}
